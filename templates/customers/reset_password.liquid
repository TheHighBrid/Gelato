<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password - {{ shop.name }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@300;400&family=DM+Mono:wght@400&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{--bg:#080808;--text:#F2EDE6;--accent:#C8FF00;--muted:#555;--border:#222;--surface:#141414;--error:#FF3333}
    body{background:var(--bg);color:var(--text);font-family:'Barlow',sans-serif;font-weight:300;min-height:100vh;display:flex;flex-direction:column;-webkit-font-smoothing:antialiased}
    a{color:inherit;text-decoration:none}
    .wrap{flex:1;display:flex;align-items:center;justify-content:center;padding:40px 24px}
    .card{width:100%;max-width:440px}
    .logo{font-family:'Bebas Neue',sans-serif;font-size:2rem;letter-spacing:.12em;margin-bottom:40px;display:block}
    .logo span{color:var(--accent)}
    h1{font-family:'Bebas Neue',sans-serif;font-size:2.5rem;letter-spacing:.05em;margin-bottom:8px}
    .sub{color:var(--muted);font-size:.875rem;line-height:1.6;margin-bottom:32px}
    .field{display:flex;flex-direction:column;gap:8px;margin-bottom:16px}
    .field label{font-family:'DM Mono',monospace;font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted)}
    .field input{background:var(--surface);border:1px solid var(--border);padding:12px 16px;font-family:'Barlow',sans-serif;font-size:.875rem;color:var(--text);outline:none;-webkit-appearance:none;appearance:none;transition:border-color .2s}
    .field input:focus{border-color:var(--accent)}
    .btn{display:inline-flex;align-items:center;justify-content:center;width:100%;padding:14px;background:var(--accent);color:var(--bg);font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.18em;text-transform:uppercase;border:none;cursor:pointer;margin-top:8px;transition:background .2s}
    .btn:hover{background:var(--text)}
    .btn-ghost{background:transparent;color:var(--muted);border:1px solid var(--border);margin-top:0;transition:border-color .2s,color .2s}
    .btn-ghost:hover{background:transparent;border-color:var(--text);color:var(--text)}
    .errors{background:rgba(255,51,51,.08);border:1px solid var(--error);padding:14px 16px;margin-bottom:20px;font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.1em;color:var(--error)}
    .success{background:rgba(200,255,0,.08);border:1px solid var(--accent);padding:14px 16px;margin-bottom:20px;font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.1em;color:var(--accent)}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <a href="{{ shop.url }}" class="logo">{{ shop.name }}<span>.</span></a>
      <h1>Reset Password</h1>
      <p class="sub">Enter your new password below.</p>

      {%- form 'reset_customer_password' -%}
        {%- if form.errors -%}
          <div class="errors" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        {%- if form.posted_successfully? -%}
          <div class="success">Password updated successfully.</div>
        {%- endif -%}
        <div class="field">
          <label for="reset-password">New Password</label>
          <input type="password" name="customer[password]" id="reset-password" autocomplete="new-password" required>
        </div>
        <div class="field">
          <label for="reset-password-confirm">Confirm New Password</label>
          <input type="password" name="customer[password_confirmation]" id="reset-password-confirm" autocomplete="new-password" required>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px;margin-top:8px;">
          <button type="submit" class="btn">Reset Password</button>
          <a href="{{ routes.account_login_url }}" class="btn btn-ghost">Back to Login</a>
        </div>
      {%- endform -%}
    </div>
  </div>
</body>
</html>

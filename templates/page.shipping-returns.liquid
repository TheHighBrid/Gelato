{% comment %}
  Melato — Delivery & Returns Page Template
  Template: page.shipping-returns
  URL: /pages/shipping-returns
{% endcomment %}

{{ 'melato-concierge.css' | asset_url | stylesheet_tag }}
<script src="{{ 'melato-concierge.js' | asset_url }}" defer></script>

<div class="melato-page">
  <header class="melato-page-header">
    <div class="melato-eyebrow">Melato Client Services</div>
    <h1 class="melato-page-header__title">{{ page.title | default: 'Shipping & Returns' }}</h1>
    <p class="melato-page-header__subtitle">Processing, delivery, tracking and return guidance in one place.</p>
  </header>

  <div class="melato-container">
    {% if page.content != blank %}
      <div class="rte">{{ page.content }}</div>
    {% else %}
      <div class="melato-card">
        <h2 class="melato-h3">Delivery & returns</h2>
        <p class="melato-body-sm">Available services and eligibility follow Melato's current shipping and returns policies.</p>
      </div>
    {% endif %}
  </div>

  {% section 'concierge-strip' %}
</div>

{% comment %}
  Melato — Delivery & Returns Page Template
  Template: page.shipping-returns
  URL: /pages/shipping-returns
{% endcomment %}

{{ 'melato-concierge.css' | asset_url | stylesheet_tag }}
<script src="{{ 'melato-concierge.js' | asset_url }}" defer></script>

<div class="melato-page">
  <header class="melato-page-header melato-service-hero" style="background:#0b0b0c!important;color:#f5f1e8!important;opacity:1!important;padding:clamp(44px,7vw,86px) 24px;margin:0 auto clamp(28px,5vw,52px);max-width:1120px;text-align:center;">
    <div class="melato-eyebrow" style="color:#d8d0c4!important;opacity:1!important;">Melato Client Services</div>
    <h1 class="melato-page-header__title" style="color:#f5f1e8!important;opacity:1!important;text-shadow:none!important;">{{ page.title | default: 'Shipping & Returns' }}</h1>
    <p class="melato-page-header__subtitle" style="color:#e8dfd1!important;opacity:1!important;">Processing, delivery, tracking and return guidance in one place.</p>
  </header>

  <div class="melato-container">
    {% if page.content != blank %}
      <div class="rte">{{ page.content }}</div>
    {% else %}
      <div class="melato-card">
        <h2 class="melato-h3">Delivery & returns</h2>
        <p class="melato-body-sm">Available services and eligibility follow Melato's current shipping and returns policies.</p>
      </div>
    {% endif %}
  </div>

  {% section 'concierge-strip' %}
</div>

{% comment %}
  Melato — Private Preview Page Template
  Template: page.preview
  URL: /pages/preview
{% endcomment %}

{{ 'melato-concierge.css' | asset_url | stylesheet_tag }}
<script src="{{ 'melato-concierge.js' | asset_url }}" defer></script>

<div class="melato-page">
  <header class="melato-page-header">
    <div class="melato-eyebrow">Melato Client Services</div>
    <h1 class="melato-page-header__title">{{ page.title | default: 'Private Preview' }}</h1>
    <p class="melato-page-header__subtitle">Selected releases, early-access notices and first-look updates from Melato.</p>
  </header>

  <div class="melato-container">
    {% if page.content != blank %}
      <div class="rte">{{ page.content }}</div>
    {% else %}
      <div class="melato-card">
        <h2 class="melato-h3">First access, when available.</h2>
        <p class="melato-body-sm">Private preview details are sent directly when an eligible Melato release opens early.</p>
      </div>
    {% endif %}
  </div>

  {% section 'concierge-strip' %}
</div>

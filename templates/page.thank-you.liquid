{% comment %}
  Melato — Post-Purchase Page Template
  Template: page.thank-you
  URL: /pages/thank-you
{% endcomment %}

{{ 'melato-concierge.css' | asset_url | stylesheet_tag }}
<script src="{{ 'melato-concierge.js' | asset_url }}" defer></script>

<div class="melato-page">
  <header class="melato-page-header">
    <div class="melato-eyebrow">Melato Client Services</div>
    <h1 class="melato-page-header__title">{{ page.title | default: 'Thank You' }}</h1>
    <p class="melato-page-header__subtitle">Order status, tracking guidance and support after checkout.</p>
  </header>

  <div class="melato-container">
    {% if page.content != blank %}
      <div class="rte">{{ page.content }}</div>
    {% else %}
      <div class="melato-card">
        <h2 class="melato-h3">Your order is in our hands.</h2>
        <p class="melato-body-sm">Tracking is sent to the contact details used at checkout once your parcel enters transit.</p>
      </div>
    {% endif %}
  </div>

  {% section 'concierge-strip' %}
</div>

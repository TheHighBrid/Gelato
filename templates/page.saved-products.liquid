{% comment %}
  Melato Saved Products
  Browser-local saved list. Product data is refreshed from Shopify when this page opens.
{% endcomment %}
<section class="melato-saved-page" data-melato-saved-page>
  <div class="melato-saved-page__inner">
    <p class="melato-saved-page__eyebrow">Your edit</p>
    <h1>Saved Pieces</h1>
    <p class="melato-saved-page__intro">Keep the pieces you are considering in one place, then return to the collection when you are ready.</p>
    <div class="melato-saved-grid" data-saved-grid aria-live="polite"></div>
    <div class="melato-saved-empty" data-saved-empty hidden>
      <p>No pieces saved yet.</p>
      <a href="/collections/new-arrivals">Explore new arrivals</a>
    </div>
  </div>
</section>

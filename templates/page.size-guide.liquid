{% comment %}
  Melato Fit Guidance Page Template
  Template: page.size-guide
  URL: /pages/size-guide

  The Shopify Page body is the source of truth. This template deliberately does
  not generate a universal measurement chart.
{% endcomment %}

{%- liquid
  assign service_content = page.content
  assign content_has_heading = false
  if service_content contains '<h1'
    assign content_has_heading = true
  endif
-%}

<div class="melato-page">
  {% unless content_has_heading %}
    <header class="melato-page-header melato-service-hero" style="background:#0b0b0c!important;color:#f5f1e8!important;opacity:1!important;padding:clamp(44px,7vw,86px) 24px;margin:0 auto clamp(28px,5vw,52px);max-width:1120px;text-align:center;">
      <div class="melato-eyebrow" style="color:#d8d0c4!important;opacity:1!important;">Melato Client Services</div>
      <h1 class="melato-page-header__title" style="color:#f5f1e8!important;opacity:1!important;text-shadow:none!important;">{{ page.title | default: 'Fit Guidance' }}</h1>
      <p class="melato-page-header__subtitle" style="color:#e8dfd1!important;opacity:1!important;">Product-specific fit notes, approved garment measurements when available, and personal sizing support.</p>
    </header>
  {% endunless %}

  <div class="melato-container">
    {% if service_content != blank %}
      <div class="rte">{{ service_content }}</div>
    {% else %}
      <div class="melato-card">
        <h2 class="melato-h3">Fit is product-specific.</h2>
        <p class="melato-body-sm">Use the Fit guidance and any approved Product Measurements shown on the product page. If measurements are not published for that piece, contact <a href="mailto:support@melato.ca">support@melato.ca</a> before ordering.</p>
      </div>
    {% endif %}
  </div>

  {% section 'concierge-strip' %}
</div>

{% comment %}
  Melato Fit Guidance Page Template
  Template: page.size-guide
  URL: /pages/size-guide

  Fit is product-specific.
  Product Measurements belong to each PDP when available.
  For fit help, contact support@melato.ca.

  The Shopify Page body is the source of truth. This template intentionally
  does not add a second hero, Client Services strip, universal measurement
  chart, or duplicate guidance copy.
{% endcomment %}

<div class="melato-page melato-service-page-clean" style="background:#0b0b0c!important;color:#f5f1e8!important;min-height:72vh;">
  <div class="melato-container" style="max-width:980px;margin:0 auto;padding:clamp(54px,7vw,92px) 24px clamp(72px,9vw,120px);background:transparent!important;color:#f5f1e8!important;">
    {% if page.content != blank %}
      <div class="rte melato-service-rte" style="color:#f5f1e8!important;background:transparent!important;">{{ page.content }}</div>
    {% else %}
      <section style="max-width:820px;color:#f5f1e8!important;">
        <p style="margin:0 0 14px;color:#c8bca9!important;font-size:12px;letter-spacing:.18em;text-transform:uppercase;">Fit guide</p>
        <h1 style="margin:0 0 22px;color:#f5f1e8!important;font-size:clamp(52px,9vw,104px);line-height:.86;letter-spacing:-.04em;text-transform:uppercase;">Fit Guide</h1>
        <p style="margin:0;color:#ded6c8!important;font-size:18px;line-height:1.7;">Use the product page first. Melato fit is product-specific by construction, silhouette, rise, length and intended drape. Product measurements appear on the product page when available. For fit help, contact support@melato.ca.</p>
      </section>
    {% endif %}
  </div>
</div>

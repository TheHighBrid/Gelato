{% comment %}
  Melato — Fit Guidance Page Template
  Template: page.size-guide
  URL: /pages/size-guide
{% endcomment %}

{{ 'melato-concierge.css' | asset_url | stylesheet_tag }}
<script src="{{ 'melato-concierge.js' | asset_url }}" defer></script>

<div class="melato-page">
  <header class="melato-page-header">
    <div class="melato-eyebrow">Melato Client Services</div>
    <h1 class="melato-page-header__title">{{ page.title | default: 'Fit Guide' }}</h1>
    <p class="melato-page-header__subtitle">Category measurements, fit notes and personal sizing support.</p>
  </header>

  <div class="melato-container">
    {% if page.content != blank %}
      <div class="rte">{{ page.content }}</div>
    {% else %}
      <div class="melato-card">
        <h2 class="melato-h3">Fit is product-specific.</h2>
        <p class="melato-body-sm">Use the measurements and fit notes shown for the piece you are considering. For personal guidance, contact Melato Client Care.</p>
      </div>
    {% endif %}
  </div>

  {% section 'concierge-strip' %}
</div>

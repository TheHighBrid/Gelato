{% comment %}
  Melato Fit Guidance
  This route intentionally does not render a universal size chart or arbitrary
  page body content. Approved sizing belongs to the individual product through
  custom.size_guide and the PDP Product Measurements drawer.
{% endcomment %}

{{ 'melato-concierge.css' | asset_url | stylesheet_tag }}
<script src="{{ 'melato-concierge.js' | asset_url }}" defer></script>

<div class="melato-page">
  <header class="melato-page-header">
    <div class="melato-eyebrow">Melato Client Services</div>
    <h1 class="melato-page-header__title">Fit Guidance</h1>
    <p class="melato-page-header__subtitle">Fit is product-specific. Construction, intended drape, rise, length and silhouette vary by garment.</p>
  </header>

  <div class="melato-container">
    <div class="melato-card">
      <h2 class="melato-h3">Use the product page for measurements.</h2>
      <p class="melato-body-sm">When a piece has approved measurements, they appear directly on that product page through its Product Measurements drawer. Those product-bound measurements are the source of truth for that garment.</p>
      <p class="melato-body-sm">If a product does not display approved measurements, Melato intentionally does not substitute a generic house chart. For personal guidance, contact <a href="mailto:support@melato.ca">support@melato.ca</a> with the product name, your usual size, height, relevant body measurements and preferred fit.</p>
    </div>
  </div>

  {% section 'concierge-strip' %}
</div>

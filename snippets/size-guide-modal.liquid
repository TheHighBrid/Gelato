{% comment %}
  Legacy size-guide modal compatibility.
  It renders only when the current product has a product-specific size-guide
  page assigned. No universal body chart is shown across unrelated garments.
{% endcomment %}

{%- assign size_guide_page = product.metafields.custom.size_guide.value -%}
{%- if product and size_guide_page != blank -%}
  <div class="size-guide-modal" role="dialog" aria-modal="true" aria-labelledby="LegacySizeGuideTitle" aria-hidden="true">
    <button class="drip-overlay" type="button" style="z-index:inherit" aria-label="Close size guide" data-size-guide-close></button>
    <div class="size-guide-modal__inner">
      <div class="size-guide-modal__header">
        <div>
          <p>Melato fit reference</p>
          <h2 id="LegacySizeGuideTitle">{{ product.title }} size guide</h2>
        </div>
        <button class="header__icon-btn" type="button" aria-label="Close size guide" data-size-guide-close>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="size-guide-modal__content rte">{{ size_guide_page.content }}</div>
      <p class="size-guide-modal__priority-note">Product-specific garment measurements take priority over general body measurements.</p>
    </div>
  </div>

  <style>
    .size-guide-modal__header{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:22px}.size-guide-modal__header p{margin:0 0 6px;font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:#9b968d}.size-guide-modal__header h2{margin:0;font-size:20px;text-transform:uppercase}.size-guide-modal__content table{width:100%;border-collapse:collapse}.size-guide-modal__content th,.size-guide-modal__content td{padding:10px 8px;text-align:left;border-bottom:1px solid rgba(255,255,255,.1)}.size-guide-modal__priority-note{margin:18px 0 0;color:#9b968d;font-size:11px;line-height:1.5}
  </style>
{%- endif -%}
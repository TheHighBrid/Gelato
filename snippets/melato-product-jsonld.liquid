{%- comment -%}
  Melato product JSON-LD.
  Outputs rich Product + Offer + Breadcrumb schema for PDP snippets.
  Aggregate ratings are emitted only when a real Shopify review count exists.
{%- endcomment -%}

{%- if product != blank -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign site_url = shop.url | default: request.origin -%}
{%- assign product_description = product.description | strip_html | strip_newlines | replace: '  ', ' ' | truncate: 700 -%}
{%- if product_description == blank -%}
  {%- assign product_description = product.title | append: ' by ' | append: shop.name -%}
{%- endif -%}
{%- assign currency_code = cart.currency.iso_code | default: shop.currency -%}
{%- assign review_count = product.metafields.reviews.rating_count.value | default: 0 -%}
{%- assign review_rating = product.metafields.reviews.rating.value.rating -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": {{ canonical_url | append: '#product' | json }},
      "name": {{ product.title | json }},
      "description": {{ product_description | json }},
      "url": {{ canonical_url | json }},
      "brand": {
        "@type": "Brand",
        "name": {{ shop.name | json }}
      },
      "sku": {{ current_variant.sku | default: product.handle | json }},
      "mpn": {{ current_variant.barcode | default: current_variant.sku | default: current_variant.id | json }},
      "category": {{ product.type | default: product.product_type | default: 'Apparel' | json }}{% if product.featured_image != blank %},
      "image": [
        {%- assign emitted_image = false -%}
        {%- for media in product.media limit: 8 -%}
          {%- if media.media_type == 'image' -%}
            {%- if emitted_image -%},{%- endif -%}{{ media | image_url: width: 1400 | prepend: 'https:' | json }}
            {%- assign emitted_image = true -%}
          {%- endif -%}
        {%- endfor -%}
      ]{% endif %},
      "offers": [
        {%- for variant in product.variants -%}
          {
            "@type": "Offer",
            "@id": {{ canonical_url | append: '?variant=' | append: variant.id | append: '#offer' | json }},
            "url": {{ site_url | append: variant.url | json }},
            "sku": {{ variant.sku | default: variant.id | json }},
            "name": {{ variant.title | json }},
            "priceCurrency": {{ currency_code | json }},
            "price": {{ variant.price | divided_by: 100.0 | json }},
            "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "itemCondition": "https://schema.org/NewCondition",
            "seller": {
              "@type": "Organization",
              "name": {{ shop.name | json }}
            }
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]{% if review_count > 0 and review_rating != blank %},
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ review_rating | json }},
        "reviewCount": {{ review_count | json }}
      }{% endif %}
    },
    {
      "@type": "BreadcrumbList",
      "@id": {{ canonical_url | append: '#product-breadcrumb' | json }},
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ site_url | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Products",
          "item": {{ site_url | append: routes.all_products_collection_url | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ product.title | json }},
          "item": {{ canonical_url | json }}
        }
      ]
    }
  ]
}
</script>
{%- endif -%}

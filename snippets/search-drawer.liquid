{% comment %}
  snippets/search-drawer.liquid
  Safe search drawer using Shopify-compatible HTML GET search form.
{% endcomment %}

<div
  class="search-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Search"
  aria-hidden="true"
>
  <form action="{{ routes.search_url }}" method="get" class="search-form" role="search">
    <label class="visually-hidden" for="SearchDrawerInput">Search</label>
    <input
      id="SearchDrawerInput"
      type="search"
      name="q"
      placeholder="Search Melato"
      aria-label="Search Melato"
      autocomplete="off"
      spellcheck="false"
    >
    <input type="hidden" name="type" value="product">
    <input type="hidden" name="options[prefix]" value="last">
    <button
  type="button"
  class="header-search-button"
  data-open-utility="search"
  aria-controls="MelatoUtilityLayer"
>
  Search
</button>
  </form>
</div>

  const normalize = (value) => {
    return String(value || "")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase();
  };

  const cleanHex = (value) => {
    if (!value) return "";
    let hex = String(value).trim();
    if (!hex.startsWith("#")) hex = "#" + hex;
    if (/^#[0-9a-f]{3}$/i.test(hex)) {
      hex = "#" + hex.slice(1).split("").map((x) => x + x).join("");
    }
    return /^#[0-9a-f]{6}$/i.test(hex) ? hex : "";
  };

  const hexToRgb = (hex) => {
    const safe = cleanHex(hex);
    if (!safe) return { r: 0, g: 0, b: 0 };
    const n = parseInt(safe.slice(1), 16);
    return {
      r: (n >> 16) & 255,
      g: (n >> 8) & 255,
      b: n & 255
    };
  };

  const luminance = (hex) => {
    const { r, g, b } = hexToRgb(hex);
    const channel = [r, g, b].map((v) => {
      v = v / 255;
      return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
    });
    return 0.2126 * channel[0] + 0.7152 * channel[1] + 0.0722 * channel[2];
  };

  const readableText = (background, palette) => {
    return luminance(background) > 0.58
      ? palette.darkText || "#17110d"
      : palette.lightText || "#fff7ea";
  };

  const contrastRatio = (a, b) => {
    const l1 = luminance(a);
    const l2 = luminance(b);
    return (Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05);
  };

  const mixHex = (from, to, amount) => {
    const a = hexToRgb(from);
    const b = hexToRgb(to);
    const channel = (start, end) => Math.round(start + (end - start) * amount);
    return "#" + [channel(a.r, b.r), channel(a.g, b.g), channel(a.b, b.b)]
      .map((value) => value.toString(16).padStart(2, "0"))
      .join("");
  };

  const readableAccent = (accent) => {
    const safe = cleanHex(accent) || fallbackPalette.accent;
    if (contrastRatio(safe, "#111214") >= 4.5) return safe;
    for (let amount = 0.12; amount <= 0.76; amount += 0.08) {
      const candidate = mixHex(safe, "#ffffff", amount);
      if (contrastRatio(candidate, "#111214") >= 4.5) return candidate;
    }
    return "#f5f1e8";
  };

  const keywordAccent = (text) => {
    const rules = [
      [["pink", "blush", "rose", "rosetta"], "#E991A7"],
      [["burgundy", "barolo", "merlot", "wine", "red"], "#9E465A"],
      [["blue", "navy", "azure", "sky", "cobalt"], "#7EA9D6"],
      [["green", "mint", "olive", "emerald", "forest"], "#79A982"],
      [["brown", "cognac", "caramel", "taupe", "cocoa"], "#A47750"],
      [["purple", "violet", "lavender", "plum"], "#8D6AB8"],
      [["orange", "magma", "rust"], "#C96A32"],
      [["yellow", "gold", "midas"], "#D3A74A"],
      [["cream", "bone", "ivory", "alabaster", "off white"], "#D8C7AD"],
      [["grey", "gray", "smoke", "silver"], "#9BA0A4"],
      [["black", "noir", "obsidian"], "#8E8172"]
    ];
    for (const rule of rules) {
      if (rule[0].some((word) => text.includes(word))) return rule[1];
    }
    return "";
  };

  const sampleProductAccent = async () => {
    const image = document.querySelector(
      ".melato-pdp-rebuild .pdp-main-image, .product__media img, .ml-main-image, [data-product-media] img"
    );
    if (!image) return "";

    const source = image.currentSrc || image.src;
    if (!source) return "";

    try {
      const url = new URL(source, window.location.href);
      if (/shopify|cdn\.shopify/i.test(url.hostname)) url.searchParams.set("width", "180");

      const response = await fetch(url.toString(), {
        mode: "cors",
        credentials: "omit",
        cache: "force-cache"
      });
      if (!response.ok) return "";

      const blob = await response.blob();
      const bitmap = await createImageBitmap(blob);
      const canvas = document.createElement("canvas");
      const size = 56;
      canvas.width = size;
      canvas.height = size;
      const context = canvas.getContext("2d", { willReadFrequently: true });
      if (!context) return "";

      context.drawImage(bitmap, 0, 0, size, size);
      if (bitmap.close) bitmap.close();

      const pixels = context.getImageData(0, 0, size, size).data;
      const bins = new Map();

      for (let i = 0; i < pixels.length; i += 4) {
        if (pixels[i + 3] < 220) continue;

        const r = pixels[i];
        const g = pixels[i + 1];
        const b = pixels[i + 2];
        const max = Math.max(r, g, b) / 255;
        const min = Math.min(r, g, b) / 255;
        const lightness = (max + min) / 2;
        const delta = max - min;
        const saturation = delta === 0 ? 0 : delta / (1 - Math.abs(2 * lightness - 1));

        if (r > 242 && g > 242 && b > 238) continue;
        if (lightness > 0.94 && saturation < 0.30) continue;
        if (lightness < 0.025) continue;

        const key = [
          Math.round(r / 24) * 24,
          Math.round(g / 24) * 24,
          Math.round(b / 24) * 24
        ].join(",");

        const entry = bins.get(key) || {
          count: 0, r: 0, g: 0, b: 0, saturation: 0, lightness: 0
        };
        entry.count += 1;
        entry.r += r;
        entry.g += g;
        entry.b += b;
        entry.saturation += saturation;
        entry.lightness += lightness;
        bins.set(key, entry);
      }

      let best = null;
      let bestScore = -1;
      bins.forEach((entry) => {
        const saturation = entry.saturation / entry.count;
        const lightness = entry.lightness / entry.count;
        const middle = 1 - Math.min(1, Math.abs(lightness - 0.52) / 0.52);
        let score = entry.count * (0.72 + saturation * 1.75) * (0.78 + middle * 0.92);
        if (lightness < 0.10) score *= 0.42;
        if (lightness > 0.88 && saturation < 0.22) score *= 0.25;
        if (score > bestScore) {
          bestScore = score;
          best = entry;
        }
      });

      if (!best) return "";
      const values = [best.r / best.count, best.g / best.count, best.b / best.count]
        .map((value) => Math.max(0, Math.min(255, Math.round(value))).toString(16).padStart(2, "0"));
      return "#" + values.join("");
    } catch (error) {
      return "";
    }
  };

  const productType = {{ product.type | json }};
const productTags = {{ product.tags | join: ' ' | json }};
const productVendor = {{ product.vendor | json }};

const haystack = normalize([
  productHandle,
  productTitle,
  productType,
  productTags,
  productVendor
].join(" "));

  const matched = productPalettes.find((item) => {
    return item.keys.some((key) => haystack.includes(normalize(key)));
  });

  let palette = matched ? { ...fallbackPalette, ...matched.palette } : { ...fallbackPalette };
  if (!matched) {
    const titleBasedAccent = keywordAccent(haystack);
    if (titleBasedAccent) {
      palette = {
        ...palette,
        name: "keyword-" + titleBasedAccent.slice(1).toLowerCase(),
        accent: titleBasedAccent,
        accent2: titleBasedAccent,
        eyebrow: titleBasedAccent,
        cta: titleBasedAccent,
        bar: [titleBasedAccent, "#111214", "#f5f1e8"]
      };
    }
  }

  const metaHasValues =
    metafieldPalette.bar.length ||
    metafieldPalette.accent ||
    metafieldPalette.accent2 ||
    metafieldPalette.title ||
    metafieldPalette.eyebrow ||
    metafieldPalette.cta;

  if (metaHasValues) {
    palette = {
      ...palette,
      name: palette.name + "-metafield-override",
      bar: metafieldPalette.bar.length ? metafieldPalette.bar : palette.bar,
      accent: metafieldPalette.accent || palette.accent,
      accent2: metafieldPalette.accent2 || palette.accent2,
      title: metafieldPalette.title || palette.title,
      eyebrow: metafieldPalette.eyebrow || palette.eyebrow,
      cta: metafieldPalette.cta || palette.cta
    };
  }

  palette.bar = palette.bar.map(cleanHex).filter(Boolean);
  palette.accent = cleanHex(palette.accent) || fallbackPalette.accent;
  palette.accent2 = cleanHex(palette.accent2) || fallbackPalette.accent2;
  palette.title = cleanHex(palette.title) || fallbackPalette.title;
  palette.eyebrow = cleanHex(palette.eyebrow) || fallbackPalette.eyebrow;
  palette.cta = cleanHex(palette.cta) || fallbackPalette.cta;

  if (!palette.bar.length) palette.bar = fallbackPalette.bar;

  const root = document.documentElement;

  const setRootVariables = () => {
    root.classList.add("melato-product-palette-ready");
    root.style.setProperty("--melato-product-accent", palette.accent);
    root.style.setProperty("--melato-product-accent-2", palette.accent2);
    root.style.setProperty("--melato-product-title", palette.title);
    root.style.setProperty("--melato-product-eyebrow", palette.eyebrow);
    root.style.setProperty("--melato-product-cta", palette.cta);
    root.style.setProperty("--melato-product-cta-text", readableText(palette.cta, palette));
    root.style.setProperty("--melato-product-accent-readable", readableAccent(palette.accent));
    root.style.setProperty("--melato-product-accent-foreground", readableText(palette.accent, palette));
    document.body.setAttribute("data-melato-product-palette", palette.name);
  };

  const findAnnouncementBars = () => {
    const selectors = [
      "#shopify-section-announcement-bar",
      "#shopify-section-announcement",
      "#shopify-section-melato-announcement",
      ".announcement-bar",
      ".announcement-bar-section",
      ".utility-bar",
      ".melato-announcement",
      "[id*='announcement']",
      "[class*='announcement']"
    ];

    const candidates = Array.from(document.querySelectorAll(selectors.join(",")));

    return candidates.filter((el) => {
      const text = normalize(el.innerText || "");
      const hasAnnouncementWords =
        text.includes("free shipping") ||
        text.includes("culture") ||
        text.includes("uniform") ||
        text.includes("new arrivals") ||
        text.includes("melato") ||
        text.length > 6;

      const hasSearch =
        el.querySelector("input[type='search']") ||
        el.querySelector("form[action*='/search']") ||
        el.querySelector("[class*='search']");

      const isProductCard = el.closest(".card-wrapper, .product-card, [class*='product-card']");

      return hasAnnouncementWords && !hasSearch && !isProductCard;
    });
  };

  const paintAnnouncementBars = () => {
    const bars = findAnnouncementBars();
    if (!bars.length) return;

    let index = 0;

    const applyColor = () => {
      const background = palette.bar[index % palette.bar.length];
      const text = readableText(background, palette);

      root.style.setProperty("--melato-bar-current", background);
      root.style.setProperty("--melato-bar-text-current", text);

      bars.forEach((bar) => {
        bar.classList.add("melato-dynamic-announcement");
        bar.style.setProperty("--melato-bar-current", background);
        bar.style.setProperty("--melato-bar-text-current", text);
      });

      index += 1;
    };

    applyColor();

    if (palette.bar.length > 1) {
      window.setInterval(applyColor, 4200);
    }
  };

  const accentProductTitles = () => {
    const titleSelectors = [
      "h1",
      "h2",
      "h3",
      ".product__title",
      ".product-title",
      ".product__info-container h1",
      ".section-title",
      ".section__title",
      ".title",
      ".heading",
      "[class*='section-title']",
      "[class*='section__title']",
      "[class*='heading']",
      "[class*='complete'] h1",
      "[class*='complete'] h2",
      "[class*='complete'] h3",
      "[id*='complete'] h1",
      "[id*='complete'] h2",
      "[id*='complete'] h3"
    ];

    document.querySelectorAll(titleSelectors.join(",")).forEach((el) => {
      const text = normalize(el.textContent || "");

      if (!text) return;

      const isSmallUtility =
        text.includes("product focus") ||
        text.includes("product architecture") ||
        text.includes("technical read") ||
        text.includes("technical details") ||
        text.includes("extra photos") ||
        text.includes("description") ||
        text.includes("complete the set") ||
        text.includes("you have") ||
        text.includes("add the matching piece");

      if (isSmallUtility) {
        el.classList.add("melato-product-accent-eyebrow");
      } else {
        el.classList.add("melato-product-accent-title");
      }
    });

    const eyebrowSelectors = [
      ".caption-with-letter-spacing",
      ".eyebrow",
      ".kicker",
      ".subtitle",
      "[class*='eyebrow']",
      "[class*='kicker']",
      "[class*='caption']",
      "[class*='subtitle']"
    ];

    document.querySelectorAll(eyebrowSelectors.join(",")).forEach((el) => {
      const text = normalize(el.textContent || "");
      if (text.length && text.length < 90) {
        el.classList.add("melato-product-accent-eyebrow");
      }
    });

    document.querySelectorAll(".product__media-wrapper, .product__info-wrapper, [class*='complete'], [class*='accordion']").forEach((el) => {
      el.classList.add("melato-product-soft-border");
    });
  };

  let autoSampleToken = 0;
  const refreshAutoAccent = async () => {
    if (matched || metaHasValues) return;
    const token = ++autoSampleToken;
    const sampled = await sampleProductAccent();
    if (!sampled || token !== autoSampleToken) return;

    palette = {
      ...palette,
      name: "image-sampled",
      accent: sampled,
      accent2: sampled,
      eyebrow: sampled,
      cta: sampled,
      bar: [sampled, mixHex(sampled, "#111214", 0.58), "#f5f1e8"]
    };
    setRootVariables();
    accentProductTitles();
  };

  const init = () => {
    setRootVariables();
    paintAnnouncementBars();
    accentProductTitles();
    refreshAutoAccent();
  };

  document.addEventListener("variant:change", () => {
    if (!matched && !metaHasValues) window.setTimeout(refreshAutoAccent, 90);
  });

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>

{% endif %}

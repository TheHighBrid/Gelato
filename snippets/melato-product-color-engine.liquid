{% comment %}
  MELATO - Dynamic Product Color Engine
  File: snippets/melato-product-color-engine.liquid

  Install:
  {% render 'melato-product-color-engine' %}

  Place before </body> in layout/theme.liquid
{% endcomment %}

{% if request.page_type == 'product' and product %}

<style id="melato-product-color-engine-css">
  html.melato-product-palette-ready {
    --melato-product-accent: #c9a85d;
    --melato-product-accent-2: #f6ead8;
    --melato-product-title: #f6ead8;
    --melato-product-eyebrow: #c9a85d;
    --melato-product-cta: #c40025;
    --melato-product-cta-text: #ffffff;
    --melato-bar-current: #111111;
    --melato-bar-text-current: #ffffff;
  }

  html.melato-product-palette-ready body.template-product .melato-dynamic-announcement,
  html.melato-product-palette-ready .melato-dynamic-announcement {
    background: var(--melato-bar-current) !important;
    color: var(--melato-bar-text-current) !important;
    transition:
      background-color 1800ms cubic-bezier(.4, 0, .2, 1),
      color 800ms ease,
      border-color 800ms ease !important;
    border-color: rgba(255, 255, 255, .14) !important;
  }

  html.melato-product-palette-ready .melato-dynamic-announcement *:not(input):not(textarea):not(select):not(option) {
    color: var(--melato-bar-text-current) !important;
    border-color: currentColor !important;
  }

  html.melato-product-palette-ready body.template-product .melato-product-accent-title {
    color: var(--melato-product-title) !important;
    transition: color 600ms ease;
  }

  html.melato-product-palette-ready body.template-product .melato-product-accent-eyebrow {
    color: var(--melato-product-eyebrow) !important;
    transition: color 600ms ease;
  }

  html.melato-product-palette-ready body.template-product .product-form__submit,
  html.melato-product-palette-ready body.template-product button[name="add"],
  html.melato-product-palette-ready body.template-product .shopify-payment-button__button,
  html.melato-product-palette-ready body.template-product .product-form button[type="submit"] {
    background: var(--melato-product-cta) !important;
    color: var(--melato-product-cta-text) !important;
    border-color: var(--melato-product-cta) !important;
    transition:
      background-color 500ms ease,
      color 500ms ease,
      border-color 500ms ease,
      transform 220ms ease;
  }

  html.melato-product-palette-ready body.template-product .product-form__submit:hover,
  html.melato-product-palette-ready body.template-product button[name="add"]:hover,
  html.melato-product-palette-ready body.template-product .product-form button[type="submit"]:hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
  }

  html.melato-product-palette-ready body.template-product .price,
  html.melato-product-palette-ready body.template-product .product__price,
  html.melato-product-palette-ready body.template-product [class*="price"] {
    color: var(--melato-product-accent-2) !important;
  }

  html.melato-product-palette-ready body.template-product .product__media-wrapper,
  html.melato-product-palette-ready body.template-product .product__info-wrapper,
  html.melato-product-palette-ready body.template-product [class*="complete"] {
    --melato-local-border: var(--melato-product-accent);
  }

  html.melato-product-palette-ready body.template-product [class*="complete"] h1,
  html.melato-product-palette-ready body.template-product [class*="complete"] h2,
  html.melato-product-palette-ready body.template-product [class*="complete"] h3,
  html.melato-product-palette-ready body.template-product [id*="complete"] h1,
  html.melato-product-palette-ready body.template-product [id*="complete"] h2,
  html.melato-product-palette-ready body.template-product [id*="complete"] h3 {
    color: var(--melato-product-title) !important;
  }

  html.melato-product-palette-ready body.template-product [class*="complete"] .price,
  html.melato-product-palette-ready body.template-product [id*="complete"] .price,
  html.melato-product-palette-ready body.template-product [class*="complete"] [class*="money"],
  html.melato-product-palette-ready body.template-product [id*="complete"] [class*="money"] {
    color: var(--melato-product-accent-2) !important;
  }

  html.melato-product-palette-ready body.template-product .melato-product-soft-border {
    border-color: var(--melato-product-accent) !important;
  }
</style>


{% comment %}
  Product-specific sizing drawer.
  The drawer renders only when product.metafields.custom.size_guide points to a product-specific page.
{% endcomment %}

{%- liquid
  assign size_guide_page = product.metafields.custom.size_guide.value
  assign size_guide_handle = size_guide_page.handle | default: '' | downcase
  assign is_generic_fit_guide = false
  if size_guide_handle == 'size-guide' or size_guide_handle == 'melato-size-guide' or size_guide_handle == 'sizing-guide' or size_guide_handle == 'fit-guide'
    assign is_generic_fit_guide = true
  endif
  assign drawer_id = 'SizeGuideDrawer-' | append: product.id
  assign drawer_title_id = 'SizeGuideTitle-' | append: product.id
-%}

{%- if size_guide_page != blank and is_generic_fit_guide == false -%}
  <div id="{{ drawer_id }}" class="melato-size-drawer" aria-hidden="true" data-size-drawer>
    <button class="melato-size-drawer__overlay" type="button" data-close-size-drawer tabindex="-1" aria-label="Close size guide"></button>
    <aside class="melato-size-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="{{ drawer_title_id }}" tabindex="-1">
      <header class="melato-size-drawer__header">
        <div>
          <p class="melato-size-drawer__eyebrow">Melato fit reference</p>
          <h2 id="{{ drawer_title_id }}" class="melato-size-drawer__title">{{ product.title }} measurements</h2>
        </div>
        <button type="button" class="melato-size-drawer__close" data-close-size-drawer aria-label="Close sizing drawer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </header>
      <div class="melato-size-drawer__body">
        <div class="melato-size-drawer__metafield rte">{{ size_guide_page.content }}</div>
        <p class="melato-size-drawer__priority-note">These product-specific garment measurements take priority over general body charts.</p>
      </div>
    </aside>
  </div>

  <style>
    .melato-size-drawer{position:fixed;inset:0;z-index:9999;visibility:hidden;pointer-events:none}.melato-size-drawer[aria-hidden="false"]{visibility:visible;pointer-events:auto}.melato-size-drawer__overlay{position:absolute;inset:0;width:100%;height:100%;padding:0;border:0;background:rgba(0,0,0,.76);opacity:0;transition:opacity .28s ease}.melato-size-drawer[aria-hidden="false"] .melato-size-drawer__overlay{opacity:1}.melato-size-drawer__panel{position:absolute;top:0;right:0;width:min(480px,100%);height:100%;display:flex;flex-direction:column;background:#090909;color:#f5f1e8;border-left:1px solid rgba(255,255,255,.12);box-shadow:-24px 0 70px rgba(0,0,0,.48);transform:translateX(100%);transition:transform .34s cubic-bezier(.16,1,.3,1);outline:none}.melato-size-drawer[aria-hidden="false"] .melato-size-drawer__panel{transform:translateX(0)}.melato-size-drawer__header{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;padding:24px;border-bottom:1px solid rgba(255,255,255,.1)}.melato-size-drawer__eyebrow{margin:0 0 7px;font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:#d3a74a}.melato-size-drawer__title{margin:0;font-size:15px;line-height:1.3;letter-spacing:.1em;text-transform:uppercase}.melato-size-drawer__close{width:40px;height:40px;display:grid;place-items:center;padding:0;border:1px solid rgba(255,255,255,.16);border-radius:50%;background:transparent;color:#f5f1e8;cursor:pointer}.melato-size-drawer__body{overflow-y:auto;padding:24px;font-size:13px;line-height:1.65}.melato-size-drawer__metafield table{width:100%;border-collapse:collapse;margin:16px 0}.melato-size-drawer__metafield th,.melato-size-drawer__metafield td{padding:11px 8px;text-align:left;border-bottom:1px solid rgba(255,255,255,.08)}.melato-size-drawer__priority-note{margin:22px 0 0;padding:14px;border:1px solid rgba(255,255,255,.08);border-radius:14px;background:#111214;color:#89837b;font-size:11px}body.melato-size-drawer-open{overflow:hidden}@media(max-width:560px){.melato-size-drawer__panel{width:100%}.melato-size-drawer__header,.melato-size-drawer__body{padding:20px}}@media(prefers-reduced-motion:reduce){.melato-size-drawer__overlay,.melato-size-drawer__panel{transition:none}}
  </style>

  <script>
  (function(){
    var drawer=document.getElementById({{ drawer_id | json }});
    if(!drawer||drawer.dataset.drawerReady==='true')return;
    drawer.dataset.drawerReady='true';
    var triggers=document.querySelectorAll('[data-open-size-drawer]');
    var panel=drawer.querySelector('.melato-size-drawer__panel');
    var lastTrigger=null;
    var focusableSelector='a[href],button:not([disabled]),input:not([disabled]),select:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex="-1"])';

    function openDrawer(trigger){
      lastTrigger=trigger;
      drawer.setAttribute('aria-hidden','false');
      triggers.forEach(function(item){item.setAttribute('aria-expanded','true')});
      document.body.classList.add('melato-size-drawer-open');
      window.requestAnimationFrame(function(){panel.focus()});
    }
    function closeDrawer(){
      drawer.setAttribute('aria-hidden','true');
      triggers.forEach(function(item){item.setAttribute('aria-expanded','false')});
      document.body.classList.remove('melato-size-drawer-open');
      if(lastTrigger)lastTrigger.focus();
    }

    triggers.forEach(function(trigger){
      trigger.setAttribute('aria-controls',drawer.id);
      trigger.addEventListener('click',function(event){event.preventDefault();openDrawer(trigger)});
    });
    drawer.querySelectorAll('[data-close-size-drawer]').forEach(function(control){control.addEventListener('click',closeDrawer)});
    drawer.addEventListener('keydown',function(event){
      if(event.key==='Escape'){event.preventDefault();closeDrawer();return}
      if(event.key!=='Tab')return;
      var focusable=Array.prototype.slice.call(drawer.querySelectorAll(focusableSelector));
      if(!focusable.length)return;
      var first=focusable[0],last=focusable[focusable.length-1];
      if(event.shiftKey&&document.activeElement===first){event.preventDefault();last.focus()}
      else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus()}
    });
  })();
  </script>
{%- endif -%}


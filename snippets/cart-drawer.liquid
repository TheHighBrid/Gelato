{% comment %}
  snippets/cart-drawer.liquid
  v2.6 — Complimentary delivery safety + cart drawer CRO
  - Free-shipping progress math is guarded when the threshold is zero
  - Per-line remove button + savings badge
  - Upsell rail auto-populated from complementary collection
  - Collapsible order note + gift wrap checkbox
  - Full AJAX qty/remove — no page reload
  - Accessible: focus trap, aria-live regions, keyboard nav, inert when closed
{% endcomment %}

{%- liquid
  assign free_threshold_cents = settings.cart_free_shipping_threshold | times: 100 | round
  assign cart_total = cart.total_price
  assign remaining_cents = 0
  assign progress_pct = 100
  assign shipping_unlocked = true

  if free_threshold_cents > 0
    assign remaining_cents = free_threshold_cents | minus: cart_total
    if remaining_cents <= 0
      assign shipping_unlocked = true
    else
      assign shipping_unlocked = false
    endif
    assign progress_pct = cart_total | times: 100 | divided_by: free_threshold_cents | at_most: 100
  endif
-%}

<div
  id="cart-drawer"
  class="cart-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Shopping cart"
  aria-hidden="true"
  inert
  data-cart-drawer
>

  <!-- HEADER -->
  <div class="cart-drawer__header">
    <div class="cart-drawer__header-left">
      <h2 class="cart-drawer__title">Your Cart</h2>
      <p class="cart-drawer__count">
        <span data-cart-item-count>{{ cart.item_count }}</span>
        {{ cart.item_count | pluralize: 'item', 'items' }}
      </p>
    </div>
<button
  type="button"
  class="header-cart-button"
  data-open-utility="cart"
  aria-controls="MelatoUtilityLayer"
>
  Cart
</button>
  </div>

  <!-- Promotional shipping progress intentionally removed by Melato brand policy. -->

  <!-- CART ITEMS -->
  <div
    class="cart-drawer__items"
    role="list"
    aria-label="Cart items"
    aria-live="polite"
    data-cart-items
  >
    {%- if cart.item_count == 0 -%}
      <div class="cart-drawer__empty">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" opacity=".3" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <p class="cart-drawer__empty-text">Your cart is empty.</p>
        <p class="cart-drawer__empty-sub">Explore the current Melato rotation.</p>
        <a href="/collections/new-arrivals" class="melato-cart-cta" data-cart-close>Shop New Arrivals</a>
      </div>
    {%- else -%}
      {%- for item in cart.items -%}
        <div class="cart-item" role="listitem" data-line-key="{{ item.key }}" data-line-index="{{ forloop.index }}">

          <!-- Item image -->
          <a href="{{ item.url }}" class="cart-item__img-link" tabindex="-1" aria-hidden="true">
            {%- if item.image != blank -%}
              <img
                class="cart-item__img"
                src="{{ item.image | image_url: width: 120 }}"
                srcset="{{ item.image | image_url: width: 120 }} 1x, {{ item.image | image_url: width: 240 }} 2x"
                alt="{{ item.title | escape }}"
                width="80"
                height="{{ 80 | divided_by: item.image.aspect_ratio | ceil }}"
                loading="lazy"
              >
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'cart-item__img' }}
            {%- endif -%}
          </a>

          <!-- Item details -->
          <div class="cart-item__info">
            <div class="cart-item__top">
              <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
              <button
                class="cart-item__remove"
                type="button"
                aria-label="Remove {{ item.product.title | escape }}"
                data-remove-line="{{ item.key }}"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
              </button>
            </div>

            {%- if item.variant.title != 'Default Title' -%}
              <span class="cart-item__variant">{{ item.variant.title }}</span>
            {%- endif -%}

            {%- if item.variant.compare_at_price > item.variant.price -%}
              {%- assign line_savings = item.variant.compare_at_price | minus: item.variant.price | times: item.quantity -%}
              <span class="cart-item__savings">Save {{ line_savings | money }}</span>
            {%- endif -%}

            <div class="cart-item__footer">
              <div class="qty-stepper" aria-label="Quantity for {{ item.product.title | escape }}">
                <button
                  class="qty-stepper__btn"
                  type="button"
                  aria-label="Decrease quantity"
                  data-qty-change="-1"
                  data-line-key="{{ item.key }}"
                >−</button>
                <input
                  class="qty-stepper__value"
                  type="number"
                  value="{{ item.quantity }}"
                  min="0"
                  aria-label="Quantity"
                  data-line-key="{{ item.key }}"
                >
                <button
                  class="qty-stepper__btn"
                  type="button"
                  aria-label="Increase quantity"
                  data-qty-change="+1"
                  data-line-key="{{ item.key }}"
                >+</button>
              </div>
              <span class="price" data-line-price="{{ item.key }}">{{ item.final_line_price | money }}</span>
            </div>
          </div>

        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <!-- UPSELL RAIL -->
  {%- if settings.cart_upsell and cart.item_count > 0 -%}
  <div class="cart-upsell" data-cart-upsell>
    <p class="cart-upsell__title">{{ settings.cart_upsell_title | default: 'COMPLETE THE UNIFORM' }}</p>
    <div class="cart-upsell__track" data-upsell-track>
      <!-- Populated by cart-drawer.js -->
    </div>
  </div>
  {%- endif -%}

  <!-- ORDER NOTE + GIFT WRAP -->
  {%- if cart.item_count > 0 -%}
  <div class="cart-extras">

    <!-- Gift wrap -->
    <label class="cart-gift-wrap">
      <input
        type="checkbox"
        class="cart-gift-wrap__check"
        data-gift-wrap
        {% if cart.attributes.gift_wrap == 'yes' %}checked{% endif %}
      >
      <span class="cart-gift-wrap__box" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
      </span>
      <span class="cart-gift-wrap__label">Gift wrap this order</span>
    </label>

    <!-- Order note -->
    <button
      class="cart-note-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="cart-note-field"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      Add order note
      <svg class="cart-note-toggle__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
    </button>
    <div id="cart-note-field" class="cart-note" aria-hidden="true" hidden>
      <textarea
        class="cart-note__input"
        name="note"
        form="cart-form"
        placeholder="Special instructions, delivery notes, gift messages…"
        aria-label="Order note"
        rows="3"
        data-note-input
      >{{ cart.note }}</textarea>
    </div>

  </div>
  {%- endif -%}

  <!-- FOOTER -->
  <div class="cart-drawer__footer">
    <div class="cart-subtotal">
      <span class="cart-subtotal__label">Subtotal</span>
      <span class="cart-subtotal__amount" data-cart-subtotal>{{ cart.total_price | money }}</span>
    </div>
    <p class="cart-drawer__tax-note">Taxes and applicable duties are calculated at checkout.</p>
    <form id="cart-form" action="/cart" method="post">
      <input type="hidden" name="note" data-note-hidden value="{{ cart.note | escape }}">
      <button
        type="submit"
        name="checkout"
        class="melato-cart-checkout-btn"
        {% if cart.item_count == 0 %}disabled{% endif %}
        data-checkout-btn
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        Checkout
      </button>
    </form>
    <a href="{{ routes.cart_url }}" class="cart-drawer__view-cart" data-cart-close>View full cart</a>
  </div>

</div>

<style>
/* ── Cart Drawer Shell ──────────────────────────────────────── */
.cart-drawer{position:fixed;top:0;right:0;width:min(440px,100vw);height:100%;background:#0e0e0f;border-left:1px solid rgba(255,255,255,.08);z-index:500;display:flex;flex-direction:column;transform:translateX(105%);transition:transform .4s cubic-bezier(.25,.46,.45,.94)}
.cart-drawer.is-open{transform:translateX(0)}
/* ── Header ───────────────────────────────────────────────── */
.cart-drawer__header{display:flex;align-items:center;justify-content:space-between;padding:20px 24px;border-bottom:1px solid rgba(255,255,255,.07);flex-shrink:0}
.cart-drawer__header-left{display:flex;align-items:baseline;gap:10px}
.cart-drawer__title{font-family:var(--font-heading-family);font-size:1.6rem;letter-spacing:.06em;text-transform:uppercase;color:#f5f1e8;margin:0}
.cart-drawer__count{font-family:var(--font-mono-family);font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:#9b968d;margin:0}
.cart-drawer__close-btn{width:36px;height:36px;display:flex;align-items:center;justify-content:center;border-radius:50%;border:1px solid rgba(255,255,255,.1);background:none;color:#9b968d;cursor:pointer;transition:border-color .2s,color .2s;flex-shrink:0}
.cart-drawer__close-btn:hover{border-color:#d3a74a;color:#d3a74a}
/* ── Free Shipping Bar ────────────────────────────────────── */
.cart-free-shipping{padding:12px 24px;border-bottom:1px solid rgba(255,255,255,.05);flex-shrink:0;background:rgba(211,167,74,.04)}
.cart-free-shipping__text{font-family:var(--font-mono-family);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:#9b968d;margin:0 0 8px;line-height:1.4}
.cart-free-shipping__text strong{color:#f5f1e8}
.cart-free-shipping__unlocked{display:inline-flex;align-items:center;gap:5px;color:#d3a74a;font-weight:600}
.cart-free-shipping__unlocked svg{flex-shrink:0}
.cart-free-shipping__bar{height:3px;background:rgba(255,255,255,.08);border-radius:99px;overflow:hidden}
.cart-free-shipping__fill{height:100%;background:linear-gradient(90deg,#d3a74a,#e8c96a);border-radius:99px;transition:width .5s cubic-bezier(.25,.46,.45,.94)}
.cart-free-shipping__fill.is-complete{background:linear-gradient(90deg,#2d8c5a,#3dac70)}
/* ── Cart Items ────────────────────────────────────────────── */
.cart-drawer__items{flex:1;overflow-y:auto;padding:0 24px;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.08) transparent}
.cart-drawer__empty{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:60px 24px;text-align:center;height:100%}
.cart-drawer__empty-text{font-family:var(--font-heading-family);font-size:1.3rem;letter-spacing:.06em;text-transform:uppercase;color:#f5f1e8;margin:0}
.cart-drawer__empty-sub{font-family:var(--font-mono-family);font-size:.65rem;letter-spacing:.1em;color:#9b968d;margin:0}
.melato-cart-cta{display:inline-flex;align-items:center;justify-content:center;padding:12px 28px;background:#9e1824;color:#fff;font-family:var(--font-mono-family);font-size:.65rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;border-radius:12px;text-decoration:none;transition:background .2s,transform .15s;margin-top:8px}
.melato-cart-cta:hover{background:#b81e2c;transform:translateY(-1px)}
.cart-item{display:grid;grid-template-columns:80px 1fr;gap:14px;padding:18px 0;border-bottom:1px solid rgba(255,255,255,.05)}
.cart-item:last-child{border-bottom:none}
.cart-item__img-link{display:block;flex-shrink:0}
.cart-item__img{width:80px;height:100px;object-fit:cover;border-radius:10px;background:#1a1a1c}
.cart-item__info{display:flex;flex-direction:column;gap:4px;min-width:0}
.cart-item__top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
.cart-item__title{font-family:var(--font-heading-family);font-size:1rem;letter-spacing:.04em;text-transform:uppercase;color:#f5f1e8;line-height:1.1;text-decoration:none;flex:1;transition:color .2s}
.cart-item__title:hover{color:#d3a74a}
.cart-item__remove{flex-shrink:0;width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:8px;border:1px solid rgba(255,255,255,.08);background:none;color:#9b968d;cursor:pointer;transition:border-color .2s,color .2s,background .2s}
.cart-item__remove:hover{border-color:rgba(240,113,123,.4);color:#f0717b;background:rgba(240,113,123,.08)}
.cart-item__variant{font-family:var(--font-mono-family);font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;color:#9b968d}
.cart-item__savings{font-family:var(--font-mono-family);font-size:.6rem;letter-spacing:.08em;text-transform:uppercase;color:#3dac70;background:rgba(61,172,112,.1);border:1px solid rgba(61,172,112,.2);border-radius:6px;padding:2px 6px;width:fit-content}
.cart-item__footer{display:flex;align-items:center;justify-content:space-between;margin-top:4px}
.qty-stepper{display:flex;align-items:center;border:1px solid rgba(255,255,255,.1);border-radius:10px;overflow:hidden}
.qty-stepper__btn{width:32px;height:32px;display:flex;align-items:center;justify-content:center;background:none;border:none;color:#9b968d;font-size:1rem;cursor:pointer;transition:background .2s,color .2s}
.qty-stepper__btn:hover{background:rgba(211,167,74,.12);color:#d3a74a}
.qty-stepper__value{width:36px;text-align:center;background:none;border:none;color:#f5f1e8;font-family:var(--font-mono-family);font-size:.75rem;-moz-appearance:textfield;appearance:textfield}
.qty-stepper__value::-webkit-outer-spin-button,.qty-stepper__value::-webkit-inner-spin-button{-webkit-appearance:none}
.cart-item .price{font-family:var(--font-mono-family);font-size:.8rem;letter-spacing:.06em;color:#f5f1e8}
/* ── Upsell Rail ───────────────────────────────────────────── */
.cart-upsell{padding:16px 24px;border-top:1px solid rgba(255,255,255,.06);flex-shrink:0}
.cart-upsell__title{font-family:var(--font-mono-family);font-size:.58rem;letter-spacing:.22em;text-transform:uppercase;color:#d3a74a;margin:0 0 12px}
.cart-upsell__track{display:flex;gap:10px;overflow-x:auto;scrollbar-width:none;padding-bottom:4px}
.cart-upsell__track::-webkit-scrollbar{display:none}
.upsell-card{flex-shrink:0;width:88px;cursor:pointer;text-decoration:none}
.upsell-card__img{width:88px;height:108px;object-fit:cover;border-radius:10px;background:#1a1a1c;display:block;transition:transform .3s}
.upsell-card:hover .upsell-card__img{transform:scale(1.03)}
.upsell-card__name{font-family:var(--font-heading-family);font-size:.75rem;letter-spacing:.04em;text-transform:uppercase;color:#f5f1e8;margin:6px 0 2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.1}
.upsell-card__price{font-family:var(--font-mono-family);font-size:.62rem;color:#d3a74a}
/* ── Cart Extras (note + gift wrap) ───────────────────────── */
.cart-extras{padding:12px 24px;border-top:1px solid rgba(255,255,255,.06);flex-shrink:0;display:flex;flex-direction:column;gap:10px}
.cart-gift-wrap{display:flex;align-items:center;gap:10px;cursor:pointer;-webkit-user-select:none;user-select:none}
.cart-gift-wrap input[type=checkbox]{position:absolute;opacity:0;width:0;height:0}
.cart-gift-wrap__box{width:22px;height:22px;flex-shrink:0;border:1px solid rgba(255,255,255,.15);border-radius:6px;display:flex;align-items:center;justify-content:center;color:transparent;background:transparent;transition:border-color .2s,background .2s,color .2s}
.cart-gift-wrap input:checked~.cart-gift-wrap__box{border-color:#d3a74a;background:rgba(211,167,74,.15);color:#d3a74a}
.cart-gift-wrap__label{font-family:var(--font-mono-family);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:#9b968d;transition:color .2s}
.cart-gift-wrap:hover .cart-gift-wrap__label{color:#f5f1e8}
.cart-note-toggle{display:flex;align-items:center;gap:8px;background:none;border:none;font-family:var(--font-mono-family);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:#9b968d;cursor:pointer;padding:0;transition:color .2s}
.cart-note-toggle:hover{color:#f5f1e8}
.cart-note-toggle__chevron{margin-left:auto;transition:transform .25s}
.cart-note-toggle[aria-expanded=true] .cart-note-toggle__chevron{transform:rotate(180deg)}
.cart-note{overflow:hidden;transition:max-height .3s ease}
.cart-note[hidden]{display:none}
.cart-note__input{width:100%;background:#171717;border:1px solid rgba(255,255,255,.1);border-radius:10px;color:#f5f1e8;font-family:var(--font-body-family);font-size:.82rem;padding:10px 12px;resize:none;transition:border-color .2s;margin-top:6px}
.cart-note__input:focus{outline:none;border-color:#d3a74a}
/* ── Footer ──────────────────────────────────────────────── */
.cart-drawer__footer{padding:16px 24px;border-top:1px solid rgba(255,255,255,.07);flex-shrink:0;display:flex;flex-direction:column;gap:10px}
.cart-subtotal{display:flex;justify-content:space-between;align-items:center}
.cart-subtotal__label{font-family:var(--font-mono-family);font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:#9b968d}
.cart-subtotal__amount{font-family:var(--font-mono-family);font-size:1.1rem;letter-spacing:.04em;font-weight:700;color:#f5f1e8}
.cart-drawer__tax-note{font-family:var(--font-mono-family);font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:#9b968d;text-align:center;margin:0}
.melato-cart-checkout-btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:54px;background:#9e1824;color:#fff;font-family:var(--font-mono-family);font-size:.7rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;border:0;border-radius:16px;cursor:pointer;transition:background .2s,transform .15s}
.melato-cart-checkout-btn:hover:not(:disabled){background:#b81e2c;transform:translateY(-1px)}
.melato-cart-checkout-btn:disabled{opacity:.4;cursor:not-allowed}
.cart-drawer__view-cart{font-family:var(--font-mono-family);font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:#9b968d;text-align:center;text-decoration:none;transition:color .2s;padding:4px 0;display:block}
.cart-drawer__view-cart:hover{color:#d3a74a}
</style>
{% comment %}
  Melato cart drawer / semantic QA 2026-08-20.
  Quantity and removal remain AJAX-driven by melato-cart-drawer.js.
{% endcomment %}
<div id="cart-drawer" class="cart-drawer" role="dialog" aria-modal="true" aria-label="Shopping cart" aria-hidden="true" inert data-cart-drawer>
  <div class="cart-drawer__header">
    <div class="cart-drawer__header-left">
      <h2 class="cart-drawer__title">Your Cart</h2>
      <p class="cart-drawer__count"><span data-cart-item-count>{{ cart.item_count }}</span> {{ cart.item_count | pluralize: 'item', 'items' }}</p>
    </div>
    <button type="button" class="cart-drawer__close-btn" data-cart-close aria-label="Close cart and continue shopping">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <div class="cart-drawer__items" role="list" aria-label="Cart items" aria-live="polite" data-cart-items>
    {%- if cart.item_count == 0 -%}
      {%- render 'melato-cart-empty-state' -%}
    {%- else -%}
      {%- for item in cart.items -%}
        <div class="cart-item" role="listitem" data-line-key="{{ item.key }}" data-line-index="{{ forloop.index }}">
          <a href="{{ item.url }}" class="cart-item__img-link" tabindex="-1" aria-hidden="true">
            {%- if item.image != blank -%}
              <img class="cart-item__img" src="{{ item.image | image_url: width: 120 }}" srcset="{{ item.image | image_url: width: 120 }} 1x, {{ item.image | image_url: width: 240 }} 2x" alt="{{ item.title | escape }}" width="80" height="{{ 80 | divided_by: item.image.aspect_ratio | ceil }}" loading="lazy">
            {%- endif -%}
          </a>
          <div class="cart-item__info">
            <div class="cart-item__top">
              <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
              <button class="cart-item__remove" type="button" aria-label="Remove {{ item.product.title | escape }}" data-remove-line="{{ item.key }}">×</button>
            </div>
            {%- if item.variant.title != 'Default Title' -%}<span class="cart-item__variant">{{ item.variant.title }}</span>{%- endif -%}
            <div class="cart-item__footer">
              <div class="qty-stepper" aria-label="Quantity for {{ item.product.title | escape }}">
                <button class="qty-stepper__btn" type="button" aria-label="Decrease quantity" data-qty-change="-1" data-line-key="{{ item.key }}">−</button>
                <input class="qty-stepper__value" type="number" value="{{ item.quantity }}" min="0" aria-label="Quantity" data-line-key="{{ item.key }}">
                <button class="qty-stepper__btn" type="button" aria-label="Increase quantity" data-qty-change="1" data-line-key="{{ item.key }}">+</button>
              </div>
              <span class="price" data-line-price="{{ item.key }}" aria-label="Price {{ item.final_line_price | money | strip_html | escape }}">{{ item.final_line_price | money }}</span>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
  <template data-cart-empty-template>{%- render 'melato-cart-empty-state' -%}</template>

  {%- if cart.item_count > 0 -%}
    <div class="cart-extras">
      <button class="cart-note-toggle" type="button" aria-expanded="false" aria-controls="cart-note-field">Add order note <span aria-hidden="true">⌄</span></button>
      <div id="cart-note-field" class="cart-note" aria-hidden="true" hidden>
        <textarea class="cart-note__input" name="note" form="cart-form" placeholder="Order note" aria-label="Order note" rows="3" data-note-input>{{ cart.note }}</textarea>
      </div>
    </div>
  {%- endif -%}

  <div class="cart-drawer__footer">
    <div class="cart-subtotal" aria-label="Subtotal {{ cart.total_price | money | strip_html | escape }}"><span class="cart-subtotal__label">Subtotal:</span> <span class="cart-subtotal__amount" data-cart-subtotal>{{ cart.total_price | money }}</span></div>
    <p class="cart-drawer__policy-note">Complimentary standard delivery.</p>
    <form id="cart-form" action="/cart" method="post">
      <input type="hidden" name="note" data-note-hidden value="{{ cart.note | escape }}">
      <button type="submit" name="checkout" class="melato-cart-checkout-btn" {% if cart.item_count == 0 %}disabled{% endif %} data-checkout-btn>Checkout</button>
    </form>
    <a href="{{ routes.cart_url }}" class="cart-drawer__view-cart">View cart</a>
  </div>
</div>

<style>
.cart-drawer{position:fixed;top:0;right:0;width:min(440px,100vw);height:100%;background:#0e0e0f;border-left:1px solid rgba(255,255,255,.08);z-index:2500;display:flex;flex-direction:column;transform:translateX(105%);transition:transform .35s ease;color:#f5f1e8}.cart-drawer.is-open{transform:translateX(0)}.cart-drawer__header{display:flex;align-items:center;justify-content:space-between;padding:20px 24px;border-bottom:1px solid rgba(255,255,255,.08);flex-shrink:0}.cart-drawer__header-left{display:flex;align-items:baseline;gap:10px}.cart-drawer__title{font-family:var(--font-heading-family);font-size:1.6rem;letter-spacing:.04em;text-transform:uppercase;margin:0;color:#f5f1e8}.cart-drawer__count{font-family:var(--font-mono-family);font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:#9b968d;margin:0}.cart-drawer__close-btn{width:42px;height:42px;display:grid;place-items:center;border-radius:50%;border:1px solid rgba(255,255,255,.15);background:transparent;color:#f5f1e8;cursor:pointer}.cart-drawer__close-btn svg{width:18px;height:18px}.cart-drawer__items{flex:1;overflow-y:auto;padding:0 24px}.cart-drawer__empty{min-height:100%;display:flex;flex-direction:column;align-items:stretch;justify-content:center;gap:20px;padding:28px 0}.cart-drawer__empty-copy{text-align:center}.cart-drawer__empty-kicker{margin:0 0 8px;color:#9b968d;font-family:var(--font-mono-family);font-size:.58rem;letter-spacing:.16em;text-transform:uppercase}.cart-drawer__empty-text{font-family:var(--font-heading-family);font-size:1.4rem;text-transform:uppercase;margin:0}.cart-drawer__empty-note{max-width:300px;margin:8px auto 0;color:#9b968d;font-size:12px;line-height:1.5}.cart-recovery{display:grid;gap:8px}.cart-recovery__item{display:grid;grid-template-columns:72px minmax(0,1fr);gap:12px;align-items:center;padding:8px;border:1px solid rgba(255,255,255,.08);border-radius:12px;color:#f5f1e8;text-decoration:none;background:rgba(255,255,255,.025)}.cart-recovery__image{display:block;width:72px;height:90px;object-fit:cover;border-radius:8px;background:#f1eee8}.cart-recovery__meta{display:flex;min-width:0;flex-direction:column;gap:5px}.cart-recovery__meta strong{font-family:var(--font-heading-family);font-size:.95rem;line-height:1.05;text-transform:uppercase}.cart-recovery__meta span{color:#aaa49b;font-family:var(--font-mono-family);font-size:.68em}.melato-cart-cta{display:inline-flex;align-self:center;padding:12px 18px;border:1px solid rgba(255,255,255,.18);border-radius:12px;color:#f5f1e8;text-decoration:none;font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.cart-item{display:grid;grid-template-columns:88px 1fr;gap:14px;padding:20px 0;border-bottom:1px solid rgba(255,255,255,.07)}.cart-item__img-link{display:block}.cart-item__img{width:88px;height:110px;object-fit:cover;border-radius:12px;background:#f1eee8}.cart-item__info{display:flex;flex-direction:column;gap:7px;min-width:0}.cart-item__top{display:flex;gap:10px;align-items:flex-start;justify-content:space-between}.cart-item__title{color:#f5f1e8;text-decoration:none;font-family:var(--font-heading-family);font-size:1rem;line-height:1.1;text-transform:uppercase}.cart-item__remove{width:30px;height:30px;display:grid;place-items:center;flex:0 0 auto;border-radius:8px;border:1px solid rgba(255,255,255,.1);background:transparent;color:#9b968d;cursor:pointer;font-size:18px}.cart-item__variant{font-family:var(--font-mono-family);font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;color:#9b968d}.cart-item__footer{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:auto}.qty-stepper{display:flex;align-items:center;border:1px solid rgba(255,255,255,.12);border-radius:10px;overflow:hidden}.qty-stepper__btn{width:34px;height:34px;border:0;background:transparent;color:#aaa49b;cursor:pointer}.qty-stepper__value{width:38px;background:transparent;border:0;color:#f5f1e8;text-align:center;font-family:var(--font-mono-family);-moz-appearance:textfield;appearance:textfield}.qty-stepper__value::-webkit-outer-spin-button,.qty-stepper__value::-webkit-inner-spin-button{-webkit-appearance:none}.cart-item .price{font-family:var(--font-mono-family);font-size:.82rem}.cart-extras{padding:16px 24px;border-top:1px solid rgba(255,255,255,.08);flex-shrink:0}.cart-note-toggle{width:100%;display:flex;align-items:center;justify-content:space-between;border:0;background:transparent;color:#aaa49b;padding:0;font-family:var(--font-mono-family);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}.cart-note{margin-top:12px}.cart-note[hidden]{display:none}.cart-note__input{box-sizing:border-box;width:100%;min-height:94px;padding:12px;border-radius:12px;border:1px solid rgba(255,255,255,.12);background:#171718;color:#f5f1e8;resize:vertical}.cart-drawer__footer{padding:18px 24px 20px;border-top:1px solid rgba(255,255,255,.08);display:flex;flex-direction:column;gap:12px;flex-shrink:0}.cart-subtotal{display:flex;align-items:center;justify-content:space-between}.cart-subtotal__label{font-family:var(--font-mono-family);font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:#9b968d}.cart-subtotal__amount{font-size:1.15rem;font-weight:800}.cart-drawer__policy-note{margin:0;color:#9b968d;font-size:12px;line-height:1.5}.melato-cart-checkout-btn{width:100%;min-height:52px;border:0;border-radius:14px;background:#c90025;color:#fff;font-weight:800;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}.melato-cart-checkout-btn:disabled{opacity:.4;cursor:not-allowed}.cart-drawer__view-cart{min-height:42px;display:flex;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,.14);border-radius:12px;color:#f5f1e8;text-decoration:none;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}@media(max-width:520px){.cart-drawer{width:calc(100vw - 42px)}.cart-drawer__header,.cart-drawer__items,.cart-extras,.cart-drawer__footer{padding-left:18px;padding-right:18px}}
</style>

{% doc %}
Preserves the current locale on internal storefront links.
@param {string} url - Destination URL
{% enddoc %}
{%- liquid
  assign prefix = routes.root_url
  if prefix == '/'
    assign prefix = ''
  endif
  assign parts = url | split: '/'
  assign first_character = url | slice: 0, 1
  assign needs_prefix = false
  if first_character == '/' and prefix != ''
    case parts[1]
      when 'collections', 'products', 'pages', 'policies', 'blogs', 'search', 'cart'
        assign needs_prefix = true
    endcase
  endif
  if needs_prefix
    echo prefix | append: url | escape
  else
    echo url | escape
  endif
-%}

{% comment %}
  Server-rendered safeguards for legacy Shopify content.
  Primary templates emit correct markup directly. This layer handles older
  templates, app output, and Shopify-managed policy HTML without inventing facts.
{% endcomment %}

{%- liquid
  assign output = html
  assign output = output | replace: 'orders@melato.ca', 'support@melato.ca'

  if context == 'announcement'
    assign output = output | replace: 'POPUP SHOW #4 · JULY 21 · POPUP SHOW #5 · AUGUST 20', 'POPUP SHOW #5 · AUGUST 20'
    assign output = output | replace: 'POPUP SHOW #4 · JULY 21 ·', ''
    assign output = output | replace: 'POPUP SHOW #4 · JULY 21', ''
    assign output = output | replace: '&quot;LIKE NEVER CHANGE&quot;Melato', 'COMME NEVER CHANGE · MELATO'
    assign output = output | replace: '"LIKE NEVER CHANGE"Melato', 'COMME NEVER CHANGE · MELATO'
    assign output = output | replace: 'LIKE NEVER CHANGEMelato', 'COMME NEVER CHANGE · MELATO'
    assign output = output | replace: '&quot;LIKE NEVER CHANGE&quot;', 'COMME NEVER CHANGE'
    assign output = output | replace: '"LIKE NEVER CHANGE"', 'COMME NEVER CHANGE'
    assign output = output | replace: 'LIKE NEVER CHANGE', 'COMME NEVER CHANGE'
  endif

  if context == 'cart'
    assign output = output | replace: 'Explore the latest uniform pieces.', 'Explore the current Melato rotation.'
    assign output = output | replace: 'Shop the Uniform', 'Shop New Arrivals'
    assign output = output | replace: '/collections/drop-001-texture-form', '/collections/new-arrivals'
    assign output = output | replace: 'Taxes &amp; shipping calculated at checkout', 'Complimentary standard delivery. Taxes and applicable duties calculated at checkout.'
    assign output = output | replace: 'Taxes & shipping calculated at checkout', 'Complimentary standard delivery. Taxes and applicable duties calculated at checkout.'
  endif

  if context == 'main'
    assign output = output | replace: 'Browse selected pieces from the current Melato rotation, then complete the set with matching jackets and pants.', 'A curated edit from the current Melato rotation, spanning apparel, fragrance and limited statement pieces.'
    assign output = output | replace: 'Visit Us In-Store', 'Visit the Melatelier pop-up'
    assign output = output | replace: 'Melatelier is located at Tanger Outlets Ottawa.', 'The Melatelier pop-up opens only on announced dates.'
    assign output = output | replace: 'Clothing Accessories', 'Accessories'
    assign output = output | replace: "Men's Undergarments", 'Underwear'
    assign output = output | replace: 'Neckties', 'Ties'
    assign output = output | replace: 'Toiletry Bags', 'Travel Cases'
    assign output = output | replace: 'Eaux De Toilette', 'Eaux de Toilette'
    assign output = output | replace: 'Eaux De Parfum', 'Eaux de Parfum'
    assign output = output | replace: 'Track jackets', 'Track Jackets'
    assign output = output | replace: 'Track pants', 'Track Pants'
    assign output = output | replace: 'Filter 0', 'Filter'
    assign output = output | replace: 'Fit Fit Concierge', 'Fit Concierge'
    assign output = output | replace: 'Delivery Delivery Concierge', 'Delivery Concierge'
    assign output = output | replace: 'CareOrder Companion', 'Order Companion'
    assign output = output | replace: 'AccessThe Preview Room', 'The Preview Room'
    assign output = output | replace: 'Client care is availableReplies are typically sent within one business day.', 'Client care is available. Replies are typically sent within one business day.'
    assign output = output | replace: 'You may request, correction of, or deletion of your personal information', 'You may request access to, correction of, or deletion of your personal information'

    # Explicit text boundaries for the compact collection service strip.
    assign output = output | replace: '<strong>Fit consultation</strong><span>Personal sizing guidance</span>', '<span class="service-link__title" role="heading" aria-level="3">Fit consultation</span><span class="visually-hidden">. </span><span class="service-link__desc">Personal sizing guidance</span>'
    assign output = output | replace: '<strong>Delivery planning</strong><span>Timing before checkout</span>', '<span class="service-link__title" role="heading" aria-level="3">Delivery planning</span><span class="visually-hidden">. </span><span class="service-link__desc">Timing before checkout</span>'
    assign output = output | replace: '<strong>Order companion</strong><span>One contact after purchase</span>', '<span class="service-link__title" role="heading" aria-level="3">Order companion</span><span class="visually-hidden">. </span><span class="service-link__desc">One contact after purchase</span>'

    if template.name == 'collection'
      assign count_chunks = output | split: '<span class="melato-filter-option__count">'
      if count_chunks.size > 1
        assign output_without_counts = count_chunks | first
        for count_chunk in count_chunks offset: 1
          assign count_value = count_chunk | split: '</span>' | first
          assign count_tail = count_chunk | remove_first: count_value | remove_first: '</span>'
          assign output_without_counts = output_without_counts | append: count_tail
        endfor
        assign output = output_without_counts
      endif
    endif

    if request.path contains '/policies/'
      assign output = output | replace: '<div class="shopify-policy__title"><h1>Refund policy</h1></div>', '<div class="shopify-policy__title" aria-hidden="true"><p>Refund policy</p></div>'
      assign output = output | replace: '<div class="shopify-policy__title"><h1>Terms of service</h1></div>', '<div class="shopify-policy__title" aria-hidden="true"><p>Terms of service</p></div>'
      assign output = output | replace: '<div class="shopify-policy__title"><h1>Privacy policy</h1></div>', '<div class="shopify-policy__title" aria-hidden="true"><p>Privacy policy</p></div>'

      if request.path contains '/policies/refund-policy'
        assign old_shipping_clause = 'Original shipping fees may be non-refundable unless otherwise required by law or stated during a promotion.'
        capture policy_clarification
          echo 'Standard delivery is complimentary and has no original standard-delivery fee to refund. If a paid expedited, special-service, or international carrier option is selected at checkout, that service fee may be non-refundable unless required by law.'
          echo '<h2>Fragrance</h2>'
          echo '<p>Unopened fragrance products may be eligible for return under the standard return conditions. Contact support@melato.ca before opening the product if you may need return assistance.</p>'
          echo '<p>Opened, sprayed, used, or otherwise scented fragrance products are not eligible for return, except where required by law or when the product arrived damaged, defective, or incorrect.</p>'
        endcapture
        assign output = output | replace: old_shipping_clause, policy_clarification
      endif
    endif

    if template.name == 'product' and product
      assign product_title_down = product.title | downcase
      assign product_type_down = product.product_type | downcase
      assign size_guide_page = product.metafields.custom.size_guide.value
      assign size_guide_handle = size_guide_page.handle | default: '' | downcase
      assign has_specific_size_guide = false
      if size_guide_page != blank and size_guide_handle != 'size-guide' and size_guide_handle != 'melato-size-guide' and size_guide_handle != 'sizing-guide' and size_guide_handle != 'fit-guide'
        assign has_specific_size_guide = true
      endif

      unless output contains 'data-bis-root'
        capture bis_markup
          render 'back-in-stock-form', product: product
        endcapture
        assign product_form_end_with_waitlist = '</form>' | append: bis_markup
        assign output = output | replace_first: '</form>', product_form_end_with_waitlist
      endunless

      if has_specific_size_guide
        assign product_has_size_option = false
        for product_option_name in product.options
          assign product_option_name_down = product_option_name | downcase
          if product_option_name_down == 'size' or product_option_name_down == 'taille'
            assign product_has_size_option = true
            break
          endif
        endfor
        if product_has_size_option
          assign output = output | replace: 'class="melato-size-guide-trigger"', 'class="size-guide-trigger" data-open-size-drawer'
          unless output contains 'data-size-drawer'
            capture size_drawer_markup
              render 'size-guide-drawer', product: product
            endcapture
            assign output = output | append: size_drawer_markup
          endunless
        endif
      else
        assign output = output | replace: '<button class="size-guide-trigger" type="button" data-open-size-drawer aria-haspopup="dialog" aria-expanded="false">Size guide &amp; silhouette fit</button>', ''
      endif

      assign old_assurances = '<div class="pdp-trust-row" aria-label="Payment and shipping trust"><span>Fast dispatch</span><span>Complimentary delivery on all orders</span><span>Secure checkout</span></div>'
      assign new_assurances = '<ul class="product-assurances" role="list" aria-label="Purchase assurances"><li>Fast dispatch</li><li>Complimentary delivery on all orders</li><li>Secure checkout</li></ul>'
      assign output = output | replace: old_assurances, new_assurances
      assign output = output | replace: 'Customers rate us 5.0/5 based on 3 reviews.', 'MELATO STORE RATING 5.0/5 from 3 verified customer reviews.'
      assign output = output | replace: '</strong><span', '</strong> <span'
      assign output = output | replace: '</span><strong', '</span> <strong'
      assign output = output | replace: '</h3><p>', '</h3> <p>'

      assign escaped_product_title = product.title | escape
      assign generic_product_alt = 'alt="' | append: escaped_product_title | append: '"'
      for image_number in (1..18)
        capture numbered_product_alt
          alt="{{ escaped_product_title }}, product image {{ image_number }}"
        endcapture
        assign output = output | replace_first: generic_product_alt, numbered_product_alt | strip
      endfor

      if product.handle == 'protective-custody'
        assign output = output | replace: 'A premium Melato piece built with clean construction, controlled proportion, and everyday presence.', ''
        assign output = output | replace: 'A premium Melato piece built with clean construction, controlled proportion, and everyday wearability.', ''
        assign output = output | replace: 'A focused Melato piece designed around proportion, texture, and styling range. Built to feel intentional without overexplaining itself.', ''
        assign output = output | replace: 'A focused Melato piece designed around proportion, texture, and styling range.', ''
        assign output = output | replace: 'Melato piece with Melato’s current-season product language.', ''
        assign output = output | replace: 'Premium construction selected for feel, structure, and everyday wearability.', ''
        assign output = output | replace: 'Premium construction selected for clean movement and everyday wearability.', ''
        assign output = output | replace: 'Suggested production composition: shell 60% polyurethane, 25% polyester, 15% nylon. Lining 100% polyester. Padding 100% polyester. Hardware: zinc alloy.', ''
        assign output = output | replace: 'Wash cold inside out where applicable. Hang dry or lay flat. Avoid direct heat over embroidery, patches, prints, trims, or branded details.', ''
      endif

      if product_type_down contains 'fragrance' or product_type_down contains 'eau de' or product_title_down contains 'eau de toilette' or product_title_down contains 'eau de parfum'
        assign output = output | replace: 'Silhouette currently unavailable', 'Size currently unavailable'
        assign output = output | replace: 'Premium everyday fit. Choose your usual size for the intended silhouette.', ''
        assign output = output | replace: '<details class="pdp-spec"><summary>Fit</summary><div class="pdp-rte"></div></details>', ''
        assign output = output | replace: 'Eligible unworn items follow posted policy.', 'Unopened fragrance products follow the posted Melato return policy.'
        assign output = output | replace: 'Returns are eligible when items are unworn, unwashed, tagged, and returned within the posted policy window.', 'Unopened fragrance products follow the posted Melato return policy. Contact support@melato.ca before opening the product if you may need return assistance.'
      elsif product.has_only_default_variant
        assign output = output | replace: 'Silhouette currently unavailable', 'Currently unavailable'
      else
        assign output = output | replace: 'Silhouette currently unavailable', 'Selected size currently unavailable'
      endif

      if product.handle == 'rex-x-fur-jacket-copy' or product_title_down contains 'fur'
        assign output = output | replace: 'Wash cold inside out where applicable. Hang dry or lay flat. Avoid direct heat over embroidery, patches, prints, trims, or branded details.', 'Professional fur cleaning only. Do not machine wash or hand wash. Store in a cool, ventilated space away from moisture, direct heat, and prolonged sunlight. Use a broad-shouldered hanger.'
      endif
    endif
  endif
-%}

{{- output -}}

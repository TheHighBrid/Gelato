{% comment %}
  Server-rendered safeguards for legacy Shopify content.
  Primary templates emit correct markup directly. This layer handles older
  templates, app output, and Shopify-managed policy HTML without inventing facts.
{% endcomment %}

{%- liquid
  assign output = html
  assign output = output | replace: 'orders@melato.ca', 'support@melato.ca'
  assign output = output | replace: 'secure checkout', 'Secure checkout'

  # Canonical storefront service policy: complimentary standard delivery plus free eligible returns.
  # Replace the complete legacy Refund Policy paragraph before any shorter legacy-string cleanup runs.
  assign legacy_refund_shipping_paragraph = '<p>Unless the item arrived damaged, defective, or incorrect, customers may be responsible for return shipping costs. Original shipping fees may be non-refundable unless otherwise required by law or stated during a promotion.</p>'
  capture protected_free_returns_policy
    echo '<p>Standard delivery is complimentary on all orders, with no minimum. Optional paid express, expedited, special-service, or premium carrier upgrades are separate from complimentary standard delivery and may be non-refundable unless required by law or related to a damaged, defective, or incorrect order.</p>'
    echo '<h2>Free Returns</h2>'
    echo '<p>Approved eligible returns include free standard return shipping through one complimentary prepaid return label or another return method approved by Melato. To keep the return free, use the label or method provided with your return authorization. Self-arranged or upgraded return shipping costs are not reimbursed unless Melato approved them in advance or reimbursement is required by law.</p>'
    echo '<p>Because standard outbound delivery is complimentary, there is no original standard-delivery fee to deduct from an eligible refund.</p>'
    echo '<h2>Fair Use &amp; Return Protection</h2>'
    echo '<p>Free returns are provided for genuine purchases and legitimate returns. To protect this service from fraud and misuse, Melato may review return activity where there is reasonable evidence of abuse, including repeated excessive return activity, returning worn, used, washed, altered, substituted, or intentionally damaged items, false damage or defect claims, misuse or duplication of return labels, returning merchandise not purchased from Melato, or attempts to circumvent this policy.</p>'
    echo '<p>Where misuse is reasonably identified, Melato may require additional verification, reject items that do not meet the return conditions, decline complimentary return shipping for an abusive or fraudulent return, or limit the free-return benefit on future orders. Any action will be proportionate to the identified misuse. This protection does not limit rights that cannot be excluded under applicable consumer law and does not reduce protection for legitimate damaged, defective, or incorrect-item claims.</p>'
  endcapture
  assign output = output | replace: '<h2>Return Shipping</h2>', '<h2>Complimentary Standard Delivery</h2>'
  assign output = output | replace: legacy_refund_shipping_paragraph, protected_free_returns_policy

  # Normalize remaining legacy storefront fragments that can appear outside the legal policy page.
  assign output = output | replace: 'eligible returns within 30 days · customer-paid return shipping', 'free returns within 30 days'
  assign output = output | replace: 'Return shipping may apply.', 'Free returns are available on approved eligible items using the Melato return method.'
  assign output = output | replace: 'Eligible unworn items may be returned within 30 days; customers pay return shipping unless the item arrived damaged, defective, or incorrect.', 'Eligible unworn items may be returned within 30 days with free return shipping through the Melato return method.'
  assign output = output | replace: 'Unless the item arrived damaged, defective, or incorrect, customers may be responsible for return shipping costs.', 'Free returns are available on approved eligible items using the Melato return method.'

  if context == 'announcement'
    assign output = output | replace: 'POPUP SHOW #4 · JULY 21 · POPUP SHOW #5 · AUGUST 20', 'POPUP SHOW #5 · AUGUST 20'
    assign output = output | replace: 'POPUP SHOW #4 · JULY 21 ·', ''
    assign output = output | replace: 'POPUP SHOW #4 · JULY 21', ''
    assign output = output | replace: '&quot;LIKE NEVER CHANGE&quot;Melato', 'COMME NEVER CHANGE · MELATO'
    assign output = output | replace: '"LIKE NEVER CHANGE"Melato', 'COMME NEVER CHANGE · MELATO'
    assign output = output | replace: 'LIKE NEVER CHANGEMelato', 'COMME NEVER CHANGE · MELATO'
    assign output = output | replace: '&quot;LIKE NEVER CHANGE&quot;', 'COMME NEVER CHANGE'
    assign output = output | replace: '"LIKE NEVER CHANGE"', 'COMME NEVER CHANGE'
    assign output = output | replace: 'LIKE NEVER CHANGE', 'COMME NEVER CHANGE'
  endif

  if context == 'cart'
    assign output = output | replace: 'Explore the latest uniform pieces.', 'Explore the current Melato rotation.'
    assign output = output | replace: 'Shop the Uniform', 'Shop New Arrivals'
    assign output = output | replace: '/collections/drop-001-texture-form', '/collections/new-arrivals'
    assign output = output | replace: 'Taxes &amp; shipping calculated at checkout', 'Complimentary standard delivery. Taxes and applicable duties are calculated at checkout.'
    assign output = output | replace: 'Taxes & shipping calculated at checkout', 'Complimentary standard delivery. Taxes and applicable duties are calculated at checkout.'
    assign output = output | replace: 'Taxes and applicable duties are calculated at checkout.', 'Complimentary standard delivery. Taxes and applicable duties are calculated at checkout.'
    assign output = output | replace: 'class="cart-drawer__tax-note"', 'class="cart-drawer__policy-note"'
  endif

  if context == 'main'
    assign output = output | replace: 'Browse selected pieces from the current Melato rotation, then complete the set with matching jackets and pants.', 'A curated edit from the current Melato rotation, spanning apparel, fragrance and limited statement pieces.'
    assign output = output | replace: 'Visit Us In-Store', 'Visit the Melatelier pop-up'
    assign output = output | replace: 'Melatelier is located at Tanger Outlets Ottawa.', 'The Melatelier pop-up opens only on announced dates.'
    assign output = output | replace: 'Clothing Accessories', 'Accessories'
    assign output = output | replace: "Men's Undergarments", 'Underwear'
    assign output = output | replace: 'Neckties', 'Ties'
    assign output = output | replace: 'Toiletry Bags', 'Travel Cases'
    assign output = output | replace: 'Eaux De Toilette', 'Eaux de Toilette'
    assign output = output | replace: 'Eaux De Parfum', 'Eaux de Parfum'
    assign output = output | replace: 'Track jackets', 'Track Jackets'
    assign output = output | replace: 'Track pants', 'Track Pants'
    assign output = output | replace: 'Filter 0', 'Filter'
    assign output = output | replace: 'Fit Fit Concierge', 'Fit Concierge'
    assign output = output | replace: 'Delivery Delivery Concierge', 'Delivery Concierge'
    assign output = output | replace: 'CareOrder Companion', 'Order Companion'
    assign output = output | replace: 'AccessThe Preview Room', 'The Preview Room'
    assign output = output | replace: 'Client care is availableReplies are typically sent within one business day.', 'Client care is available. Replies are typically sent within one business day.'
    assign output = output | replace: 'You may request, correction of, or deletion of your personal information', 'You may request access to, correction of, or deletion of your personal information'

    # The homepage hero file currently carries a generic asset alt of "Image".
    # Give only that generic value useful campaign context without overwriting
    # already descriptive image alternatives elsewhere on the homepage.
    if template.name == 'index'
      assign output = output | replace: 'alt="Image"', 'alt="Melato current collection campaign"'
    endif

    if template.name == 'collection'
      if output contains '<aside class="melato-collection-service-strip"'
        assign service_parts = output | split: '<aside class="melato-collection-service-strip"'
        assign service_tail_parts = service_parts[1] | split: '</aside>'
        assign service_after = blank
        for service_segment in service_tail_parts offset: 1
          if forloop.first
            assign service_after = service_segment
          else
            assign service_after = service_after | append: '</aside>' | append: service_segment
          endif
        endfor
        assign output = service_parts[0] | append: service_after
      endif

      assign count_chunks = output | split: '<span class="melato-filter-option__count">'
      if count_chunks.size > 1
        assign output_without_counts = count_chunks | first
        for count_chunk in count_chunks offset: 1
          assign count_value = count_chunk | split: '</span>' | first
          assign count_tail = count_chunk | remove_first: count_value | remove_first: '</span>'
          assign output_without_counts = output_without_counts | append: count_tail
        endfor
        assign output = output_without_counts
      endif
    endif

    if request.path contains '/policies/'
      assign output = output | replace: '<div class="shopify-policy__title"><h1>Refund policy</h1></div>', '<div class="shopify-policy__title" aria-hidden="true"><p>Refund policy</p></div>'
      assign output = output | replace: '<div class="shopify-policy__title"><h1>Terms of service</h1></div>', '<div class="shopify-policy__title" aria-hidden="true"><p>Terms of service</p></div>'
      assign output = output | replace: '<div class="shopify-policy__title"><h1>Privacy policy</h1></div>', '<div class="shopify-policy__title" aria-hidden="true"><p>Privacy policy</p></div>'
      assign output = output | replace: '<h1>Refund policy</h1>', '<p class="shopify-policy__generated-title" aria-hidden="true">Refund policy</p>'
      assign output = output | replace: '<h1>Terms of service</h1>', '<p class="shopify-policy__generated-title" aria-hidden="true">Terms of service</p>'
      assign output = output | replace: '<h1>Privacy policy</h1>', '<p class="shopify-policy__generated-title" aria-hidden="true">Privacy policy</p>'

      if request.path contains '/policies/refund-policy'
        assign output = output | replace: '<p class="melato-small-print">Last updated: May 2026</p>', '<p class="melato-small-print">Last updated: August 29, 2026</p>'

        unless output contains '<h2>Fragrance</h2>'
          capture fragrance_policy
            echo '<h2>Fragrance</h2>'
            echo '<p>Unopened fragrance products may be eligible for return under the standard return conditions.</p>'
            echo '<p>Opened, sprayed, used, or otherwise scented fragrance products are not eligible for return, except where required by law or when the product arrived damaged, defective, or incorrect.</p>'
            echo '<p>Contact <a href="mailto:support@melato.ca">support@melato.ca</a> before opening the product if you may need return assistance.</p>'
          endcapture
          assign exchanges_heading = '<h2>Exchanges</h2>'
          assign exchanges_with_fragrance = fragrance_policy | append: exchanges_heading
          assign output = output | replace_first: exchanges_heading, exchanges_with_fragrance
        endunless
      endif
    endif

    if template.name == 'product' and product
      assign product_title_down = product.title | downcase
      assign product_type_down = product.product_type | downcase
      assign size_guide_page = product.metafields.custom.size_guide.value
      assign size_guide_handle = size_guide_page.handle | default: '' | downcase
      assign has_specific_size_guide = false
      if size_guide_page != blank and size_guide_handle != blank and size_guide_handle != 'size-guide' and size_guide_handle != 'melato-size-guide' and size_guide_handle != 'sizing-guide' and size_guide_handle != 'fit-guide'
        assign has_specific_size_guide = true
      endif

      assign product_has_size_option = false
      for product_option_name in product.options
        assign product_option_name_down = product_option_name | downcase
        if product_option_name_down == 'size' or product_option_name_down == 'taille'
          assign product_has_size_option = true
          break
        endif
      endfor

      unless output contains 'data-bis-root'
        capture bis_markup
          render 'back-in-stock-form', product: product
        endcapture
        assign product_form_end_with_waitlist = '</form>' | append: bis_markup
        assign output = output | replace_first: '</form>', product_form_end_with_waitlist
      endunless

      if has_specific_size_guide
        if product_has_size_option
          assign output = output | replace: 'class="melato-size-guide-trigger"', 'class="size-guide-trigger" data-open-size-drawer'
          unless output contains 'data-size-drawer'
            capture size_drawer_markup
              render 'size-guide-drawer', product: product
            endcapture
            assign output = output | append: size_drawer_markup
          endunless
        endif
      else
        assign output = output | replace: '<button class="size-guide-trigger" type="button" data-open-size-drawer aria-haspopup="dialog" aria-expanded="false">Size guide &amp; silhouette fit</button>', ''
        assign output = output | replace: '<button class="size-guide-trigger" type="button" data-open-size-drawer aria-haspopup="dialog" aria-expanded="false">Product measurements</button>', ''
      endif

      # Add an above-the-fold trust and fit layer only from current policy and product data.
      unless output contains 'pdp-conversion-assurances'
        assign origin_copy = product.metafields.custom.made_in.value | default: product.metafields.custom.country_of_origin.value
        if origin_copy == blank and product.metafields.custom.made_in_canada.value == true
          assign origin_copy = 'Canada'
        endif
        assign fit_preview = product.metafields.melato.fit.value | default: product.metafields.custom.fit_summary.value | default: product.metafields.custom.fit_notes.value | default: product.metafields.custom.fit.value
        assign pdp_review_count = product.metafields.reviews.rating_count.value | default: 0
        assign pdp_review_rating = product.metafields.reviews.rating.value.rating
        capture pdp_conversion_markup
          echo '<style>.pdp-conversion-assurances{margin:14px 0 0;padding:14px 0 0;border-top:1px solid color-mix(in srgb,currentColor 16%,transparent)}.pdp-conversion-assurances__trust{display:flex;flex-wrap:wrap;gap:8px 16px;margin:0;padding:0;list-style:none;font-size:11px;letter-spacing:.08em;text-transform:uppercase;opacity:.9}.pdp-conversion-assurances__facts{display:grid;gap:8px;margin-top:12px}.pdp-conversion-assurances__fact{display:grid;grid-template-columns:minmax(72px,auto) 1fr;gap:12px;font-size:12px;line-height:1.45}.pdp-conversion-assurances__fact strong{text-transform:uppercase;letter-spacing:.1em;font-size:10px}.pdp-conversion-assurances a{color:inherit;text-underline-offset:3px}.pdp-conversion-assurances__payments{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin-top:12px}.pdp-conversion-assurances__payments svg{width:auto;height:22px;max-width:40px}</style>'
          echo '<div class="pdp-conversion-assurances" aria-label="Purchase and product essentials">'
          echo '<ul class="pdp-conversion-assurances__trust" role="list"><li>Complimentary standard delivery</li><li>Prepared in 1–3 business days</li><li><a href="/policies/refund-policy">Free returns within 30 days</a></li><li>Secure checkout</li></ul>'
          echo '<div class="pdp-conversion-assurances__facts">'
          if origin_copy != blank
            echo '<div class="pdp-conversion-assurances__fact"><strong>Origin</strong><span>Made in '
            echo origin_copy | escape
            echo '</span></div>'
          endif
          if fit_preview != blank
            echo '<div class="pdp-conversion-assurances__fact"><strong>Fit</strong><span>'
            echo fit_preview | strip_html | strip_newlines | truncate: 170 | escape
            echo '</span></div>'
          endif
          if product_has_size_option and has_specific_size_guide == false
            echo '<div class="pdp-conversion-assurances__fact"><strong>Sizing</strong><span><a href="/pages/size-guide">Fit guidance</a> for products without approved garment measurements.</span></div>'
          endif
          echo '<div class="pdp-conversion-assurances__fact"><strong>Returns</strong><span>Approved eligible returns include free standard return shipping through the Melato return method.</span></div>'
          if pdp_review_count > 0 and pdp_review_rating != blank
            echo '<div class="pdp-conversion-assurances__fact"><strong>Reviews</strong><span>'
            echo pdp_review_rating
            echo '/5 from '
            echo pdp_review_count
            echo ' verified review'
            if pdp_review_count != 1
              echo 's'
            endif
            echo '.</span></div>'
          endif
          echo '</div>'
          if shop.enabled_payment_types.size > 0
            echo '<div class="pdp-conversion-assurances__payments" aria-label="Accepted payment methods">'
            for payment_type in shop.enabled_payment_types
              echo payment_type | payment_type_svg_tag
            endfor
            echo '</div>'
          endif
          echo '</div>'
        endcapture
        assign product_form_end_with_conversion = '</form>' | append: pdp_conversion_markup
        assign output = output | replace_first: '</form>', product_form_end_with_conversion
      endunless

      # Specification panels intentionally render closed by default. Native details state belongs to the shopper.

      assign old_assurances = '<div class="pdp-trust-row" aria-label="Payment and shipping trust"><span>Fast dispatch</span><span>Complimentary delivery on all orders</span><span>Secure checkout</span></div>'
      assign new_assurances = '<ul class="product-assurances" role="list" aria-label="Purchase assurances"><li>Prepared in 1–3 business days</li><li>Complimentary delivery on all orders</li><li><a href="/policies/refund-policy">Free returns within 30 days</a></li><li>Secure checkout</li></ul>'
      assign output = output | replace: old_assurances, new_assurances
      assign output = output | replace: 'Customers rate us 5.0/5 based on 3 reviews.', 'MELATO STORE RATING 5.0/5 from 3 verified customer reviews.'
      assign output = output | replace: 'Verified material information', 'Material details'
      assign output = output | replace: '</strong><span', '</strong> <span'
      assign output = output | replace: '</span><strong', '</span> <strong'
      assign output = output | replace: '</h3><p>', '</h3> <p>'

      assign escaped_product_title = product.title | escape
      assign generic_product_alt = 'alt="' | append: escaped_product_title | append: '"'
      for image_number in (1..18)
        capture numbered_product_alt
          echo 'alt="' | append: escaped_product_title | append: ', product image ' | append: image_number | append: '"'
        endcapture
        assign numbered_product_alt = numbered_product_alt | strip
        assign output = output | replace_first: generic_product_alt, numbered_product_alt
      endfor

      if product.handle == 'protective-custody'
        assign output = output | replace: 'A premium Melato piece built with clean construction, controlled proportion, and everyday presence.', ''
        assign output = output | replace: 'A premium Melato piece built with clean construction, controlled proportion, and everyday wearability.', ''
        assign output = output | replace: 'A focused Melato piece designed around proportion, texture, and styling range. Built to feel intentional without overexplaining itself.', ''
        assign output = output | replace: 'A focused Melato piece designed around proportion, texture, and styling range.', ''
        assign output = output | replace: 'Melato piece with Melato’s current-season product language.', ''
        assign output = output | replace: 'Premium construction selected for feel, structure, and everyday wearability.', ''
        assign output = output | replace: 'Premium construction selected for clean movement and everyday wearability.', ''
        assign output = output | replace: 'Suggested production composition: shell 60% polyurethane, 25% polyester, 15% nylon. Lining 100% polyester. Padding 100% polyester. Hardware: zinc alloy.', ''
        assign output = output | replace: 'Wash cold inside out where applicable. Hang dry or lay flat. Avoid direct heat over embroidery, patches, prints, trims, or branded details.', ''
      endif

      # Hargneux previously repeated fit, material, and care inside a long Story
      # field and again in structured specification cards. Keep the structured set.
      if product.handle == 'hargneux-velour-track-pant'
        assign story_marker = '<details class="pdp-mini-detail"><summary>Story</summary>'
        if output contains story_marker
          assign story_parts = output | split: story_marker
          assign story_tail = story_parts[1]
          assign story_end_parts = story_tail | split: '</details>'
          assign rebuilt_tail = blank
          for story_segment in story_end_parts offset: 1
            if forloop.first
              assign rebuilt_tail = story_segment
            else
              assign rebuilt_tail = rebuilt_tail | append: '</details>' | append: story_segment
            endif
          endfor
          assign output = story_parts[0] | append: rebuilt_tail
        endif
      endif

      if product_type_down contains 'fragrance' or product_type_down contains 'eau de' or product_title_down contains 'eau de toilette' or product_title_down contains 'eau de parfum'
        assign output = output | replace: 'Silhouette currently unavailable', 'Size currently unavailable'
        assign output = output | replace: 'Premium everyday fit. Choose your usual size for the intended silhouette.', ''
        assign output = output | replace: '<details class="pdp-spec"><summary>Fit</summary><div class="pdp-rte"></div></details>', ''
        assign output = output | replace: 'Eligible unworn items follow posted policy.', 'Unopened fragrance products follow the posted Melato return policy.'
        assign output = output | replace: 'Returns are eligible when items are unworn, unwashed, tagged, and returned within the posted policy window.', 'Unopened fragrance products follow the posted Melato return policy. Contact support@melato.ca before opening the product if you may need return assistance.'
      elsif product.has_only_default_variant
        assign output = output | replace: 'Silhouette currently unavailable', 'Currently unavailable'
      else
        assign output = output | replace: 'Silhouette currently unavailable', 'Selected size currently unavailable'
      endif

      if product.handle == 'rex-x-fur-jacket' or product.handle == 'rex-x-fur-jacket-copy' or product_title_down contains 'fur'
        assign output = output | replace: 'Wash cold inside out where applicable. Hang dry or lay flat. Avoid direct heat over embroidery, patches, prints, trims, or branded details.', 'Professional fur cleaning only. Do not machine wash or hand wash. Store in a cool, ventilated space away from moisture, direct heat, and prolonged sunlight. Use a broad-shouldered hanger.'
      endif
    endif
  endif
-%}

{{- output -}}
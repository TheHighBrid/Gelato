/* Full-set purchase must inherit the product palette instead of using a generic cream box. */
.melato-pdp-rebuild .melato-full-set-action{width:100%!important}
.melato-pdp-rebuild .melato-full-set-button{
  width:100%!important;
  min-width:0!important;
  border-color:var(--pdp-accent,#d3a74a)!important;
  background:var(--pdp-accent,#d3a74a)!important;
  color:#fff!important;
  border-radius:12px!important;
  transition:filter .2s ease,transform .2s ease!important;
}
.melato-pdp-rebuild .melato-full-set-button:hover,
.melato-pdp-rebuild .melato-full-set-button:focus-visible{
  filter:brightness(1.08)!important;
}

/* Announcement badge remains readable even when the bar rotates through product palettes. */
#melato-announcement-bar .melato-ann__badge{
  background:#f7f1e8!important;
  color:#120c08!important;
  border-color:rgba(18,12,8,.22)!important;
  text-shadow:none!important;
  box-shadow:0 1px 0 rgba(0,0,0,.16)!important;
}

/* Collection pagination: make page navigation visible, touch-safe and intentional. */
.melato-pagination{
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  gap:8px!important;
  width:100%!important;
  margin:0!important;
  padding:28px min(5vw,60px) 34px!important;
  border-top:1px solid rgba(255,255,255,.08)!important;
  background:#080808!important;
}
.melato-pagination .page,
.melato-pagination .next,
.melato-pagination .prev{display:inline-flex!important;align-items:center!important}
.melato-pagination a,
.melato-pagination .current{
  display:grid!important;
  place-items:center!important;
  min-width:44px!important;
  height:44px!important;
  padding:0 12px!important;
  border:1px solid rgba(255,255,255,.18)!important;
  border-radius:999px!important;
  background:#111214!important;
  color:#f5f1e8!important;
  text-decoration:none!important;
  font-size:11px!important;
  font-weight:800!important;
  letter-spacing:.08em!important;
  line-height:1!important;
  text-transform:uppercase!important;
}
.melato-pagination .current{
  border-color:#f4ead8!important;
  background:#f4ead8!important;
  color:#080808!important;
}
.melato-pagination .next a,
.melato-pagination .prev a{min-width:74px!important;padding-inline:16px!important}
.melato-pagination a:hover,
.melato-pagination a:focus-visible{
  border-color:#d3a74a!important;
  color:#d3a74a!important;
  outline:none!important;
}

@media (max-width:768px){
  .featured-collection .grid{row-gap:36px!important}
  .featured-collection .product-card__price{margin-top:10px!important}
  .melato-pagination{gap:6px!important;padding:22px 12px 28px!important}
  .melato-pagination a,.melato-pagination .current{min-width:42px!important;height:42px!important;padding:0 10px!important}
  .melato-pagination .next a,.melato-pagination .prev a{min-width:64px!important;padding-inline:12px!important}
}
</style>
<script src="{{ 'melato-site-cleanup-20260811.js' | asset_url }}" defer></script>
<script src="{{ 'melato-content-policy-20260811.js' | asset_url }}" defer></script>
<script src="{{ 'melato-audit-ui-20260818.js' | asset_url }}" defer></script>
<script>
(() => {
  'use strict';

  function normalize(value) {
    return String(value || '').replace(/\s+/g, ' ').trim();
  }

  function cleanCompleteSetPresentation(root = document) {
    root.querySelectorAll('.pdp-set-card').forEach((card) => {
      const walker = document.createTreeWalker(card, NodeFilter.SHOW_TEXT);
      const stray = [];
      while (walker.nextNode()) {
        const value = normalize(walker.currentNode.nodeValue).toLowerCase();
        if (/^,\s*(selected|matching) piece$/.test(value)) stray.push(walker.currentNode);
      }
      stray.forEach((node) => node.remove());
    });

    root.querySelectorAll('.pdp-set-label').forEach((label) => {
      const value = normalize(label.textContent).toLowerCase();
      if (value === 'selected piece') label.textContent = 'Current piece';
      if (value === 'matching piece') label.textContent = 'Pair with';
    });
  }

  function renameLivingBook(root = document) {
    root.querySelectorAll('[data-lb-director] .mlbd__case-identity h2').forEach((heading) => {
      if (normalize(heading.textContent).toUpperCase() === 'THE UNIFORM IN MOTION') {
        heading.textContent = 'THE LIVING BOOK';
      }
    });
  }

  function run() {
    cleanCompleteSetPresentation(document);
    renameLivingBook(document);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run, { once:true });
  else run();

  let timer;
  new MutationObserver(() => {
    clearTimeout(timer);
    timer = window.setTimeout(run, 80);
  }).observe(document.documentElement, { childList:true, subtree:true });
})();
</script>

{% doc %}
Global Melato utility layer.

Keeps cart, search, menu, login, and size guide drawer content out of initial page HTML.
Drawer bodies are loaded only when triggered by the user.

@example
{% render 'melato-utility-layer' %}
{% enddoc %}

<div
  id="MelatoUtilityLayer"
  class="melato-utility-layer"
  hidden
  inert
  aria-hidden="true"
  data-nosnippet
  data-utility-layer
>
  <div class="melato-utility-backdrop" data-close-utility></div>

  <div class="melato-utility-host" data-utility-host="menu"></div>
  <div class="melato-utility-host" data-utility-host="search"></div>
  <div class="melato-utility-host" data-utility-host="cart"></div>
  <div class="melato-utility-host" data-utility-host="login"></div>
  <div class="melato-utility-host" data-utility-host="size-guide"></div>
</div>

{% stylesheet %}
  .melato-utility-layer[hidden] {
    display: none;
  }

  .melato-utility-layer {
    position: fixed;
    inset: 0;
    z-index: 9999;
  }

  .melato-utility-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.62);
  }

  .melato-utility-host {
    position: relative;
    z-index: 2;
  }

  html.melato-utility-open,
  html.melato-utility-open body {
    overflow: hidden;
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const layer = document.querySelector('[data-utility-layer]');
    if (!layer) return;

    const loaded = new Set();

    const sections = {
      menu: 'melato-menu-drawer',
      search: 'melato-search-drawer',
      cart: 'melato-cart-drawer',
      login: 'melato-login-drawer',
      'size-guide': 'melato-size-guide-drawer'
    };

    async function loadUtility(type) {
      const sectionId = sections[type];
      const host = layer.querySelector(`[data-utility-host="${type}"]`);

      if (!sectionId || !host || loaded.has(type)) return;

      const url = `${window.location.pathname}?sections=${sectionId}`;

      const response = await fetch(url, {
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        }
      });

      if (!response.ok) return;

      const data = await response.json();
      host.innerHTML = data[sectionId] || '';

      loaded.add(type);
    }

    async function openUtility(type) {
      await loadUtility(type);

      layer.hidden = false;
      layer.inert = false;
      layer.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('melato-utility-open');

      const activeDrawer = layer.querySelector(`[data-utility-host="${type}"] [data-utility-drawer]`);
      if (activeDrawer) activeDrawer.focus();
    }

    function closeUtility() {
      layer.hidden = true;
      layer.inert = true;
      layer.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('melato-utility-open');
    }

    document.addEventListener('click', event => {
      const opener = event.target.closest('[data-open-utility]');
      const closer = event.target.closest('[data-close-utility]');

      if (opener) {
        event.preventDefault();
        openUtility(opener.dataset.openUtility);
      }

      if (closer) {
        event.preventDefault();
        closeUtility();
      }
    });

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') closeUtility();
    });

    window.MelatoUtility = {
      open: openUtility,
      close: closeUtility
    };
  })();
{% endjavascript %}
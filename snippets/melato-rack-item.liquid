{% doc %}
  Renders a garment with explicit rack media and optional section overrides.
  @param {product} product - The product to display
  @param {number} index - Position in the collection
  @param {block[]} [view_blocks] - Section media overrides
{% enddoc %}
{%- liquid
  capture media_record
    render 'melato-rack-media', product: product
  endcapture
  assign media_parts = media_record | strip | split: '|'
  assign front_asset = media_parts[0]
  assign back_asset = media_parts[1]
  assign baked_hanger = false
  assign angle_block = nil
  assign front_image = nil
  assign back_image = nil
  for view_block in view_blocks
    if view_block.settings.product.id == product.id
      assign angle_block = view_block
      assign baked_hanger = view_block.settings.baked_hanger
      assign front_image = view_block.settings.front
      assign back_image = view_block.settings.back
      break
    endif
  endfor
  assign front_url = nil
  assign back_url = nil
  if front_image
    assign front_url = front_image | image_url: width: 1200
  elsif front_asset and front_asset != empty
    assign front_url = front_asset | asset_url
  endif
  if back_image
    assign back_url = back_image | image_url: width: 1200
  elsif back_asset and back_asset != empty
    assign back_url = back_asset | asset_url
  endif
  if product.handle == 'conquista-velour-track-jacket' and front_image == nil
    assign baked_hanger = true
  endif
  assign front_alt = product.title | append: ' - Front'
-%}
{%- if front_url -%}
  <li class="mrack__item{% if baked_hanger %} has-baked-hanger{% endif %}" data-rack-item data-handle="{{ product.handle }}" data-index="{{ index }}">
    <a class="mrack__link" href="{{ product.url }}" data-rack-link aria-label="{{ product.title | escape }}, {{ product.price | money_with_currency }}">
      <span class="mrack__hanger-wrap" aria-hidden="true">{% render 'melato-rack-hanger' %}</span>
      <span class="mrack__garment"><img src="{{ front_url }}" alt="{{ front_alt | escape }}" width="1200" height="1500" loading="{% if index < 3 %}eager{% else %}lazy{% endif %}" decoding="async" draggable="false"></span>
    </a>
    <script type="application/json" data-rack-data>
      {"handle":{{ product.handle | json }},"title":{{ product.title | json }},"price":{{ product.price | money_with_currency | json }},"url":{{ product.url | json }},"front":{{ front_url | json }},"back":{% if back_url %}{{ back_url | json }}{% else %}null{% endif %},"bakedHanger":{{ baked_hanger | json }},"angles":[{% if product.handle == 'conquista-velour-track-jacket' and front_image == nil %}{% assign view_degrees = '0,30,45,90,135' | split: ',' %}{% for degree in view_degrees %}{"degrees":{{ degree }},"url":{{ 'rack-conquista-view-' | append: degree | append: '.webp' | asset_url | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}{% elsif angle_block and angle_block.settings.angle_30 and front_url %}{"degrees":0,"url":{{ front_url | json }}},{"degrees":30,"url":{{ angle_block.settings.angle_30 | image_url: width: 1200 | json }}}{% if angle_block.settings.angle_60 %},{"degrees":60,"url":{{ angle_block.settings.angle_60 | image_url: width: 1200 | json }}}{% endif %}{% if angle_block.settings.angle_90 %},{"degrees":90,"url":{{ angle_block.settings.angle_90 | image_url: width: 1200 | json }}}{% endif %}{% endif %}],"variants":[ {%- for variant in product.variants -%}{"id":{{ variant.id }},"title":{{ variant.title | json }},"available":{{ variant.available | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}
    </script>
  </li>
{%- endif -%}

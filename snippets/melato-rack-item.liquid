{%- comment -%}
  One hanger + garment.
  Params: product, index
  Front = featured image, back = second image (if any).
{%- endcomment -%}
{%- liquid
  assign front = product.featured_image
  assign back = product.images[1]
-%}
{%- if front != blank -%}
  <li class="mrack__item" data-rack-item data-handle="{{ product.handle }}" data-index="{{ index }}">
    <a class="mrack__link" href="{{ product.url }}" data-rack-link aria-label="{{ product.title | escape }}, {{ product.price | money }}">
      <span class="mrack__hanger-wrap" aria-hidden="true">{%- render 'melato-rack-hanger' -%}</span>
      <span class="mrack__garment">
        <img
          src="{{ front | image_url: width: 600 }}"
          srcset="{{ front | image_url: width: 360 }} 360w, {{ front | image_url: width: 600 }} 600w, {{ front | image_url: width: 900 }} 900w"
          sizes="(max-width: 640px) 62vw, 22vw"
          width="{{ front.width }}" height="{{ front.height }}"
          alt="{{ front.alt | default: product.title | escape }}"
          loading="{% if index < 3 %}eager{% else %}lazy{% endif %}"
          decoding="async"
          draggable="false">
      </span>
      <span class="mrack__item-shadow" aria-hidden="true"></span>
    </a>
    <script type="application/json" data-rack-data>
      {
        "handle": {{ product.handle | json }},
        "title": {{ product.title | json }},
        "price": {{ product.price | money | json }},
        "url": {{ product.url | json }},
        "front": {{ front | image_url: width: 1200 | json }},
        "back": {% if back %}{{ back | image_url: width: 1200 | json }}{% else %}null{% endif %},
        "variants": [
          {%- for v in product.variants -%}
            { "id": {{ v.id }}, "title": {{ v.title | json }}, "available": {{ v.available | json }} }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  </li>
{%- endif -%}

{% doc %}
  Renders a garment with explicit rack media, multi-angle 360 views, open-zip views, and optional section overrides.
  @param {product} product - The product to display
  @param {number} index - Position in the collection
  @param {block[]} [view_blocks] - Section media overrides
{% enddoc %}
{%- liquid
  capture media_record
    render 'melato-rack-media', product: product
  endcapture
  assign media_parts = media_record | strip | split: '|'
  assign front_asset = media_parts[0]
  assign back_asset = media_parts[1]
  assign angle_spec = media_parts[2]
  assign open_spec = media_parts[3]
  assign baked_hanger = false
  assign angle_block = nil
  assign front_image = nil
  assign back_image = nil
  for view_block in view_blocks
    if view_block.settings.product.id == product.id
      assign angle_block = view_block
      assign baked_hanger = view_block.settings.baked_hanger
      assign front_image = view_block.settings.front
      assign back_image = view_block.settings.back
      break
    endif
  endfor
  assign front_url = nil
  assign back_url = nil
  if front_image
    assign front_url = front_image | image_url: width: 1200
  elsif front_asset and front_asset != empty
    assign front_url = front_asset | asset_url
  endif
  if back_image
    assign back_url = back_image | image_url: width: 1200
  elsif back_asset and back_asset != empty
    assign back_url = back_asset | asset_url
  endif
  if angle_spec and angle_spec != empty and front_image == nil
    assign baked_hanger = true
  endif
  assign front_alt = product.title | append: ' - Front'
-%}
{%- if front_url -%}
  <li class="mrack__item{% if baked_hanger %} has-baked-hanger{% endif %}{% if angle_spec and angle_spec != empty %} has-360-angles{% endif %}" data-rack-item data-handle="{{ product.handle }}" data-index="{{ index }}">
    <a class="mrack__link" href="{{ product.url }}" data-rack-link aria-label="{{ product.title | escape }}, {{ product.price | money_with_currency }}">
      <span class="mrack__hanger-wrap" aria-hidden="true">{% render 'melato-rack-hanger' %}</span>
      <span class="mrack__garment" data-rack-garment>
        <img src="{{ front_url }}" alt="{{ front_alt | escape }}" width="1120" height="1400" loading="{% if index < 4 %}eager{% else %}lazy{% endif %}" decoding="async" draggable="false">
        <canvas class="mrack__cloth-canvas" data-rack-canvas width="560" height="700" aria-hidden="true"></canvas>
      </span>
      <span class="mrack__floor-shadow" aria-hidden="true"></span>
    </a>
    <script type="application/json" data-rack-data>
      {"handle":{{ product.handle | json }},"title":{{ product.title | json }},"price":{{ product.price | money_with_currency | json }},"url":{{ product.url | json }},"front":{{ front_url | json }},"back":{% if back_url %}{{ back_url | json }}{% else %}null{% endif %},"bakedHanger":{{ baked_hanger | json }},"angles":[{% if angle_spec and angle_spec != empty and front_image == nil %}{% assign angle_tokens = angle_spec | split: ':' %}{% assign angle_prefix = angle_tokens[0] %}{% assign view_degrees = angle_tokens[1] | split: ',' %}{% for degree in view_degrees %}{% assign view_file = 'rack-' | append: angle_prefix | append: '-view-' | append: degree | append: '.webp' %}{"degrees":{{ degree }},"url":{{ view_file | asset_url | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}{% elsif angle_block and angle_block.settings.angle_30 and front_url %}{"degrees":0,"url":{{ front_url | json }}},{"degrees":30,"url":{{ angle_block.settings.angle_30 | image_url: width: 1200 | json }}}{% if angle_block.settings.angle_60 %},{"degrees":60,"url":{{ angle_block.settings.angle_60 | image_url: width: 1200 | json }}}{% endif %}{% if angle_block.settings.angle_90 %},{"degrees":90,"url":{{ angle_block.settings.angle_90 | image_url: width: 1200 | json }}}{% endif %}{% endif %}],"openViews":[{% if open_spec and open_spec != empty and front_image == nil %}{% assign open_tokens = open_spec | split: ':' %}{% assign open_prefix = open_tokens[0] %}{% assign open_stages = open_tokens[1] | split: ',' %}{% for stage in open_stages %}{% assign open_file = 'rack-' | append: open_prefix | append: '-view-' | append: stage | append: '.webp' %}{"stage":{{ stage | json }},"url":{{ open_file | asset_url | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}],"variants":[ {%- for variant in product.variants -%}{"id":{{ variant.id }},"title":{{ variant.title | json }},"available":{{ variant.available | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}
    </script>
  </li>
{%- endif -%}

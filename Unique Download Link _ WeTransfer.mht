.Collapsible { color: var(--wt-color-gray-85,#353535); outline: none; }

.Collapsible__header { cursor: pointer; justify-content: space-between; align-items: center; display: flex; }

.Collapsible__header-text { margin: 0px; }

@media (min-width: 768px) {
  .Collapsible__header-text { font-weight: var(--wt-font-weight-500,500) !important; font-size: var(--wt-size-font-20,20px) !important; }
}

.Collapsible__content { width: 90%; max-height: 0px; transition: max-height 0.5s ease-out; overflow: hidden; }

.Collapsible__content p { margin-top: 1.25rem; transition: 0.5s ease-in; }

@media (min-width: 768px) {
  .Collapsible__content p { font-size: var(--wt-size-font-18,18px) !important; }
}

.Collapsible__content--is-expanded { max-height: 700px; overflow: hidden; }

.Collapsible__arrow { color: rgb(22, 22, 22); flex-shrink: 0; width: 0.875rem; height: 0.875rem; transition: transform 0.25s ease-in-out; }

@media (min-width: 768px) {
  .Collapsible__arrow { margin-right: 2rem; }
}

.Collapsible__arrow--default { transform: rotate(-90deg); }

.Collapsible__arrow--open { transform: rotate(90deg); }


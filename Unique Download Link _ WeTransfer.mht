html { --scale: 0.3px; min-height: 0vw; }

@media only screen and (min-width: 768px) {
  html { --scale: calc(
      0.3px + 0.7 * (
          100vw - 768px
        ) / 1792
    ); }
}

@media only screen and (min-width: 2560px) {
  html { --scale: 1px; }
}

@media only screen and (min-aspect-ratio: 213 / 100) {
  html { --scale: 0.3px; min-height: 0vh; }
}


.ProButton { max-height: 3.375rem; font-weight: var(--wt-font-weight-semi,500); font-family: var(--wt-font-family-actief,"Actief Grotesque"),var(--wt-font-fallback-actief,Arial, Helvetica, sans-serif); text-align: center; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 4.5rem; outline: none; min-width: 16.25rem; margin-top: 0px; margin-bottom: 2.5rem; padding: 1.0625rem 1.6875rem; font-size: 1rem; line-height: 1.5rem; text-decoration: none; position: relative; }

.ProButton__text { z-index: 3; color: rgb(255, 255, 255); }

.ProButton__noise { content: ""; z-index: 2; mix-blend-mode: overlay; background: url("../media/Noise.3vfv00a4ptmgh.png") 0px 0px / cover no-repeat; border-radius: 4.5rem; width: 100%; height: 100%; display: block; position: absolute; inset: 0px; }


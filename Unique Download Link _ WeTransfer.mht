@keyframes SlideRight { 
  0% { opacity: 0; transform: translate(-100%); }
  10% { opacity: 1; }
  100% { opacity: 1; transform: translate(0px); }
}

@keyframes SlideUp { 
  0% { opacity: 0; transform: translateY(10px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.drawer__wrapper { color: rgb(51, 51, 51); z-index: 0; background-color: rgb(255, 255, 255); border-top-right-radius: 0.5rem; border-bottom-right-radius: 0.5rem; gap: 0.625rem; width: 600px; height: 100%; padding: 3rem 0px 3rem 2rem; display: flex; position: absolute; left: 280px; overflow: hidden; }

@media (max-width: 1040px) {
  .drawer__wrapper { display: none; }
}

.drawer__wrapper-enter-active { opacity: 1; animation: 0.6s cubic-bezier(0.3, 0, 0.3, 1) 0s 1 normal forwards running SlideRight; }

.drawer__wrapper-exit-active { opacity: 0; animation: 0.5s cubic-bezier(0.3, 0, 0.3, 1) 0s 1 reverse forwards running SlideRight; }

.drawer__text-wrapper { flex-direction: column; justify-content: space-between; width: 100%; display: flex; }

.drawer__text-wrapper > * { opacity: 0; animation: 0.6s cubic-bezier(0.65, 0.01, 0.25, 1.5) 0s 1 normal forwards running SlideUp; }

.drawer__text-wrapper > :first-child { animation-delay: 1.3s; }

.drawer__text-wrapper > :nth-child(2) { animation-delay: 1.4s; }

.drawer__text-wrapper > :nth-child(3) { animation-delay: 1.5s; }

.drawer__text-wrapper > :nth-child(4) { animation-delay: 1.6s; }

.drawer__buttons-wrapper { margin-top: 2.5rem; }


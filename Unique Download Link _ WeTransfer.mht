  .ProButton { margin-top: 2.5rem; margin-bottom: 0px; }
}

a.ProButton::before { background: linear-gradient(rgb(129, 145, 255) 0%, rgb(74, 93, 254) 100%); }

a.ProButton::after, a.ProButton::before { content: ""; border-radius: 4.5rem; width: 100%; height: 100%; display: block; position: absolute; inset: 0px; }

a.ProButton::after { opacity: 0; z-index: 1; background: linear-gradient(360deg, rgb(129, 145, 255) 0%, rgb(74, 93, 254) 100%); transition: opacity 0.3s ease-in-out; }

a.ProButton:hover::after { opacity: 0.6; }


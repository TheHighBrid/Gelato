<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#080808">
  <title>{{ shop.name }} - Coming Soon</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@300;400&family=DM+Mono:wght@400&display=swap" rel="stylesheet">

  {{ content_for_header }}

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #080808;
      --text: #F2EDE6;
      --accent: #C8FF00;
      --muted: #555;
      --border: #222;
      --surface: #141414;
    }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Barlow', sans-serif;
      font-weight: 300;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }

    /* Noise */
    body::after {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.04'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
    }

    .pw-wrap {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 24px;
      position: relative;
      z-index: 1;
      text-align: center;
    }

    .pw-logo {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(3rem, 8vw, 6rem);
      letter-spacing: 0.12em;
      margin-bottom: 16px;
    }
    .pw-logo span { color: var(--accent); }

    .pw-tagline {
      font-family: 'DM Mono', monospace;
      font-size: 0.65rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 60px;
    }

    .pw-heading {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(3rem, 7vw, 8rem);
      line-height: 0.9;
      letter-spacing: -0.01em;
      margin-bottom: 20px;
    }
    .pw-heading .out {
      -webkit-text-stroke: 1px rgba(242,237,230,0.3);
      color: transparent;
    }

    .pw-sub {
      font-size: 0.9rem;
      color: var(--muted);
      max-width: 400px;
      line-height: 1.7;
      margin-bottom: 48px;
    }

    /* Password form */
    .pw-form {
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 100%;
      max-width: 400px;
    }

    .pw-form-row {
      display: flex;
      gap: 0;
    }

    .pw-input {
      flex: 1;
      background: var(--surface);
      border: 1px solid var(--border);
      border-right: none;
      padding: 13px 16px;
      font-family: 'DM Mono', monospace;
      font-size: 0.7rem;
      color: var(--text);
      outline: none;
      transition: border-color 0.2s;
      -webkit-appearance: none;
      appearance: none;
    }
    .pw-input::placeholder { color: var(--muted); }
    .pw-input:focus { border-color: var(--accent); }

    .pw-btn {
      background: var(--accent);
      border: 1px solid var(--accent);
      padding: 13px 24px;
      font-family: 'DM Mono', monospace;
      font-size: 0.65rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--bg);
      cursor: pointer;
      transition: background 0.2s;
      white-space: nowrap;
    }
    .pw-btn:hover { background: var(--text); border-color: var(--text); }

    .pw-error {
      font-family: 'DM Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      color: #FF3333;
      text-transform: uppercase;
    }

    /* Newsletter section */
    .pw-divider {
      width: 40px;
      height: 1px;
      background: var(--border);
      margin: 40px auto;
    }

    .pw-nl-label {
      font-family: 'DM Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 12px;
    }

    .pw-nl-heading {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(1.5rem, 3vw, 2.5rem);
      letter-spacing: 0.05em;
      margin-bottom: 8px;
    }

    .pw-nl-sub {
      font-size: 0.825rem;
      color: var(--muted);
      margin-bottom: 24px;
    }

    /* Countdown */
    .pw-countdown {
      display: flex;
      gap: 12px;
      justify-content: center;
      margin-bottom: 48px;
    }

    .pw-unit {
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 16px 20px;
      text-align: center;
      min-width: 76px;
    }

    .pw-num {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 2.5rem;
      line-height: 1;
      color: var(--text);
    }

    .pw-unit-label {
      font-family: 'DM Mono', monospace;
      font-size: 0.5rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
      margin-top: 4px;
    }

    /* Footer */
    .pw-footer {
      padding: 24px;
      text-align: center;
      border-top: 1px solid var(--border);
      position: relative;
      z-index: 1;
    }

    .pw-footer-text {
      font-family: 'DM Mono', monospace;
      font-size: 0.55rem;
      letter-spacing: 0.12em;
      color: var(--muted);
      text-transform: uppercase;
    }

    .pw-footer-text a { color: var(--accent); }

    /* Admin link */
    .pw-admin {
      position: fixed;
      bottom: 20px;
      right: 20px;
      font-family: 'DM Mono', monospace;
      font-size: 0.55rem;
      letter-spacing: 0.1em;
      color: var(--muted);
      border: 1px solid var(--border);
      padding: 8px 14px;
      transition: color 0.2s, border-color 0.2s;
      z-index: 10;
    }
    .pw-admin:hover { color: var(--accent); border-color: var(--accent); }

    @media (max-width: 480px) {
      .pw-countdown { gap: 8px; }
      .pw-unit { min-width: 60px; padding: 12px 14px; }
      .pw-num { font-size: 2rem; }
    }
  </style>
</head>
<body>

  <div class="pw-wrap">

    <div class="pw-logo">{{ shop.name }}<span>.</span></div>
    <p class="pw-tagline">Coming Soon - {{ 'now' | date: '%Y' }}</p>

    <h1 class="pw-heading">
      SOMETHING<br>
      <span class="out">BIG</span><br>
      IS COMING.
    </h1>

    <p class="pw-sub">{{ shop.name }} is almost ready. Enter the password below for early access, or sign up to be notified when we launch.</p>

    {%- if shop.password_message != blank -%}
      <p style="font-size:0.875rem;color:var(--muted);margin-bottom:24px;max-width:400px;">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'storefront_password', class: 'pw-form' -%}
      {%- if form.errors -%}
        <p class="pw-error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="pw-form-row">
        <input
          class="pw-input"
          type="password"
          name="password"
          id="password"
          placeholder="Enter password..."
          autocomplete="current-password"
          required
          aria-label="Store password"
        >
        <button type="submit" class="pw-btn">Enter</button>
      </div>
    {%- endform -%}

    <div class="pw-divider"></div>

    <p class="pw-nl-label">Get Notified</p>
    <h2 class="pw-nl-heading">DROP ALERTS</h2>
    <p class="pw-nl-sub">Be the first to know when we go live.</p>

    {%- form 'customer', class: 'pw-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,launch-alert">
      {%- if form.posted_successfully? -%}
        <p style="font-family:'DM Mono',monospace;font-size:0.7rem;letter-spacing:0.15em;color:var(--accent);text-transform:uppercase;">You're on the list! 🔥</p>
      {%- else -%}
        <div class="pw-form-row">
          <input
            class="pw-input"
            type="email"
            name="contact[email]"
            placeholder="your@email.com"
            autocomplete="email"
            required
            aria-label="Email address"
          >
          <button type="submit" class="pw-btn">Notify Me</button>
        </div>
      {%- endif -%}
    {%- endform -%}

  </div>

  <footer class="pw-footer">
    <p class="pw-footer-text">
      © {{ 'now' | date: '%Y' }} {{ shop.name }}.
      Powered by <a href="https://www.shopify.com" target="_blank" rel="noopener">Shopify</a>.
    </p>
  </footer>

  <a href="/admin" class="pw-admin">Store Admin →</a>

  <script>
    // Optional countdown - set your launch date here
    const launchDate = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000); // 7 days from now

    function updateCountdown() {
      const diff = launchDate - Date.now();
      if (diff <= 0) return;
      const d = Math.floor(diff / 86400000);
      const h = Math.floor((diff % 86400000) / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);
      const fmt = n => String(n).padStart(2, '0');
      document.querySelectorAll('.pw-num').forEach((el, i) => {
        el.textContent = fmt([d,h,m,s][i]);
      });
    }

    // Inject countdown
    const countdown = document.querySelector('.pw-wrap');
    const cdHtml = `
      <div class="pw-countdown">
        <div class="pw-unit"><div class="pw-num">07</div><div class="pw-unit-label">Days</div></div>
        <div class="pw-unit"><div class="pw-num">00</div><div class="pw-unit-label">Hours</div></div>
        <div class="pw-unit"><div class="pw-num">00</div><div class="pw-unit-label">Mins</div></div>
        <div class="pw-unit"><div class="pw-num">00</div><div class="pw-unit-label">Secs</div></div>
      </div>`;
    const divider = document.querySelector('.pw-divider');
    divider.insertAdjacentHTML('beforebegin', cdHtml);

    updateCountdown();
    setInterval(updateCountdown, 1000);
  </script>

  {{ content_for_layout }}
</body>
</html>

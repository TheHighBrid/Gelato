<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' or request.locale.iso_code == 'he' %}rtl{% else %}ltr{% endif %}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height">
  <meta name="theme-color" content="{{ settings.color_background }}">
  {%- liquid
    assign melato_meta_title = page_title
    assign melato_meta_description = page_description
    assign melato_noindex = false

    if template.name == 'index'
      assign melato_meta_title = 'Melato | Designer Apparel & Limited Collections'
      assign melato_meta_description = 'Discover Melato designer apparel, limited-run tracksuits, denim and statement pieces. Curated in Canada, built for movement. Shop the latest drop.'
    elsif template.name == 'product' and product
      assign melato_meta_title = product.title
    elsif template.name == 'collection' and collection.handle == 'all'
      assign melato_meta_title = 'Designer Apparel & Accessories'
      assign melato_meta_description = 'Shop the complete Melato index: designer apparel, tracksuits, denim, womenswear and accessories, curated in limited runs and built with intent.'
    elsif template.name == 'page' and page.handle == 'contact'
      assign melato_meta_title = page.title | default: 'Contact'
      assign melato_meta_description = 'Contact Melato for order support, sizing, delivery, returns, press and general inquiries. Our customer care team is here to help.'
    elsif request.path contains '/policies/privacy-policy'
      assign melato_meta_description = 'Read Melato’s Privacy Policy to understand how personal information is collected, used and protected when you browse, shop or contact us.'
    elsif request.path contains '/policies/terms-of-service'
      assign melato_meta_description = 'Read the Melato Terms of Service covering use of melato.ca, purchases, account responsibilities and other terms that govern the store.'
    elsif request.path contains '/policies/refund-policy'
      assign melato_meta_description = 'Review Melato’s return and refund policy, including eligibility, item condition requirements and how to request customer-care support.'
    elsif request.path contains '/policies/shipping-policy'
      assign melato_meta_description = 'Review Melato delivery information, including order preparation, complimentary standard delivery, tracking, duties and destination details.'
    elsif template.name == 'cart'
      assign melato_meta_description = blank
      assign melato_noindex = true
    elsif template.name == '404'
      assign melato_meta_title = 'Page Not Found'
      assign melato_meta_description = blank
      assign melato_noindex = true
    endif
  -%}
  {%- if melato_noindex -%}<meta name="robots" content="noindex,follow">{%- endif -%}
  {%- if request.path == '/collections/denim-1' -%}<link rel="canonical" href="{{ shop.secure_url }}/collections/denim">{%- else -%}<link rel="canonical" href="{{ canonical_url }}">{%- endif -%}
  {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width:32,height:32 }}">{%- endif -%}
  <title>{{ melato_meta_title | escape }}{%- if current_tags %} | Tagged {{ current_tags | join:', ' }}{% endif -%}{%- if current_page != 1 %} | Page {{ current_page }}{% endif -%}{%- unless melato_meta_title contains shop.name %} | {{ shop.name }}{% endunless -%}</title>
  {%- if melato_meta_description != blank -%}<meta name="description" content="{{ melato_meta_description | strip_html | escape }}">{%- endif -%}
  <meta property="og:site_name" content="{{ shop.name }}"><meta property="og:url" content="{{ canonical_url }}"><meta property="og:title" content="{{ melato_meta_title | escape }}"><meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
  {%- if melato_meta_description != blank -%}<meta property="og:description" content="{{ melato_meta_description | strip_html | escape }}">{%- endif -%}
  {%- if page_image != blank -%}<meta property="og:image" content="https:{{ page_image | image_url: width:1200 }}"><meta name="twitter:image" content="https:{{ page_image | image_url: width:1200 }}">{%- elsif settings.share_image != blank -%}<meta property="og:image" content="https:{{ settings.share_image | image_url: width:1200 }}"><meta name="twitter:image" content="https:{{ settings.share_image | image_url: width:1200 }}">{%- endif -%}
  <meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="{{ melato_meta_title | escape }}">{%- if melato_meta_description != blank -%}<meta name="twitter:description" content="{{ melato_meta_description | strip_html | escape }}">{%- endif -%}
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet">
  {%- style -%}:root{--color-bg:{{ settings.color_background }};--color-text:{{ settings.color_text }};--color-accent:{{ settings.color_accent }};--color-accent-hover:{{ settings.color_accent_hover }};--color-surface:{{ settings.color_surface }};--color-border:{{ settings.color_border }};--color-muted:{{ settings.color_muted }};--color-error:{{ settings.color_error }};--font-heading-family:'Bebas Neue',sans-serif;--font-heading-style:normal;--font-heading-weight:400;--font-body-family:'Barlow',sans-serif;--font-body-style:normal;--font-body-weight:400;--font-mono-family:'DM Mono','Courier New',monospace;--font-size-base:{{ settings.font_size_base }}px;--letter-spacing-heading:{{ settings.letter_spacing_heading }}em;--line-height-body:{{ settings.line_height_body }};--container-width:{{ settings.container_width }}px;--container-padding:{{ settings.container_padding }}px;--grid-gap:{{ settings.grid_gap }}px;--border-radius:{{ settings.border_radius }}px;--header-height:60px;--header-bg:{{ settings.header_bg }};--header-text:{{ settings.header_text_color }}}{%- endstyle -%}
  {{ content_for_header }}
  <link rel="preload" href="{{ 'theme.css' | asset_url }}" as="style">{{ 'theme.css' | asset_url | stylesheet_tag }}{{ 'melato-enhancements.css' | asset_url | stylesheet_tag }}{{ 'melato-palette-logo-updated.css' | asset_url | stylesheet_tag }}{{ 'melato-info-legal-pages.css' | asset_url | stylesheet_tag }}{{ 'melato-header-logo-bigger.css' | asset_url | stylesheet_tag }}{{ 'melato-palette-v3.css' | asset_url | stylesheet_tag }}{{ 'melato-audit-upgrades.css' | asset_url | stylesheet_tag }}{{ 'premium-enhancements.css' | asset_url | stylesheet_tag }}{{ 'melato-header-footer-fix.css' | asset_url | stylesheet_tag }}{{ 'melato-optimization-2026.css' | asset_url | stylesheet_tag }}{{ 'melato-hidden-ui-cleanup.css' | asset_url | stylesheet_tag }}{{ 'melato-august-2026-audit-fixes.css' | asset_url | stylesheet_tag }}{{ 'melato-pdp-layout-2026.css' | asset_url | stylesheet_tag }}
  {%- if settings.custom_css != blank -%}<style>{{ settings.custom_css }}</style>{%- endif -%}
  {% render 'melato-global-jsonld' %}{% render 'melato-global-polish' %}
</head>
<body class="template-{{ template.name }}{%- if template.suffix %} template-{{ template.name }}--{{ template.suffix }}{% endif %}{%- if settings.animations_enabled %} animations-enabled{% endif %}{%- if settings.high_contrast %} high-contrast{% endif %}" data-theme="{{ settings.color_scheme }}" data-product-handle="{% if product %}{{ product.handle | escape }}{% endif %}" data-product-type="{% if product %}{{ product.product_type | escape }}{% endif %}">
  <a href="#main-content" class="skip-to-content">{{ 'accessibility.skip_to_content' | t }}</a>
  {%- capture melato_announcement_output -%}{%- section 'melato-announcement-bar' -%}{%- endcapture -%}{% render 'melato-rendered-output-filters', html:melato_announcement_output, context:'announcement' %}
  {%- section 'melato-header' -%}
  {%- liquid
    assign melato_filter_main_output = false
    if template.name == 'index' or template.name == 'collection'
      assign melato_filter_main_output = true
    elsif request.path == '/pages/faq' or request.path == '/pages/contact' or request.path contains '/policies/refund-policy'
      assign melato_filter_main_output = true
    elsif template.name == 'product' and product
      assign melato_filter_main_output = true
    endif
  -%}
  {%- if melato_filter_main_output -%}{%- capture melato_main_output -%}{{ content_for_layout }}{%- endcapture -%}<main id="main-content" class="main-content" role="main" tabindex="-1">{% render 'melato-rendered-output-filters', html:melato_main_output, context:'main' %}</main>{%- else -%}<main id="main-content" class="main-content" role="main" tabindex="-1">{{ content_for_layout }}</main>{%- endif -%}
  {%- section 'melato-footer' -%}
  {%- capture melato_cart_output -%}{%- render 'cart-drawer' -%}{%- endcapture -%}
  <div class="melato-utility-layer" aria-label="Store utilities"><div id="drip-overlay" class="drip-overlay" aria-hidden="true" data-overlay></div>{% render 'melato-rendered-output-filters', html:melato_cart_output, context:'cart' %}{%- render 'search-drawer' -%}{%- render 'mobile-menu' -%}{%- render 'quick-view-modal' -%}<div id="drip-toast" class="drip-toast" role="status" aria-live="polite" aria-atomic="true"></div></div>
  <script>window.DRIP={shop:{currency:{{ shop.currency | json }},moneyFormat:{{ shop.money_format | json }},locale:{{ request.locale.iso_code | json }},freeShippingThreshold:0,routes:{root:{{ routes.root_url | json }},cart:{{ routes.cart_url | json }},cartAdd:{{ routes.cart_add_url | json }},cartChange:{{ routes.cart_change_url | json }},search:{{ routes.search_url | json }},collections:{{ routes.collections_url | json }}}},cart:{{ cart | json }},customer:{{ customer | json }},strings:{addedToCart:{{ 'cart.added' | t | json }},cartEmpty:{{ 'cart.empty' | t | json }},soldOut:{{ 'products.sold_out' | t | json }},unavailable:{{ 'products.unavailable' | t | json }},addToCart:{{ 'products.add_to_cart' | t | json }},outOfStock:{{ 'products.out_of_stock' | t | json }}}};</script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script><script src="{{ 'premium-enhancements.js' | asset_url }}" defer></script><script src="{{ 'melato-optimization-2026.js' | asset_url }}" defer></script><script src="{{ 'melato-audit-nav-collections.js' | asset_url }}" defer></script><script src="{{ 'melato-pdp-polish.js' | asset_url }}" defer></script><script src="{{ 'melato-cart-drawer.js' | asset_url }}" defer></script><script src="{{ 'melato-august-2026-audit-fixes.js' | asset_url }}" defer></script>{%- if template.name == 'collection' -%}<script src="{{ 'melato-collection-filters.js' | asset_url }}" defer></script>{%- endif -%}{% render 'melato-living-lookbook-loader' %}{% render 'melato-back-in-stock-loader' %}{% render 'melato-product-color-engine' %}
</body>
</html>

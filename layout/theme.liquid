<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' or request.locale.iso_code == 'he' %}rtl{% else %}ltr{% endif %}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height">
  <meta name="theme-color" content="{{ settings.color_background }}">

  {%- liquid
    assign melato_meta_title = page_title
    assign melato_meta_description = page_description

    if template.name == 'collection' and collection.handle == 'all'
      assign melato_meta_title = 'The Melato Index'
      if melato_meta_description == blank
        assign melato_meta_description = 'The complete Melato catalogue across the current rotation and archive.'
      endif
    elsif template.name == 'page' and page.handle == 'contact'
      assign melato_meta_title = page.title | default: 'Contact'
      assign melato_meta_description = 'Contact Melato for order support, sizing, shipping, returns and brand inquiries.'
    endif
  -%}

  {%- if request.path == '/collections/denim-1' -%}
    <link rel="canonical" href="{{ shop.secure_url }}/collections/denim">
  {%- else -%}
    <link rel="canonical" href="{{ canonical_url }}">
  {%- endif -%}

  {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{%- endif -%}

  <title>{{ melato_meta_title | escape }}{%- if current_tags %} | Tagged {{ current_tags | join: ', ' }}{% endif -%}{%- if current_page != 1 %} | Page {{ current_page }}{% endif -%}{%- unless melato_meta_title contains shop.name %} | {{ shop.name }}{% endunless -%}</title>
  {%- if melato_meta_description != blank -%}<meta name="description" content="{{ melato_meta_description | strip_html | escape }}">{%- endif -%}

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ melato_meta_title | escape }}">
  <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
  {%- if melato_meta_description != blank -%}<meta property="og:description" content="{{ melato_meta_description | strip_html | escape }}">{%- endif -%}
  {%- if page_image != blank -%}
    <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
    <meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">
  {%- elsif settings.share_image != blank -%}
    <meta property="og:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
    <meta name="twitter:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
  {%- endif -%}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ melato_meta_title | escape }}">
  {%- if melato_meta_description != blank -%}<meta name="twitter:description" content="{{ melato_meta_description | strip_html | escape }}">{%- endif -%}

  {%- assign heading_font = settings.font_heading -%}{%- assign body_font = settings.font_body -%}
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:ital,wght@0,300;0,400;0,500;1,300&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet">
  {%- style -%}:root{--color-bg:{{ settings.color_background }};--color-text:{{ settings.color_text }};--color-accent:{{ settings.color_accent }};--color-accent-hover:{{ settings.color_accent_hover }};--color-surface:{{ settings.color_surface }};--color-border:{{ settings.color_border }};--color-muted:{{ settings.color_muted }};--color-error:{{ settings.color_error }};--font-heading-family:{% if heading_font.family %}{{ heading_font.family }},{{ heading_font.fallback_families }}{% else %}'Bebas Neue',sans-serif{% endif %};--font-heading-style:{% if heading_font.family %}{{ heading_font.style }}{% else %}normal{% endif %};--font-heading-weight:{% if heading_font.family %}{{ heading_font.weight }}{% else %}400{% endif %};--font-body-family:{% if body_font.family %}{{ body_font.family }},{{ body_font.fallback_families }}{% else %}'Barlow',sans-serif{% endif %};--font-body-style:{% if body_font.family %}{{ body_font.style }}{% else %}normal{% endif %};--font-body-weight:{% if body_font.family %}{{ body_font.weight }}{% else %}300{% endif %};--font-mono-family:'DM Mono','Courier New',monospace;--font-size-base:{{ settings.font_size_base }}px;--letter-spacing-heading:{{ settings.letter_spacing_heading }}em;--line-height-body:{{ settings.line_height_body }};--container-width:{{ settings.container_width }}px;--container-padding:{{ settings.container_padding }}px;--grid-gap:{{ settings.grid_gap }}px;--border-radius:{{ settings.border_radius }}px;--header-height:60px;--header-bg:{{ settings.header_bg }};--header-text:{{ settings.header_text_color }}}{%- endstyle -%}
  {{ content_for_header }}
  <link rel="preload" href="{{ 'theme.css' | asset_url }}" as="style">
  {{ 'theme.css' | asset_url | stylesheet_tag }}{{ 'melato-enhancements.css' | asset_url | stylesheet_tag }}{{ 'melato-palette-logo-updated.css' | asset_url | stylesheet_tag }}{{ 'melato-info-legal-pages.css' | asset_url | stylesheet_tag }}{{ 'melato-header-logo-bigger.css' | asset_url | stylesheet_tag }}{{ 'melato-palette-v3.css' | asset_url | stylesheet_tag }}{{ 'melato-audit-upgrades.css' | asset_url | stylesheet_tag }}{{ 'premium-enhancements.css' | asset_url | stylesheet_tag }}{{ 'melato-header-footer-fix.css' | asset_url | stylesheet_tag }}{{ 'melato-optimization-2026.css' | asset_url | stylesheet_tag }}{{ 'melato-hidden-ui-cleanup.css' | asset_url | stylesheet_tag }}{{ 'melato-august-2026-audit-fixes.css' | asset_url | stylesheet_tag }}
  {%- if settings.custom_css != blank -%}<style>{{ settings.custom_css }}</style>{%- endif -%}
  {% render 'melato-global-jsonld' %}
  {% render 'melato-global-polish' %}
</head>
<body
  class="template-{{ template.name }}{%- if template.suffix %} template-{{ template.name }}--{{ template.suffix }}{% endif %}{%- if settings.animations_enabled %} animations-enabled{% endif %}{%- if settings.high_contrast %} high-contrast{% endif %}"
  data-theme="{{ settings.color_scheme }}"
  data-product-handle="{% if product %}{{ product.handle | escape }}{% endif %}"
  data-product-type="{% if product %}{{ product.product_type | escape }}{% endif %}"
>
  <a href="#main-content" class="skip-to-content">{{ 'accessibility.skip_to_content' | t }}</a>

  {%- liquid
    assign melato_is_fragrance_product = false
    if template.name == 'product' and product
      assign melato_product_type_down = product.product_type | downcase
      assign melato_product_title_down = product.title | downcase
      if melato_product_type_down contains 'fragrance' or melato_product_type_down contains 'eau de toilette' or melato_product_type_down contains 'eau de parfum' or melato_product_title_down contains 'eau de toilette' or melato_product_title_down contains 'eau de parfum'
        assign melato_is_fragrance_product = true
      endif
    endif
  -%}

  {%- capture melato_announcement_output -%}{%- section 'melato-announcement-bar' -%}{%- endcapture -%}
  {% render 'melato-rendered-output-filters', html: melato_announcement_output, context: 'announcement' %}

  {%- section 'melato-header' -%}

  {%- if melato_is_fragrance_product -%}
    <main id="main-content" class="main-content" role="main" tabindex="-1">
      {%- section 'melato-fragrance-product' -%}
    </main>
  {%- else -%}
    {%- capture melato_main_output -%}{{ content_for_layout }}{%- endcapture -%}
    <main id="main-content" class="main-content" role="main" tabindex="-1">{% render 'melato-rendered-output-filters', html: melato_main_output, context: 'main' %}</main>
  {%- endif -%}

  {%- section 'melato-footer' -%}

  {%- liquid
    assign melato_show_size_guide = false
    if template.name == 'product' and product and melato_is_fragrance_product == false
      assign melato_size_type = product.product_type | downcase
      assign melato_size_title = product.title | downcase
      if melato_size_type contains 'jacket' or melato_size_title contains 'jacket' or melato_size_type contains 'pant' or melato_size_title contains 'pant' or melato_size_type contains 'trouser' or melato_size_title contains 'trouser' or melato_size_type contains 'jean' or melato_size_title contains 'jean' or melato_size_type contains 'denim' or melato_size_title contains 'denim' or melato_size_type contains 'shirt' or melato_size_title contains 'shirt' or melato_size_type contains 'top' or melato_size_title contains 'top' or melato_size_type contains 'tee' or melato_size_title contains 'tee' or melato_size_type contains 'polo' or melato_size_title contains 'polo' or melato_size_type contains 'dress' or melato_size_title contains 'dress' or melato_size_type contains 'skirt' or melato_size_title contains 'skirt' or melato_size_type contains 'bodysuit' or melato_size_title contains 'bodysuit' or melato_size_type contains 'coat' or melato_size_title contains 'coat' or melato_size_type contains 'vest' or melato_size_title contains 'vest' or melato_size_type contains 'tracksuit' or melato_size_title contains 'tracksuit'
        assign melato_show_size_guide = true
      endif
    endif
  -%}

  {%- capture melato_cart_output -%}{%- render 'cart-drawer' -%}{%- endcapture -%}
  <div class="melato-utility-layer" aria-label="Store utilities"><div id="drip-overlay" class="drip-overlay" aria-hidden="true" data-overlay></div>{% render 'melato-rendered-output-filters', html: melato_cart_output, context: 'cart' %}{%- render 'search-drawer' -%}{%- render 'mobile-menu' -%}{%- render 'quick-view-modal' -%}{%- if melato_show_size_guide -%}{%- render 'size-guide-modal' -%}{%- endif -%}<div id="drip-toast" class="drip-toast" role="status" aria-live="polite" aria-atomic="true"></div></div>
  <script>window.DRIP={shop:{currency:{{ shop.currency | json }},moneyFormat:{{ shop.money_format | json }},locale:{{ request.locale.iso_code | json }},freeShippingThreshold:0,routes:{root:{{ routes.root_url | json }},cart:{{ routes.cart_url | json }},cartAdd:{{ routes.cart_add_url | json }},cartChange:{{ routes.cart_change_url | json }},search:{{ routes.search_url | json }},collections:{{ routes.collections_url | json }}}},cart:{{ cart | json }},customer:{{ customer | json }},strings:{addedToCart:{{ 'cart.added' | t | json }},cartEmpty:{{ 'cart.empty' | t | json }},soldOut:{{ 'products.sold_out' | t | json }},unavailable:{{ 'products.unavailable' | t | json }},addToCart:{{ 'products.add_to_cart' | t | json }},outOfStock:{{ 'products.out_of_stock' | t | json }}}};</script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script src="{{ 'melato-hero-video.js' | asset_url }}" defer></script>
  <script src="{{ 'premium-enhancements.js' | asset_url }}" defer></script>
  <script src="{{ 'melato-optimization-2026.js' | asset_url }}" defer></script>
  <script src="{{ 'melato-audit-nav-collections.js' | asset_url }}" defer></script>
  <script src="{{ 'melato-pdp-polish.js' | asset_url }}" defer></script>
  <script src="{{ 'melato-cart-drawer.js' | asset_url }}" defer></script>
  <script src="{{ 'melato-august-2026-audit-fixes.js' | asset_url }}" defer></script>
  {%- if template.name == 'collection' -%}<script src="{{ 'melato-collection-filters.js' | asset_url }}" defer></script>{%- endif -%}
  {% render 'melato-living-lookbook-loader' %}
  {% render 'melato-back-in-stock-loader' %}
  {% render 'melato-product-color-engine' %}
  {% render 'melato-utility-layer' %}
</body>
</html>

<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' or request.locale.iso_code == 'he' %}rtl{% else %}ltr{% endif %}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height">
  <meta name="theme-color" content="{{ settings.color_background }}">
  <meta name="shop-currency" content="{{ shop.currency | escape }}">
  {%- liquid
    assign melato_meta_title = page_title
    assign melato_meta_description = page_description
    if template.name == 'index'
      assign melato_meta_title = 'Melato | Premium Designer Apparel'
      assign melato_meta_description = 'Limited-run Melato apparel, accessories and fragrance, tailored for movement and cut with deliberate intent.'
    elsif template.name == 'collection' and collection.handle == 'all'
      assign melato_meta_title = 'All Products'
      assign melato_meta_description = 'Shop the complete Melato catalogue.'
    elsif template.name == 'page' and page.handle == 'contact'
      assign melato_meta_title = page.title | default: 'Contact'
      assign melato_meta_description = 'Contact Melato for order support, sizing, delivery, returns and general inquiries.'
    endif
  -%}
  {%- if request.path == '/collections/denim-1' -%}<link rel="canonical" href="{{ shop.secure_url }}/collections/denim">{%- else -%}<link rel="canonical" href="{{ canonical_url }}">{%- endif -%}
  {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width:32,height:32 }}">{%- endif -%}
  <title>{{ melato_meta_title | escape }}{%- if current_tags %} | Tagged {{ current_tags | join:', ' }}{% endif -%}{%- if current_page != 1 %} | Page {{ current_page }}{% endif -%}{%- unless melato_meta_title contains shop.name %} | {{ shop.name }}{% endunless -%}</title>
  {%- if melato_meta_description != blank -%}<meta name="description" content="{{ melato_meta_description | strip_html | escape }}">{%- endif -%}
  <meta property="og:site_name" content="{{ shop.name }}"><meta property="og:url" content="{{ canonical_url }}"><meta property="og:title" content="{{ melato_meta_title | escape }}"><meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
  {%- if melato_meta_description != blank -%}<meta property="og:description" content="{{ melato_meta_description | strip_html | escape }}">{%- endif -%}
  {%- if page_image != blank -%}<meta property="og:image" content="https:{{ page_image | image_url: width:1200 }}"><meta name="twitter:image" content="https:{{ page_image | image_url: width:1200 }}">{%- elsif settings.share_image != blank -%}<meta property="og:image" content="https:{{ settings.share_image | image_url: width:1200 }}"><meta name="twitter:image" content="https:{{ settings.share_image | image_url: width:1200 }}">{%- endif -%}
  <meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="{{ melato_meta_title | escape }}">{%- if melato_meta_description != blank -%}<meta name="twitter:description" content="{{ melato_meta_description | strip_html | escape }}">{%- endif -%}
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300&family=DM+Mono:wght@300;400;500&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet"></noscript>
  {%- style -%}:root{--color-bg:{{ settings.color_background }};--color-text:{{ settings.color_text }};--color-accent:{{ settings.color_accent }};--color-accent-hover:{{ settings.color_accent_hover }};--color-surface:{{ settings.color_surface }};--color-border:{{ settings.color_border }};--color-muted:{{ settings.color_muted }};--color-error:{{ settings.color_error }};--font-heading-family:'Bebas Neue',sans-serif;--font-heading-style:normal;--font-heading-weight:400;--font-body-family:'Barlow',sans-serif;--font-body-style:normal;--font-body-weight:400;--font-mono-family:'DM Mono','Courier New',monospace;--font-size-base:{{ settings.font_size_base }}px;--letter-spacing-heading:{{ settings.letter_spacing_heading }}em;--line-height-body:{{ settings.line_height_body }};--container-width:{{ settings.container_width }}px;--container-padding:{{ settings.container_padding }}px;--grid-gap:{{ settings.grid_gap }}px;--border-radius:{{ settings.border_radius }}px;--header-height:60px;--header-bg:{{ settings.header_bg }};--header-text:{{ settings.header_text_color }}}
  .melato-trust-strip{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:10px 24px;padding:12px 18px;background:#0a0a0a;color:#f5f1e8;border-top:1px solid rgba(245,241,232,.09);border-bottom:1px solid rgba(245,241,232,.09);font-size:10px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;text-align:center}.melato-trust-strip a{color:inherit;text-decoration:none;border-bottom:1px solid rgba(245,241,232,.38)}
  {%- endstyle -%}
  {{ content_for_header }}

  {%- if template.name == 'collection' and collection -%}
    {%- for preload_product in collection.products limit: 4 -%}
      {%- if preload_product.featured_image != blank -%}
        <link rel="preload" as="image" href="{{ preload_product.featured_image | image_url: width: 800 }}" imagesrcset="{{ preload_product.featured_image | image_url: width: 400 }} 400w, {{ preload_product.featured_image | image_url: width: 600 }} 600w, {{ preload_product.featured_image | image_url: width: 800 }} 800w" imagesizes="(min-width:1200px) 25vw,(min-width:768px) 33vw,50vw" fetchpriority="high">
      {%- endif -%}
    {%- endfor -%}
    <style>
      .melato-product-grid__inner .product-card__media{background:linear-gradient(110deg,var(--color-surface) 22%,color-mix(in srgb,var(--color-surface) 82%,var(--color-text)) 38%,var(--color-surface) 54%);background-size:220% 100%;animation:melato-card-placeholder 1.4s linear infinite}
      .melato-product-grid__inner .product-card__img{position:relative;z-index:1;background:var(--color-surface)}
      @keyframes melato-card-placeholder{to{background-position:-220% 0}}
      @media(prefers-reduced-motion:reduce){.melato-product-grid__inner .product-card__media{animation:none}}
    </style>
  {%- endif -%}

  <link rel="preload" href="{{ 'theme.css' | asset_url }}" as="style">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ 'melato-enhancements.css' | asset_url | stylesheet_tag }}
  {{ 'melato-palette-logo-updated.css' | asset_url | stylesheet_tag }}
  {%- if template.name == 'page' or request.path contains '/policies/' -%}{{ 'melato-info-legal-pages.css' | asset_url | stylesheet_tag }}{%- endif -%}
  {{ 'melato-header-logo-bigger.css' | asset_url | stylesheet_tag }}
  {{ 'melato-palette-v3.css' | asset_url | stylesheet_tag }}
  {{ 'melato-audit-upgrades.css' | asset_url | stylesheet_tag }}
  {{ 'premium-enhancements.css' | asset_url | stylesheet_tag }}
  {{ 'melato-storefront-tail.css' | asset_url | stylesheet_tag }}
  {%- if template.name == 'product' -%}{{ 'melato-pdp-layout-2026.css' | asset_url | stylesheet_tag }}{%- endif -%}
  {%- if settings.custom_css != blank -%}<style>{{ settings.custom_css }}</style>{%- endif -%}
  {% render 'melato-global-jsonld' %}{% render 'melato-global-polish' %}
</head>
<body class="template-{{ template.name }}{%- if template.suffix %} template-{{ template.name }}--{{ template.suffix }}{% endif %}{%- if settings.animations_enabled %} animations-enabled{% endif %}{%- if settings.high_contrast %} high-contrast{% endif %}" data-theme="{{ settings.color_scheme }}" data-product-handle="{% if product %}{{ product.handle | escape }}{% endif %}" data-product-type="{% if product %}{{ product.product_type | escape }}{% endif %}">
  <a href="#main-content" class="skip-to-content">{{ 'accessibility.skip_to_content' | t }}</a>
  {%- capture melato_announcement_output -%}{%- section 'melato-announcement-bar' -%}{%- endcapture -%}{% render 'melato-rendered-output-filters', html:melato_announcement_output, context:'announcement' %}
  {%- section 'melato-header' -%}
  {%- liquid
    assign melato_filter_main_output = false
    if template.name == 'index' or template.name == 'collection'
      assign melato_filter_main_output = true
    elsif request.path == '/pages/faq' or request.path == '/pages/contact' or request.path contains '/policies/refund-policy'
      assign melato_filter_main_output = true
    elsif template.name == 'product' and product
      assign melato_filter_main_output = true
    endif
  -%}
  {%- if melato_filter_main_output -%}{%- capture melato_main_output -%}{{ content_for_layout }}{%- endcapture -%}<main id="main-content" class="main-content" role="main" tabindex="-1">{% render 'melato-rendered-output-filters', html:melato_main_output, context:'main' %}</main>{%- else -%}<main id="main-content" class="main-content" role="main" tabindex="-1">{{ content_for_layout }}</main>{%- endif -%}
  {%- if template.name == 'index' or template.name == 'product' -%}<section class="melato-trust-strip" aria-label="Shopping assurances"><span>Complimentary standard delivery</span><span>Prepared in 1–3 business days</span><a href="/policies/refund-policy">30-day eligible returns</a><span>Secure Shopify checkout</span></section>{%- endif -%}
  {%- section 'melato-footer' -%}
  {%- capture melato_cart_output -%}{%- render 'cart-drawer' -%}{%- endcapture -%}
  <div class="melato-utility-layer" aria-label="Store utilities"><div id="drip-overlay" class="drip-overlay" aria-hidden="true" data-overlay></div>{% render 'melato-rendered-output-filters', html:melato_cart_output, context:'cart' %}{%- render 'search-drawer' -%}{%- render 'mobile-menu' -%}{%- render 'quick-view-modal' -%}<div id="drip-toast" class="drip-toast" role="status" aria-live="polite" aria-atomic="true"></div></div>
  <script>window.DRIP={shop:{currency:{{ shop.currency | json }},moneyFormat:{{ shop.money_format | json }},locale:{{ request.locale.iso_code | json }},freeShippingThreshold:0,routes:{root:{{ routes.root_url | json }},cart:{{ routes.cart_url | json }},cartAdd:{{ routes.cart_add_url | json }},cartChange:{{ routes.cart_change_url | json }},search:{{ routes.search_url | json }},collections:{{ routes.collections_url | json }}}},cart:{{ cart | json }},customer:{{ customer | json }},strings:{addedToCart:{{ 'cart.added' | t | json }},cartEmpty:{{ 'cart.empty' | t | json }},soldOut:{{ 'products.sold_out' | t | json }},unavailable:{{ 'products.unavailable' | t | json }},addToCart:{{ 'products.add_to_cart' | t | json }},outOfStock:{{ 'products.out_of_stock' | t | json }}}};</script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script src="{{ 'premium-enhancements.js' | asset_url }}" defer></script>
  <script src="{{ 'melato-optimization-2026.js' | asset_url }}" defer></script>
  <script src="{{ 'melato-audit-nav-collections.js' | asset_url }}" defer></script>
  <script src="{{ 'melato-cart-drawer.js' | asset_url }}" defer></script>
  {%- if template.name == 'collection' -%}<script src="{{ 'melato-collection-filters.js' | asset_url }}" defer></script>{%- endif -%}
  {% render 'melato-living-lookbook-loader' %}{% render 'melato-back-in-stock-loader' %}{% render 'melato-product-color-engine' %}
  <script>
    (function () {
      function initMelatoHeroVideo(scope) {
        var root = scope && scope.querySelectorAll ? scope : document;
        root.querySelectorAll('.melato-hero-video').forEach(function (section) {
          var cue = section.querySelector('[data-melato-scroll-cue]');
          if (cue && cue.dataset.melatoHeroBound !== 'true') {
            cue.dataset.melatoHeroBound = 'true';
            cue.addEventListener('click', function () {
              var next = section.nextElementSibling;
              if (next) next.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
          }

          section.querySelectorAll('.melato-hero-video__asset').forEach(function (video) {
            if (video.dataset.melatoAutoplayChecked === 'true') return;
            video.dataset.melatoAutoplayChecked = 'true';
            video.muted = true;
            video.playsInline = true;
            var playPromise = video.play && video.play();
            if (playPromise && typeof playPromise.catch === 'function') {
              playPromise.catch(function () { video.setAttribute('controls', 'controls'); });
            }
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () { initMelatoHeroVideo(document); });
      } else {
        initMelatoHeroVideo(document);
      }
      document.addEventListener('shopify:section:load', function (event) { initMelatoHeroVideo(event.target); });
    })();
  </script>
  <script>
    (function () {
      var connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
      if (connection && (connection.saveData || /2g/.test(connection.effectiveType || ''))) return;
      var budget = 2;
      var seen = new Set();
      var timer;
      function warm(anchor) {
        if (!anchor || budget < 1) return;
        var url;
        try { url = new URL(anchor.href, window.location.href); } catch (error) { return; }
        if (url.origin !== window.location.origin || !/\/products\//.test(url.pathname) || seen.has(url.href)) return;
        seen.add(url.href);
        budget -= 1;
        var link = document.createElement('link');
        link.rel = 'prefetch';
        link.as = 'document';
        link.href = url.href;
        document.head.appendChild(link);
      }
      document.addEventListener('pointerover', function (event) {
        var anchor = event.target.closest && event.target.closest('a[href*="/products/"]');
        if (!anchor) return;
        clearTimeout(timer);
        timer = setTimeout(function () { warm(anchor); }, 120);
      }, { passive: true });
      document.addEventListener('focusin', function (event) {
        var anchor = event.target.closest && event.target.closest('a[href*="/products/"]');
        if (anchor) warm(anchor);
      });
    })();
  </script>
</body>
</html>

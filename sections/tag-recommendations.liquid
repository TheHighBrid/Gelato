{% comment %}
  MELATO - STYLE WITH / TAG-BASED RECOMMENDATIONS
  Cleaned so visual cards do not read like "CHU CHŪ..." or duplicate product naming.
{% endcomment %}

{% assign current_type = blank %}
{% assign current_colorway = blank %}

{% for tag in product.tags %}
  {% assign tag_clean = tag | downcase | strip %}
  {% if tag_clean contains 'type_' %}
    {% assign current_type = tag_clean %}
  {% endif %}
  {% if tag_clean contains 'colorway_' %}
    {% assign current_colorway = tag_clean %}
  {% endif %}
{% endfor %}

{% assign theme_primary = '#d3a74a' %}
{% assign theme_secondary = '#f5f1e8' %}
{% assign theme_border = 'rgba(255,255,255,.14)' %}

{% if current_colorway == 'colorway_chu' %}
  {% assign theme_primary = '#5ea6d8' %}
  {% assign theme_secondary = '#d8d8d8' %}
{% elsif current_colorway == 'colorway_divididos' %}
  {% assign theme_primary = '#800020' %}
  {% assign theme_secondary = '#f5e6d3' %}
{% elsif current_colorway == 'colorway_conquista' %}
  {% assign theme_primary = '#12a99a' %}
  {% assign theme_secondary = '#e6ff5e' %}
{% elsif current_colorway == 'colorway_reliance' %}
  {% assign theme_primary = '#d39aa1' %}
  {% assign theme_secondary = '#f5f1ec' %}
{% endif %}

{% assign max_results = section.settings.max_products | default: 4 %}
{% assign found_count = 0 %}

{% capture recommendations_html %}
  {% if current_type != blank %}
    {% for p in collections.all.products %}
      {% if p.id != product.id and found_count < max_results %}
        {% assign p_has_type = false %}
        {% for tag in p.tags %}
          {% assign ptag = tag | downcase | strip %}
          {% if ptag == current_type %}
            {% assign p_has_type = true %}
            {% break %}
          {% endif %}
        {% endfor %}

        {% if p_has_type %}
          {% assign found_count = found_count | plus: 1 %}
          <a href="{{ p.url }}" class="m-recs__card" aria-label="{{ p.title | escape }}">
            <div class="m-recs__card-image-wrap">
              {% if p.featured_image %}
                <img
                  class="m-recs__card-img m-recs__card-img--primary"
                  src="{{ p.featured_image | image_url: width: 700 }}"
                  alt="{{ p.featured_image.alt | default: p.title | escape }}"
                  loading="lazy"
                  width="700"
                  height="700"
                >
                {% if p.images[1] %}
                  <img
                    class="m-recs__card-img m-recs__card-img--secondary"
                    src="{{ p.images[1] | image_url: width: 700 }}"
                    alt="{{ p.images[1].alt | default: p.title | escape }}"
                    loading="lazy"
                    width="700"
                    height="700"
                    aria-hidden="true"
                  >
                {% endif %}
              {% endif %}
              <span class="m-recs__type-badge">{{ p.product_type | default: 'Melato piece' }}</span>
            </div>

            <div class="m-recs__card-meta">
              <p class="m-recs__card-title">{{ p.title }}</p>
              <div class="m-recs__card-bottom">
                <p class="m-recs__card-price">{{ p.price | money }}</p>
                {% unless p.available %}
                  <span class="m-recs__sold-out">Sold out</span>
                {% endunless %}
              </div>
            </div>
          </a>
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endcapture %}

{% if found_count > 0 %}
  <section class="m-recs" id="tag-recs-{{ section.id }}" style="--theme-primary: {{ theme_primary }}; --theme-secondary: {{ theme_secondary }}; --theme-border: {{ theme_border }};">
    <div class="m-recs__inner">
      <div class="m-recs__header">
        <p class="m-recs__eyebrow">{{ section.settings.eyebrow | default: 'STYLE WITH' }}</p>
        <h2 class="m-recs__heading">{{ section.settings.heading | default: 'MORE FROM THE COLLECTION' }}</h2>
      </div>

      <div class="m-recs__grid" style="--cols: {{ found_count | at_most: 4 }}">
        {{ recommendations_html }}
      </div>
    </div>
  </section>
{% endif %}

<style>
  #tag-recs-{{ section.id }}.m-recs{
    background:#080808;
    border-top:1px solid #1a1a1a;
    padding:64px 24px 80px;
  }
  #tag-recs-{{ section.id }} .m-recs__inner{max-width:1200px;margin:0 auto;}
  #tag-recs-{{ section.id }} .m-recs__header{margin-bottom:34px;}
  #tag-recs-{{ section.id }} .m-recs__eyebrow{
    font-size:10px;
    font-weight:800;
    letter-spacing:.35em;
    text-transform:uppercase;
    color:var(--theme-primary);
    margin:0 0 10px;
  }
  #tag-recs-{{ section.id }} .m-recs__heading{
    font-size:clamp(22px,3.5vw,34px);
    font-weight:900;
    letter-spacing:-.03em;
    text-transform:uppercase;
    color:#f0f0f0;
    line-height:1;
    margin:0;
  }
  #tag-recs-{{ section.id }} .m-recs__grid{
    display:grid;
    grid-template-columns:repeat(var(--cols,4),1fr);
    gap:16px;
  }
  #tag-recs-{{ section.id }} .m-recs__card{
    display:block;
    text-decoration:none;
    background:#111;
    border:1px solid #1e1e1e;
    border-radius:8px;
    overflow:hidden;
    transition:border-color .25s, transform .25s;
  }
  #tag-recs-{{ section.id }} .m-recs__card:hover{
    border-color:var(--theme-primary);
    transform:translateY(-3px);
  }
  #tag-recs-{{ section.id }} .m-recs__card-image-wrap{
    position:relative;
    aspect-ratio:1/1;
    overflow:hidden;
    background:#1a1a1a;
  }
  #tag-recs-{{ section.id }} .m-recs__card-img{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center top;
    transition:opacity .35s ease, transform .45s ease;
  }
  #tag-recs-{{ section.id }} .m-recs__card-img--primary{opacity:1;transform:scale(1);z-index:1;}
  #tag-recs-{{ section.id }} .m-recs__card-img--secondary{opacity:0;transform:scale(1.04);z-index:2;}
  #tag-recs-{{ section.id }} .m-recs__card:hover .m-recs__card-img--primary{opacity:0;transform:scale(1.04);}
  #tag-recs-{{ section.id }} .m-recs__card:hover .m-recs__card-img--secondary{opacity:1;transform:scale(1);}
  #tag-recs-{{ section.id }} .m-recs__type-badge{
    position:absolute;
    top:10px;
    left:10px;
    z-index:10;
    font-size:9px;
    font-weight:900;
    letter-spacing:.16em;
    text-transform:uppercase;
    padding:5px 9px;
    border-radius:999px;
    background:rgba(8,8,8,.76);
    color:var(--theme-secondary);
    border:1px solid var(--theme-primary);
  }
  #tag-recs-{{ section.id }} .m-recs__card-meta{padding:14px 14px 16px;}
  #tag-recs-{{ section.id }} .m-recs__card-title{
    font-size:13px;
    font-weight:800;
    letter-spacing:.03em;
    color:#e8e8e8;
    margin:0 0 8px;
    line-height:1.25;
    text-transform:uppercase;
  }
  #tag-recs-{{ section.id }} .m-recs__card-bottom{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:8px;
  }
  #tag-recs-{{ section.id }} .m-recs__card-price{
    font-size:13px;
    font-weight:700;
    color:var(--theme-secondary);
    margin:0;
  }
  #tag-recs-{{ section.id }} .m-recs__sold-out{
    font-size:9px;
    font-weight:800;
    letter-spacing:.15em;
    text-transform:uppercase;
    color:#777;
    border:1px solid #333;
    padding:3px 7px;
    border-radius:999px;
  }
  @media(max-width:900px){#tag-recs-{{ section.id }} .m-recs__grid{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:480px){#tag-recs-{{ section.id }}.m-recs{padding:48px 12px 64px;}#tag-recs-{{ section.id }} .m-recs__grid{gap:10px;}}
  @media(hover:none){#tag-recs-{{ section.id }} .m-recs__card-img--secondary{display:none;}}
</style>

{% schema %}
{
  "name": "You Might Also Like",
  "tag": "div",
  "class": "melato-tag-recommendations",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "STYLE WITH"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "MORE FROM THE COLLECTION"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Max products to show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "You Might Also Like"
    }
  ]
}
{% endschema %}
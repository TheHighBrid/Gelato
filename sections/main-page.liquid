{% comment %}
  sections/main-page.liquid
  Generic page renderer with duplicate-H1 protection.
  Our Story receives the World of Melato editorial shell while all other
  standard pages retain the existing narrow utility layout.
{% endcomment %}

{%- liquid
  assign page_content_down = page.content | downcase
  assign content_has_h1 = false
  assign world_story_content = page.content

  if page_content_down contains '<h1'
    assign content_has_h1 = true
  endif

  if page.handle == 'our-story'
    assign world_story_content = world_story_content | replace: '<h1>Our Story</h1>', ''
  endif
-%}

{%- if page.handle == 'our-story' -%}
  <section class="melato-world-story" aria-labelledby="WorldStoryTitle-{{ section.id }}">
    {% render 'melato-world-rail' %}
    <header class="melato-world-story__masthead">
      <p class="melato-world-kicker">The House / Melato</p>
      <h1 id="WorldStoryTitle-{{ section.id }}">Our Story</h1>
    </header>
    <div class="melato-world-story__content">
      {{ world_story_content }}
    </div>
  </section>
{%- else -%}
  <section class="section-spacing melato-page-main" aria-labelledby="MainPageHeading-{{ section.id }}">
    <div class="container--narrow">
      {%- unless content_has_h1 -%}
        <h1 id="MainPageHeading-{{ section.id }}" class="heading-md drip-reveal" style="margin-bottom:40px;">
          {{ page.title }}
        </h1>
      {%- endunless -%}

      <div class="page-content drip-reveal drip-reveal--delay-1" style="color:var(--color-muted);line-height:1.9;font-size:0.95rem;">
        {{ page.content }}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "settings": []
}
{% endschema %}

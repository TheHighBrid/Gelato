<section class="melato-search-page" aria-labelledby="MelatoSearchHeading">
  <div class="melato-search-page__wrap">
    <header class="melato-search-page__header">
      <div class="melato-search-page__header-copy">
        <p class="melato-search-page__eyebrow">Index / Search</p>
        <h1 id="MelatoSearchHeading">Search</h1>
      </div>
      <p>Search the Melato catalogue, current work and published house pages.</p>
    </header>

    <form action="{{ routes.search_url }}" method="get" role="search" class="melato-search-page__form">
      <label class="visually-hidden" for="MelatoSearchInput">Search Melato</label>
      <input
        id="MelatoSearchInput"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="What are you looking for?"
        autocomplete="off"
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit">Search Melato</button>
    </form>

    {%- if search.performed -%}
      <div class="melato-search-page__status" role="status">
        {%- if search.results_count > 0 -%}
          {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} / “{{ search.terms | escape }}”
        {%- else -%}
          0 results / “{{ search.terms | escape }}”
        {%- endif -%}
      </div>

      {%- paginate search.results by 24 -%}
        {%- if search.results_count > 0 -%}
          <div class="melato-search-page__grid">
            {%- for item in search.results -%}
              <article class="melato-search-card">
                <a class="melato-search-card__media" href="{{ item.url }}">
                  {%- if item.object_type == 'product' and item.featured_media -%}
                    {{
                      item.featured_media
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '300, 450, 600, 750, 900',
                        sizes: '(max-width: 749px) 50vw, 25vw',
                        alt: item.title
                    }}
                  {%- else -%}
                    <div class="melato-search-card__placeholder">
                      {{ item.object_type | capitalize }}
                    </div>
                  {%- endif -%}
                </a>

                <div class="melato-search-card__content">
                  <p class="melato-search-card__type">{{ item.object_type | capitalize }}</p>
                  <h2><a href="{{ item.url }}">{{ item.title }}</a></h2>
                  {%- if item.object_type == 'product' -%}
                    <p class="melato-search-card__price">{{ item.price | money }}</p>
                  {%- endif -%}
                </div>
              </article>
            {%- endfor -%}
          </div>
        {%- else -%}
          <section class="melato-empty-state" aria-labelledby="MelatoSearchEmptyTitle">
            <p class="melato-empty-state__eyebrow">Search / No result</p>
            <div>
              <h2 id="MelatoSearchEmptyTitle" class="melato-empty-state__title">Nothing matched that description.</h2>
              <p class="melato-empty-state__copy">Try a product name, category or collection, or continue through the current Melato edit.</p>
              <div class="melato-empty-state__actions">
                <a class="melato-utility-link" href="/collections/new-arrivals">New arrivals</a>
                <a class="melato-utility-link" href="/collections/best-sellers">Best sellers</a>
                <a class="melato-utility-link" href="/pages/contact">Client services</a>
              </div>
            </div>
          </section>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="melato-search-pagination" aria-label="Search result pages">
            <span>{% if paginate.previous %}<a href="{{ paginate.previous.url }}">Previous</a>{% endif %}</span>
            <span>Page {{ paginate.current_page }} / {{ paginate.pages }}</span>
            <span>{% if paginate.next %}<a href="{{ paginate.next.url }}">Next</a>{% endif %}</span>
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Melato main search",
  "settings": []
}
{% endschema %}

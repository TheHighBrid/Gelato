{% comment %}
  sections/main-cart.liquid
{% endcomment %}

<section class="section-spacing">
  <div class="container--narrow">
    <h1 class="heading-md drip-reveal" style="margin-bottom:48px;">{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      {%- form 'cart', cart -%}
        <div style="display:grid;grid-template-columns:1fr 360px;gap:48px;align-items:start;" class="cart-page-grid">

          <div>
            {%- for item in cart.items -%}
              <div class="cart-item drip-reveal" style="grid-template-columns:100px 1fr;padding:24px 0;">
                <a href="{{ item.url }}">
 <img
  class="cart-item_img"
  src="{{ item.image | image_url: width: 100 }}"
  srcset="{{ item.image | image_url: width: 100 }} 1x, {{ item.image | image_url: width: 200 }} 2x"
  alt="{{ item.title | escape }}"
  width="100"
  height="{{ 100 | divided_by: item.image.aspect_ratio | ceil }}"
  loading="lazy"
>
                                                                                                                                                        </a>

                  <div class="cart-item__info">
                  <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                  {%- if item.variant.title != 'Default Title' -%}
                    <span class="cart-item__variant">{{ item.variant.title }}</span>
                  {%- endif -%}
                  <div class="cart-item__footer">
                    <div class="qty-stepper">
                      <button type="button" class="qty-stepper__btn" data-qty-change="-1" data-line="{{ item.key }}">−</button>
                      <input class="qty-stepper__value" type="number" value="{{ item.quantity }}" min="0" data-line="{{ item.key }}" name="updates[]">
                      <button type="button" class="qty-stepper__btn" data-qty-change="+1" data-line="{{ item.key }}">+</button>
                    </div>
                    <span class="price">{{ item.final_line_price | money }}</span>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>

          <div style="background:var(--color-surface);padding:32px;position:sticky;top:80px;" class="drip-reveal drip-reveal--delay-2">
            <h2 class="heading-xs" style="margin-bottom:24px;">ORDER SUMMARY</h2>
            <div class="cart-subtotal" style="margin-bottom:12px;">
              <span class="text-label">{{ 'cart.subtotal' | t }}</span>
              <span class="price">{{ cart.total_price | money }}</span>
            </div>
            <p class="text-label" style="color:var(--color-muted);text-align:center;margin-bottom:20px;">{{ 'general.secure_checkout' | t }}</p>
            <button type="submit" name="checkout" class="btn btn--primary btn--full btn--lg">
              {{ 'cart.checkout' | t }}
            </button>
            {%- if additional_checkout_buttons -%}
              <div class="additional-checkout-buttons" style="margin-top:12px;">
                {{ content_for_additional_checkout_buttons }}
              </div>
            {%- endif -%}
          </div>

        </div>
      {%- endform -%}

    {%- else -%}
      <div style="text-align:center;padding:80px 0;">
        <h2 class="heading-sm" style="margin-bottom:20px;color:var(--color-muted);">{{ 'cart.empty' | t }}</h2>
        <a href="/collections/all" class="btn btn--primary">{{ 'cart.empty_cta' | t }}</a>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  @media (max-width: 768px) {
    .cart-page-grid { grid-template-columns: 1fr !important; }
  }
</style>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_order_note", "label": "Show order note", "default": true }
  ]
}
{% endschema %}

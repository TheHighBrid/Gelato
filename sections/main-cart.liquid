{% comment %}
  sections/main-cart.liquid
  Full cart page. Shopify cart/form behavior remains authoritative.
{% endcomment %}

<section class="melato-cart-page" aria-labelledby="MelatoCartTitle-{{ section.id }}">
  <header class="melato-cart-page__header">
    <div>
      <p class="melato-cart-page__eyebrow">Bag / Melato</p>
      <h1 id="MelatoCartTitle-{{ section.id }}" class="melato-cart-page__title">Your Bag</h1>
    </div>
    <p class="melato-cart-page__meta">{{ cart.item_count }} {{ cart.item_count | pluralize: 'piece', 'pieces' }}</p>
  </header>

  {%- if cart.item_count > 0 -%}
    {%- form 'cart', cart -%}
      <div class="melato-cart-page__grid">
        <div class="melato-cart-page__lines">
          {%- for item in cart.items -%}
            <article class="melato-cart-line">
              <a href="{{ item.url }}" aria-label="View {{ item.product.title | escape }}">
                {%- if item.image != blank -%}
                  <img
                    class="melato-cart-line__image"
                    src="{{ item.image | image_url: width: 240 }}"
                    srcset="{{ item.image | image_url: width: 120 }} 120w, {{ item.image | image_url: width: 240 }} 240w, {{ item.image | image_url: width: 360 }} 360w"
                    sizes="120px"
                    alt="{{ item.title | escape }}"
                    width="120"
                    height="{{ 120 | divided_by: item.image.aspect_ratio | ceil }}"
                    loading="lazy"
                  >
                {%- endif -%}
              </a>

              <div class="melato-cart-line__body">
                <div>
                  <a href="{{ item.url }}" class="melato-cart-line__title">{{ item.product.title }}</a>
                  {%- if item.variant.title != 'Default Title' -%}
                    <div class="melato-cart-line__variant">{{ item.variant.title }}</div>
                  {%- endif -%}
                </div>

                <div class="melato-cart-line__bottom">
                  <div class="qty-stepper" aria-label="Quantity for {{ item.product.title | escape }}">
                    <button type="button" class="qty-stepper__btn" data-qty-change="-1" data-line="{{ item.key }}" aria-label="Decrease quantity">−</button>
                    <input class="qty-stepper__value" type="number" value="{{ item.quantity }}" min="0" data-line="{{ item.key }}" name="updates[]" aria-label="Quantity">
                    <button type="button" class="qty-stepper__btn" data-qty-change="+1" data-line="{{ item.key }}" aria-label="Increase quantity">+</button>
                  </div>
                  <span class="price">{{ item.final_line_price | money }}</span>
                </div>
              </div>
            </article>
          {%- endfor -%}
        </div>

        <aside class="melato-cart-page__summary" aria-labelledby="MelatoCartSummary-{{ section.id }}">
          <p class="melato-cart-page__eyebrow">Order / Summary</p>
          <h2 id="MelatoCartSummary-{{ section.id }}" class="melato-cart-page__summary-title">Ready when you are.</h2>
          <div class="melato-cart-page__summary-row">
            <span class="melato-cart-page__summary-label">Subtotal</span>
            <span class="price">{{ cart.total_price | money }}</span>
          </div>
          <p class="melato-cart-page__meta">Taxes and applicable duties are calculated at checkout.</p>

          {%- if section.settings.show_order_note -%}
            <div class="melato-field" style="margin-top:28px;">
              <label for="MelatoCartNote-{{ section.id }}">Order note</label>
              <textarea id="MelatoCartNote-{{ section.id }}" name="note" rows="3" placeholder="Optional instructions">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}

          <button type="submit" name="checkout" class="melato-house-button" style="width:100%;margin-top:18px;">
            Continue to checkout
          </button>

          {%- if additional_checkout_buttons -%}
            <div class="additional-checkout-buttons">
              {{ content_for_additional_checkout_buttons }}
            </div>
          {%- endif -%}
        </aside>
      </div>
    {%- endform -%}
  {%- else -%}
    <section class="melato-empty-state" aria-labelledby="MelatoEmptyBag-{{ section.id }}">
      <p class="melato-empty-state__eyebrow">Bag / Empty</p>
      <div>
        <h2 id="MelatoEmptyBag-{{ section.id }}" class="melato-empty-state__title">Nothing selected yet.</h2>
        <p class="melato-empty-state__copy">The bag is clear. Continue with the current release or browse the complete Melato catalogue.</p>
        <div class="melato-empty-state__actions">
          <a class="melato-utility-link" href="/collections/new-arrivals">New arrivals</a>
          <a class="melato-utility-link" href="/collections/all-products">All products</a>
        </div>
      </div>
    </section>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_order_note", "label": "Show order note", "default": true }
  ]
}
{% endschema %}

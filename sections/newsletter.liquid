{% comment %}Brand-aligned first-party email capture using Shopify's customer form.{% endcomment %}
<section class="melato-newsletter" aria-labelledby="melato-newsletter-title-{{ section.id }}" style="--newsletter-bg:{{ section.settings.background_color }};--newsletter-text:{{ section.settings.text_color }};--newsletter-muted:{{ section.settings.muted_color }};--newsletter-accent:{{ section.settings.accent_color }}"><div class="melato-newsletter__inner"><div class="melato-newsletter__copy">{%- if section.settings.eyebrow != blank -%}<p class="melato-newsletter__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}{%- if section.settings.heading != blank -%}<h2 id="melato-newsletter-title-{{ section.id }}" class="melato-newsletter__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}{%- if section.settings.subheading != blank -%}<p class="melato-newsletter__subheading">{{ section.settings.subheading | escape }}</p>{%- endif -%}</div><div class="melato-newsletter__form-wrap">{%- form 'customer', class: 'melato-newsletter__form' -%}<input type="hidden" name="contact[tags]" value="newsletter, melato collective"><label class="melato-newsletter__label" for="newsletter-email-{{ section.id }}">Email address</label><div class="melato-newsletter__controls"><input class="melato-newsletter__input" type="email" name="contact[email]" id="newsletter-email-{{ section.id }}" placeholder="Email address" required><button type="submit" class="melato-newsletter__button">{{ section.settings.button_label }}</button></div>{%- if form.posted_successfully? -%}<p class="melato-newsletter__message">{{ section.settings.success_message }}</p>{%- endif -%}{%- endform -%}</div></div></section>
<style>#shopify-section-{{ section.id }} .melato-newsletter{background:var(--newsletter-bg);color:var(--newsletter-text);border-top:1px solid rgba(255,255,255,.12)}#shopify-section-{{ section.id }} .melato-newsletter__inner{width:min(1320px,calc(100% - 40px));margin:auto;padding:clamp(64px,9vw,120px) 0;display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(36px,8vw,120px);align-items:end}#shopify-section-{{ section.id }} .melato-newsletter__title{margin:0;font-size:clamp(44px,7vw,104px);line-height:.88;text-transform:uppercase}#shopify-section-{{ section.id }} .melato-newsletter__subheading{color:var(--newsletter-muted)}#shopify-section-{{ section.id }} .melato-newsletter__controls{display:grid;grid-template-columns:1fr auto;border-bottom:1px solid rgba(255,255,255,.4)}#shopify-section-{{ section.id }} .melato-newsletter__input,#shopify-section-{{ section.id }} .melato-newsletter__button{background:transparent;color:var(--newsletter-text);border:0;padding:18px 0}#shopify-section-{{ section.id }} .melato-newsletter__button{font-weight:800;text-transform:uppercase}@media(max-width:820px){#shopify-section-{{ section.id }} .melato-newsletter__inner{grid-template-columns:1fr}}</style>
{% schema %}{"name":"Newsletter","tag":"section","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Private access"},{"type":"text","id":"heading","label":"Heading","default":"Join the Collective"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Priority access to new releases, restocks, private styling notes, and new chapters of The Living Book."},{"type":"text","id":"button_label","label":"Button label","default":"Enter the Collective"},{"type":"text","id":"success_message","label":"Success message","default":"You are on the list. Watch your inbox for the next chapter."},{"type":"color","id":"background_color","label":"Background","default":"#080808"},{"type":"color","id":"text_color","label":"Text","default":"#f5f1e8"},{"type":"color","id":"muted_color","label":"Muted text","default":"#9b968d"},{"type":"color","id":"accent_color","label":"Accent","default":"#d3a74a"}],"presets":[{"name":"Newsletter"}]}{% endschema %}
{% comment %}
  sections/newsletter.liquid
  Brand-aligned first-party email capture using Shopify's customer form.
{% endcomment %}

<section
  class="melato-newsletter"
  aria-labelledby="melato-newsletter-title-{{ section.id }}"
  style="
    --newsletter-bg: {{ section.settings.background_color }};
    --newsletter-text: {{ section.settings.text_color }};
    --newsletter-muted: {{ section.settings.muted_color }};
    --newsletter-accent: {{ section.settings.accent_color }};
  "
>
  <div class="melato-newsletter__inner">
    <div class="melato-newsletter__copy drip-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="melato-newsletter__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 id="melato-newsletter-title-{{ section.id }}" class="melato-newsletter__title">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="melato-newsletter__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="melato-newsletter__form-wrap drip-reveal drip-reveal--delay-2">
      {%- form 'customer', class: 'melato-newsletter__form', data-newsletter-form: '' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, melato collective">

        <label class="melato-newsletter__label" for="newsletter-email-{{ section.id }}">
          Email address
        </label>

        <div class="melato-newsletter__controls">
          <input
            class="melato-newsletter__input"
            type="email"
            name="contact[email]"
            id="newsletter-email-{{ section.id }}"
            value="{{ customer.email | escape }}"
            placeholder="{{ section.settings.placeholder | default: 'Email address' | escape }}"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            required
            {% if form.errors %}aria-invalid="true" aria-describedby="newsletter-error-{{ section.id }}"{% endif %}
          >

          <button type="submit" class="melato-newsletter__button">
            {{ section.settings.button_label | default: 'Enter the Collective' | escape }}
          </button>
        </div>

        {%- if form.errors -%}
          <div id="newsletter-error-{{ section.id }}" class="melato-newsletter__message melato-newsletter__message--error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <p class="melato-newsletter__message melato-newsletter__message--success" role="status">
            {{ section.settings.success_message | default: 'You are on the list. Watch your inbox for the next chapter.' | escape }}
          </p>
        {%- elsif section.settings.note != blank -%}
          <p class="melato-newsletter__note">{{ section.settings.note | escape }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .melato-newsletter {
    background:
      radial-gradient(circle at 12% 10%, color-mix(in srgb, var(--newsletter-accent) 18%, transparent), transparent 34%),
      var(--newsletter-bg);
    color: var(--newsletter-text);
    border-top: 1px solid color-mix(in srgb, var(--newsletter-text) 14%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--newsletter-text) 14%, transparent);
  }

  #shopify-section-{{ section.id }} .melato-newsletter__inner {
    width: min(1320px, calc(100% - 40px));
    margin: 0 auto;
    padding: clamp(64px, 9vw, 120px) 0;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, .9fr);
    gap: clamp(36px, 8vw, 120px);
    align-items: end;
  }

  #shopify-section-{{ section.id }} .melato-newsletter__eyebrow,
  #shopify-section-{{ section.id }} .melato-newsletter__label,
  #shopify-section-{{ section.id }} .melato-newsletter__note,
  #shopify-section-{{ section.id }} .melato-newsletter__message {
    font-family: var(--font-mono-family, inherit);
    text-transform: uppercase;
    letter-spacing: .16em;
  }

  #shopify-section-{{ section.id }} .melato-newsletter__eyebrow {
    margin: 0 0 14px;
    color: var(--newsletter-accent);
    font-size: .68rem;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .melato-newsletter__title {
    margin: 0;
    max-width: 760px;
    font-family: var(--font-heading-family, inherit);
    font-size: clamp(44px, 7vw, 104px);
    line-height: .88;
    letter-spacing: -.055em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .melato-newsletter__subheading {
    max-width: 620px;
    margin: 22px 0 0;
    color: var(--newsletter-muted);
    font-size: clamp(15px, 1.2vw, 18px);
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .melato-newsletter__label {
    display: block;
    margin-bottom: 10px;
    color: var(--newsletter-muted);
    font-size: .62rem;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .melato-newsletter__controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    border-bottom: 1px solid color-mix(in srgb, var(--newsletter-text) 52%, transparent);
  }

  #shopify-section-{{ section.id }} .melato-newsletter__input {
    min-width: 0;
    padding: 18px 14px 18px 0;
    border: 0;
    border-radius: 0;
    outline: 0;
    background: transparent;
    color: var(--newsletter-text);
    font: inherit;
    font-size: 1rem;
  }

  #shopify-section-{{ section.id }} .melato-newsletter__input::placeholder {
    color: color-mix(in srgb, var(--newsletter-muted) 72%, transparent);
  }

  #shopify-section-{{ section.id }} .melato-newsletter__input:focus-visible {
    box-shadow: inset 0 -2px 0 var(--newsletter-accent);
  }

  #shopify-section-{{ section.id }} .melato-newsletter__button {
    padding: 16px 0 16px 20px;
    border: 0;
    background: transparent;
    color: var(--newsletter-text);
    font-family: var(--font-mono-family, inherit);
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .melato-newsletter__button:hover,
  #shopify-section-{{ section.id }} .melato-newsletter__button:focus-visible {
    color: var(--newsletter-accent);
  }

  #shopify-section-{{ section.id }} .melato-newsletter__note,
  #shopify-section-{{ section.id }} .melato-newsletter__message {
    margin: 14px 0 0;
    color: var(--newsletter-muted);
    font-size: .58rem;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .melato-newsletter__message--success {
    color: var(--newsletter-accent);
  }

  #shopify-section-{{ section.id }} .melato-newsletter__message--error {
    color: #ff9d8f;
    text-transform: none;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .melato-newsletter__message--error ul {
    margin: 0;
    padding-left: 18px;
  }

  @media (max-width: 820px) {
    #shopify-section-{{ section.id }} .melato-newsletter__inner {
      width: min(100% - 28px, 1320px);
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 520px) {
    #shopify-section-{{ section.id }} .melato-newsletter__controls {
      grid-template-columns: 1fr;
      border-bottom: 0;
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .melato-newsletter__input {
      border-bottom: 1px solid color-mix(in srgb, var(--newsletter-text) 52%, transparent);
    }

    #shopify-section-{{ section.id }} .melato-newsletter__button {
      width: 100%;
      padding: 15px 18px;
      border: 1px solid color-mix(in srgb, var(--newsletter-text) 46%, transparent);
      text-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Private access" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Collective" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Priority access to new releases, restocks, private styling notes, and new chapters of The Living Book." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Enter the Collective" },
    { "type": "text", "id": "note", "label": "Privacy note", "default": "Sent with restraint. Unsubscribe whenever you choose." },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "You are on the list. Watch your inbox for the next chapter." },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#080808" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#f5f1e8" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#9b968d" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#d3a74a" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}

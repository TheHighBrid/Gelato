{% comment %}
  sections/main-order.liquid
{% endcomment %}

<section class="melato-account" aria-labelledby="MelatoOrderTitle-{{ section.id }}">
  <header class="melato-account__header">
    <div>
      <p class="melato-account__eyebrow">Order / {{ order.name }}</p>
      <h1 id="MelatoOrderTitle-{{ section.id }}" class="melato-account__title">Order</h1>
    </div>
    <a href="{{ routes.account_url }}" class="melato-utility-link">Back to account</a>
  </header>

  <div class="melato-account__grid">
    <section aria-labelledby="MelatoOrderPieces-{{ section.id }}">
      <h2 id="MelatoOrderPieces-{{ section.id }}" class="melato-account__section-title">{{ order.name }} / {{ order.created_at | date: '%B %d, %Y' }}</h2>

      {%- for line_item in order.line_items -%}
        <article class="melato-cart-line">
          {%- if line_item.image -%}
            <img
              src="{{ line_item.image | image_url: width: 240 }}"
              alt="{{ line_item.title | escape }}"
              class="melato-cart-line__image"
              width="120"
              height="{{ 120 | divided_by: line_item.image.aspect_ratio | ceil }}"
              loading="lazy"
            >
          {%- endif -%}
          <div class="melato-cart-line__body">
            <div>
              <p class="melato-cart-line__title">{{ line_item.product.title }}</p>
              {%- if line_item.variant.title != 'Default Title' -%}
                <p class="melato-cart-line__variant">{{ line_item.variant.title }}</p>
              {%- endif -%}
            </div>
            <div class="melato-cart-line__bottom">
              <span class="melato-cart-page__meta">Quantity / {{ line_item.quantity }}</span>
              <span class="price">{{ line_item.final_line_price | money }}</span>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </section>

    <aside class="melato-account__details" aria-labelledby="MelatoOrderSummary-{{ section.id }}">
      <p class="melato-account__label">Order summary</p>
      <h2 id="MelatoOrderSummary-{{ section.id }}" class="melato-account__section-title">{{ order.total_price | money }}</h2>

      <div class="melato-cart-page__summary-row">
        <span class="melato-cart-page__summary-label">Subtotal</span>
        <span>{{ order.subtotal_price | money }}</span>
      </div>
      {%- for shipping_method in order.shipping_methods -%}
        <div class="melato-cart-page__summary-row">
          <span class="melato-cart-page__summary-label">Shipping</span>
          <span>{{ shipping_method.price | money }}</span>
        </div>
      {%- endfor -%}
      <div class="melato-cart-page__summary-row" style="padding-top:18px;border-top:1px solid var(--melato-utility-rule);">
        <span class="melato-cart-page__summary-label">Total</span>
        <strong>{{ order.total_price | money }}</strong>
      </div>

      <p class="melato-account__label" style="margin-top:34px;">Status</p>
      <p>{{ order.financial_status_label | default: order.financial_status | capitalize }} / {{ order.fulfillment_status_label | default: order.fulfillment_status | capitalize }}</p>
    </aside>
  </div>
</section>

{% schema %}
{ "name": "Order", "tag": "section", "settings": [] }
{% endschema %}

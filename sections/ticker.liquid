{% comment %}
  sections/ticker.liquid
  Scrolling marquee with configurable items, speed, direction, and an accessible static summary.
{% endcomment %}

{%- if section.blocks.size > 0 -%}

<div
  class="ticker"
  style="
    --ticker-speed: {{ section.settings.speed | default: 30 }}s;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    border-color: {{ section.settings.border_color }};
    padding: {{ section.settings.padding }}px 0;
  "
  role="region"
  aria-label="{{ section.settings.accessible_label | default: 'Melato announcements' | escape }}"
>
  <p class="ticker__sr-only">
    {%- for block in section.blocks -%}
      {{ block.settings.text | strip | escape }}{% unless forloop.last %}. {% endunless %}
    {%- endfor -%}
  </p>

  <div
    class="ticker__track"
    data-ticker-track
    aria-hidden="true"
    {% if section.settings.direction == 'right' %}style="animation-direction: reverse;"{% endif %}
  >
    {%- comment -%} Render twice for a seamless visual loop. Assistive technology receives the static summary above once. {%- endcomment -%}
    {%- for n in (1..2) -%}
      {%- for block in section.blocks -%}
        <span class="ticker__item"{% if n == 1 %} {{ block.shopify_attributes }}{% endif %}>
          {{ block.settings.text | upcase | escape }}
        </span>
        <span class="ticker__separator" aria-hidden="true">
          {{ section.settings.separator | default: '✦' | escape }}
        </span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .ticker__sr-only {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .ticker__track {
      animation: none !important;
      transform: none !important;
    }
  }
</style>

{%- endif -%}

{% schema %}
{
  "name": "Ticker",
  "tag": "div",
  "blocks": [
    {
      "type": "item",
      "name": "Ticker item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "The culture wears us"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "accessible_label",
      "label": "Accessible label",
      "default": "Melato announcements",
      "info": "Read once by screen readers before the decorative moving text."
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed",
      "min": 10,
      "max": 80,
      "step": 5,
      "default": 30,
      "unit": "s",
      "info": "Lower = faster"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator character",
      "default": "✦"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        { "value": "left",  "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical padding",
      "min": 6,
      "max": 24,
      "step": 2,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#C8FF00"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#080808"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#2A2A2A"
    }
  ],
  "presets": [
    {
      "name": "Ticker",
      "blocks": [
        { "type": "item", "settings": { "text": "THE CULTURE WEARS US" } },
        { "type": "item", "settings": { "text": "CUT WITH INTENT" } },
        { "type": "item", "settings": { "text": "LIMITED PRODUCTION" } }
      ]
    }
  ]
}
{% endschema %}

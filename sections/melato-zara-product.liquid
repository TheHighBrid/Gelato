{{ 'melato-zara-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'melato-zara-product.js' | asset_url }}" defer></script>

{%- liquid
  assign v = product.selected_or_first_available_variant
  assign form_id = 'MZP-' | append: section.id
  assign details = product.metafields.custom.details
  assign fit = product.metafields.custom.fit_notes
  assign material = product.metafields.custom.material_composition
  assign care = product.metafields.custom.care_instructions
  assign size_page = product.metafields.custom.size_guide.value
  assign related = product.metafields.custom.complete_the_set.value
-%}

<section class="mzp" data-mzp data-money="{{ shop.money_format | escape }}">
  <div class="mzp-grid">
    <div class="mzp-media-wrap">
      <div class="mzp-gallery" data-gallery>
        {%- for media in product.media -%}
          <figure class="mzp-media" data-media data-id="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- assign image_alt = media.alt | default: product.title -%}
                {{ media.preview_image | image_url: width: 1800 | image_tag: widths: '480,720,960,1200,1500,1800', sizes: '(min-width: 990px) 62vw, 100vw', loading: 'lazy', class: 'mzp-image', alt: image_alt }}
              {%- when 'video' -%}
                {{ media | video_tag: controls: true, muted: true, class: 'mzp-image' }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag: class: 'mzp-image' }}
              {%- when 'model' -%}
                {{ media | model_viewer_tag: reveal: 'interaction', class: 'mzp-image' }}
            {%- endcase -%}
          </figure>
        {%- else -%}
          <figure class="mzp-media">{{ 'product-1' | placeholder_svg_tag }}</figure>
        {%- endfor -%}
      </div>
      {%- if product.media.size > 1 -%}<div class="mzp-count"><span data-count>1</span> / {{ product.media.size }}</div>{%- endif -%}
    </div>

    <aside class="mzp-panel">
      <div class="mzp-panel-inner">
        <header class="mzp-head">
          <p class="mzp-kicker">{{ section.settings.eyebrow }}</p>
          <h1>{{ product.title }}</h1>
          <div class="mzp-price"><span data-price>{{ v.price | money }}</span><s data-compare {% unless v.compare_at_price > v.price %}hidden{% endunless %}>{{ v.compare_at_price | money }}</s></div>
        </header>

        {%- form 'product', product, id: form_id, class: 'mzp-form' -%}
          <input type="hidden" name="id" value="{{ v.id }}" data-variant-id>
          {%- unless product.has_only_default_variant -%}
            <div class="mzp-options">
              {%- for option in product.options_with_values -%}
                {%- assign option_index = option.position | minus: 1 -%}
                {%- assign option_name = option.name | downcase -%}
                <fieldset data-option>
                  <div class="mzp-option-head"><legend>{{ option.name }}</legend>{% if option_name contains 'size' %}{% if size_page != blank %}<button type="button" class="mzp-link" data-size-open>Size guide</button>{% elsif section.settings.size_guide_url != blank %}<a class="mzp-link" href="{{ section.settings.size_guide_url }}">Size guide</a>{% endif %}{% endif %}</div>
                  <div class="mzp-values">
                    {%- for value in option.values -%}
                      {%- assign available = false -%}
                      {%- for variant in product.variants -%}{%- if variant.options[option_index] == value and variant.available -%}{%- assign available = true -%}{%- break -%}{%- endif -%}{%- endfor -%}
                      {%- assign uid = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                      <input id="{{ uid }}" type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" data-option-input {% if option.selected_value == value %}checked{% endif %} {% unless available %}data-unavailable{% endunless %}>
                      <label for="{{ uid }}">{{ value }}</label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            </div>
          {%- endunless -%}
          <button class="mzp-add" type="submit" data-add {% unless v.available %}disabled{% endunless %}><span data-add-label>{% if v.available %}{{ section.settings.add_label }}{% else %}Sold out{% endif %}</span></button>
          <p class="mzp-message" data-message role="status"></p>
        {%- endform -%}

        <p class="mzp-delivery">{{ section.settings.delivery_line }}</p>

        <div class="mzp-accordions">
          {%- if details != blank or product.description != blank -%}<details><summary>Details <i></i></summary><div class="rte">{% if details != blank %}{{ details | metafield_tag }}{% else %}{{ product.description }}{% endif %}</div></details>{%- endif -%}
          {%- if fit != blank or size_page != blank -%}<details><summary>Fit &amp; size <i></i></summary><div class="rte">{{ fit | metafield_tag }}{% if size_page != blank %}<button type="button" class="mzp-link" data-size-open>Open full size guide</button>{% endif %}</div></details>{%- endif -%}
          {%- if material != blank or care != blank -%}<details><summary>Composition &amp; care <i></i></summary><div class="rte">{% if material != blank %}<h3>Composition</h3>{{ material | metafield_tag }}{% endif %}{% if care != blank %}<h3>Care</h3>{{ care | metafield_tag }}{% endif %}</div></details>{%- endif -%}
          <details><summary>Shipping, exchanges &amp; returns <i></i></summary><div class="rte">{{ section.settings.shipping_copy }}<p><a href="{{ routes.root_url }}policies/shipping-policy">Shipping policy</a> · <a href="{{ routes.root_url }}policies/refund-policy">Returns policy</a></p></div></details>
        </div>

        {%- if related != blank -%}
          <section class="mzp-related"><h2>Style it with</h2><div class="mzp-related-track">{% for p in related limit: 4 %}<a href="{{ p.url }}" class="mzp-card">{{ p.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: p.title }}<span>{{ p.title }}</span><small>{{ p.price | money }}</small></a>{% endfor %}</div></section>
        {%- endif -%}
      </div>
    </aside>
  </div>

  <div class="mzp-sticky" data-sticky hidden><span data-sticky-meta>{{ v.title }} · {{ v.price | money }}</span><button type="button" data-sticky-add>{% if v.available %}{{ section.settings.add_label }}{% else %}Sold out{% endif %}</button></div>

  {%- if size_page != blank -%}<dialog class="mzp-dialog" data-size-dialog><header><h2>{{ size_page.title }}</h2><button type="button" data-size-close aria-label="Close">×</button></header><div class="rte">{{ size_page.content }}</div></dialog>{%- endif -%}
  <script type="application/json" data-product-json>{{ product | json }}</script>
</section>

{% schema %}
{"name":"Melato minimal product","tag":"section","class":"shopify-section--melato-minimal-product","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"MELATO"},{"type":"text","id":"add_label","label":"Add label","default":"ADD"},{"type":"text","id":"delivery_line","label":"Delivery line","default":"COMPLIMENTARY DELIVERY ON ALL ORDERS"},{"type":"url","id":"size_guide_url","label":"Fallback size guide"},{"type":"richtext","id":"shipping_copy","label":"Shipping copy","default":"<p>Orders are prepared within 1–3 business days.</p>"}],"presets":[{"name":"Melato minimal product"}]}
{% endschema %}
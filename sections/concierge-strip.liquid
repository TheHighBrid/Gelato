{{ 'melato-concierge.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign current = section.settings.current_pillar | default: 'post-purchase'
  case page.handle
    when 'thank-you'; assign current = 'post-purchase'
    when 'preview'; assign current = 'private-preview'
    when 'size-guide'; assign current = 'fit-guidance'
    when 'size-guide-1'; assign current = 'fit-guidance'
    when 'shipping-returns'; assign current = 'delivery-policy'
  endcase
  assign pillars = 'post-purchase,private-preview,fit-guidance,delivery-policy' | split: ','
  assign pillar_labels = 'Order Support,Private Preview,Fit Guide,Delivery & Returns' | split: ','
  assign pillar_urls = '/pages/thank-you,/pages/preview,/pages/size-guide,/pages/shipping-returns' | split: ','
-%}
<div class="melato-strip" data-concierge-strip data-current-pillar="{{ current }}"><div class="melato-strip__inner"><div class="melato-strip__eyebrow">Client Services</div><nav class="melato-strip__nav" aria-label="Client services">{% for pillar in pillars %}{% assign label=pillar_labels[forloop.index0] %}{% assign url=pillar_urls[forloop.index0] %}<a href="{{ url }}" class="melato-strip-link{% if pillar == current %} melato-strip-link--active{% endif %}" data-pillar="{{ pillar }}" {% if pillar == current %}aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}</nav>{% if section.settings.show_contextual and section.settings.contextual_copy != blank %}<div class="melato-strip__contextual"><div class="melato-strip__contextual-text">{{ section.settings.contextual_copy }}</div></div>{% endif %}</div></div>
{% schema %}
{"name":"Client Services Nav","settings":[{"type":"select","id":"current_pillar","label":"Current service","options":[{"value":"post-purchase","label":"Order Support"},{"value":"private-preview","label":"Private Preview"},{"value":"fit-guidance","label":"Fit Guide"},{"value":"delivery-policy","label":"Delivery & Returns"}],"default":"post-purchase"},{"type":"richtext","id":"contextual_copy","label":"Support copy","default":"<p>Need help with an order? Email <a href=\"mailto:support@melato.ca\">support@melato.ca</a> and include your order number.</p>"},{"type":"checkbox","id":"show_contextual","label":"Show support copy","default":true}],"presets":[{"name":"Client Services Nav","category":"Melato"}]}
{% endschema %}

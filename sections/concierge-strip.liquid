{% comment %}
  Melato Client Services navigation
  Connects the four canonical service pages.
  House integration keeps service content authoritative while removing legacy pill UI.
{% endcomment %}

{{ 'melato-concierge.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current = section.settings.current_pillar | default: 'post-purchase'

  case page.handle
    when 'thank-you'
      assign current = 'post-purchase'
    when 'preview'
      assign current = 'private-preview'
    when 'size-guide'
      assign current = 'fit-guidance'
    when 'size-guide-1'
      assign current = 'fit-guidance'
    when 'shipping-returns'
      assign current = 'delivery-policy'
  endcase

  assign pillars = 'post-purchase,private-preview,fit-guidance,delivery-policy' | split: ','
  assign pillar_labels = 'Order Support,Private Preview,Fit Guide,Delivery & Returns' | split: ','
  assign pillar_urls = '/pages/thank-you,/pages/preview,/pages/size-guide,/pages/shipping-returns' | split: ','
-%}

<style>
  /* Canonical service pages inherit the House visual language without changing content. */
  .melato-page {
    background: var(--melato-cream, #f0e8d9);
    color: var(--melato-ink, #090909);
    font-family: var(--melato-ui, "Helvetica Neue", Helvetica, Arial, sans-serif);
  }
  .melato-page-header {
    width: min(1440px, 100%);
    margin: 0 auto;
    padding: clamp(54px, 8vw, 112px) var(--melato-side, 24px) clamp(34px, 5vw, 64px);
    text-align: left;
  }
  .melato-page-header .melato-eyebrow {
    margin: 0 0 16px;
    color: var(--melato-muted-ink, rgba(9,9,9,.58));
    font-family: var(--melato-mono, "DM Mono", monospace);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: .18em;
  }
  .melato-page-header__title {
    max-width: 12ch;
    margin: 0;
    font-family: var(--melato-editorial, "Iowan Old Style", Baskerville, "Times New Roman", serif);
    font-size: clamp(48px, 8vw, 112px);
    font-weight: 400;
    line-height: .9;
    letter-spacing: -.055em;
  }
  .melato-page-header__subtitle {
    max-width: 620px;
    margin: 24px 0 0;
    color: var(--melato-muted-ink, rgba(9,9,9,.58));
    font-size: 14px;
    line-height: 1.55;
  }
  .melato-page > .melato-container {
    max-width: 1440px;
    padding-inline: var(--melato-side, 24px);
  }
  .melato-page :is(.melato-card, .melato-card-muted, .melato-drop-card, .melato-connector, .melato-gate__icon, .melato-icon, .melato-tag, .melato-btn, .melato-input) {
    border-radius: 0 !important;
    box-shadow: none !important;
  }
  .melato-page .melato-card,
  .melato-page .melato-card-muted {
    background: var(--melato-cream-soft, #f7f2e9);
    border-color: rgba(9,9,9,.16);
  }
  .melato-page .melato-btn--primary {
    background: var(--melato-ink, #090909);
    color: var(--melato-cream, #f0e8d9);
    border-color: var(--melato-ink, #090909);
  }

  .melato-strip {
    margin-top: clamp(64px, 9vw, 128px);
    padding: 0 0 clamp(48px, 7vw, 88px);
    border-top: 0;
  }
  .melato-strip__inner {
    width: min(1440px, 100%);
    margin: 0 auto;
    padding: 0 var(--melato-side, 24px);
  }
  .melato-strip__eyebrow {
    margin: 0 0 16px;
    color: var(--melato-muted-ink, rgba(9,9,9,.58)) !important;
    font-family: var(--melato-mono, "DM Mono", monospace);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: .18em;
    text-align: left;
    text-transform: uppercase;
  }
  .melato-strip__nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid rgba(9,9,9,.2);
    border-bottom: 1px solid rgba(9,9,9,.2);
  }
  .melato-strip-link {
    min-height: 58px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 14px 16px;
    border: 0;
    border-right: 1px solid rgba(9,9,9,.2);
    border-radius: 0;
    background: transparent;
    color: var(--melato-ink, #090909) !important;
    font-size: 10px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: .12em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 180ms ease, color 180ms ease;
  }
  .melato-strip-link:last-child { border-right: 0; }
  .melato-strip-link:hover,
  .melato-strip-link:focus-visible {
    background: rgba(9,9,9,.05);
    color: var(--melato-ink, #090909) !important;
  }
  .melato-strip-link--active,
  .melato-strip-link--active:hover {
    background: var(--melato-ink, #090909) !important;
    color: var(--melato-cream, #f0e8d9) !important;
    border-color: rgba(240,232,217,.18) !important;
  }
  .melato-strip__contextual {
    max-width: none;
    margin: 18px 0 0;
    padding: 16px 0 0;
    border: 0;
    border-radius: 0;
    background: transparent !important;
    text-align: left;
  }
  .melato-strip__contextual-text,
  .melato-strip__contextual-text :where(p, span, strong, em, small) {
    margin: 0;
    color: var(--melato-muted-ink, rgba(9,9,9,.58)) !important;
    font-size: 12px;
    line-height: 1.55;
  }
  .melato-strip__contextual-text a {
    color: var(--melato-ink, #090909) !important;
    text-underline-offset: 3px;
  }

  @media (max-width: 720px) {
    .melato-page-header {
      padding-top: 42px;
    }
    .melato-page-header__title {
      font-size: clamp(42px, 15vw, 72px);
    }
    .melato-strip__nav {
      grid-template-columns: 1fr 1fr;
    }
    .melato-strip-link {
      min-height: 54px;
      border-bottom: 1px solid rgba(9,9,9,.2);
    }
    .melato-strip-link:nth-child(2n) { border-right: 0; }
    .melato-strip-link:nth-last-child(-n+2) { border-bottom: 0; }
  }
</style>

<div class="melato-strip" data-concierge-strip data-current-pillar="{{ current }}">
  <div class="melato-strip__inner">
    <div class="melato-strip__eyebrow">Client Services</div>

    <nav class="melato-strip__nav" aria-label="Client services">
      {%- for pillar in pillars -%}
        {%- assign label = pillar_labels[forloop.index0] -%}
        {%- assign url = pillar_urls[forloop.index0] -%}
        {%- assign is_active = false -%}
        {%- if pillar == current -%}
          {%- assign is_active = true -%}
        {%- endif -%}

        <a
          href="{{ url }}"
          class="melato-strip-link{% if is_active %} melato-strip-link--active{% endif %}"
          data-pillar-link
          data-pillar="{{ pillar }}"
          {% if is_active %}aria-current="page"{% endif %}
        >{{ label }}</a>
      {%- endfor -%}
    </nav>

    {%- if section.settings.show_contextual and section.settings.contextual_copy != blank -%}
      <div class="melato-strip__contextual">
        <div class="melato-strip__contextual-text">
          {{ section.settings.contextual_copy }}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Client Services Nav",
  "settings": [
    {
      "type": "select",
      "id": "current_pillar",
      "label": "Current service",
      "options": [
        { "value": "post-purchase", "label": "Order Support" },
        { "value": "private-preview", "label": "Private Preview" },
        { "value": "fit-guidance", "label": "Fit Guide" },
        { "value": "delivery-policy", "label": "Delivery & Returns" }
      ],
      "default": "post-purchase",
      "info": "The current page is detected automatically for the canonical service URLs."
    },
    {
      "type": "richtext",
      "id": "contextual_copy",
      "label": "Support copy",
      "default": "<p>Need help with an order? Email <a href=\"mailto:support@melato.ca\">support@melato.ca</a> and include your order number.</p>",
      "info": "Optional support copy shown beneath the service navigation."
    },
    {
      "type": "checkbox",
      "id": "show_contextual",
      "label": "Show support copy",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Client Services Nav",
      "category": "Melato"
    }
  ]
}
{% endschema %}

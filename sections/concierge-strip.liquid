{% comment %} Melato Client Services navigation, unified visual system. {% endcomment %}
{{ 'melato-concierge.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign current = section.settings.current_pillar | default: 'post-purchase'
  case page.handle
    when 'thank-you'
      assign current = 'post-purchase'
    when 'preview'
      assign current = 'private-preview'
    when 'size-guide'
      assign current = 'fit-guidance'
    when 'size-guide-1'
      assign current = 'fit-guidance'
    when 'shipping-returns'
      assign current = 'delivery-policy'
  endcase
  assign pillars = 'post-purchase,private-preview,fit-guidance,delivery-policy' | split: ','
  assign pillar_labels = 'Order Support,Private Preview,Fit Guide,Delivery & Returns' | split: ','
  assign pillar_urls = '/pages/thank-you,/pages/preview,/pages/size-guide,/pages/shipping-returns' | split: ','
-%}
<style>
.melato-strip__inner{max-width:1200px;margin:0 auto;padding:0 16px}.melato-strip__eyebrow{text-align:center;margin:0 0 20px;font-size:10px;letter-spacing:3px;text-transform:uppercase}.melato-strip__nav{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}.melato-strip-link{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:10px 18px;border:1px solid currentColor;text-decoration:none;font-size:12px;font-weight:600}.melato-strip__contextual{text-align:center;margin:20px auto 0;padding:14px;max-width:600px}.melato-strip__contextual-text{font-size:13px;line-height:1.6}
</style>
<div class="melato-strip" data-concierge-strip data-current-pillar="{{ current }}">
  <div class="melato-strip__inner">
    <div class="melato-strip__eyebrow">Client Services</div>
    <nav class="melato-strip__nav" aria-label="Client services">
      {%- for pillar in pillars -%}
        {%- assign label = pillar_labels[forloop.index0] -%}
        {%- assign url = pillar_urls[forloop.index0] -%}
        <a href="{{ url }}" class="melato-strip-link{% if pillar == current %} melato-strip-link--active{% endif %}" data-pillar="{{ pillar }}" {% if pillar == current %}aria-current="page"{% endif %}>{{ label }}</a>
      {%- endfor -%}
    </nav>
    {%- if section.settings.show_contextual and section.settings.contextual_copy != blank -%}
      <div class="melato-strip__contextual"><div class="melato-strip__contextual-text">{{ section.settings.contextual_copy }}</div></div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name":"Client Services Nav",
  "settings":[
    {"type":"select","id":"current_pillar","label":"Current service","options":[{"value":"post-purchase","label":"Order Support"},{"value":"private-preview","label":"Private Preview"},{"value":"fit-guidance","label":"Fit Guide"},{"value":"delivery-policy","label":"Delivery & Returns"}],"default":"post-purchase"},
    {"type":"richtext","id":"contextual_copy","label":"Support copy","default":"<p>Need help with an order? Email <a href=\"mailto:support@melato.ca\">support@melato.ca</a> and include your order number.</p>"},
    {"type":"checkbox","id":"show_contextual","label":"Show support copy","default":true}
  ],
  "presets":[{"name":"Client Services Nav","category":"Melato"}]
}
{% endschema %}

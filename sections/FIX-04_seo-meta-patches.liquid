─────────────────────────────────────────────────────────────
BLOCK A: theme.liquid - add INSIDE <head>, after existing meta tags
─────────────────────────────────────────────────────────────
Fixes:
  - Pagination rel="prev" / rel="next" for Google indexing
  - Ensures paginated collection pages share link equity correctly
─────────────────────────────────────────────────────────────
{%- endcomment -%}

{% comment %} ── MELATO FIX-04A: Pagination rel links ── {% endcomment %}
{%- if paginate -%}
  {%- if paginate.previous -%}
    <link rel="prev" href="{{ paginate.previous.url | prepend: shop.url }}">
  {%- endif -%}
  {%- if paginate.next -%}
    <link rel="next" href="{{ paginate.next.url | prepend: shop.url }}">
  {%- endif -%}
{%- endif -%}

{%- comment -%} ── MELATO FIX-04A: Org JSON-LD (add once, in theme.liquid) ── {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Melato",
  "url": "https://melato.ca",
  "logo": "https://melato.ca/cdn/shop/files/Melato-logo-lightbrown-ontransparent.png",
  "sameAs": [
    "https://www.instagram.com/melato.ca"
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Ottawa",
    "addressRegion": "ON",
    "addressCountry": "CA"
  }
}
</script>

{%- comment -%} ── MELATO FIX-04A: Website sitelinks search box ── {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Melato",
  "url": "https://melato.ca",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://melato.ca/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>



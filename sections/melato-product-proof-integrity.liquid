{% comment %}
  Melato PDP proof-integrity guard.

  The canonical customer-facing specification UI lives in
  melato-product-page-rebuild. This section is deliberately safety-only so a
  second Product Specification panel can never duplicate Construction, Fit,
  Material, or Care below the PDP.

  specification_pending remains fail-safe for products whose technical claims
  are still under review. A storefront-ready status overrides a stale pending
  tag so approved details cannot disappear because of old catalogue metadata.
{% endcomment %}

{%- liquid
  assign specification_pending = false
  assign material_spec_status = product.metafields.custom.material_spec_status.value | downcase | strip
  assign material_spec_ready = false
  if material_spec_status contains 'ready'
    assign material_spec_ready = true
  endif

  for tag in product.tags
    assign proof_tag = tag | downcase | strip
    if proof_tag == 'specification_pending' and material_spec_ready == false
      assign specification_pending = true
      break
    endif
  endfor
-%}

{%- if specification_pending -%}
  <style data-melato-proof-integrity-fallback>
    /* No-JS safety: provisional technical claims remain hidden. Commerce and
       Shipping & Returns stay available. */
    .melato-pdp-rebuild .pdp-story-tech,
    .melato-pdp-rebuild .pdp-proof-mini {
      display: none;
    }

    .melato-pdp-rebuild .pdp-spec-grid > .pdp-spec:not(:last-child) {
      display: none;
    }

    .melato-pdp-rebuild.pdp-proof-integrity-ready .pdp-story-tech {
      display: block;
    }

    .melato-pdp-rebuild.pdp-proof-integrity-ready .pdp-proof-mini {
      display: grid;
    }

    .melato-pdp-rebuild.pdp-proof-integrity-ready .pdp-spec-grid > .pdp-spec {
      display: block;
    }
  </style>

  <script data-melato-proof-integrity>
    (function () {
      var root = document.querySelector('.melato-pdp-rebuild');
      if (!root) return;

      function summaryText(details) {
        var summary = details.querySelector(':scope > summary');
        return summary ? summary.textContent.trim().toLowerCase() : '';
      }

      root.querySelectorAll('.pdp-mini-detail').forEach(function (details) {
        var label = summaryText(details);
        if (label === 'story' || label === 'construction') details.remove();
      });

      root.querySelectorAll('.pdp-spec').forEach(function (details) {
        var label = summaryText(details);
        if (label === 'fit' || label === 'material' || label === 'care' || label === 'application' || label === 'scent profile') details.remove();
      });

      root.querySelectorAll('.pdp-proof-mini > div').forEach(function (item) {
        var label = item.querySelector('strong');
        if (label && label.textContent.trim().toLowerCase() === 'verified material information') {
          item.remove();
        }
      });

      root.classList.add('pdp-proof-integrity-ready');
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Product proof integrity",
  "tag": "section",
  "class": "section-product-proof-integrity",
  "settings": []
}
{% endschema %}

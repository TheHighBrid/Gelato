{% comment %}
  Melato Living Book Vol. 01
  Replaces the scroll-gallery Living Lookbook with the page-turning editorial book.
{% endcomment %}

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Barlow+Condensed:wght@300;400;500;600&display=swap">
{{ 'melato-living-book-vol01.css' | asset_url | stylesheet_tag }}

<script type="application/json" data-lbv-assets>
{
  "goldFront": {{ 'lbv-goldset-front.jpg' | asset_url | json }},
  "goldBack": {{ 'lbv-goldset-back.jpg' | asset_url | json }},
  "sideTape": {{ 'lbv-sidetape-back.jpg' | asset_url | json }},
  "divididosCast": {{ 'lbv-divididos-cast.jpg' | asset_url | json }},
  "divididosExit": {{ 'lbv-divididos-exit.jpg' | asset_url | json }},
  "waqaaFront": {{ 'lbv-waqaa-front.jpg' | asset_url | json }},
  "astroFront": {{ 'lbv-astro-front.jpg' | asset_url | json }},
  "astroProfile": {{ 'lbv-astro-profile.jpg' | asset_url | json }},
  "suitBack": {{ 'lbv-suit-back.jpg' | asset_url | json }}
}
</script>

<section
  id="LivingBookVol01-{{ section.id }}"
  class="lbv"
  data-lbv-root
  data-hide-chrome="{% if section.settings.hide_store_chrome %}true{% else %}false{% endif %}"
  aria-label="The Living Book"
>
  <noscript>
    <div class="lbv-contents" style="padding:96px 24px">
      <p class="eye">Vol. 01 · 2026</p>
      <h2>The Living Book</h2>
      <p class="dek">JavaScript is required to turn the pages. Shop the uniform while this edition loads.</p>
      <p><a class="lbv-shop-link" href="/collections/tracksuits">Shop tracksuits →</a></p>
    </div>
  </noscript>
</section>

<script src="{{ 'melato-living-book-vol01.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Living Book Vol. 01",
  "tag": "section",
  "class": "section-living-book-vol01",
  "settings": [
    {
      "type": "checkbox",
      "id": "hide_store_chrome",
      "label": "Hide store header and footer",
      "default": true,
      "info": "Gives the book a full-viewport reading surface. Shop remains reachable from the book chrome."
    }
  ],
  "presets": [
    {
      "name": "Living Book Vol. 01"
    }
  ]
}
{% endschema %}

{% comment %}
  Melato homepage conversion section.
{% endcomment %}
{%- liquid
  assign home_collection = section.settings.featured_collection
  if home_collection == blank
    assign home_collection = collections['all']
  endif
-%}
<section class="melato-home-conversion" id="MelatoHomeConversion-{{ section.id }}">
  <div class="melato-home-conversion__shell">
    <div class="melato-home-conversion__hero">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="melato-home-conversion__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h1 class="melato-home-conversion__title">{{ section.settings.heading }}</h1>
        {% if section.settings.copy != blank %}<p class="melato-home-conversion__copy">{{ section.settings.copy }}</p>{% endif %}
        <div class="melato-home-conversion__ctas">
          <a class="melato-home-conversion__cta" href="{{ section.settings.primary_cta_url | default: routes.all_products_collection_url }}">{{ section.settings.primary_cta_label }}</a>
          <a class="melato-home-conversion__cta-secondary" href="{{ section.settings.secondary_cta_url | default: '/pages/our-story' }}">{{ section.settings.secondary_cta_label }}</a>
        </div>
      </div>
      <div class="melato-home-conversion__proof" aria-label="Melato trust badges">
        <div class="melato-home-conversion__proof-card"><strong>Limited productions</strong><span>Small-batch releases designed to move fast, not sit in mass stock.</span></div>
        <div class="melato-home-conversion__proof-card"><strong>Premium feel</strong><span>Velour, structured panels, embroidery, and retro silhouettes.</span></div>
        <div class="melato-home-conversion__proof-card"><strong>Fast dispatch</strong><span>Clear checkout, smooth shipping, and responsive customer support.</span></div>
        <div class="melato-home-conversion__proof-card"><strong>Secure checkout</strong><span>Shopify checkout with major cards, Shop Pay, Apple Pay, and Google Pay.</span></div>
      </div>
    </div>
    <div class="melato-home-conversion__sections">
      <article class="melato-home-conversion__panel"><p class="melato-section-eyebrow">Limited productions</p><h2>Built in small runs</h2><p>Each release is treated like a capsule: focused colourways, intentional graphics, and no unnecessary overproduction.</p></article>
      <article class="melato-home-conversion__panel"><p class="melato-section-eyebrow">Melato Picks</p><h2>Pieces in Rotation</h2><p>Browse selected pieces from the current Melato rotation, then complete the set with matching jackets and pants.</p></article>
      <article class="melato-home-conversion__panel"><p class="melato-section-eyebrow">Brand Value</p><h2>Culture-forward premium apparel</h2><p>Melato combines retro athletic codes, symbolic graphics, and elevated product photography for a sharper identity.</p></article>
    </div>
    {% if home_collection != blank and home_collection.products_count > 0 %}
      <div class="melato-home-conversion__products" aria-label="Melato picks">
        {% for product in home_collection.products limit: 4 %}
          <a class="melato-home-conversion__product" href="{{ product.url }}">
            {% if product.featured_image != blank %}
              {{ product.featured_image | image_url: width: 900 | image_tag: class: 'melato-home-conversion__product-image', loading: 'lazy', widths: '320, 480, 640, 900', sizes: '(max-width: 749px) 100vw, 25vw', alt: product.featured_image.alt | default: product.title }}
            {% endif %}
            <div class="melato-home-conversion__product-text"><p class="melato-home-conversion__product-title">{{ product.title }}</p><p class="melato-home-conversion__product-price">{{ product.price | money }}</p></div>
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Melato conversion hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited-drop apparel" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Premium retro made to stand out before it sells out." },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "Shop Melato tracksuits and statement pieces built with bold colour-blocking, premium textures, and limited capsule energy." },
    { "type": "text", "id": "primary_cta_label", "label": "Primary CTA label", "default": "Shop the drop" },
    { "type": "url", "id": "primary_cta_url", "label": "Primary CTA URL" },
    { "type": "text", "id": "secondary_cta_label", "label": "Secondary CTA label", "default": "Why Melato" },
    { "type": "url", "id": "secondary_cta_url", "label": "Secondary CTA URL" },
    { "type": "collection", "id": "featured_collection", "label": "Featured product collection" }
  ],
  "presets": [{ "name": "Melato conversion hero" }]
}
{% endschema %}

{% comment %}
  sections/video.liquid
{% endcomment %}

<section id="MelatoVideo-{{ section.id }}" class="section-spacing">
  <div class="{% if section.settings.full_width %}container--full{% else %}container{% endif %}">

    {%- if section.settings.heading != blank -%}
      <h2 class="heading-md drip-reveal" style="margin-bottom:40px;{% if section.settings.center_heading %}text-align:center;{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div
      class="drip-reveal drip-reveal--delay-1 melato-video-frame"
      style="position:relative;overflow:hidden;aspect-ratio:{{ section.settings.aspect_ratio | default: '16/9' }};"
      data-melato-video-frame
    >
      {%- if section.settings.video_url != blank -%}
        <video
          src="{{ section.settings.video_url }}"
          {% if section.settings.autoplay %}autoplay muted loop playsinline{% endif %}
          {% unless section.settings.autoplay %}controls{% endunless %}
          style="width:100%;height:100%;object-fit:cover;"
          aria-label="{{ section.settings.heading | default: 'Video' | escape }}"
          preload="metadata"
          data-melato-video
        >
          Your browser does not support the video tag.
        </video>

        {%- if section.settings.autoplay -%}
          <button
            class="melato-video-sound-toggle"
            type="button"
            aria-label="Turn sound on"
            aria-pressed="false"
            data-melato-sound-toggle
          >
            <span class="visually-hidden" data-melato-sound-label>Turn sound on</span>

            <svg class="melato-video-sound-toggle__icon" data-melato-icon-muted width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M11 5 6.8 8.5H3.5v7h3.3L11 19V5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
              <path d="m16 9 5 5M21 9l-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            </svg>

            <svg class="melato-video-sound-toggle__icon" data-melato-icon-sound width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" hidden>
              <path d="M11 5 6.8 8.5H3.5v7h3.3L11 19V5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
              <path d="M15.2 9.2a4 4 0 0 1 0 5.6M18 6.7a7.4 7.4 0 0 1 0 10.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            </svg>
          </button>
        {%- endif -%}
      {%- elsif section.settings.cover_image != blank -%}
        <img
          src="{{ section.settings.cover_image | image_url: width: 1600 }}"
          alt="{{ section.settings.cover_image.alt | escape }}"
          loading="lazy"
          style="width:100%;height:100%;object-fit:cover;"
        >
        <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(8,8,8,0.3);">
          <div style="width:72px;height:72px;background:var(--color-accent);border-radius:50%;display:flex;align-items:center;justify-content:center;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="var(--color-bg)" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </div>
        </div>
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>

  </div>
</section>

<style>
  #MelatoVideo-{{ section.id }} .melato-video-sound-toggle {
    position: absolute;
    right: clamp(14px, 2vw, 26px);
    bottom: clamp(14px, 2vw, 26px);
    z-index: 3;
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid rgba(255,255,255,0.42);
    border-radius: 999px;
    background: rgba(5,5,5,0.48);
    color: #fff;
    box-shadow: 0 8px 28px rgba(0,0,0,0.22);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    cursor: pointer;
    transition: background 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  #MelatoVideo-{{ section.id }} .melato-video-sound-toggle:hover {
    background: rgba(5,5,5,0.7);
    border-color: rgba(255,255,255,0.72);
    transform: translateY(-1px);
  }

  #MelatoVideo-{{ section.id }} .melato-video-sound-toggle:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  #MelatoVideo-{{ section.id }} .melato-video-sound-toggle__icon {
    width: 20px;
    height: 20px;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    #MelatoVideo-{{ section.id }} .melato-video-sound-toggle {
      width: 44px;
      height: 44px;
      right: 14px;
      bottom: 14px;
    }
  }
</style>

{%- if section.settings.video_url != blank and section.settings.autoplay -%}
  <script>
    (() => {
      const section = document.getElementById('MelatoVideo-{{ section.id }}');
      if (!section) return;

      const video = section.querySelector('[data-melato-video]');
      const button = section.querySelector('[data-melato-sound-toggle]');
      const label = section.querySelector('[data-melato-sound-label]');
      const mutedIcon = section.querySelector('[data-melato-icon-muted]');
      const soundIcon = section.querySelector('[data-melato-icon-sound]');

      if (!video || !button) return;

      const syncSoundState = () => {
        const isMuted = video.muted || video.volume === 0;
        const nextLabel = isMuted ? 'Turn sound on' : 'Mute video';

        button.setAttribute('aria-label', nextLabel);
        button.setAttribute('aria-pressed', String(!isMuted));

        if (label) label.textContent = nextLabel;
        if (mutedIcon) mutedIcon.hidden = !isMuted;
        if (soundIcon) soundIcon.hidden = isMuted;
      };

      button.addEventListener('click', async () => {
        const shouldUnmute = video.muted || video.volume === 0;

        if (shouldUnmute) {
          video.volume = 1;
          video.muted = false;

          try {
            await video.play();
          } catch (error) {
            video.muted = true;
          }
        } else {
          video.muted = true;
        }

        syncSoundState();
      });

      video.addEventListener('volumechange', syncSoundState);
      syncSoundState();
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "center_heading", "label": "Center heading", "default": true },
    { "type": "text", "id": "video_url", "label": "Video URL", "info": "Upload to Files. MP4 or WebM." },
    { "type": "image_picker", "id": "cover_image", "label": "Cover image (if no video)" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay (muted)", "default": false },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "16/9", "label": "Widescreen (16:9)" },
        { "value": "4/3",  "label": "Standard (4:3)" },
        { "value": "1/1",  "label": "Square (1:1)" },
        { "value": "21/9", "label": "Ultrawide (21:9)" }
      ],
      "default": "16/9"
    }
  ],
  "presets": [{ "name": "Video" }]
}
{% endschema %}

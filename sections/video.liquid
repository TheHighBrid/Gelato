{% comment %}
  sections/video.liquid
{% endcomment %}

<section class="section-spacing">
  <div class="{% if section.settings.full_width %}container--full{% else %}container{% endif %}">

    {%- if section.settings.heading != blank -%}
      <h2 class="heading-md drip-reveal" style="margin-bottom:40px;{% if section.settings.center_heading %}text-align:center;{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div
      class="drip-reveal drip-reveal--delay-1"
      style="position:relative;overflow:hidden;aspect-ratio:{{ section.settings.aspect_ratio | default: '16/9' }};"
    >
      {%- if section.settings.video_url != blank -%}
        <video
          src="{{ section.settings.video_url }}"
          {% if section.settings.autoplay %}autoplay muted loop playsinline{% endif %}
          {% unless section.settings.autoplay %}controls{% endunless %}
          style="width:100%;height:100%;object-fit:cover;"
          aria-label="{{ section.settings.heading | default: 'Video' | escape }}"
          preload="metadata"
        >
          Your browser does not support the video tag.
        </video>
      {%- elsif section.settings.cover_image != blank -%}
        <img
          src="{{ section.settings.cover_image | image_url: width: 1600 }}"
          alt="{{ section.settings.cover_image.alt | escape }}"
          loading="lazy"
          style="width:100%;height:100%;object-fit:cover;"
        >
        <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(8,8,8,0.3);">
          <div style="width:72px;height:72px;background:var(--color-accent);border-radius:50%;display:flex;align-items:center;justify-content:center;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="var(--color-bg)" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </div>
        </div>
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "center_heading", "label": "Center heading", "default": true },
    { "type": "text", "id": "video_url", "label": "Video URL", "info": "Upload to Files. MP4 or WebM." },
    { "type": "image_picker", "id": "cover_image", "label": "Cover image (if no video)" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay (muted)", "default": false },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "16/9", "label": "Widescreen (16:9)" },
        { "value": "4/3",  "label": "Standard (4:3)" },
        { "value": "1/1",  "label": "Square (1:1)" },
        { "value": "21/9", "label": "Ultrawide (21:9)" }
      ],
      "default": "16/9"
    }
  ],
  "presets": [{ "name": "Video" }]
}
{% endschema %}

{% comment %}
  Melato - Main Product Section
  v2.3 — Trust Signal Cluster
  - Replaces plain pill badges with a structured 4-signal trust bar
  - Signals: Free shipping threshold | Easy returns | Secure checkout | Estimated delivery
  - Delivery estimate auto-calculates based on today's date + 5–9 business days
  - All signals driven by section settings (editable in Theme Editor)
  - Fully accessible, dark-mode native, mobile optimised
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_image = current_variant.featured_image | default: product.featured_image
  assign form_id = 'product-form-' | append: section.id
  assign size_guide_page = product.metafields.custom.size_guide.value
  assign modal_id = 'sg-modal-' | append: section.id
-%}

<section class="melato-clean-product" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}">
  <div class="melato-clean-product__shell">

    <!-- GALLERY -->
    <div class="melato-clean-product__gallery">
      {% if featured_image != blank %}
        {{ featured_image | image_url: width: 1400 | image_tag:
            class: 'melato-clean-product__image',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '500, 800, 1100, 1400',
            alt: featured_image.alt | default: product.title }}
      {% endif %}
    </div>

    <!-- PRODUCT INFO PANEL -->
    <div class="melato-clean-product__info" id="melato-pdp-info">

      {% if section.settings.show_vendor and product.vendor != blank %}
        <p class="melato-clean-product__vendor">{{ product.vendor }}</p>
      {% endif %}

      <h1 class="melato-clean-product__title">{{ product.title }}</h1>

      <div class="melato-clean-product__price">
        <span class="melato-pdp-price-display">{{ current_variant.price | money }}</span>
        {% if current_variant.compare_at_price > current_variant.price %}
          <s class="melato-pdp-compare-price">{{ current_variant.compare_at_price | money }}</s>
          {%- assign savings = current_variant.compare_at_price | minus: current_variant.price -%}
          <span class="melato-pdp-savings-badge">Save {{ savings | money }}</span>
        {% endif %}
      </div>

      {% form 'product', product, id: form_id, class: 'melato-clean-product__form' %}

        {% unless product.has_only_default_variant %}
          {% for option in product.options_with_values %}
            <fieldset class="melato-clean-product__option">
              <div class="melato-clean-product__option-header">
                <legend>{{ option.name }}</legend>
                {% if option.name == 'Size' or option.name == 'Taille' %}
                  {% if size_guide_page != blank %}
                    <button
                      type="button"
                      class="melato-size-guide-trigger"
                      aria-haspopup="dialog"
                      aria-controls="{{ modal_id }}"
                      aria-expanded="false"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/><path d="M19 3v18"/></svg>
                      Size Guide
                    </button>
                  {% endif %}
                {% endif %}
              </div>
              <div class="melato-clean-product__choices">
                {% for value in option.values %}
                  <label class="melato-clean-product__choice">
                    <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                    <span>{{ value }}</span>
                  </label>
                {% endfor %}
              </div>
            </fieldset>
          {% endfor %}
        {% endunless %}

        <select name="id" class="melato-clean-product__select" aria-label="Select variant">
          {% for variant in product.variants %}
            <option value="{{ variant.id }}" {% if variant == current_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
              {{ variant.title }}{% unless variant.available %} — Sold out{% endunless %}
            </option>
          {% endfor %}
        </select>

        <div class="melato-clean-product__buy">
          <input type="number" name="quantity" min="1" value="1" aria-label="Quantity">
          <button type="submit" name="add" class="melato-pdp-atc-btn" {% unless current_variant.available %}disabled{% endunless %}>
            {% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}
          </button>
        </div>

        <div class="melato-clean-product__dynamic-checkout">
          {{ form | payment_button }}
        </div>

      {% endform %}

      <!-- ================================================
        TRUST SIGNAL CLUSTER v2.3
        4 signals in a 2x2 grid below dynamic checkout.
        Each signal: SVG icon + label + sub-copy.
        Delivery estimate computed client-side in JS.
      ================================================= -->
      <div class="melato-trust-cluster" aria-label="Shopping reassurances">

        {% if section.settings.trust_show_shipping %}
        <div class="melato-trust-cluster__item">
          <div class="melato-trust-cluster__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <div class="melato-trust-cluster__text">
            <span class="melato-trust-cluster__label">{{ section.settings.trust_shipping_label | default: 'Free Shipping' }}</span>
            <span class="melato-trust-cluster__sub">{{ section.settings.trust_shipping_sub | default: 'On orders over $150 CAD' }}</span>
          </div>
        </div>
        {% endif %}

        {% if section.settings.trust_show_returns %}
        <div class="melato-trust-cluster__item">
          <div class="melato-trust-cluster__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.5"/></svg>
          </div>
          <div class="melato-trust-cluster__text">
            <span class="melato-trust-cluster__label">{{ section.settings.trust_returns_label | default: 'Easy Returns' }}</span>
            <span class="melato-trust-cluster__sub">{{ section.settings.trust_returns_sub | default: '14-day return window' }}</span>
          </div>
        </div>
        {% endif %}

        {% if section.settings.trust_show_secure %}
        <div class="melato-trust-cluster__item">
          <div class="melato-trust-cluster__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          </div>
          <div class="melato-trust-cluster__text">
            <span class="melato-trust-cluster__label">{{ section.settings.trust_secure_label | default: 'Secure Checkout' }}</span>
            <span class="melato-trust-cluster__sub">{{ section.settings.trust_secure_sub | default: 'SSL encrypted · PCI compliant' }}</span>
          </div>
        </div>
        {% endif %}

        {% if section.settings.trust_show_delivery %}
        <div class="melato-trust-cluster__item">
          <div class="melato-trust-cluster__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div class="melato-trust-cluster__text">
            <span class="melato-trust-cluster__label">{{ section.settings.trust_delivery_label | default: 'Estimated Delivery' }}</span>
            <span class="melato-trust-cluster__sub melato-trust-delivery-date"
              data-min-days="{{ section.settings.trust_delivery_min | default: 5 }}"
              data-max-days="{{ section.settings.trust_delivery_max | default: 9 }}"
            >Calculating&hellip;</span>
          </div>
        </div>
        {% endif %}

      </div>
      <!-- /TRUST SIGNAL CLUSTER -->

      {% if product.description != blank %}
        <div class="melato-clean-product__description rte">
          {{ product.description }}
        </div>
      {% endif %}

    </div>
    <!-- /PRODUCT INFO PANEL -->

  </div>
</section>

<!-- SIZE GUIDE MODAL -->
{% if size_guide_page != blank %}
<div class="melato-sg-modal" id="{{ modal_id }}" role="dialog" aria-modal="true" aria-label="Melato Size Guide" aria-hidden="true">
  <div class="melato-sg-modal__backdrop" data-sg-close></div>
  <div class="melato-sg-modal__panel">
    <div class="melato-sg-modal__header">
      <span class="melato-sg-modal__eyebrow">Melato</span>
      <h2 class="melato-sg-modal__title">Size Guide</h2>
      <button class="melato-sg-modal__close" type="button" data-sg-close aria-label="Close size guide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="melato-sg-modal__body">
      {{ size_guide_page.content }}
      <div class="melato-sg-modal__footer-link">
        <a href="{{ size_guide_page.url }}" target="_blank" rel="noopener" class="melato-sg-modal__fullpage-link">
          Open full page
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      </div>
    </div>
  </div>
</div>
{% endif %}

<!-- MOBILE STICKY BAR -->
<div class="melato-mobile-sticky-bar" id="melato-sticky-bar" aria-hidden="true">
  <div class="melato-mobile-sticky-bar__inner">
    <div class="melato-mobile-sticky-bar__meta">
      <span class="melato-mobile-sticky-bar__title">{{ product.title | truncate: 28 }}</span>
      <span class="melato-mobile-sticky-bar__price">{{ current_variant.price | money }}</span>
    </div>
    <button
      class="melato-mobile-sticky-bar__btn"
      onclick="document.getElementById('{{ form_id }}').querySelector('[name=add]').click()"
      {% unless current_variant.available %}disabled{% endunless %}
    >
      {% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}
    </button>
  </div>
</div>

<script>
(function(){
  var section  = document.querySelector('[data-section-id="{{ section.id }}"]');
  if(!section) return;
  var select   = section.querySelector('.melato-clean-product__select');
  var radios   = section.querySelectorAll('.melato-clean-product__choice input');
  var variants = {{ product.variants | json }};

  // ── Variant selector ────────────────────────────────────
  function selectedOptions(){
    var out=[];
    section.querySelectorAll('.melato-clean-product__option').forEach(function(g){
      var c=g.querySelector('input:checked');
      out.push(c?c.value:null);
    });
    return out;
  }
  function findVariant(){
    var opts=selectedOptions();
    return variants.find(function(v){
      return v.options.every(function(o,i){return opts[i]===o;});
    });
  }
  radios.forEach(function(r){
    r.addEventListener('change',function(){
      var v=findVariant();
      if(v&&select) select.value=v.id;
      if(v){
        document.querySelectorAll('.melato-pdp-price-display,.melato-mobile-sticky-bar__price').forEach(function(el){el.textContent=fmt(v.price);});
        document.querySelectorAll('.melato-pdp-atc-btn,.melato-mobile-sticky-bar__btn').forEach(function(btn){
          btn.disabled=!v.available;
          btn.textContent=v.available?'Add to cart':'Sold out';
        });
      }
    });
  });
  function fmt(cents){return '$'+(cents/100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g,',');}

  // ── Sticky ATC bar (all screen sizes) ──────────────────
  var bar=document.getElementById('melato-sticky-bar');
  var atc=section.querySelector('.melato-clean-product__buy');
  if(bar&&atc){
    new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        bar.classList.toggle('is-visible',!e.isIntersecting);
        bar.setAttribute('aria-hidden',e.isIntersecting?'true':'false');
      });
    },{threshold:0.2}).observe(atc);
  }

  // ── Size guide modal ────────────────────────────────────
  var modal=document.getElementById('{{ modal_id }}');
  var trigs=section.querySelectorAll('.melato-size-guide-trigger');
  if(modal&&trigs.length){
    var fp='button,[href],input,select,textarea,[tabindex]:not([tabindex="-1"])';
    function openSG(){
      modal.setAttribute('aria-hidden','false');
      modal.classList.add('is-open');
      document.body.classList.add('sg-modal-open');
      var cb=modal.querySelector('.melato-sg-modal__close');
      if(cb) cb.focus();
      trigs.forEach(function(t){t.setAttribute('aria-expanded','true');});
    }
    function closeSG(){
      modal.setAttribute('aria-hidden','true');
      modal.classList.remove('is-open');
      document.body.classList.remove('sg-modal-open');
      trigs.forEach(function(t){t.setAttribute('aria-expanded','false');t.focus();});
    }
    trigs.forEach(function(t){t.addEventListener('click',openSG);});
    modal.querySelectorAll('[data-sg-close]').forEach(function(el){el.addEventListener('click',closeSG);});
    document.addEventListener('keydown',function(e){if(e.key==='Escape'&&modal.classList.contains('is-open'))closeSG();});
    modal.addEventListener('keydown',function(e){
      if(e.key!=='Tab') return;
      var els=Array.from(modal.querySelectorAll(fp));
      if(!els.length) return;
      if(e.shiftKey){if(document.activeElement===els[0]){e.preventDefault();els[els.length-1].focus();}}
      else{if(document.activeElement===els[els.length-1]){e.preventDefault();els[0].focus();}}
    });
  }

  // ── Delivery date estimate ──────────────────────────────
  // NOTE: Skips weekends only (Sat/Sun). Does not account for public holidays
  // or regional delivery variations — the displayed range is a best-effort estimate.
  // Data attributes on the span drive the range (set via section settings).
  (function(){
    var el=document.querySelector('.melato-trust-delivery-date');
    if(!el) return;
    var minDays=parseInt(el.dataset.minDays||'5',10);
    var maxDays=parseInt(el.dataset.maxDays||'9',10);
    var MONTHS=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    function addBizDays(date,n){
      var d=new Date(date);
      var added=0;
      while(added<n){
        d.setDate(d.getDate()+1);
        var day=d.getDay();
        if(day!==0&&day!==6) added++;
      }
      return d;
    }
    var now=new Date();
    var earliest=addBizDays(now,minDays);
    var latest=addBizDays(now,maxDays);
    var label;
    if(earliest.getMonth()===latest.getMonth()){
      label=MONTHS[earliest.getMonth()]+' '+earliest.getDate()+'–'+latest.getDate();
    } else {
      label=MONTHS[earliest.getMonth()]+' '+earliest.getDate()+' – '+MONTHS[latest.getMonth()]+' '+latest.getDate();
    }
    el.textContent=label;
  })();

})();
</script>

<style>
/* ── Base PDP ───────────────────────────────────────────── */
.melato-clean-product{background:#080808;color:#f5f1e8;padding:32px 0 64px}
.melato-clean-product__shell{width:min(1320px,calc(100% - 32px));margin:0 auto;display:grid;grid-template-columns:1.08fr .92fr;gap:28px;align-items:start}
.melato-clean-product__gallery,.melato-clean-product__info{background:#111214;border:1px solid rgba(255,255,255,.1);border-radius:24px;box-shadow:0 18px 50px rgba(0,0,0,.25)}
.melato-clean-product__gallery{padding:12px;overflow:hidden}
.melato-clean-product__image{display:block;width:100%;height:auto;border-radius:18px}
.melato-clean-product__info{padding:26px;position:sticky;top:20px;max-height:calc(100vh - 40px);overflow-y:auto;scrollbar-width:none}
.melato-clean-product__info::-webkit-scrollbar{display:none}
/* ── Vendor / Title / Price ──────────────────────────── */
.melato-clean-product__vendor{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#d3a74a;margin:0 0 10px}
.melato-clean-product__title{font-size:clamp(34px,5vw,62px);line-height:.95;text-transform:uppercase;letter-spacing:-.04em;margin:0 0 14px}
.melato-clean-product__price{display:flex;gap:12px;align-items:baseline;font-size:26px;font-weight:900;margin-bottom:24px;flex-wrap:wrap}
.melato-clean-product__price s{font-size:16px;color:#9b968d}
.melato-pdp-savings-badge{font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;background:rgba(158,24,36,.18);color:#f0717b;border:1px solid rgba(158,24,36,.35);border-radius:8px;padding:3px 8px;align-self:center}
/* ── Options ──────────────────────────────────────────── */
.melato-clean-product__option{border:0;margin:0 0 18px;padding:0}
.melato-clean-product__option-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.melato-clean-product__option-header legend{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#d3a74a;float:none;padding:0}
.melato-size-guide-trigger{display:inline-flex;align-items:center;gap:5px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#d3a74a;background:none;border:none;border-bottom:1px solid rgba(211,167,74,.4);padding:0 0 1px;cursor:pointer;transition:color .2s,border-color .2s;line-height:1.2}
.melato-size-guide-trigger:hover{color:#f5f1e8;border-color:rgba(245,241,232,.4)}
.melato-size-guide-trigger svg{flex-shrink:0;opacity:.7}
.melato-clean-product__choices{display:flex;gap:8px;flex-wrap:wrap}
.melato-clean-product__choice input{position:absolute;opacity:0}
.melato-clean-product__choice span{display:block;min-width:52px;text-align:center;padding:12px 14px;border-radius:14px;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.05);cursor:pointer;transition:border-color .2s,background .2s}
.melato-clean-product__choice input:checked+span{border-color:#d3a74a;background:rgba(255,255,255,.12)}
.melato-clean-product__choice input:focus-visible+span{outline:2px solid #d3a74a;outline-offset:2px}
.melato-clean-product__select{width:100%;min-height:48px;margin-bottom:12px;border-radius:14px;background:#171717;color:#f5f1e8;border:1px solid rgba(255,255,255,.15);padding:0 12px}
/* ── Buy Row ──────────────────────────────────────────── */
.melato-clean-product__buy{display:grid;grid-template-columns:84px 1fr;gap:10px}
.melato-clean-product__buy input,.melato-clean-product__buy button{min-height:54px;border-radius:16px;border:0}
.melato-clean-product__buy input{text-align:center;background:#171717;color:#f5f1e8;border:1px solid rgba(255,255,255,.14)}
.melato-clean-product__buy button{background:#9e1824;color:#fff;font-weight:900;text-transform:uppercase;letter-spacing:.08em;transition:background .2s,transform .15s}
.melato-clean-product__buy button:hover:not(:disabled){background:#b81e2c;transform:translateY(-1px)}
.melato-clean-product__buy button:disabled{opacity:.5;cursor:not-allowed}
/* ── Dynamic Checkout ─────────────────────────────────── */
.melato-clean-product__dynamic-checkout{margin-top:12px}
.melato-clean-product__dynamic-checkout .shopify-payment-button__button{border-radius:16px!important;min-height:50px!important;font-weight:700!important;letter-spacing:.05em!important}
/* ── Trust Signal Cluster ─────────────────────────────── */
.melato-trust-cluster{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:1px;
  margin:20px 0;
  border:1px solid rgba(255,255,255,.08);
  border-radius:18px;
  overflow:hidden;
  background:rgba(255,255,255,.08);
}
.melato-trust-cluster__item{
  display:flex;
  align-items:flex-start;
  gap:11px;
  padding:14px 16px;
  background:#111214;
  transition:background .2s;
}
.melato-trust-cluster__item:hover{background:#161719}
/* Round corners on the four outer cells */
.melato-trust-cluster__item:nth-child(1){border-radius:17px 0 0 0}
.melato-trust-cluster__item:nth-child(2){border-radius:0 17px 0 0}
.melato-trust-cluster__item:nth-child(3){border-radius:0 0 0 17px}
.melato-trust-cluster__item:nth-child(4){border-radius:0 0 17px 0}
/* Single-item fallback */
.melato-trust-cluster__item:only-child{border-radius:17px}
.melato-trust-cluster__icon{
  flex-shrink:0;
  width:36px;
  height:36px;
  background:rgba(211,167,74,.1);
  border-radius:10px;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#d3a74a;
  margin-top:1px;
}
.melato-trust-cluster__text{
  display:flex;
  flex-direction:column;
  gap:2px;
  min-width:0;
}
.melato-trust-cluster__label{
  font-size:11px;
  font-weight:700;
  letter-spacing:.1em;
  text-transform:uppercase;
  color:#f5f1e8;
  line-height:1.2;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.melato-trust-cluster__sub{
  font-size:11px;
  color:#9b968d;
  letter-spacing:.02em;
  line-height:1.4;
}
/* ── Description ──────────────────────────────────────── */
.melato-clean-product__description{line-height:1.7;color:#d8d0c4;border-top:1px solid rgba(255,255,255,.1);padding-top:18px}
/* ── Size Guide Modal ─────────────────────────────────── */
.melato-sg-modal{display:none;position:fixed;inset:0;z-index:600;align-items:center;justify-content:center;padding:20px}
.melato-sg-modal.is-open{display:flex}
.melato-sg-modal__backdrop{position:absolute;inset:0;background:rgba(0,0,0,.78);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);cursor:pointer}
.melato-sg-modal__panel{position:relative;z-index:1;background:#111214;border:1px solid rgba(255,255,255,.12);border-radius:24px;width:min(680px,100%);max-height:88vh;display:flex;flex-direction:column;box-shadow:0 32px 80px rgba(0,0,0,.6);animation:sgSlideUp .3s cubic-bezier(.25,.46,.45,.94)}
@keyframes sgSlideUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
.melato-sg-modal__header{display:flex;align-items:center;gap:12px;padding:20px 24px 16px;border-bottom:1px solid rgba(255,255,255,.08);flex-shrink:0}
.melato-sg-modal__eyebrow{font-size:10px;letter-spacing:.25em;text-transform:uppercase;color:#d3a74a;flex:1}
.melato-sg-modal__title{font-size:18px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#f5f1e8;margin:0}
.melato-sg-modal__close{margin-left:auto;width:36px;height:36px;display:flex;align-items:center;justify-content:center;border-radius:50%;border:1px solid rgba(255,255,255,.12);color:#9b968d;background:none;cursor:pointer;transition:border-color .2s,color .2s;flex-shrink:0}
.melato-sg-modal__close:hover{border-color:#d3a74a;color:#d3a74a}
.melato-sg-modal__body{overflow-y:auto;padding:24px;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.1) transparent;color:#d8d0c4;line-height:1.7;font-size:14px}
.melato-sg-modal__body table{width:100%;border-collapse:collapse;margin:16px 0;font-size:13px}
.melato-sg-modal__body th{text-align:left;padding:10px 12px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#d3a74a;border-bottom:1px solid rgba(255,255,255,.1)}
.melato-sg-modal__body td{padding:10px 12px;border-bottom:1px solid rgba(255,255,255,.06);color:#d8d0c4}
.melato-sg-modal__body tr:hover td{color:#f5f1e8}
.melato-sg-modal__body h2,.melato-sg-modal__body h3{font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:#f5f1e8;margin:20px 0 10px}
.melato-sg-modal__body p{margin:0 0 12px;color:#9b968d;font-size:13px}
.melato-sg-modal__body strong{color:#f5f1e8}
.melato-sg-modal__footer-link{padding-top:16px;border-top:1px solid rgba(255,255,255,.06);margin-top:8px}
.melato-sg-modal__fullpage-link{display:inline-flex;align-items:center;gap:5px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#d3a74a;text-decoration:none;transition:color .2s}
.melato-sg-modal__fullpage-link:hover{color:#f5f1e8}
body.sg-modal-open{overflow:hidden}
/* ── Sticky ATC Bar (all viewports) ──────────────────── */
.melato-mobile-sticky-bar{display:block;position:fixed;bottom:0;left:0;right:0;z-index:300;background:#0e0e0f;border-top:1px solid rgba(255,255,255,.12);padding:12px 16px;padding-bottom:max(12px,env(safe-area-inset-bottom));box-shadow:0 -6px 32px rgba(0,0,0,.45);transform:translateY(100%);transition:transform .3s cubic-bezier(.25,.46,.45,.94)}
.melato-mobile-sticky-bar.is-visible{transform:translateY(0)}
.melato-mobile-sticky-bar__inner{display:flex;align-items:center;gap:12px;max-width:600px;margin:0 auto}
.melato-mobile-sticky-bar__meta{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
.melato-mobile-sticky-bar__title{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#f5f1e8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.melato-mobile-sticky-bar__price{font-size:18px;font-weight:900;color:#d3a74a;letter-spacing:.02em}
.melato-mobile-sticky-bar__btn{flex-shrink:0;min-width:140px;height:50px;background:#9e1824;color:#fff;font-weight:900;font-size:13px;text-transform:uppercase;letter-spacing:.08em;border:0;border-radius:14px;cursor:pointer;transition:background .2s;white-space:nowrap}
.melato-mobile-sticky-bar__btn:hover:not(:disabled){background:#b81e2c}
.melato-mobile-sticky-bar__btn:disabled{opacity:.5;cursor:not-allowed}
/* ── Responsive ───────────────────────────────────────── */
@media(max-width:900px){
  .melato-clean-product__shell{grid-template-columns:1fr}
  .melato-clean-product__info{position:static;max-height:none;overflow-y:visible}
  .melato-clean-product__buy{grid-template-columns:76px 1fr}
  .melato-clean-product{padding-bottom:100px}
  .melato-trust-cluster{grid-template-columns:1fr 1fr}
  .melato-trust-cluster__label{font-size:10px}
  .melato-trust-cluster__sub{font-size:10px}
  .melato-sg-modal{padding:0;align-items:flex-end}
  .melato-sg-modal__panel{width:100%;border-radius:24px 24px 0 0;max-height:92vh}
}
@media(max-width:380px){
  .melato-trust-cluster{grid-template-columns:1fr}
  .melato-trust-cluster__item:nth-child(1){border-radius:17px 17px 0 0}
  .melato-trust-cluster__item:nth-child(2){border-radius:0}
  .melato-trust-cluster__item:nth-child(3){border-radius:0}
  .melato-trust-cluster__item:nth-child(4){border-radius:0 0 17px 17px}
}
</style>

{% render 'melato-product-jsonld', product: product %}

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "header",
      "content": "Trust Signals"
    },
    {
      "type": "checkbox",
      "id": "trust_show_shipping",
      "label": "Show shipping signal",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_shipping_label",
      "label": "Shipping — label",
      "default": "Free Shipping"
    },
    {
      "type": "text",
      "id": "trust_shipping_sub",
      "label": "Shipping — sub-copy",
      "default": "On orders over $150 CAD"
    },
    {
      "type": "checkbox",
      "id": "trust_show_returns",
      "label": "Show returns signal",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_returns_label",
      "label": "Returns — label",
      "default": "Easy Returns"
    },
    {
      "type": "text",
      "id": "trust_returns_sub",
      "label": "Returns — sub-copy",
      "default": "14-day return window"
    },
    {
      "type": "checkbox",
      "id": "trust_show_secure",
      "label": "Show secure checkout signal",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_secure_label",
      "label": "Secure — label",
      "default": "Secure Checkout"
    },
    {
      "type": "text",
      "id": "trust_secure_sub",
      "label": "Secure — sub-copy",
      "default": "SSL encrypted \u00b7 PCI compliant"
    },
    {
      "type": "checkbox",
      "id": "trust_show_delivery",
      "label": "Show delivery estimate signal",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_delivery_label",
      "label": "Delivery — label",
      "default": "Estimated Delivery"
    },
    {
      "type": "range",
      "id": "trust_delivery_min",
      "label": "Delivery — min business days",
      "min": 1,
      "max": 14,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "trust_delivery_max",
      "label": "Delivery — max business days",
      "min": 1,
      "max": 21,
      "step": 1,
      "default": 9
    }
  ]
}
{% endschema %}
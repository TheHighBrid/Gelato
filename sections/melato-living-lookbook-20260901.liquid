{% endcapture %}
{% assign evidence_items = evidence_manifest | strip | split: '~' %}

<section
  id="MelatoEvidenceArchive-{{ section.id }}"
  class="mea"
  data-evidence-archive
  data-case-code="LL-04"
  aria-labelledby="MelatoEvidenceTitle-{{ section.id }}"
>
  <div class="mea__masthead">
    <div class="mea__masthead-rule" aria-hidden="true"></div>
    <div class="mea__masthead-grid">
      <div class="mea__identity">
        <p class="mea__eyebrow">MELATO / LIVING LOOKBOOK</p>
        <h2 id="MelatoEvidenceTitle-{{ section.id }}" class="mea__title">
          <span>CASE FILE 04</span>
          SEPTEMBER SIGHTINGS
        </h2>
      </div>
      <div class="mea__brief">
        <p>Nine newly filed living studies from Meknes, Rabat, Ottawa, Toronto and Montreal.</p>
        <dl class="mea__registry">
          <div><dt>Filed</dt><dd>01 SEP 2026</dd></div>
          <div><dt>Volume</dt><dd>{{ evidence_items.size }} FRAMES</dd></div>
          <div><dt>Status</dt><dd>AUTHORIZED VIEWING</dd></div>
        </dl>
      </div>
    </div>
    <div class="mea__custody">
      <span>ARCHIVE 2026</span>
      <span>CASE / LL-04</span>
      <span>CLICK ANY EXHIBIT TO INSPECT</span>
    </div>
  </div>

  <div class="mea__board-shell">
    <aside class="mea__case-note" aria-label="Case narrative">
      <span>INVESTIGATOR'S NOTE / LL-04</span>
      <p>Five cities, nine sightings. The record moves from interiors to streets, from velour to evening silhouettes, without leaving the Melato frame.</p>
    </aside>

    <div class="mea__board" role="list" aria-label="Case File 04 Living Lookbook evidence archive">
      {% for record in evidence_items %}
        {% assign fields = record | strip | split: '|' %}
        {% assign image_url = fields[0] | strip %}
        {% assign image_width = fields[1] | strip %}
        {% assign image_height = fields[2] | strip %}
        {% assign image_kind = fields[3] | strip %}
        {% assign image_alt = fields[4] | strip %}
        {% assign evidence_number = forloop.index %}

        {% if evidence_number == 1 %}
          <div class="mea__chapter" role="listitem">
            <span>CHAPTER 01 / NEW FILES</span>
            <h3>The archive crosses cities.</h3>
            <p>Frames added and renamed on September 1, 2026, filed as one controlled Living Lookbook batch.</p>
          </div>
        {% endif %}

        {% capture evidence_code %}{% if evidence_number < 10 %}0{% endif %}{{ evidence_number }}{% endcapture %}
        {% assign evidence_code = evidence_code | strip %}
        {% assign image_480 = image_url | append: '&width=480' %}
        {% assign image_760 = image_url | append: '&width=760' %}
        {% assign image_1100 = image_url | append: '&width=1100' %}
        {% assign image_full = image_url | append: '&width=2200' %}

        <figure class="mea__evidence mea__evidence--{{ image_kind }} mea__evidence--pattern-{{ forloop.index | modulo: 9 }}" role="listitem">
          <button
            type="button"
            class="mea__open"
            data-evidence-open
            data-evidence-index="{{ forloop.index0 }}"
            data-evidence-full="{{ image_full | escape }}"
            data-evidence-code="{{ evidence_code }}"
            aria-label="Inspect Case File 04 evidence frame {{ evidence_code }}"
          >
            <span class="mea__mount mea__mount--top" aria-hidden="true"></span>
            <span class="mea__mount mea__mount--side" aria-hidden="true"></span>
            <span class="mea__image-well">
              <img
                src="{{ image_760 | escape }}"
                srcset="{{ image_480 | escape }} 480w, {{ image_760 | escape }} 760w, {{ image_1100 | escape }} 1100w"
                sizes="(min-width: 1280px) 22vw, (min-width: 900px) 29vw, (min-width: 600px) 44vw, 88vw"
                width="{{ image_width }}"
                height="{{ image_height }}"
                alt="{{ image_alt | escape }}"
                loading="lazy"
                decoding="async"
              >
            </span>
          </button>

          <figcaption class="mea__caption">
            <span class="mea__caption-primary">EXHIBIT {{ evidence_code }}</span>
            <span class="mea__caption-secondary">
              {% if image_kind == 'fragment' %}CONTACT FRAGMENT{% elsif image_kind == 'master' %}MASTER PRINT{% else %}LIVING STUDY{% endif %}
            </span>
            <span class="mea__caption-code">LL-04 / {{ evidence_code }}</span>
          </figcaption>

          <span class="mea__stamp" aria-hidden="true">FILED</span>
        </figure>
      {% endfor %}
    </div>
  </div>

  <footer class="mea__footer">
    <p>THE LIVING LOOKBOOK / DOCUMENTING GARMENTS IN MOTION, MEMORY AND PLACE.</p>
    <p>END OF CASE FILE 04 / LL-04 / {{ evidence_items.size }} EXHIBITS</p>
  </footer>

  <div
    class="mea__viewer"
    data-evidence-viewer
    role="dialog"
    aria-modal="true"
    aria-label="Case File 04 evidence image viewer"
    aria-hidden="true"
    hidden
  >
    <button type="button" class="mea__viewer-close" data-evidence-close aria-label="Close evidence viewer"><span aria-hidden="true">×</span></button>
    <button type="button" class="mea__viewer-nav mea__viewer-nav--previous" data-evidence-previous aria-label="Previous evidence frame"><span aria-hidden="true">←</span></button>
    <figure class="mea__viewer-figure">
      <div class="mea__viewer-mat"><img data-evidence-viewer-image src="" alt=""></div>
      <figcaption class="mea__viewer-caption"><span data-evidence-viewer-label>EXHIBIT 01</span><span>CASE / LL-04</span></figcaption>
    </figure>
    <button type="button" class="mea__viewer-nav mea__viewer-nav--next" data-evidence-next aria-label="Next evidence frame"><span aria-hidden="true">→</span></button>
    <p class="mea__viewer-counter" data-evidence-counter>01 / {{ evidence_items.size }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Living Lookbook Sep 01",
  "tag": "section",
  "class": "section-living-lookbook-evidence",
  "settings": [],
  "presets": [
    {
      "name": "Living Lookbook Sep 01"
    }
  ]
}
{% endschema %}

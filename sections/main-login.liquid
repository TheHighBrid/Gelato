{% comment %}
  sections/main-login.liquid
  Customer authentication, styled as a restrained Melato private-access surface.
{% endcomment %}

<section class="melato-auth" aria-labelledby="MelatoLoginTitle-{{ section.id }}">
  <div class="melato-auth__grid">
    <header class="melato-auth__intro">
      <p class="melato-auth__eyebrow">Account / Private access</p>
      <h1 id="MelatoLoginTitle-{{ section.id }}" class="melato-auth__title">Sign In</h1>
      <p class="melato-auth__note">Access order history, saved delivery details and the account attached to your Melato purchases.</p>
    </header>

    <div class="melato-auth__form">
      {%- form 'customer_login' -%}
        {%- if form.errors -%}
          <div class="melato-form-error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="melato-field">
          <label for="customer-email">Email address</label>
          <input type="email" name="customer[email]" id="customer-email" autocomplete="email" autocapitalize="off" required>
        </div>

        <div class="melato-field">
          <label for="customer-password">Password</label>
          <input type="password" name="customer[password]" id="customer-password" autocomplete="current-password" required>
        </div>

        <a href="{{ routes.account_recover_url }}" class="melato-auth__secondary-link">Forgot your password?</a>

        <div class="melato-auth__actions">
          <button type="submit" class="melato-house-button">Sign in</button>
          <a href="{{ routes.account_register_url }}" class="melato-house-button melato-house-button--secondary">Create account</a>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Login", "tag": "section", "settings": [] }
{% endschema %}

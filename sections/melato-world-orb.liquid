            "link": "/pages/contact",
            "lat": 12,
            "lon": 300
          }
        },
        {
          "type": "location",
          "settings": {
            "loc_id": "radio",
            "title": "Melato Radio",
            "kicker": "Frequency",
            "blurb": "The house frequency. Sound from the atelier — a listening room for the world of Melato.",
            "link": "/pages/our-story",
            "lat": -20,
            "lon": 348
          }
        }
      ]
    }
  ]
}
{% endschema %}

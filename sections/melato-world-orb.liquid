            "link": "/pages/living-lookbook",
            "lat": 22,
            "lon": 18
          }
        },
        {
          "type": "location",
          "settings": {
            "loc_id": "ready-to-wear",
            "title": "Ready To Wear",
            "kicker": "The Uniform",
            "blurb": "Limited-run apparel, tailored for movement and cut with intent. Tracksuits, denim, the daily house language.",
            "link": "/collections/new-arrivals",
            "lat": 6,
            "lon": 72
          }
        },
        {
          "type": "location",
          "settings": {
            "loc_id": "accessories",
            "title": "Accessories",
            "kicker": "Finishing",
            "blurb": "Bags, lenses, chain wallets, and the last decisions. Small objects that complete the look.",
            "link": "/collections/accessories",
            "lat": -16,
            "lon": 128
          }
        },
        {
          "type": "location",
          "settings": {
            "loc_id": "editorial",
            "title": "Editorial",
            "kicker": "Journal",
            "blurb": "Notes from the house. Process, references, and the culture that wears us.",
            "link": "/blogs/news",
            "lat": 34,
            "lon": 196
          }
        },
        {
          "type": "location",
          "settings": {
            "loc_id": "popup",
            "title": "Pop-Up Show & Events",
            "kicker": "Coordinates",
            "blurb": "Physical appearances. Popup calendar, showings, and the house in a room.",
            "link": "/pages/popup-calendar",
            "lat": -28,

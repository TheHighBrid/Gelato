{% liquid
  assign issue_title = section.settings.issue_title | default: 'The Uniform in Motion'
  assign issue_volume = section.settings.issue_volume | default: 'Vol. 01'
  assign issue_deck = section.settings.issue_deck | default: 'A uniform made for the distance between a quiet room, the platform and last call.'
  assign issue_code = section.settings.issue_code | default: 'Toronto / 2026 / 21:40'
  assign archive_initial_count = section.settings.archive_initial_count | default: 12
  assign archive_start = 17
  assign archive_maximum = 24
  assign archive_end = archive_start | plus: archive_maximum | minus: 1

  capture journal_manifest
    render 'melato-living-lookbook-evidence-data'
    echo '~'
    render 'melato-living-lookbook-evidence-case02-additions'
    echo '~'
    render 'melato-living-lookbook-evidence-case03-data'
  endcapture
  assign journal_records = journal_manifest | strip | split: '~'

  assign first_record = journal_records.first | strip | split: '|'
  assign fallback_cover_url = first_record[0] | strip
%}

{{ 'melato-living-field-journal.js' | asset_url | script_tag }}

<section
  id="FieldJournal-{{ section.id }}"
  class="fj"
  data-field-journal
  aria-labelledby="FieldJournalTitle-{{ section.id }}"
>
  <style>
    #shopify-section-{{ section.id }} { background: #0e0d0c; }

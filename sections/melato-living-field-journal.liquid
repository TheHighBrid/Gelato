      #shopify-section-{{ section.id }} .fj__cover-media::after { background: linear-gradient(0deg, rgba(14,13,12,.93), rgba(14,13,12,.22) 74%), linear-gradient(90deg, rgba(14,13,12,.35), transparent); }
      #shopify-section-{{ section.id }} .fj__cover-grid,
      #shopify-section-{{ section.id }} .fj__chapter-head,
      #shopify-section-{{ section.id }} .fj__archive-head,
      #shopify-section-{{ section.id }} .fj__shop-head,
      #shopify-section-{{ section.id }} .fj__close-inner,
      #shopify-section-{{ section.id }} .fj__viewer-content { grid-template-columns: 1fr; }
      #shopify-section-{{ section.id }} .fj__cover-notes { border-left: 0; border-top: 1px solid var(--fj-line); padding: 17px 0 0; margin-top: 16px; }
      #shopify-section-{{ section.id }} .fj__issue-title { font-size: clamp(61px, 18vw, 96px); }
      #shopify-section-{{ section.id }} .fj__index-rail { top: 0; }
      #shopify-section-{{ section.id }} .fj__index-rail a { font-size: 9px; padding: 14px 16px; }
      #shopify-section-{{ section.id }} .fj__spread-grid { display: block; }
      #shopify-section-{{ section.id }} .fj__spread,
      #shopify-section-{{ section.id }} .fj__spread:nth-child(n) { margin: 0 0 32px; }
      #shopify-section-{{ section.id }} .fj__image-wrap,
      #shopify-section-{{ section.id }} .fj__spread:nth-child(n) .fj__image-wrap { aspect-ratio: 4 / 5; }
      #shopify-section-{{ section.id }} .fj__spread:nth-child(4n + 1) .fj__image-wrap { aspect-ratio: 3 / 4; }
      #shopify-section-{{ section.id }} .fj__archive-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 13px; }
      #shopify-section-{{ section.id }} .fj__shop-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      #shopify-section-{{ section.id }} .fj__shop-card a { padding: 10px; }
      #shopify-section-{{ section.id }} .fj__shop-card strong { font-size: 13px; }
      #shopify-section-{{ section.id }} .fj__close-meta { justify-content: flex-start; }
      #shopify-section-{{ section.id }} .fj__drawer { align-items: end; padding: 0; }
      #shopify-section-{{ section.id }} .fj__drawer-panel { width: 100%; min-height: 72svh; border-radius: 18px 18px 0 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} .fj *,
      #shopify-section-{{ section.id }} .fj *::before,
      #shopify-section-{{ section.id }} .fj *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; }
    }
  </style>

  <header class="fj__masthead" aria-label="Melato Living issue header">
    <a href="{{ routes.root_url }}">Menu</a>
    <a class="fj__wordmark" href="{{ routes.root_url }}" aria-label="Melato home">Melato</a>
    <div class="fj__masthead-end"><a href="{{ routes.search_url }}">Search</a><a href="{{ routes.cart_url }}">Bag ({{ cart.item_count }})</a></div>
  </header>

  <div class="fj__cover">
    <div class="fj__cover-media">
      {% if section.settings.cover_image != blank %}
        {{ section.settings.cover_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1600, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.cover_alt }}
      {% elsif fallback_cover_url != blank %}
        <img src="{{ fallback_cover_url | append: '&width=2000' | escape }}" srcset="{{ fallback_cover_url | append: '&width=750' | escape }} 750w, {{ fallback_cover_url | append: '&width=1200' | escape }} 1200w, {{ fallback_cover_url | append: '&width=2000' | escape }} 2000w" sizes="100vw" width="{{ first_record[1] | escape }}" height="{{ first_record[2] | escape }}" loading="eager" fetchpriority="high" alt="{{ section.settings.cover_alt | default: 'Melato Living Volume 01 editorial portrait' | escape }}">
      {% endif %}
    </div>
    <div class="fj__cover-grid">
      <div>
        <span class="fj__eyebrow">Melato Living / {{ issue_volume | escape }}</span>
        <h1 id="FieldJournalTitle-{{ section.id }}" class="fj__issue-title">{{ issue_title | escape }}<span>{{ issue_volume | escape }}</span></h1>
        <p class="fj__deck">{{ issue_deck | escape }}</p>
        <div class="fj__cover-actions">
          <a class="fj__button fj__button--solid" href="#FieldJournalRead-{{ section.id }}">Read the issue</a>
          <a class="fj__button fj__button--ghost" href="#FieldJournalShop-{{ section.id }}">Shop the issue</a>
          <a class="fj__button fj__button--ghost" href="#FieldJournalArchive-{{ section.id }}">Open archive</a>
        </div>
      </div>
      <aside class="fj__cover-notes" aria-label="Issue details">
        <span class="fj__kicker">Issue note</span>
        <p>{{ section.settings.cover_note | default: 'A field journal of silhouette, transit and after-hours ritual—filed as a sequence rather than a catalogue.' | escape }}</p>
        <dl>
          <div><dt>Filed</dt><dd>{{ issue_code | escape }}</dd></div>
          <div><dt>Creative credits</dt><dd>{{ section.settings.credits | default: 'Melato Studio' | escape }}</dd></div>
        </dl>
      </aside>
    </div>
  </div>

  <nav class="fj__index-rail" aria-label="Issue chapters" data-chapter-navigation>
    <a href="#FieldJournalRead-{{ section.id }}" data-chapter-link="1">01 / First Light</a>
    <a href="#FieldJournalChapter2-{{ section.id }}" data-chapter-link="2">02 / In Transit</a>
    <a href="#FieldJournalChapter3-{{ section.id }}" data-chapter-link="3">03 / After Hours</a>
    <a href="#FieldJournalChapter4-{{ section.id }}" data-chapter-link="4">04 / Filed Under</a>
    <a href="#FieldJournalShop-{{ section.id }}">Shop</a>
  </nav>

  {% for chapter in (1..4) %}
    {% liquid
      if chapter == 1
        assign chapter_start = 1
        assign chapter_end = 4
        assign chapter_number = '01'
        assign chapter_title = section.settings.chapter_1_title | default: 'First Light'
        assign chapter_deck = section.settings.chapter_1_deck | default: 'The first move is not an entrance. It is the decision to leave, measured in quiet rooms, brown tailoring and the small rituals that make a silhouette feel lived in.'
      elsif chapter == 2
        assign chapter_start = 5
        assign chapter_end = 8
        assign chapter_number = '02'
        assign chapter_title = section.settings.chapter_2_title | default: 'In Transit'
        assign chapter_deck = section.settings.chapter_2_deck | default: 'The uniform meets the public. Platforms, pavement and passing light make the line more active without asking it to become louder.'
      elsif chapter == 3
        assign chapter_start = 9
        assign chapter_end = 12
        assign chapter_number = '03'
        assign chapter_title = section.settings.chapter_3_title | default: 'After Hours'
        assign chapter_deck = section.settings.chapter_3_deck | default: 'Colour deepens, texture softens and a familiar shape learns the grammar of dinner, conversation and last call.'
      else
        assign chapter_start = 13
        assign chapter_end = 16
        assign chapter_number = '04'
        assign chapter_title = section.settings.chapter_4_title | default: 'Filed Under: Melato'
        assign chapter_deck = section.settings.chapter_4_deck | default: 'Objects, gestures and residual light close the issue. The archive is not an answer; it is the material left in the room after the story.'
      endif
    %}
    <section id="{% if chapter == 1 %}FieldJournalRead-{{ section.id }}{% else %}FieldJournalChapter{{ chapter }}-{{ section.id }}{% endif %}" class="fj__chapter" data-field-journal-chapter data-chapter-number="{{ chapter }}" aria-labelledby="FieldJournalChapterTitle-{{ chapter }}-{{ section.id }}">
      <div class="fj__chapter-head">
        <div><span class="fj__kicker">Chapter {{ chapter_number }}</span><h2 id="FieldJournalChapterTitle-{{ chapter }}-{{ section.id }}" class="fj__chapter-title">{{ chapter_title | escape }}</h2></div>
        <p class="fj__chapter-deck">{{ chapter_deck | escape }}</p>
      </div>
      <div class="fj__spread-grid" role="list">
        {% for record in journal_records %}
          {% assign frame_number = forloop.index %}
          {% if frame_number < chapter_start or frame_number > chapter_end %}{% continue %}{% endif %}
          {% assign fields = record | strip | split: '|' %}
          {% assign image_url = fields[0] | strip %}
          {% assign image_width = fields[1] | strip %}
          {% assign image_height = fields[2] | strip %}
          {% assign image_kind = fields[3] | strip | default: 'editorial study' %}
          {% assign first_product = blank %}{% assign second_product = blank %}{% assign third_product = blank %}{% assign styling_note = blank %}
          {% for block in section.blocks %}
            {% assign assigned_frame = block.settings.frame_number | plus: 0 %}
            {% if assigned_frame == frame_number %}
              {% assign first_product = block.settings.product_one %}
              {% assign second_product = block.settings.product_two %}
              {% assign third_product = block.settings.product_three %}
              {% assign styling_note = block.settings.styling_note %}
              {% break %}
            {% endif %}
          {% endfor %}
          {% capture frame_code %}{% if frame_number < 10 %}0{% endif %}{{ frame_number }}{% endcapture %}
          <figure class="fj__spread" role="listitem">
            <div class="fj__image-wrap">
              <img src="{{ image_url | append: '&width=1000' | escape }}" srcset="{{ image_url | append: '&width=520' | escape }} 520w, {{ image_url | append: '&width=760' | escape }} 760w, {{ image_url | append: '&width=1000' | escape }} 1000w, {{ image_url | append: '&width=1400' | escape }} 1400w" sizes="(min-width: 990px) 54vw, 100vw" width="{{ image_width | escape }}" height="{{ image_height | escape }}" loading="lazy" decoding="async" alt="{{ section.settings.issue_title | default: 'Melato Living' | escape }} — {{ chapter_title | escape }}, frame {{ frame_code | strip }}">
            </div>
            <figcaption class="fj__spread-caption"><span>{{ chapter_number }} / {{ frame_code | strip }}</span><span>{{ image_kind | escape }}</span></figcaption>
            {% if first_product != blank or second_product != blank or third_product != blank %}
              <div class="fj__look-action">
                <button type="button" data-look-open data-look-template="FieldJournalLook-{{ section.id }}-{{ frame_number }}" aria-controls="FieldJournalDrawer-{{ section.id }}">View the look +</button>
                <a href="#FieldJournalShop-{{ section.id }}">Shop products</a>
              </div>
              <template id="FieldJournalLook-{{ section.id }}-{{ frame_number }}" data-look-template>
                <div data-look-key="{{ section.id }}-{{ frame_number }}">
                  <span class="fj__drawer-label">Look {{ frame_code | strip }} / {{ chapter_title | escape }}</span>
                  <h2 class="fj__drawer-title">{{ styling_note | default: 'The issue uniform' | escape }}</h2>
                  <p class="fj__drawer-note">{{ styling_note | default: 'Selected pieces are shown together to preserve the proportion, texture and mood of the frame.' | escape }}</p>
                  <div class="fj__drawer-products">
                    {% for product_item in (1..3) %}
                      {% liquid
                        if product_item == 1
                          assign product = first_product
                        elsif product_item == 2
                          assign product = second_product
                        else
                          assign product = third_product
                        endif
                      %}
                      {% if product != blank %}
                        {% assign selected_variant = product.selected_or_first_available_variant %}
                        <article class="fj__drawer-product">
                          {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 160 }}" alt="{{ product.title | escape }}" loading="lazy" width="160" height="200">{% endif %}
                          <div>
                            <h3>{{ product.title | escape }}</h3>
                            <p>{{ product.price | money }}{% unless product.available %} · Currently unavailable{% endunless %}</p>
                            <div class="fj__drawer-product-links">
                              <a href="{{ product.url }}">View product</a>
                              {% if selected_variant != blank %}
                                <form action="{{ routes.cart_add_url }}" method="post">
                                  <input type="hidden" name="id" value="{{ selected_variant.id }}">
                                  <button class="fj__quick-add" type="submit"{% unless product.available %} disabled{% endunless %}>{% if product.available %}Quick add{% else %}Archived{% endif %}</button>
                                </form>
                              {% endif %}
                            </div>
                          </div>
                        </article>
                      {% endif %}
                    {% endfor %}
                  </div>
                  <button class="fj__save-button" type="button" data-look-save data-look-key="{{ section.id }}-{{ frame_number }}">Save this look</button>
                </div>
              </template>
            {% endif %}
          </figure>
        {% endfor %}
      </div>
    </section>
  {% endfor %}

  <section id="FieldJournalArchive-{{ section.id }}" class="fj__archive" data-field-journal-archive aria-labelledby="FieldJournalArchiveTitle-{{ section.id }}">
    <div class="fj__archive-head">
      <div><span class="fj__kicker">Archive mode / selected exhibits</span><h2 id="FieldJournalArchiveTitle-{{ section.id }}">Filed after the issue</h2></div>
      <p>{{ section.settings.archive_deck | default: 'A finite contact sheet of outtakes, objects and afterimages. Select an exhibit for the record; the main story remains the primary route.' | escape }}</p>
    </div>
    <div class="fj__archive-grid" role="list">
      {% for record in journal_records %}
        {% assign frame_number = forloop.index %}
        {% if frame_number < archive_start or frame_number > archive_end %}{% continue %}{% endif %}
        {% assign archive_position = frame_number | minus: archive_start | plus: 1 %}
        {% assign fields = record | strip | split: '|' %}
        {% assign image_url = fields[0] | strip %}
        {% assign image_width = fields[1] | strip %}
        {% assign image_height = fields[2] | strip %}
        {% capture archive_code %}{% if frame_number < 10 %}0{% endif %}{{ frame_number }}{% endcapture %}
        <figure class="fj__exhibit" data-archive-item{% if archive_position > archive_initial_count %} hidden{% endif %} role="listitem">
          <button type="button" data-archive-open data-archive-template="FieldJournalArchiveItem-{{ section.id }}-{{ frame_number }}" data-archive-index="{{ archive_position | minus: 1 }}" aria-controls="FieldJournalViewer-{{ section.id }}">
            <img src="{{ image_url | append: '&width=600' | escape }}" srcset="{{ image_url | append: '&width=360' | escape }} 360w, {{ image_url | append: '&width=600' | escape }} 600w, {{ image_url | append: '&width=900' | escape }} 900w" sizes="(min-width: 750px) 25vw, 48vw" width="{{ image_width | escape }}" height="{{ image_height | escape }}" loading="lazy" decoding="async" alt="Archive exhibit {{ archive_code | strip }} from {{ issue_title | escape }}">
            <span class="fj__exhibit-label"><span>Exhibit {{ archive_code | strip }}</span><span>Filed</span></span>
          </button>
        </figure>
        <template id="FieldJournalArchiveItem-{{ section.id }}-{{ frame_number }}">
          <div class="fj__viewer-content">
            <img src="{{ image_url | append: '&width=1600' | escape }}" width="{{ image_width | escape }}" height="{{ image_height | escape }}" alt="Archive exhibit {{ archive_code | strip }} from {{ issue_title | escape }}">
            <div class="fj__viewer-copy"><span class="fj__drawer-label">Exhibit {{ archive_code | strip }} / Field record</span><h2 class="fj__drawer-title">Filed under: Melato</h2><p>{{ section.settings.archive_note | default: 'A recovered image from the edges of the issue: texture, gesture and a record of the time between scenes.' | escape }}</p><p><strong>Credit:</strong> {{ section.settings.credits | default: 'Melato Studio' | escape }}</p></div>
          </div>
        </template>
      {% endfor %}
    </div>
    {% if journal_records.size > archive_initial_count %}
      <div class="fj__archive-more"><button type="button" data-archive-load-more>Load more exhibits</button></div>
    {% endif %}
  </section>

  <section id="FieldJournalShop-{{ section.id }}" class="fj__shop" aria-labelledby="FieldJournalShopTitle-{{ section.id }}">
    <div class="fj__shop-head">
      <div><span class="fj__kicker">Shop the issue</span><h2 id="FieldJournalShopTitle-{{ section.id }}">The product index</h2></div>
      <p>{{ section.settings.shop_deck | default: 'Complete looks first, then individual pieces. Product availability is live; archive items remain clearly identified.' | escape }}</p>
    </div>
    <div class="fj__shop-filters" role="group" aria-label="Filter issue products">
      <button type="button" data-shop-filter="all" aria-pressed="true">All</button>
      <button type="button" data-shop-filter="jackets" aria-pressed="false">Jackets</button>
      <button type="button" data-shop-filter="pants" aria-pressed="false">Pants</button>
      <button type="button" data-shop-filter="tracksuits" aria-pressed="false">Tracksuits</button>
      <button type="button" data-shop-filter="dresses" aria-pressed="false">Dresses</button>
      <button type="button" data-shop-filter="accessories" aria-pressed="false">Accessories</button>
    </div>
    <div class="fj__shop-grid" data-shop-grid>
      {% assign indexed_products = '|' %}
      {% for block in section.blocks %}
        {% for product_slot in (1..3) %}
          {% liquid
            if product_slot == 1
              assign index_product = block.settings.product_one
            elsif product_slot == 2
              assign index_product = block.settings.product_two
            else
              assign index_product = block.settings.product_three
            endif
          %}
          {% if index_product != blank %}
            {% capture indexed_token %}|{{ index_product.handle }}|{% endcapture %}
            {% unless indexed_products contains indexed_token %}
              {% assign indexed_products = indexed_products | append: index_product.handle | append: '|' %}
              <article class="fj__shop-card" data-shop-card data-product-category="{{ index_product.type | handleize }} {{ index_product.tags | join: ' ' | handleize }}">
                <a href="{{ index_product.url }}">
                  {% if index_product.featured_image %}<img src="{{ index_product.featured_image | image_url: width: 720 }}" srcset="{{ index_product.featured_image | image_url: width: 360 }} 360w, {{ index_product.featured_image | image_url: width: 540 }} 540w, {{ index_product.featured_image | image_url: width: 720 }} 720w" sizes="(min-width: 750px) 33vw, 50vw" alt="{{ index_product.title | escape }}" loading="lazy" width="720" height="900">{% endif %}
                  <div class="fj__shop-card-meta"><div><small>Look {{ block.settings.frame_number }}</small><strong>{{ index_product.title | escape }}</strong></div><span>{{ index_product.price | money }}</span></div>
                </a>
              </article>
            {% endunless %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  </section>

  <footer class="fj__close">
    <div class="fj__close-inner"><div><span class="fj__kicker" style="color: var(--fj-brass)">End of issue</span><p>{{ section.settings.close_note | default: 'Save this issue, return to the archive, or wait for the next field note. The collection remains available whenever the scene calls for it.' | escape }}</p></div><div class="fj__close-meta"><span>{{ issue_volume | escape }}</span><span>{{ issue_code | escape }}</span><a href="#FieldJournalShop-{{ section.id }}">Shop the issue</a></div></div>
  </footer>

  <div id="FieldJournalDrawer-{{ section.id }}" class="fj__dialog fj__drawer" data-field-journal-drawer role="dialog" aria-modal="true" aria-labelledby="FieldJournalDrawerLabel-{{ section.id }}" aria-hidden="true" hidden>
    <div class="fj__drawer-panel"><button class="fj__dialog-close" type="button" data-dialog-close aria-label="Close look details">×</button><span id="FieldJournalDrawerLabel-{{ section.id }}" class="fj__live">Look details</span><div class="fj__drawer-content" data-drawer-content></div></div>
  </div>
  <div id="FieldJournalViewer-{{ section.id }}" class="fj__dialog fj__viewer" data-field-journal-viewer role="dialog" aria-modal="true" aria-labelledby="FieldJournalViewerLabel-{{ section.id }}" aria-hidden="true" hidden>
    <div class="fj__viewer-panel"><button class="fj__dialog-close" type="button" data-dialog-close aria-label="Close archive exhibit">×</button><span id="FieldJournalViewerLabel-{{ section.id }}" class="fj__live">Archive exhibit viewer</span><div data-viewer-content></div><div class="fj__viewer-navigation"><button type="button" data-archive-previous aria-label="Previous archive exhibit">←</button><button type="button" data-archive-next aria-label="Next archive exhibit">→</button></div></div>
  </div>
  <p class="fj__live" data-field-journal-live aria-live="polite"></p>
</section>

{% schema %}
{
  "name": "Melato Living Field Journal",
  "tag": "section",
  "class": "section-melato-living-field-journal",
  "settings": [
    { "type": "image_picker", "id": "cover_image", "label": "Cover image" },
    { "type": "text", "id": "cover_alt", "label": "Cover image alt text", "default": "Melato Living Volume 01 editorial portrait" },
    { "type": "text", "id": "issue_title", "label": "Issue title", "default": "The Uniform in Motion" },
    { "type": "text", "id": "issue_volume", "label": "Volume", "default": "Vol. 01" },
    { "type": "textarea", "id": "issue_deck", "label": "Issue deck", "default": "A uniform made for the distance between a quiet room, the platform and last call." },
    { "type": "textarea", "id": "cover_note", "label": "Cover note", "default": "A field journal of silhouette, transit and after-hours ritual—filed as a sequence rather than a catalogue." },
    { "type": "text", "id": "issue_code", "label": "Time and location code", "default": "Toronto / 2026 / 21:40" },
    { "type": "text", "id": "credits", "label": "Credits", "default": "Melato Studio" },
    { "type": "text", "id": "chapter_1_title", "label": "Chapter 1 title", "default": "First Light" },
    { "type": "textarea", "id": "chapter_1_deck", "label": "Chapter 1 deck", "default": "The first move is not an entrance. It is the decision to leave, measured in quiet rooms, brown tailoring and the small rituals that make a silhouette feel lived in." },
    { "type": "text", "id": "chapter_2_title", "label": "Chapter 2 title", "default": "In Transit" },
    { "type": "textarea", "id": "chapter_2_deck", "label": "Chapter 2 deck", "default": "The uniform meets the public. Platforms, pavement and passing light make the line more active without asking it to become louder." },
    { "type": "text", "id": "chapter_3_title", "label": "Chapter 3 title", "default": "After Hours" },
    { "type": "textarea", "id": "chapter_3_deck", "label": "Chapter 3 deck", "default": "Colour deepens, texture softens and a familiar shape learns the grammar of dinner, conversation and last call." },
    { "type": "text", "id": "chapter_4_title", "label": "Chapter 4 title", "default": "Filed Under: Melato" },
    { "type": "textarea", "id": "chapter_4_deck", "label": "Chapter 4 deck", "default": "Objects, gestures and residual light close the issue. The archive is not an answer; it is the material left in the room after the story." },
    { "type": "textarea", "id": "archive_deck", "label": "Archive introduction", "default": "A finite contact sheet of outtakes, objects and afterimages. Select an exhibit for the record; the main story remains the primary route." },
    { "type": "textarea", "id": "archive_note", "label": "Archive exhibit note", "default": "A recovered image from the edges of the issue: texture, gesture and a record of the time between scenes." },
    { "type": "range", "id": "archive_initial_count", "label": "Initial archive exhibits", "min": 12, "max": 24, "step": 1, "default": 12 },
    { "type": "textarea", "id": "shop_deck", "label": "Shop index introduction", "default": "Complete looks first, then individual pieces. Product availability is live; archive items remain clearly identified." },
    { "type": "textarea", "id": "close_note", "label": "Issue close note", "default": "Save this issue, return to the archive, or wait for the next field note. The collection remains available whenever the scene calls for it." }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Shoppable look",
      "settings": [
        { "type": "range", "id": "frame_number", "label": "Archive frame number", "min": 1, "max": 16, "step": 1, "default": 1 },
        { "type": "product", "id": "product_one", "label": "Primary product" },
        { "type": "product", "id": "product_two", "label": "Secondary product" },
        { "type": "product", "id": "product_three", "label": "Third product" },
        { "type": "textarea", "id": "styling_note", "label": "Styling note", "default": "Selected pieces are shown together to preserve the proportion, texture and mood of the frame." }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [{ "name": "Melato Living Field Journal" }]
}
{% endschema %}

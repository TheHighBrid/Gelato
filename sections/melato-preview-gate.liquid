{% comment %}
  sections/melato-preview-gate.liquid
  Full editorial upgrade: full-bleed dark layout with background image,
  frosted-glass form card, social proof, pending animation, unlocked product grid.

  SECURITY NOTE: This controls *display only*. It does not restrict products or
  checkout. Use Locksmith or similar for genuinely protected drops.
  AUTOMATION NOTE: The tag "newsletter" must be applied via Shopify Flow
  (marketing-consent-updated trigger) — not by this Liquid form.
{% endcomment %}

{%- liquid
  assign state = 'locked'
  if customer
    if customer.tags contains 'preview-access'
      assign state = 'unlocked'
    elsif customer.tags contains 'newsletter'
      assign state = 'pending'
    endif
  endif
  assign member_count = section.settings.member_count | default: ''
-%}

<div
  class="mpg mpg--{{ state }}"
  id="PreviewGate-{{ section.id }}"
  data-preview-state="{{ state }}"
>

  <!-- ── Background layer ── -->
  <div class="mpg__bg" aria-hidden="true">
    {%- if section.settings.bg_image != blank -%}
      {{ section.settings.bg_image | image_url: width: 1800 | image_tag:
          class: 'mpg__bg-img',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '800, 1200, 1600, 1800',
          sizes: '100vw',
          alt: '' }}
    {%- endif -%}
    <div class="mpg__bg-veil"></div>
  </div>

  <!-- ── Content ── -->
  <div class="mpg__content">

    {%- if state == 'locked' -%}
      <!-- ── LOCKED ── -->
      <div class="mpg__card mpg__card--locked">
        <p class="mpg__eyebrow">MELATO / PREVIEW ROOM</p>
        <h1 class="mpg__headline">{{ section.settings.locked_headline | default: 'The List Sees It First.' }}</h1>
        <p class="mpg__copy">{{ section.settings.locked_copy | default: 'Newsletter subscribers get private previews before pieces reach the public floor.' }}</p>

        {%- if section.settings.benefits != blank -%}
          {%- assign benefit_items = section.settings.benefits | newline_to_br | split: '<br />' -%}
          <ul class="mpg__benefits" aria-label="Preview member benefits">
            {%- for item in benefit_items -%}
              {%- if item != blank -%}
                <li>{{ item | strip | escape }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- form 'customer', class: 'mpg__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="mpg__form-row">
            <label class="mpg__sr-only" for="mpg-email-{{ section.id }}">Email address</label>
            <input
              id="mpg-email-{{ section.id }}"
              type="email"
              name="contact[email]"
              placeholder="{{ section.settings.email_placeholder | default: 'Your email address' }}"
              required
              autocomplete="email"
              class="mpg__input"
              aria-required="true"
            >
            <button type="submit" class="mpg__submit">
              {{ section.settings.locked_cta | default: 'Join the List' | escape }}
            </button>
          </div>
          <label class="mpg__consent">
            <input type="checkbox" name="contact[accepts_marketing]" value="1" checked>
            <span>{{ section.settings.consent_text | default: 'Yes, send me Melato previews and first-access releases.' }}</span>
          </label>
          {%- if form.posted_successfully? -%}
            <p class="mpg__success" role="status">
              {{ section.settings.success_text | default: 'You\u2019re on the list \u2014 selected pieces will appear here as access opens.' }}
            </p>
          {%- endif -%}
        {%- endform -%}

        {%- if member_count != blank -%}
          <p class="mpg__social-proof">
            <span class="mpg__social-dot" aria-hidden="true"></span>
            Join {{ member_count | escape }} members already on the list
          </p>
        {%- endif -%}
      </div>

    {%- elsif state == 'pending' -%}
      <!-- ── PENDING ── -->
      <div class="mpg__card mpg__card--pending">
        <p class="mpg__eyebrow">MELATO / PREVIEW ROOM</p>
        <h1 class="mpg__headline">{{ section.settings.pending_headline | default: "You\u2019re On The List." }}</h1>
        <p class="mpg__copy">{{ section.settings.pending_copy | default: 'Selected pieces will appear here before the public floor, as soon as the room opens.' }}</p>
        <div class="mpg__verifying" aria-label="Access verification in progress">
          <span class="mpg__verify-spinner" aria-hidden="true"></span>
          <span class="mpg__verify-label">Verifying access</span>
        </div>
      </div>

    {%- elsif state == 'unlocked' -%}
      <!-- ── UNLOCKED ── -->
      <div class="mpg__welcome">
        <p class="mpg__eyebrow">MELATO / PREVIEW ROOM</p>
        <h1 class="mpg__headline">{{ section.settings.unlocked_headline | default: 'Welcome Inside.' }}</h1>
        <p class="mpg__copy">{{ section.settings.unlocked_copy | default: 'Selected pieces appear here first, before the public floor.' }}</p>
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
.mpg {
  --mpg-bg:     #0a0908;
  --mpg-ink:    #f4ead8;
  --mpg-muted:  #a8a099;
  --mpg-accent: #c9974a;
  --mpg-glass:  rgba(12,10,8,.72);
  position: relative;
  min-height: 100svh;
  display: flex;
  align-items: flex-end;
  background: var(--mpg-bg);
  color: var(--mpg-ink);
  overflow: hidden;
}
.mpg * { box-sizing: border-box; }

/* ── background layer ── */
.mpg__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.mpg__bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
  filter: saturate(.7) brightness(.55);
}
.mpg__bg-veil {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(10,9,8,.20) 0%, rgba(10,9,8,.88) 100%),
    linear-gradient(0deg, rgba(10,9,8,.95) 0%, transparent 40%);
}

/* ── content layer ── */
.mpg__content {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  min-height: 100svh;
  padding: clamp(80px, 12vw, 140px) clamp(20px, 5vw, 48px) clamp(40px, 6vw, 80px);
}

/* ── card ── */
.mpg__card {
  width: 100%;
  max-width: 520px;
  background: var(--mpg-glass);
  border: 1px solid rgba(244,234,216,.18);
  border-radius: 18px;
  padding: clamp(28px, 4vw, 48px);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
}

.mpg__eyebrow {
  margin: 0 0 .7rem;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: .6rem;
  letter-spacing: .24em;
  text-transform: uppercase;
  color: rgba(244,234,216,.44);
}

.mpg__headline {
  margin: 0 0 .6rem;
  font-family: var(--font-heading-family, 'Bebas Neue', sans-serif);
  font-size: clamp(38px, 7vw, 72px);
  line-height: .84;
  letter-spacing: -.05em;
  text-transform: uppercase;
}

.mpg__copy {
  margin: 0 0 1.4rem;
  font-size: clamp(14px, 1.2vw, 16px);
  line-height: 1.65;
  color: rgba(244,234,216,.7);
}

/* benefits list */
.mpg__benefits {
  list-style: none;
  padding: 0;
  margin: 0 0 1.4rem;
  display: flex;
  flex-direction: column;
  gap: .5rem;
}
.mpg__benefits li {
  font-size: .86rem;
  color: rgba(244,234,216,.8);
  padding-left: 1.2rem;
  position: relative;
}
.mpg__benefits li::before {
  content: '';
  position: absolute;
  left: 0; top: .5rem;
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--mpg-accent);
}

/* form */
.mpg__form-row {
  display: flex;
  gap: 8px;
}
@media (max-width: 440px) { .mpg__form-row { flex-direction: column; } }

.mpg__input {
  flex: 1;
  padding: .72rem .9rem;
  background: rgba(244,234,216,.06);
  border: 1px solid rgba(244,234,216,.26);
  border-radius: 8px;
  color: var(--mpg-ink);
  font-family: inherit;
  font-size: .9rem;
}
.mpg__input::placeholder { color: rgba(244,234,216,.34); }
.mpg__input:focus-visible { outline: 2px solid var(--mpg-accent); outline-offset: 2px; }

.mpg__submit {
  padding: .72rem 1.4rem;
  background: var(--mpg-accent);
  color: #0a0908;
  border: none;
  border-radius: 8px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: .75rem;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  cursor: pointer;
  white-space: nowrap;
  transition: opacity .2s;
}
.mpg__submit:hover { opacity: .86; }

.mpg__consent {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin-top: .9rem;
  font-size: .76rem;
  color: rgba(244,234,216,.5);
  cursor: pointer;
}
.mpg__consent input { flex-shrink: 0; margin-top: 2px; accent-color: var(--mpg-accent); }

.mpg__success {
  margin-top: .9rem;
  font-size: .85rem;
  color: #8fcf8a;
  line-height: 1.5;
}

/* social proof */
.mpg__social-proof {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 1.2rem;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: .65rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: rgba(244,234,216,.44);
}
.mpg__social-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: #5acd6e;
  box-shadow: 0 0 0 3px rgba(90,205,110,.18);
  animation: mpg-dot 2.2s ease-in-out infinite;
  flex-shrink: 0;
}
@keyframes mpg-dot {
  0%, 100% { box-shadow: 0 0 0 3px rgba(90,205,110,.18); }
  50%       { box-shadow: 0 0 0 7px rgba(90,205,110,.04); }
}

/* pending card */
.mpg__card--pending .mpg__copy { margin-bottom: 1.8rem; }
.mpg__verifying {
  display: flex;
  align-items: center;
  gap: 10px;
}
.mpg__verify-spinner {
  width: 20px; height: 20px;
  border: 2px solid rgba(244,234,216,.22);
  border-top-color: var(--mpg-accent);
  border-radius: 50%;
  animation: mpg-spin 1s linear infinite;
  flex-shrink: 0;
}
@keyframes mpg-spin { to { transform: rotate(360deg); } }
.mpg__verify-label {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: .65rem;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: rgba(244,234,216,.52);
}

/* unlocked welcome */
.mpg__welcome {
  max-width: 680px;
  text-align: center;
  padding: clamp(20px, 3vw, 40px) 0;
}
.mpg__welcome .mpg__headline { font-size: clamp(44px, 8vw, 86px); margin-bottom: .8rem; }
.mpg__welcome .mpg__copy { max-width: 480px; margin-inline: auto; }

/* accessibility */
.mpg__sr-only {
  position: absolute;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
  border: 0;
}

@media (prefers-reduced-motion: reduce) {
  .mpg__verify-spinner, .mpg__social-dot { animation: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Melato Preview Gate",
  "tag": "section",
  "settings": [
    { "type": "header",       "content": "Background" },
    { "type": "image_picker", "id": "bg_image",          "label": "Background image",  "info": "Editorial or lookbook photo. Displayed full-screen behind the gate." },
    { "type": "header",       "content": "Locked state" },
    { "type": "text",         "id": "locked_headline",   "label": "Headline",          "default": "The List Sees It First." },
    { "type": "textarea",     "id": "locked_copy",       "label": "Copy",              "default": "Newsletter subscribers get private previews before pieces reach the public floor." },
    { "type": "textarea",     "id": "benefits",          "label": "Benefits list (one per line)", "default": "First access to new drops\nExclusive release notes from the team\nEarly reservation windows before public launch" },
    { "type": "text",         "id": "email_placeholder", "label": "Email placeholder", "default": "Your email address" },
    { "type": "text",         "id": "locked_cta",        "label": "Button label",      "default": "Join the List" },
    { "type": "textarea",     "id": "consent_text",      "label": "Consent label",     "default": "Yes, send me Melato previews and first-access releases." },
    { "type": "textarea",     "id": "success_text",      "label": "Success message",   "default": "You\u2019re on the list \u2014 selected pieces will appear here as access opens." },
    { "type": "text",         "id": "member_count",      "label": "Member count (social proof)", "info": "Displays as \u2018Join X members already on the list\u2019. Leave blank to hide." },
    { "type": "header",       "content": "Pending state" },
    { "type": "text",         "id": "pending_headline",  "label": "Headline",          "default": "You\u2019re On The List." },
    { "type": "textarea",     "id": "pending_copy",      "label": "Copy",              "default": "Selected pieces will appear here before the public floor, as soon as the room opens." },
    { "type": "header",       "content": "Unlocked state" },
    { "type": "text",         "id": "unlocked_headline", "label": "Headline",          "default": "Welcome Inside." },
    { "type": "textarea",     "id": "unlocked_copy",     "label": "Copy",              "default": "Selected pieces appear here first, before the public floor." }
  ],
  "presets": [{ "name": "Melato Preview Gate" }]
}
{% endschema %}

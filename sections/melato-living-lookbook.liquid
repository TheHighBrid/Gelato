{%- liquid
  assign section_anchor = section.settings.section_anchor | default: 'living-lookbook' | handleize
  assign bg_color = section.settings.bg_color | default: '#080706'
  assign text_color = section.settings.text_color | default: '#f7efe2'
  assign muted_color = section.settings.muted_color | default: '#b9aa96'
  assign accent_color = section.settings.accent_color | default: '#c9974a'
  assign selector = section_anchor | append: '-' | append: section.id
  assign block_count = section.blocks | size
-%}

<section id="{{ selector }}" class="melato-living-lookbook" data-section-type="melato-living-lookbook">
  <style>
    :root {
      --ll-bg: {{ bg_color }};
      --ll-ink: {{ text_color }};
      --ll-muted: {{ muted_color }};
      --ll-accent: {{ accent_color }};
      --ll-line: rgba(247,239,226,.16);
      --ll-text-secondary: rgba(247,239,226,.8);
      --ll-text-muted: rgba(247,239,226,.85);
      --ll-text-subtle: rgba(247,239,226,.74);
    }

    #{{ selector }} {
      background: var(--ll-bg);
      color: var(--ll-ink);
      overflow: clip;
      border-top: 1px solid rgba(247,239,226,.1);
      border-bottom: 1px solid rgba(247,239,226,.1);
    }

    #{{ selector }} * { box-sizing: border-box; }

    #{{ selector }} .living-lookbook__wrap {
      width: min({{ section.settings.max_width | default: 1360 }}px, calc(100% - 40px));
      margin: 0 auto;
      padding: clamp(64px, 9vw, 126px) 0;
    }

    #{{ selector }} .living-lookbook__header {
      display: grid;
      grid-template-columns: minmax(0, .95fr) minmax(280px, .55fr);
      gap: clamp(24px, 5vw, 84px);
      align-items: end;
      margin-bottom: clamp(32px, 5vw, 72px);
    }

    #{{ selector }} .living-lookbook__kicker,
    #{{ selector }} .living-lookbook-scene__chapter,
    #{{ selector }} .living-lookbook-pin__label {
      margin: 0;
      color: var(--ll-muted);
      font-size: 10px;
      line-height: 1.35;
      font-weight: 800;
      letter-spacing: .26em;
      text-transform: uppercase;
    }

    #{{ selector }} .living-lookbook__title {
      margin: 12px 0 0;
      max-width: 980px;
      color: var(--ll-ink);
      font-family: var(--font-heading-family, inherit);
      font-size: clamp(46px, 8vw, 118px);
      line-height: .82;
      letter-spacing: -.08em;
      text-transform: uppercase;
      text-wrap: balance;
    }

    #{{ selector }} .living-lookbook__copy {
      margin: 0;
      color: var(--ll-text-subtle);
      font-size: clamp(15px, 1.25vw, 19px);
      line-height: 1.65;
    }

    #{{ selector }} .living-lookbook__stage {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(14px, 1.7vw, 24px);
      align-items: stretch;
    }

    #{{ selector }} .living-lookbook-scene {
      position: relative;
      min-height: 520px;
      overflow: hidden;
      border: 1px solid var(--ll-line);
      border-radius: clamp(24px, 3vw, 42px);
      color: inherit;
      text-decoration: none;
      background: rgba(255,255,255,.035);
      box-shadow: 0 12px 40px rgba(0,0,0,.28);
      transition: transform .28s ease, border-color .28s ease, box-shadow .28s ease;
      outline-offset: 2px;
      display: flex;
      flex-direction: column;
    }

    @media (prefers-reduced-motion: no-preference) {
      #{{ selector }} .living-lookbook-scene:hover {
        transform: translateY(-6px);
        border-color: rgba(247,239,226,.32);
        box-shadow: 0 16px 50px rgba(0,0,0,.36);
      }
    }

    #{{ selector }} .living-lookbook-scene:focus-visible {
      outline: 2px solid var(--ll-accent);
    }

    #{{ selector }} .living-lookbook-scene__image {
      position: absolute;
      inset: 0;
      z-index: -2;
      background: linear-gradient(135deg, rgba(201,151,74,.16), rgba(255,255,255,.04));
    }

    #{{ selector }} .living-lookbook-scene__image img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      aspect-ratio: 4/5;
      will-change: transform;
      transition: transform .7s ease;
    }

    #{{ selector }} .living-lookbook-scene__image.is-loading {
      animation: shimmer 1.5s infinite ease-in-out;
    }

    @keyframes shimmer {
      0% { opacity: .7; }
      50% { opacity: 1; }
      100% { opacity: .7; }
    }

    @media (prefers-reduced-motion: no-preference) {
      #{{ selector }} .living-lookbook-scene:hover .living-lookbook-scene__image img {
        transform: scale(1.06);
      }
    }

    #{{ selector }} .living-lookbook-scene__veil {
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        linear-gradient(180deg, rgba(0,0,0,.04) 28%, rgba(0,0,0,.72) 100%),
        linear-gradient(90deg, rgba(0,0,0,.36), rgba(0,0,0,0) 54%);
    }

    #{{ selector }} .living-lookbook-scene__content {
      min-height: inherit;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: clamp(22px, 3vw, 34px);
      position: relative;
      z-index: 1;
    }

    #{{ selector }} .living-lookbook-pin {
      align-self: flex-start;
      display: inline-flex;
      align-items: center;
      gap: 12px;
      max-width: min(100%, 360px);
      padding: 12px 16px;
      min-height: 44px;
      border: 1px solid rgba(247,239,226,.22);
      border-radius: 999px;
      background: rgba(8,7,6,.54);
      color: var(--ll-ink);
      backdrop-filter: blur(12px);
    }

    #{{ selector }} .living-lookbook-pin::before {
      content: "";
      width: 14px;
      height: 14px;
      flex: 0 0 14px;
      border: 3px solid var(--ll-bg);
      border-radius: 50%;
      background: var(--ll-accent);
      box-shadow: 0 0 0 1px rgba(247,239,226,.34), 0 0 16px rgba(201,151,74,.6);
    }

    #{{ selector }} .living-lookbook-pin__label {
      display: block;
      color: var(--ll-text-secondary);
      letter-spacing: .18em;
      font-size: 10px;
    }

    #{{ selector }} .living-lookbook-pin__title {
      display: block;
      margin-top: 3px;
      color: var(--ll-ink);
      font-size: 12px;
      line-height: 1.25;
      letter-spacing: .01em;
    }

    #{{ selector }} .living-lookbook-scene__title {
      display: block;
      margin: 14px 0 0;
      max-width: 520px;
      font-family: var(--font-heading-family, inherit);
      font-size: clamp(28px, 3.5vw, 58px);
      line-height: .9;
      letter-spacing: -.06em;
      text-transform: uppercase;
      text-wrap: balance;
    }

    #{{ selector }} .living-lookbook-scene__text {
      display: block;
      margin: 14px 0 0;
      max-width: 440px;
      color: var(--ll-text-muted);
      font-size: 14px;
      line-height: 1.58;
    }

    #{{ selector }} .living-lookbook-scene__cta {
      display: inline-flex;
      width: fit-content;
      margin-top: 20px;
      color: var(--ll-ink);
      font-size: 10px;
      font-weight: 900;
      letter-spacing: .18em;
      text-transform: uppercase;
      border-bottom: 2px solid rgba(247,239,226,.45);
      transition: border-color .28s ease;
    }

    @media (prefers-reduced-motion: no-preference) {
      #{{ selector }} .living-lookbook-scene:hover .living-lookbook-scene__cta {
        border-color: var(--ll-accent);
      }
    }

    #{{ selector }} .living-lookbook-scene--empty {
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255,255,255,.05);
      color: var(--ll-muted);
      font-size: 12px;
      text-align: center;
      padding: 24px;
      min-height: 240px;
    }

    @media (max-width: 990px) {
      #{{ selector }} .living-lookbook__header { grid-template-columns: 1fr; }
      #{{ selector }} .living-lookbook__stage { grid-template-columns: repeat(2, 1fr); }
      #{{ selector }} .living-lookbook-scene {
        min-height: 440px;
      }
    }

    @media (max-width: 640px) {
      #{{ selector }} .living-lookbook__wrap { width: min(100% - 28px, {{ section.settings.max_width | default: 1360 }}px); }
      #{{ selector }} .living-lookbook__stage { grid-template-columns: 1fr; }
      #{{ selector }} .living-lookbook-scene {
        min-height: 380px;
      }
      #{{ selector }} .living-lookbook-pin {
        padding: 10px 13px;
        min-height: auto;
      }
      #{{ selector }} .living-lookbook-pin { border-radius: 22px; align-items: flex-start; }
    }

    @media (prefers-color-scheme: light) {
      #{{ selector }} {
        --ll-bg: #f5f5f5;
        --ll-ink: #1a1a1a;
        --ll-muted: #666;
        --ll-text-secondary: rgba(26,26,26,.85);
        --ll-text-muted: rgba(26,26,26,.9);
      }
    }
  </style>

  <div class="living-lookbook__wrap">
    <div class="living-lookbook__header">
      <div>
        {%- if section.settings.kicker != blank -%}
          <p class="living-lookbook__kicker">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="living-lookbook__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.copy != blank -%}
        <p class="living-lookbook__copy">{{ section.settings.copy | escape }}</p>
      {%- endif -%}
    </div>

    <div class="living-lookbook__stage" aria-label="{{ section.settings.title | escape }}">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- if product != blank and product.url != blank -%}
          {%- assign scene_image = block.settings.image | default: product.featured_image -%}
          <a class="living-lookbook-scene" href="{{ product.url }}" aria-label="Shop {{ product.title | escape }}" {{ block.shopify_attributes }}>
            <div class="living-lookbook-scene__image is-loading">
              {%- if scene_image != blank -%}
                <picture>
                  <source srcset="{{ scene_image | image_url: width: 480, format: 'webp' }}" media="(max-width: 640px)" type="image/webp">
                  <source srcset="{{ scene_image | image_url: width: 480 }}" media="(max-width: 640px)">
                  <source srcset="{{ scene_image | image_url: width: 960, format: 'webp' }}" media="(max-width: 990px)" type="image/webp">
                  <source srcset="{{ scene_image | image_url: width: 960 }}" media="(max-width: 990px)">
                  <source srcset="{{ scene_image | image_url: width: 1500, format: 'webp' }}" type="image/webp">
                  {{ scene_image | image_url: width: 1500 | image_tag: loading: 'lazy', sizes: '(max-width: 640px) 100vw, (max-width: 990px) 50vw, 33vw', alt: scene_image.alt | default: product.title | escape, fetchpriority: 'low' }}
                </picture>
              {%- else -%}
                <div class="living-lookbook-scene--empty" aria-hidden="true">No image available</div>
              {%- endif -%}
            </div>
            <div class="living-lookbook-scene__veil"></div>
            <div class="living-lookbook-scene__content">
              <span class="living-lookbook-pin">
                <span>
                  <span class="living-lookbook-pin__label">Shop the photo</span>
                  <span class="living-lookbook-pin__title">{{ product.title | escape }}</span>
                </span>
              </span>
              <span>
                {%- if block.settings.chapter != blank -%}
                  <span class="living-lookbook-scene__chapter">{{ block.settings.chapter | escape }}</span>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <span class="living-lookbook-scene__title">{{ block.settings.title | escape }}</span>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span class="living-lookbook-scene__text">{{ block.settings.text | escape }}</span>
                {%- endif -%}
                <span class="living-lookbook-scene__cta">Open product</span>
              </span>
            </div>
          </a>
        {%- elsif block.shopify_attributes -%}
          <!-- Block {{ forloop.index }} requires a product selection. Please edit this block and select a product. -->
        {%- endif -%}
      {%- endfor -%}
      {%- if block_count == 0 -%}
        <div class="living-lookbook-scene--empty" style="grid-column: 1 / -1;">
          Add shoppable photo blocks to display products.
        </div>
      {%- endif -%}
    </div>
  </div>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": {{ section.settings.title | default: 'Living Lookbook' | json }},
      "description": {{ section.settings.copy | default: '' | json }},
      "mainEntity": {
        "@type": "Collection",
        "name": {{ section.settings.title | default: 'Living Lookbook' | json }},
        "numberOfItems": {{ block_count }}
      }
    }
  </script>

  <script>
    (function() {
      const selector = '#{{ selector }}';
      const section = document.querySelector(selector);
      if (!section) return;

      // Remove loading animation when images load
      const images = section.querySelectorAll('.living-lookbook-scene__image img');
      images.forEach(img => {
        const loadingContainer = img.closest('.living-lookbook-scene__image');
        
        function stopLoading() {
          if (loadingContainer) {
            loadingContainer.classList.remove('is-loading');
          }
        }

        img.addEventListener('load', stopLoading);
        img.addEventListener('error', function() {
          if (loadingContainer) {
            loadingContainer.classList.add('is-error');
            loadingContainer.innerHTML = '<div class="living-lookbook-scene--empty" aria-hidden="true">Image failed to load</div>';
          }
        });

        // Fallback: remove loading after 3 seconds
        setTimeout(stopLoading, 3000);
      });

      // Validate product URLs are safe (relative or same-origin)
      const productLinks = section.querySelectorAll('.living-lookbook-scene');
      productLinks.forEach(link => {
        const url = link.getAttribute('href');
        if (url && !url.startsWith('/') && !url.startsWith(window.location.origin)) {
          console.warn('Invalid product URL detected:', url);
          link.setAttribute('href', '#');
          link.setAttribute('aria-disabled', 'true');
        }
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Melato Living Lookbook",
  "tag": "section",
  "class": "section-melato-living-lookbook",
  "settings": [
    { "type": "text", "id": "section_anchor", "label": "Section anchor", "default": "living-lookbook" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Editorial commerce" },
    { "type": "text", "id": "title", "label": "Title", "default": "The Living Lookbook" },
    { "type": "textarea", "id": "copy", "label": "Intro copy", "default": "A cinematic lookbook that behaves like a shop floor: every editorial photo is a direct doorway to the exact Melato piece it shows." },
    { "type": "range", "id": "max_width", "min": 1100, "max": 1600, "step": 20, "unit": "px", "label": "Maximum width", "default": 1360 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#080706" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#f7efe2" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#b9aa96" },
    { "type": "color", "id": "accent_color", "label": "Pin accent", "default": "#c9974a" }
  ],
  "blocks": [
    {
      "type": "scene",
      "name": "Shoppable photo",
      "settings": [
        { "type": "product", "id": "product", "label": "Product shown in this photo" },
        { "type": "image_picker", "id": "image", "label": "Editorial photo", "info": "If empty, the selected product image is used." },
        { "type": "text", "id": "chapter", "label": "Chapter label", "default": "Scene 01" },
        { "type": "text", "id": "title", "label": "Scene title", "default": "Worn like a memory" },
        { "type": "textarea", "id": "text", "label": "Scene text", "default": "Tap the image to move from editorial mood into the exact product page." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Melato Living Lookbook",
      "blocks": [
        { "type": "scene", "settings": { "chapter": "Scene 01", "title": "Motion study", "text": "A product-linked frame for your strongest campaign image." } },
        { "type": "scene", "settings": { "chapter": "Scene 02", "title": "Soft signal", "text": "Every displayed photo opens the product it features." } },
        { "type": "scene", "settings": { "chapter": "Scene 03", "title": "After-hours uniform", "text": "Build a living editorial grid from real products, not dead inspiration." } }
      ]
    }
  ]
}
{% endschema %}

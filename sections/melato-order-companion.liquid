<div class="melato-order-bleed">
<div class="melato-order">
  {%- if section.settings.intro != blank -%}<div class="melato-order__intro">{{ section.settings.intro }}</div>{%- endif -%}

  {%- assign steps = section.settings.timeline | newline_to_br | split: '<br />' -%}
  {%- if steps.size > 0 -%}
    <ol class="melato-order__timeline">
      {%- for step in steps -%}{%- if step != blank -%}
        <li class="melato-order__step"><span class="melato-order__step-num">{{ forloop.index }}</span><span class="melato-order__step-label">{{ step }}</span></li>
      {%- endif -%}{%- endfor -%}
    </ol>
  {%- endif -%}

  {%- assign tile_blocks = section.blocks | where: 'type', 'tile' -%}
  {%- if tile_blocks.size > 0 -%}
    <h2 class="melato-order__tiles-heading">{{ section.settings.tiles_heading | default: 'Need help with this order?' }}</h2>
    <div class="melato-order__tiles">
      {%- for block in tile_blocks -%}
        {% render 'melato-fit-card', title: block.settings.title, text: block.settings.text, cta_label: block.settings.cta_label, url: block.settings.url | default: '#melato-support' %}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
</div>

{% stylesheet %}
.melato-order-bleed { background: #f4ead8 !important; }
.melato-order { max-width: 1000px; margin: 0 auto; padding: 0 1.25rem clamp(2rem,5vw,3.5rem); }
.melato-order__intro { max-width: 640px; margin: 0 auto clamp(2.5rem,6vw,4rem); text-align: center; }
.melato-order__intro p { color: #3a3833 !important; margin: 0; }
.melato-order__timeline { list-style: none; display: flex; overflow-x: auto; padding: 0; margin: 0 0 clamp(2.5rem,6vw,4rem); border-top: 1px solid rgba(10,10,10,.14); border-bottom: 1px solid rgba(10,10,10,.14); }
.melato-order__step { flex: 1 0 auto; min-width: 150px; padding: 1.25rem 1rem; border-right: 1px solid rgba(10,10,10,.14); display: flex; align-items: center; gap: .6rem; }
.melato-order__step:last-child { border-right: none; }
.melato-order__step-num { font-family: 'Bebas Neue', sans-serif; font-size: .9rem; color: #6f6d68 !important; }
.melato-order__step-label { font-size: .85rem; color: #0a0a0a !important; }
.melato-order__tiles-heading { color: #0a0a0a !important; font-weight: 500; text-align: center; margin: 0 0 1.25rem; font-size: 1.2rem; }
.melato-order__tiles { display: grid; grid-template-columns: repeat(2,1fr); gap: 1px; background: rgba(10,10,10,.14); border: 1px solid rgba(10,10,10,.14); }
@media (min-width: 760px) { .melato-order__tiles { grid-template-columns: repeat(3,1fr); } }
.melato-order__tiles .melato-fit__card { background: #f4ead8 !important; }
{% endstylesheet %}

{% schema %}
{
  "name": "Melato Order Companion", "tag": "section",
  "settings": [
    { "type": "richtext", "id": "intro", "label": "Intro copy (optional)" },
    { "type": "textarea", "id": "timeline", "label": "Timeline steps (one per line)", "default": "Order received\nGarment checked\nPrepared for packaging\nDispatched\nDelivered and ready to wear" },
    { "type": "text", "id": "tiles_heading", "label": "Tiles heading", "default": "Need help with this order?" }
  ],
  "blocks": [{ "type": "tile", "name": "Support tile", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "text", "label": "Text" },
      { "type": "text", "id": "cta_label", "label": "CTA label" },
      { "type": "url", "id": "url", "label": "Link (defaults to support form below)" }
  ]}],
  "max_blocks": 8,
  "presets": [{ "name": "Melato Order Companion", "blocks": [
      { "type": "tile", "settings": { "title": "Change address", "cta_label": "Contact us" } },
      { "type": "tile", "settings": { "title": "Order status", "cta_label": "Contact us" } },
      { "type": "tile", "settings": { "title": "Damaged or incorrect item", "cta_label": "Contact us" } },
      { "type": "tile", "settings": { "title": "Return or exchange", "cta_label": "Contact us" } },
      { "type": "tile", "settings": { "title": "Fit after delivery", "cta_label": "Contact us" } },
      { "type": "tile", "settings": { "title": "Care question", "cta_label": "Contact us" } }
  ]}]
}
{% endschema %}

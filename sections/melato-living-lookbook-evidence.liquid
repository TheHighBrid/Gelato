{% liquid
  assign archive_label = section.settings.archive_label | default: 'CASE FILE 02'
  assign archive_title = section.settings.archive_title | default: 'NEW EVIDENCE'
  assign archive_note = section.settings.archive_note | default: 'Photographs catalogued and framed as recovered visual evidence.'
  assign archive_source = section.settings.archive_source | default: 'case02'
  assign case_code = section.settings.case_code | default: 'LL-02'
%}

{% unless archive_source == 'case03' %}
  {{ 'melato-living-lookbook-evidence.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'melato-living-lookbook-evidence.js' | asset_url }}" defer></script>
{% endunless %}

{% capture evidence_manifest %}
  {% if archive_source == 'case03' %}
    {% render 'melato-living-lookbook-evidence-case03-data' %}
  {% else %}
    {% render 'melato-living-lookbook-evidence-data' %}~{% render 'melato-living-lookbook-evidence-case02-additions' %}
  {% endif %}
{% endcapture %}
{% assign evidence_items = evidence_manifest | strip | split: '~' %}

<section
  id="MelatoEvidenceArchive-{{ section.id }}"
  class="mea"
  data-evidence-archive
  data-case-code="{{ case_code | escape }}"
  aria-labelledby="MelatoEvidenceTitle-{{ section.id }}"
>
  <div class="mea__masthead">
    <div class="mea__masthead-rule" aria-hidden="true"></div>

    <div class="mea__masthead-grid">
      <div class="mea__identity">
        <p class="mea__eyebrow">MELATO / LIVING LOOKBOOK</p>
        <h2 id="MelatoEvidenceTitle-{{ section.id }}" class="mea__title">
          <span>{{ archive_label | escape }}</span>
          {{ archive_title | escape }}
        </h2>
      </div>

      <div class="mea__brief">
        <p>{{ archive_note | escape }}</p>
        <dl class="mea__registry">
          <div>
            <dt>Filed</dt>
            <dd>14 JUL 2026</dd>
          </div>
          <div>
            <dt>Volume</dt>
            <dd>{{ evidence_items.size }} FRAMES</dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>AUTHORIZED VIEWING</dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="mea__custody">
      <span>ARCHIVE 2025 / 2026</span>
      <span>CASE / {{ case_code | escape }}</span>
      <span>CLICK ANY EXHIBIT TO INSPECT</span>
    </div>
  </div>

  <div class="mea__board-shell">
    <div class="mea__board" role="list" aria-label="{{ archive_label | escape }} Living Lookbook evidence archive">
      {% for record in evidence_items %}
        {% assign fields = record | strip | split: '|' %}
        {% assign image_url = fields[0] | strip %}
        {% assign image_width = fields[1] | strip %}
        {% assign image_height = fields[2] | strip %}
        {% assign image_kind = fields[3] | strip %}
        {% assign evidence_number = forloop.index %}

        {% capture evidence_code %}
          {% if evidence_number < 10 %}0{% endif %}{{ evidence_number }}
        {% endcapture %}
        {% assign evidence_code = evidence_code | strip %}

        {% assign image_480 = image_url | append: '&width=480' %}
        {% assign image_760 = image_url | append: '&width=760' %}
        {% assign image_1100 = image_url | append: '&width=1100' %}
        {% assign image_full = image_url | append: '&width=2200' %}

        <figure
          class="mea__evidence mea__evidence--{{ image_kind }} mea__evidence--pattern-{{ forloop.index | modulo: 9 }}"
          role="listitem"
        >
          <button
            type="button"
            class="mea__open"
            data-evidence-open
            data-evidence-index="{{ forloop.index0 }}"
            data-evidence-full="{{ image_full | escape }}"
            data-evidence-code="{{ evidence_code }}"
            aria-label="Inspect {{ archive_label | escape }} evidence frame {{ evidence_code }}"
          >
            <span class="mea__mount mea__mount--top" aria-hidden="true"></span>
            <span class="mea__mount mea__mount--side" aria-hidden="true"></span>
            <span class="mea__image-well">
              <img
                src="{{ image_760 | escape }}"
                srcset="{{ image_480 | escape }} 480w, {{ image_760 | escape }} 760w, {{ image_1100 | escape }} 1100w"
                sizes="(min-width: 1280px) 22vw, (min-width: 900px) 29vw, (min-width: 600px) 44vw, 88vw"
                width="{{ image_width }}"
                height="{{ image_height }}"
                alt="Melato {{ archive_label | escape }} evidence frame {{ evidence_code }}"
                {% if forloop.index <= 4 %}
                  loading="eager"
                  fetchpriority="high"
                {% else %}
                  loading="lazy"
                {% endif %}
                decoding="async"
              >
            </span>
          </button>

          <figcaption class="mea__caption">
            <span class="mea__caption-primary">EXHIBIT {{ evidence_code }}</span>
            <span class="mea__caption-secondary">
              {% if image_kind == 'fragment' %}
                CONTACT FRAGMENT
              {% elsif image_kind == 'master' %}
                MASTER PRINT
              {% else %}
                LIVING STUDY
              {% endif %}
            </span>
            <span class="mea__caption-code">{{ case_code | escape }} / {{ evidence_code }}</span>
          </figcaption>

          {% assign review_remainder = forloop.index | modulo: 6 %}
          <span class="mea__stamp" aria-hidden="true">
            {% if review_remainder == 0 %}REVIEWED{% else %}FILED{% endif %}
          </span>
        </figure>
      {% endfor %}
    </div>
  </div>

  <footer class="mea__footer">
    <p>THE LIVING LOOKBOOK / DOCUMENTING GARMENTS IN MOTION, MEMORY AND PLACE.</p>
    <p>END OF {{ archive_label | escape }} / {{ case_code | escape }} / {{ evidence_items.size }} EXHIBITS</p>
  </footer>

  <div
    class="mea__viewer"
    data-evidence-viewer
    role="dialog"
    aria-modal="true"
    aria-label="{{ archive_label | escape }} evidence image viewer"
    aria-hidden="true"
    hidden
  >
    <button type="button" class="mea__viewer-close" data-evidence-close aria-label="Close evidence viewer">
      <span aria-hidden="true">×</span>
    </button>

    <button type="button" class="mea__viewer-nav mea__viewer-nav--previous" data-evidence-previous aria-label="Previous evidence frame">
      <span aria-hidden="true">←</span>
    </button>

    <figure class="mea__viewer-figure">
      <div class="mea__viewer-mat">
        <img data-evidence-viewer-image src="" alt="">
      </div>
      <figcaption class="mea__viewer-caption">
        <span data-evidence-viewer-label>EXHIBIT 01</span>
        <span>CASE / {{ case_code | escape }}</span>
      </figcaption>
    </figure>

    <button type="button" class="mea__viewer-nav mea__viewer-nav--next" data-evidence-next aria-label="Next evidence frame">
      <span aria-hidden="true">→</span>
    </button>

    <p class="mea__viewer-counter" data-evidence-counter>01 / {{ evidence_items.size }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Living Lookbook Evidence",
  "tag": "section",
  "class": "section-living-lookbook-evidence",
  "settings": [
    {
      "type": "text",
      "id": "archive_label",
      "label": "Case label",
      "default": "CASE FILE 02"
    },
    {
      "type": "text",
      "id": "archive_title",
      "label": "Archive title",
      "default": "NEW EVIDENCE"
    },
    {
      "type": "textarea",
      "id": "archive_note",
      "label": "Archive note",
      "default": "Photographs catalogued and framed as recovered visual evidence."
    },
    {
      "type": "text",
      "id": "case_code",
      "label": "Case code",
      "default": "LL-02"
    },
    {
      "type": "select",
      "id": "archive_source",
      "label": "Evidence source",
      "default": "case02",
      "options": [
        {
          "value": "case02",
          "label": "Case File 02"
        },
        {
          "value": "case03",
          "label": "Case File 03"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Living Lookbook Evidence"
    }
  ]
}
{% endschema %}

{% liquid
  assign anchor = section.settings.section_anchor | default: 'living-book'
  assign source = section.settings.archive_source | default: 'all'
  assign season = section.settings.season | default: 'Season I'
  assign shop_label = section.settings.shop_label | default: 'Shop this frame'

  if source == 'case02'
    capture manifest
      render 'melato-living-lookbook-evidence-data'
      echo '~'
      render 'melato-living-lookbook-evidence-case02-additions'
    endcapture
  elsif source == 'case03'
    capture manifest
      render 'melato-living-lookbook-evidence-case03-data'
    endcapture
  else
    capture manifest
      render 'melato-living-lookbook-evidence-data'
      echo '~'
      render 'melato-living-lookbook-evidence-case02-additions'
      echo '~'
      render 'melato-living-lookbook-evidence-case03-data'
    endcapture
  endif

  assign records = manifest | strip | split: '~'
  assign cover_fields = records.first | strip | split: '|'
  assign cover_image = cover_fields[0] | strip
  assign title_words = section.settings.title | split: ' '
%}

{{ 'melato-living-book.css' | asset_url | stylesheet_tag }}
<script src="{{ 'melato-living-book.js' | asset_url }}" defer="defer"></script>

<section id="{{ anchor | escape }}" class="mlb" data-melato-living-book>
  <header class="mlb-cover" data-mlb-reveal>
    {% if cover_image != blank %}
      <div class="mlb-cover-image" aria-hidden="true">
        <img
          src="{{ cover_image | append: '&width=2000' | escape }}"
          srcset="{{ cover_image | append: '&width=900' | escape }} 900w, {{ cover_image | append: '&width=1400' | escape }} 1400w, {{ cover_image | append: '&width=2000' | escape }} 2000w"
          sizes="100vw"
          width="{{ cover_fields[1] | strip }}"
          height="{{ cover_fields[2] | strip }}"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      </div>
    {% endif %}

    <div class="mlb-cover-grid">
      <div class="mlb-cover-copy">
        <p class="mlb-kicker">{{ section.settings.eyebrow | escape }}</p>
        <h1 class="mlb-title">
          {% for word in title_words %}
            {% if forloop.index == 2 %}<span class="mlb-title-accent">{{ word | escape }}</span>{% else %}{{ word | escape }}{% unless forloop.last %} {% endunless %}{% endif %}
          {% endfor %}
        </h1>
        <span class="mlb-season">{{ season | escape }} · Digital wardrobe archive</span>
        <p class="mlb-dek">{{ section.settings.dek | escape }}</p>
        <div class="mlb-cover-actions">
          <button class="mlb-button" type="button" data-mlb-scroll="#MLBChapter1-{{ section.id }}">Begin the story</button>
          <a class="mlb-text-link" href="#MLBIndex-{{ section.id }}">Wardrobe index ↗</a>
        </div>
      </div>

      <aside class="mlb-cover-note">
        <span class="mlb-overline">Read / Inspect / Acquire</span>
        <p>{{ section.settings.cover_note | escape }}</p>
        <a class="mlb-text-link" href="#MLBIndex-{{ section.id }}">Open the archive ↗</a>
      </aside>
    </div>

    <div class="mlb-progress" aria-hidden="true"><span></span></div>
  </header>

  <nav class="mlb-dossier" aria-label="Living Book chapters">
    <span class="mlb-dossier-label mlb-kicker">Case index</span>
    <a class="mlb-dossier-link is-current" href="#MLBChapter1-{{ section.id }}" data-mlb-scroll="#MLBChapter1-{{ section.id }}">01 / {{ section.settings.chapter_1_title | escape }}</a>
    <a class="mlb-dossier-link" href="#MLBChapter2-{{ section.id }}" data-mlb-scroll="#MLBChapter2-{{ section.id }}">02 / {{ section.settings.chapter_2_title | escape }}</a>
    <a class="mlb-dossier-link" href="#MLBChapter3-{{ section.id }}" data-mlb-scroll="#MLBChapter3-{{ section.id }}">03 / {{ section.settings.chapter_3_title | escape }}</a>
    <a class="mlb-dossier-link" href="#MLBChapter4-{{ section.id }}" data-mlb-scroll="#MLBChapter4-{{ section.id }}">04 / {{ section.settings.chapter_4_title | escape }}</a>
    <a class="mlb-dossier-link" href="#MLBIndex-{{ section.id }}" data-mlb-scroll="#MLBIndex-{{ section.id }}">Wardrobe index</a>
  </nav>

  {% for chapter in (1..4) %}
    {% liquid
      if chapter == 1
        assign start_frame = 1
        assign end_frame = 12
        assign chapter_title = section.settings.chapter_1_title
        assign chapter_copy = section.settings.chapter_1_copy
      elsif chapter == 2
        assign start_frame = 13
        assign end_frame = 30
        assign chapter_title = section.settings.chapter_2_title
        assign chapter_copy = section.settings.chapter_2_copy
      elsif chapter == 3
        assign start_frame = 31
        assign end_frame = 48
        assign chapter_title = section.settings.chapter_3_title
        assign chapter_copy = section.settings.chapter_3_copy
      else
        assign start_frame = 49
        assign end_frame = 999
        assign chapter_title = section.settings.chapter_4_title
        assign chapter_copy = section.settings.chapter_4_copy
      endif
      capture chapter_code
        if chapter < 10
          echo '0'
        endif
        echo chapter
      endcapture
    %}

    <section id="MLBChapter{{ chapter }}-{{ section.id }}" class="mlb-chapter" data-chapter-number="{{ chapter_code | strip }}" data-mlb-chapter>
      <header class="mlb-chapter-intro" data-mlb-reveal>
        <div>
          <span class="mlb-overline mlb-chapter-number">Chapter {{ chapter_code | strip }}</span>
          <h2 class="mlb-chapter-title">{{ chapter_title | escape }}</h2>
        </div>
        <div>
          <p class="mlb-chapter-copy">{{ chapter_copy | escape }}</p>
          <span class="mlb-chapter-meta mlb-kicker">A visual correspondence / {{ season | escape }}</span>
        </div>
      </header>

      <div class="mlb-grid" role="list">
        {% for record in records %}
          {% assign fields = record | strip | split: '|' %}
          {% assign image_url = fields[0] | strip %}
          {% if image_url == blank %}{% continue %}{% endif %}
          {% assign frame_number = forloop.index %}
          {% if frame_number < start_frame or frame_number > end_frame %}{% continue %}{% endif %}

          {% liquid
            assign image_width = fields[1] | strip
            assign image_height = fields[2] | strip
            assign image_kind = fields[3] | strip | default: 'study'
            assign p1 = blank
            assign p2 = blank
            assign p3 = blank
            assign frame_note = blank
            for block in section.blocks
              assign mapped_frame = block.settings.frame_number | plus: 0
              if mapped_frame == frame_number
                assign p1 = block.settings.product_one
                assign p2 = block.settings.product_two
                assign p3 = block.settings.product_three
                assign frame_note = block.settings.frame_note
                break
              endif
            endfor
            capture frame_code
              if frame_number < 10
                echo '0'
              endif
              echo frame_number
            endcapture
            assign mod6 = frame_number | modulo: 6
            assign mod10 = frame_number | modulo: 10
            capture card_class
              echo 'mlb-frame'
              if mod10 == 1 or mod10 == 7
                echo ' is-hero'
              elsif mod6 == 0
                echo ' is-wide'
              elsif mod6 == 3
                echo ' is-tall'
              elsif image_kind == 'fragment'
                echo ' is-detail'
              endif
            endcapture
            if image_kind == 'fragment'
              assign frame_type = 'Detail study'
            elsif image_kind == 'master'
              assign frame_type = 'Cover print'
            else
              assign frame_type = 'Living study'
            endif
          %}

          <figure class="{{ card_class | strip }}" role="listitem" data-mlb-reveal>
            <button
              class="mlb-frame-trigger"
              type="button"
              data-mlb-open
              data-mlb-image="{{ image_url | append: '&width=1800' | escape }}"
              data-mlb-alt="Melato Living Book {{ season | escape }} frame {{ frame_code | strip }}"
              data-mlb-frame="{{ frame_code | strip }}"
              data-mlb-kind="{{ frame_type | escape }}"
              data-mlb-note="{{ frame_note | default: chapter_copy | escape }}"
              aria-haspopup="dialog"
              aria-label="Open Living Book frame {{ frame_code | strip }}"
            >
              <img
                src="{{ image_url | append: '&width=1000' | escape }}"
                srcset="{{ image_url | append: '&width=520' | escape }} 520w, {{ image_url | append: '&width=1000' | escape }} 1000w, {{ image_url | append: '&width=1400' | escape }} 1400w"
                sizes="(min-width: 1280px) 34vw, (min-width: 990px) 42vw, (min-width: 641px) 48vw, 100vw"
                width="{{ image_width }}"
                height="{{ image_height }}"
                alt="Melato Living Book {{ season | escape }} frame {{ frame_code | strip }}"
                {% if frame_number <= 2 %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                decoding="async"
              >
              <span class="mlb-frame-caption"><span class="mlb-frame-no">{{ frame_code | strip }}</span><span class="mlb-frame-kind">{{ frame_type | escape }}</span></span>
            </button>

            {% if p1 != blank or p2 != blank or p3 != blank %}
              <details class="mlb-frame-shop">
                <summary>{{ shop_label | escape }}</summary>
                <div class="mlb-product-list">
                  {% if frame_note != blank %}<span class="mlb-kicker">{{ frame_note | escape }}</span>{% endif %}
                  {% if p1 != blank %}<a class="mlb-product" href="{{ p1.url }}" aria-label="Shop {{ p1.title | escape }} from Living Book frame {{ frame_code | strip }}">{% if p1.featured_image %}<img src="{{ p1.featured_image | image_url: width: 150 }}" alt="" loading="lazy" width="150" height="190">{% endif %}<span><strong>{{ p1.title | escape }}</strong>{% if section.settings.show_prices %}<span class="mlb-price">{{ p1.price | money }}</span>{% endif %}</span><span class="mlb-product-cta">View</span></a>{% endif %}
                  {% if p2 != blank %}<a class="mlb-product" href="{{ p2.url }}" aria-label="Shop {{ p2.title | escape }} from Living Book frame {{ frame_code | strip }}">{% if p2.featured_image %}<img src="{{ p2.featured_image | image_url: width: 150 }}" alt="" loading="lazy" width="150" height="190">{% endif %}<span><strong>{{ p2.title | escape }}</strong>{% if section.settings.show_prices %}<span class="mlb-price">{{ p2.price | money }}</span>{% endif %}</span><span class="mlb-product-cta">View</span></a>{% endif %}
                  {% if p3 != blank %}<a class="mlb-product" href="{{ p3.url }}" aria-label="Shop {{ p3.title | escape }} from Living Book frame {{ frame_code | strip }}">{% if p3.featured_image %}<img src="{{ p3.featured_image | image_url: width: 150 }}" alt="" loading="lazy" width="150" height="190">{% endif %}<span><strong>{{ p3.title | escape }}</strong>{% if section.settings.show_prices %}<span class="mlb-price">{{ p3.price | money }}</span>{% endif %}</span><span class="mlb-product-cta">View</span></a>{% endif %}
                </div>
              </details>

              <template data-mlb-product-template>
                <div class="mlb-product-list">
                  {% if frame_note != blank %}<span class="mlb-kicker">{{ frame_note | escape }}</span>{% endif %}
                  {% if p1 != blank %}<a class="mlb-product" href="{{ p1.url }}">{% if p1.featured_image %}<img src="{{ p1.featured_image | image_url: width: 220 }}" alt="" loading="lazy" width="220" height="280">{% endif %}<span><strong>{{ p1.title | escape }}</strong>{% if section.settings.show_prices %}<span class="mlb-price">{{ p1.price | money }}</span>{% endif %}</span><span class="mlb-product-cta">Shop the piece ↗</span></a>{% endif %}
                  {% if p2 != blank %}<a class="mlb-product" href="{{ p2.url }}">{% if p2.featured_image %}<img src="{{ p2.featured_image | image_url: width: 220 }}" alt="" loading="lazy" width="220" height="280">{% endif %}<span><strong>{{ p2.title | escape }}</strong>{% if section.settings.show_prices %}<span class="mlb-price">{{ p2.price | money }}</span>{% endif %}</span><span class="mlb-product-cta">Shop the piece ↗</span></a>{% endif %}
                  {% if p3 != blank %}<a class="mlb-product" href="{{ p3.url }}">{% if p3.featured_image %}<img src="{{ p3.featured_image | image_url: width: 220 }}" alt="" loading="lazy" width="220" height="280">{% endif %}<span><strong>{{ p3.title | escape }}</strong>{% if section.settings.show_prices %}<span class="mlb-price">{{ p3.price | money }}</span>{% endif %}</span><span class="mlb-product-cta">Shop the piece ↗</span></a>{% endif %}
                </div>
              </template>
            {% elsif section.settings.show_unlinked_note %}
              <p class="mlb-kicker">Editorial frame / product routing pending</p>
            {% endif %}
          </figure>
        {% endfor %}
      </div>
    </section>
  {% endfor %}

  <section id="MLBIndex-{{ section.id }}" class="mlb-index" data-mlb-reveal>
    <div class="mlb-index-inner">
      <div>
        <span class="mlb-overline">Wardrobe index</span>
        <h2 class="mlb-index-title">{{ section.settings.index_title | escape }}</h2>
        <p>{{ section.settings.index_copy | escape }}</p>
      </div>
      <div class="mlb-index-grid">
        {% assign indexed = '' %}
        {% for block in section.blocks %}
          {% assign p1 = block.settings.product_one %}{% assign p2 = block.settings.product_two %}{% assign p3 = block.settings.product_three %}
          {% if p1 != blank %}{% assign token = '|' | append: p1.handle | append: '|' %}{% unless indexed contains token %}{% assign indexed = indexed | append: token %}<a class="mlb-index-link" href="{{ p1.url }}"><small>Frame {{ block.settings.frame_number }}</small><strong>{{ p1.title | escape }}</strong></a>{% endunless %}{% endif %}
          {% if p2 != blank %}{% assign token = '|' | append: p2.handle | append: '|' %}{% unless indexed contains token %}{% assign indexed = indexed | append: token %}<a class="mlb-index-link" href="{{ p2.url }}"><small>Frame {{ block.settings.frame_number }}</small><strong>{{ p2.title | escape }}</strong></a>{% endunless %}{% endif %}
          {% if p3 != blank %}{% assign token = '|' | append: p3.handle | append: '|' %}{% unless indexed contains token %}{% assign indexed = indexed | append: token %}<a class="mlb-index-link" href="{{ p3.url }}"><small>Frame {{ block.settings.frame_number }}</small><strong>{{ p3.title | escape }}</strong></a>{% endunless %}{% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <footer class="mlb-close"><span>Creative direction: Melato</span><span>{{ season | escape }} / {{ section.settings.title | escape }}</span><span>Read the next chapter</span></footer>

  <dialog class="mlb-viewer" aria-labelledby="MLBViewerTitle-{{ section.id }}" data-mlb-viewer>
    <button class="mlb-viewer-close" type="button" aria-label="Close frame viewer" data-mlb-viewer-close>×</button>
    <div class="mlb-viewer-grid">
      <div class="mlb-viewer-media"><img alt="" width="1400" height="1800" data-mlb-viewer-image></div>
      <div class="mlb-viewer-info">
        <span class="mlb-overline mlb-viewer-count" data-mlb-viewer-count>Frame</span>
        <h2 id="MLBViewerTitle-{{ section.id }}" class="mlb-viewer-title" data-mlb-viewer-title>Living study</h2>
        <p class="mlb-viewer-copy" data-mlb-viewer-note></p>
        <div class="mlb-viewer-products" data-mlb-viewer-products></div>
        <p class="mlb-viewer-empty" data-mlb-viewer-empty hidden>Editorial frame. Its wardrobe route is being filed.</p>
      </div>
    </div>
  </dialog>
</section>

{% schema %}
{
  "name": "Melato Living Book",
  "tag": "section",
  "class": "section-melato-living-book",
  "settings": [
    { "type": "text", "id": "section_anchor", "label": "Section anchor", "default": "living-book" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "MELATO / LIVING BOOK" },
    { "type": "text", "id": "title", "label": "Title", "default": "The Living Book" },
    { "type": "text", "id": "season", "label": "Season label", "default": "Season I" },
    { "type": "textarea", "id": "dek", "label": "Cover copy", "default": "A cinematic wardrobe archive. Read the scene, inspect the garment, shop the piece." },
    { "type": "textarea", "id": "cover_note", "label": "Cover side note", "default": "The lookbook becomes a digital fashion book: chaptered editorial pacing, verified product routing, and a wardrobe index that lets customers shop without breaking the cinematic mood." },
    {
      "type": "select",
      "id": "archive_source",
      "label": "Image archive source",
      "default": "all",
      "options": [
        { "value": "all", "label": "All living archive frames" },
        { "value": "case02", "label": "Case file 02 only" },
        { "value": "case03", "label": "Case file 03 only" }
      ]
    },
    { "type": "text", "id": "shop_label", "label": "Frame shopping label", "default": "Shop this frame" },
    { "type": "checkbox", "id": "show_prices", "label": "Show prices in frame product cards", "default": true },
    { "type": "checkbox", "id": "show_unlinked_note", "label": "Mark frames without assigned products", "default": false },
    { "type": "text", "id": "chapter_1_title", "label": "Chapter 1 title", "default": "The Uniform" },
    { "type": "textarea", "id": "chapter_1_copy", "label": "Chapter 1 copy", "default": "Tracksuits, repetition, identity and the pieces that make Melato instantly readable." },
    { "type": "text", "id": "chapter_2_title", "label": "Chapter 2 title", "default": "Eve's Wardrobe" },
    { "type": "textarea", "id": "chapter_2_copy", "label": "Chapter 2 copy", "default": "Fitted silhouettes, evening textures and the more intimate side of the wardrobe." },
    { "type": "text", "id": "chapter_3_title", "label": "Chapter 3 title", "default": "Objects of Use" },
    { "type": "textarea", "id": "chapter_3_copy", "label": "Chapter 3 copy", "default": "Bags, accessories, small details and the quiet items that finish a look." },
    { "type": "text", "id": "chapter_4_title", "label": "Chapter 4 title", "default": "After Hours" },
    { "type": "textarea", "id": "chapter_4_copy", "label": "Chapter 4 copy", "default": "The archive becomes darker, more cinematic and closer to memory than product photography." },
    { "type": "text", "id": "index_title", "label": "Wardrobe index title", "default": "Shop the archive" },
    { "type": "textarea", "id": "index_copy", "label": "Wardrobe index copy", "default": "Every verified garment assigned to a Living Book frame is collected here as a clean shopping exit after the editorial experience." }
  ],
  "blocks": [
    {
      "type": "wardrobe_frame",
      "name": "Shoppable frame",
      "settings": [
        { "type": "range", "id": "frame_number", "label": "Frame number", "min": 1, "max": 150, "step": 1, "default": 1 },
        { "type": "product", "id": "product_one", "label": "Primary product" },
        { "type": "product", "id": "product_two", "label": "Secondary product" },
        { "type": "product", "id": "product_three", "label": "Third product" },
        { "type": "text", "id": "frame_note", "label": "Frame product note", "default": "Verified wardrobe" }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    { "name": "Melato Living Book" }
  ]
}
{% endschema %}

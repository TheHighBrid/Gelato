{% comment %}
  sections/main-account.liquid
{% endcomment %}

<section class="section-spacing">
  <div class="container">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:48px;" class="drip-reveal">
      <h1 class="heading-md">{{ 'account.my_account' | t }}</h1>
      <a href="{{ routes.account_logout_url }}" class="btn btn--secondary btn--sm">{{ 'account.logout' | t }}</a>
    </div>

    <div style="display:grid;grid-template-columns:2fr 1fr;gap:48px;align-items:start;" class="account-grid">

      <div class="drip-reveal">
        <h2 class="heading-xs" style="margin-bottom:24px;">{{ 'account.orders' | t }}</h2>
        {%- if customer.orders.size > 0 -%}
          <table style="width:100%;border-collapse:collapse;">
            <thead>
              <tr>
                <th style="text-align:left;padding:12px 0;border-bottom:1px solid var(--color-border);" class="text-label">Order</th>
                <th style="text-align:left;padding:12px 0;border-bottom:1px solid var(--color-border);" class="text-label">Date</th>
                <th style="text-align:left;padding:12px 0;border-bottom:1px solid var(--color-border);" class="text-label">Status</th>
                <th style="text-align:right;padding:12px 0;border-bottom:1px solid var(--color-border);" class="text-label">Total</th>
              </tr>
            </thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td style="padding:16px 0;border-bottom:1px solid var(--color-border);">
                    <a href="{{ order.customer_url }}" style="color:var(--color-accent);font-family:var(--font-mono-family);font-size:0.75rem;">{{ order.name }}</a>
                  </td>
                  <td style="padding:16px 0;border-bottom:1px solid var(--color-border);color:var(--color-muted);font-family:var(--font-mono-family);font-size:0.7rem;">
                    {{ order.created_at | date: '%b %d, %Y' }}
                  </td>
                  <td style="padding:16px 0;border-bottom:1px solid var(--color-border);">
                    <span class="badge badge--{% if order.financial_status == 'paid' %}new{% else %}limited{% endif %}">
                      {{ order.financial_status | capitalize }}
                    </span>
                  </td>
                  <td style="padding:16px 0;border-bottom:1px solid var(--color-border);text-align:right;font-family:var(--font-mono-family);font-size:0.8rem;">
                    {{ order.total_price | money }}
                  </td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        {%- else -%}
          <p style="color:var(--color-muted);">You haven't placed any orders yet.</p>
          <a href="/collections/all" class="btn btn--primary btn--sm" style="margin-top:20px;">Shop the Drop</a>
        {%- endif -%}
      </div>

      <div class="drip-reveal drip-reveal--delay-2" style="background:var(--color-surface);padding:32px;">
        <h2 class="heading-xs" style="margin-bottom:20px;">Account Details</h2>
        <p style="font-family:var(--font-mono-family);font-size:0.75rem;color:var(--color-muted);line-height:1.8;">
          {{ customer.name }}<br>
          {{ customer.email }}<br>
          {%- if customer.default_address -%}
            <br>
            {{ customer.default_address.address1 }}<br>
            {{ customer.default_address.city }}, {{ customer.default_address.country }}
          {%- endif -%}
        </p>
        <a href="{{ routes.account_addresses_url }}" class="btn btn--secondary btn--sm btn--full" style="margin-top:20px;">
          {{ 'account.addresses' | t }}
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  @media (max-width: 768px) { .account-grid { grid-template-columns: 1fr !important; } }
</style>

{% schema %}
{ "name": "Account", "tag": "section", "settings": [] }
{% endschema %}

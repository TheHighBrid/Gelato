{% comment %}
  sections/main-account.liquid
  Customer order ledger and account details.
{% endcomment %}

<section class="melato-account" aria-labelledby="MelatoAccountTitle-{{ section.id }}">
  <header class="melato-account__header">
    <div>
      <p class="melato-account__eyebrow">Account / {{ customer.first_name | default: 'Melato' }}</p>
      <h1 id="MelatoAccountTitle-{{ section.id }}" class="melato-account__title">Account</h1>
    </div>
    <a href="{{ routes.account_logout_url }}" class="melato-utility-link">Sign out</a>
  </header>

  <div class="melato-account__grid">
    <section aria-labelledby="MelatoOrdersTitle-{{ section.id }}">
      <h2 id="MelatoOrdersTitle-{{ section.id }}" class="melato-account__section-title">Order archive</h2>

      {%- if customer.orders.size > 0 -%}
        <table class="melato-account__table">
          <thead>
            <tr>
              <th>Order</th>
              <th>Date</th>
              <th>Status</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr>
                <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
                <td><span class="melato-account__status">{{ order.financial_status | capitalize }}</span></td>
                <td>{{ order.total_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      {%- else -%}
        <div class="melato-empty-state" style="padding-inline:0;min-height:260px;">
          <p class="melato-empty-state__eyebrow">Orders / 00</p>
          <div>
            <h3 class="melato-empty-state__title">No orders filed yet.</h3>
            <p class="melato-empty-state__copy">When you place a Melato order, its history and status will appear here.</p>
            <div class="melato-empty-state__actions">
              <a class="melato-utility-link" href="/collections/new-arrivals">View new arrivals</a>
            </div>
          </div>
        </div>
      {%- endif -%}
    </section>

    <aside class="melato-account__details" aria-labelledby="MelatoAccountDetails-{{ section.id }}">
      <p class="melato-account__label">Account details</p>
      <h2 id="MelatoAccountDetails-{{ section.id }}" class="melato-account__section-title">{{ customer.name | default: customer.email }}</h2>
      <p>
        {{ customer.email }}
        {%- if customer.default_address -%}
          <br><br>{{ customer.default_address.address1 }}
          {%- if customer.default_address.address2 != blank -%}<br>{{ customer.default_address.address2 }}{%- endif -%}
          <br>{{ customer.default_address.city }}{% if customer.default_address.province != blank %}, {{ customer.default_address.province }}{% endif %}
          <br>{{ customer.default_address.country }} {{ customer.default_address.zip }}
        {%- endif -%}
      </p>
      <a href="{{ routes.account_addresses_url }}" class="melato-utility-link">Manage addresses</a>
    </aside>
  </div>
</section>

{% schema %}
{ "name": "Account", "tag": "section", "settings": [] }
{% endschema %}

{% comment %}
  sections/main-404.liquid
{% endcomment %}

<section class="error-page">
  <div>
    <span class="error-page__code" aria-hidden="true">404</span>
    <h1 class="heading-md drip-reveal" style="margin-bottom:16px;">
      {{ section.settings.subheading | default: "This page dropped. And it's not coming back." }}
    </h1>
    <p style="color:var(--color-muted);margin-bottom:36px;" class="drip-reveal drip-reveal--delay-1">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;" class="drip-reveal drip-reveal--delay-2">
      <a href="{{ section.settings.cta_url | default: '/' }}" class="btn btn--primary">
        {{ section.settings.cta_label | default: 'Back to the Drop' }}
      </a>
      <a href="/collections/all" class="btn btn--secondary">Shop All</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "This page dropped. And it's not coming back." },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "Back to the Drop" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ]
}
{% endschema %}

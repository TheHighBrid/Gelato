{% comment %}
  MELATO HOUSE HEADER
  Phase 1 global shell.
  Keeps the existing Shopify menu, logo, account and cart integrations while
  replacing the previous pill-heavy visual system with a fashion-house shell.
{% endcomment %}

{% liquid
  assign house_menu = section.settings.menu
  if house_menu == blank
    assign house_menu = linklists['main-menu']
  endif
  assign logo_alt = section.settings.logo.alt | default: shop.name | escape
%}

<header
  id="mxh-{{ section.id }}"
  class="mxh melato-house-header"
  role="banner"
  data-house-header
  style="--house-logo-width:{{ section.settings.logo_width | default: 188 }}px;--house-header-bg:{{ section.settings.house_bg_color | default: '#f0e8d9' }};--house-header-fg:{{ section.settings.house_text_color | default: '#090909' }}"
>
  <div class="melato-house-header__bar">
    <div class="melato-house-header__left">
      <button
        class="melato-house-header__word"
        type="button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="MelatoHouseMenu-{{ section.id }}"
        data-house-menu-open
      >Menu</button>
    </div>

    <a class="melato-house-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo
          | image_url: width: 900
          | image_tag:
            class: 'melato-house-header__logo-image',
            alt: logo_alt,
            loading: 'eager',
            fetchpriority: 'high',
            widths: '140, 180, 220, 280, 360, 480, 640, 900',
            sizes: '(max-width: 749px) 38vw, 220px'
        }}
      {% else %}
        <span class="melato-house-header__logo-text">{{ shop.name }}</span>
      {% endif %}
    </a>

    <div class="melato-house-header__right" aria-label="Store tools">
      <button
        class="melato-house-header__utility melato-house-header__search-button"
        type="button"
        aria-label="Open search"
        aria-expanded="false"
        aria-controls="MelatoHouseSearch-{{ section.id }}"
        data-house-search-open
      >Search</button>

      {% if shop.customer_accounts_enabled and section.settings.show_account %}
        <a
          class="melato-house-header__utility melato-house-header__account"
          href="{{ routes.account_url }}"
          rel="nofollow"
        >Account</a>
      {% endif %}

      <button
        class="mxh__bag"
        type="button"
        aria-label="Bag with {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}"
        data-cart-open
      >
        <span>Bag</span>
        <span class="mxh__bag-count" data-cart-item-count>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>

  <aside
    id="MelatoHouseMenu-{{ section.id }}"
    class="melato-house-menu"
    aria-label="Melato navigation"
    aria-hidden="true"
    hidden
    data-house-menu
  >
    <div class="melato-house-menu__inner">
      <div class="melato-house-menu__top">
        <p class="melato-house-menu__mark">Melato / Index</p>
        <button class="melato-house-menu__close" type="button" aria-label="Close navigation" data-house-menu-close>
          <span></span><span></span>
        </button>
      </div>

      <div class="melato-house-menu__grid">
        <div>
          <p class="melato-house-menu__section-title">Shop</p>
          <nav class="melato-house-menu__primary" aria-label="Primary navigation">
            {% if house_menu != blank and house_menu.links.size > 0 %}
              {% for link in house_menu.links %}
                <div class="melato-house-menu__item">
                  <a class="melato-house-menu__primary-link{% if link.active %} is-active{% endif %}" href="{{ link.url }}">
                    <span>{{ link.title }}</span>
                    <small>{{ forloop.index | prepend: '0' }}</small>
                  </a>
                  {% if link.links.size > 0 %}
                    <div class="melato-house-menu__children">
                      {% for child_link in link.links %}
                        <a href="{{ child_link.url }}">{{ child_link.title }}</a>
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
            {% else %}
              <div class="melato-house-menu__item"><a class="melato-house-menu__primary-link" href="/collections/new-arrivals"><span>New</span><small>01</small></a></div>
              <div class="melato-house-menu__item"><a class="melato-house-menu__primary-link" href="/collections/men"><span>Men</span><small>02</small></a></div>
              <div class="melato-house-menu__item"><a class="melato-house-menu__primary-link" href="/collections/womens-zellige-capsule"><span>Women</span><small>03</small></a></div>
              <div class="melato-house-menu__item"><a class="melato-house-menu__primary-link" href="/collections/tracksuits"><span>The Uniform</span><small>04</small></a></div>
              <div class="melato-house-menu__item"><a class="melato-house-menu__primary-link" href="/collections/accessories"><span>Objects</span><small>05</small></a></div>
            {% endif %}
          </nav>
        </div>

        <div class="melato-house-menu__secondary">
          <div class="melato-house-menu__secondary-group melato-house-menu__feature">
            <p class="melato-house-menu__section-title">Current</p>
            <p class="melato-house-menu__feature-name">Texture &amp; Form</p>
            <p class="melato-house-menu__feature-meta">Drop 001 / Melato</p>
            <a class="melato-house-link" href="/collections/drop-001-texture-form">Explore current drop</a>
          </div>

          <div class="melato-house-menu__secondary-group">
            <p class="melato-house-menu__section-title">World of Melato</p>
            <a href="/collections/the-living-lookbook">Living Book</a>
            <a href="/pages/our-story">Our Story</a>
            <a href="/collections/ovum-before-the-world">Collections</a>
          </div>

          <div class="melato-house-menu__secondary-group">
            <p class="melato-house-menu__section-title">Client Services</p>
            <a href="/pages/contact">Contact</a>
            <a href="/pages/faq">FAQ</a>
            <a href="/pages/size-guide">Size Guide</a>
            <a href="/pages/shipping-returns">Delivery &amp; Returns</a>
            <a href="/pages/preview">Private Preview</a>
          </div>
        </div>
      </div>

      <div class="melato-house-menu__bottom">
        <button class="melato-house-menu__search" type="button" data-house-search-open>Search Melato</button>
        <span class="melato-house-menu__mark">{{ localization.country.name }} / {{ localization.country.currency.iso_code }}</span>
      </div>
    </div>
  </aside>

  <section
    id="MelatoHouseSearch-{{ section.id }}"
    class="melato-house-search"
    aria-label="Search Melato"
    aria-hidden="true"
    hidden
    data-house-search
  >
    <div class="melato-house-search__inner">
      <div class="melato-house-search__top">
        <p class="melato-house-search__mark">Search / Melato</p>
        <button class="melato-house-search__close" type="button" aria-label="Close search" data-house-search-close>
          <span></span><span></span>
        </button>
      </div>

      <div class="melato-house-search__stage">
        <form action="{{ routes.search_url }}" method="get" role="search">
          <label class="melato-house-search__label" for="MelatoHouseSearchInput-{{ section.id }}">Find a piece</label>
          <div class="melato-house-search__field-row">
            <input
              id="MelatoHouseSearchInput-{{ section.id }}"
              class="melato-house-search__input"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="Search"
              autocomplete="off"
              aria-describedby="MelatoHouseSearchStatus-{{ section.id }}"
              data-house-search-input
            >
            <input type="hidden" name="type" value="product">
            <input type="hidden" name="options[prefix]" value="last">
            <button class="melato-house-search__submit" type="submit">View all results</button>
          </div>
          <p id="MelatoHouseSearchStatus-{{ section.id }}" class="melato-house-search__status" role="status" aria-live="polite" data-house-search-status>Type at least two characters.</p>
          <div class="melato-house-search__results" data-house-search-results></div>
        </form>
      </div>
    </div>
  </section>
</header>

{% schema %}
{
  "name": "Melato House Header",
  "limit": 1,
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu" },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 120, "max": 320, "step": 4, "unit": "px", "default": 188 },
    { "type": "checkbox", "id": "show_account", "label": "Show account link on desktop", "default": true },
    { "type": "header", "content": "House colors" },
    { "type": "color", "id": "house_bg_color", "label": "Default header background", "default": "#f0e8d9" },
    { "type": "color", "id": "house_text_color", "label": "Default header text", "default": "#090909" },
    { "type": "color", "id": "house_accent_color", "label": "Accent", "default": "#9d4918" }
  ],
  "presets": [{ "name": "Melato House Header" }]
}
{% endschema %}

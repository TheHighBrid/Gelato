{% comment %}
  MELATO ATELIER HEADER
  Target: Gelato v4.9
  Purpose: one premium menu button, preserved logo, redesigned designer header/drawer/search/cart.
{% endcomment %}

{% liquid
  assign atelier_menu = section.settings.menu
  if atelier_menu == blank
    assign atelier_menu = linklists['main-menu']
  endif
  assign logo_alt = section.settings.logo.alt | default: shop.name | escape
%}

<header id="mxh-{{ section.id }}" class="mxh" role="banner" data-mxh>
  <div class="mxh__bar">
    <div class="mxh__left">
      <button class="mxh__menu" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mxh-drawer-{{ section.id }}" data-mxh-menu>
        <span class="mxh__menu-mark" aria-hidden="true">
          <svg viewBox="0 0 40 40" focusable="false">
            <path d="M7 20h26" />
            <path d="M20 7v26" />
            <circle cx="20" cy="20" r="15" />
          </svg>
        </span>
        <span class="mxh__menu-text">{{ section.settings.menu_label | default: 'Index' }}</span>
      </button>
    </div>

    <div class="mxh__center">
      <a class="mxh__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 900 | image_tag: class: 'mxh__logo-img', alt: logo_alt, loading: 'eager', widths: '140, 180, 220, 280, 360, 480, 640, 900', sizes: '(max-width: 749px) 138px, 210px' }}
        {% else %}
          <span class="mxh__wordmark">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <div class="mxh__right" aria-label="Header tools">
      <button class="mxh__text-btn mxh__search-btn" type="button" aria-label="Open search" aria-expanded="false" aria-controls="mxh-search-{{ section.id }}" data-mxh-search-open>Search</button>
      {% if shop.customer_accounts_enabled and section.settings.show_account %}
        <a class="mxh__text-btn mxh__account" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">Account</a>
      {% endif %}
      <a class="mxh__bag" href="{{ routes.cart_url }}" aria-label="Cart with {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}">
        <span>Bag</span>
        <span class="mxh__bag-count">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <div class="mxh__shade" hidden data-mxh-shade></div>

  <aside id="mxh-drawer-{{ section.id }}" class="mxh__drawer" aria-hidden="true" hidden data-mxh-drawer>
    <div class="mxh__drawer-inner">
      <div class="mxh__drawer-top">
        <span class="mxh__drawer-kicker">Melato / Navigation</span>
        <button class="mxh__close" type="button" aria-label="Close navigation" data-mxh-close>
          <span></span><span></span>
        </button>
      </div>

      <div class="mxh__drawer-grid">
        <div class="mxh__drawer-note">
          <p>{{ section.settings.drawer_note | default: 'Designer apparel, edited with intention. Built in Ottawa. Worn anywhere.' }}</p>
          <a href="{{ routes.all_products_collection_url }}">Collection</a>
        </div>

        <nav class="mxh__nav" aria-label="Main navigation">
          {% if atelier_menu != blank and atelier_menu.links.size > 0 %}
            {% for link in atelier_menu.links %}
              <div class="mxh__nav-item">
                <a class="mxh__nav-link{% if link.active %} is-active{% endif %}" href="{{ link.url }}">
                  <span>{{ forloop.index | prepend: '0' }}</span>
                  {{ link.title }}
                </a>
                {% if link.links.size > 0 %}
                  <div class="mxh__subnav">
                    {% for child_link in link.links %}
                      <a href="{{ child_link.url }}">{{ child_link.title }}</a>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          {% else %}
            <a class="mxh__nav-link" href="{{ routes.root_url }}"><span>01</span>Home</a>
            <a class="mxh__nav-link" href="{{ routes.all_products_collection_url }}"><span>02</span>Collection</a>
            <a class="mxh__nav-link" href="{{ routes.search_url }}"><span>03</span>Search</a>
          {% endif %}
        </nav>
      </div>

      <div class="mxh__drawer-bottom">
        <button class="mxh__drawer-search" type="button" data-mxh-search-open>Search the archive</button>
        <a href="{{ routes.cart_url }}">Cart / {{ cart.item_count }}</a>
      </div>
    </div>
  </aside>

  <section id="mxh-search-{{ section.id }}" class="mxh__search" aria-hidden="true" hidden data-mxh-search>
    <div class="mxh__search-panel">
      <button class="mxh__close mxh__search-close" type="button" aria-label="Close search" data-mxh-search-close><span></span><span></span></button>
      <p class="mxh__search-kicker">Search Melato</p>
      <form class="mxh__search-form" action="{{ routes.search_url }}" method="get" role="search">
        <label class="mxh__sr" for="mxh-search-input-{{ section.id }}">Search products</label>
        <input id="mxh-search-input-{{ section.id }}" type="search" name="q" placeholder="Type what you want" autocomplete="off" data-mxh-search-input>
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit">Search</button>
      </form>
    </div>
  </section>
</header>

<style>
  #mxh-{{ section.id }} {
    --mxh-bg: {{ section.settings.bg_color | default: '#050505' }};
    --mxh-text: {{ section.settings.text_color | default: '#F6F0E5' }};
    --mxh-muted: color-mix(in srgb, var(--mxh-text) 62%, transparent);
    --mxh-line: color-mix(in srgb, var(--mxh-text) 13%, transparent);
    --mxh-panel: #090909;
    --mxh-accent: {{ section.settings.accent_color | default: '#D8C7A7' }};
    --mxh-logo-width: {{ section.settings.logo_width | default: 188 }}px;
    position: sticky;
    top: 0;
    z-index: 1200;
    width: 100%;
    color: var(--mxh-text);
    background: color-mix(in srgb, var(--mxh-bg) 94%, transparent);
    border-bottom: 1px solid var(--mxh-line);
    backdrop-filter: blur(18px) saturate(125%);
    -webkit-backdrop-filter: blur(18px) saturate(125%);
    isolation: isolate;
  }

  #mxh-{{ section.id }} *, #mxh-{{ section.id }} *:before, #mxh-{{ section.id }} *:after { box-sizing: border-box; }
  #mxh-{{ section.id }} a { color: inherit; text-decoration: none; }
  #mobile-menu.mobile-menu { display: none !important; }

  #mxh-{{ section.id }} .mxh__bar {
    min-height: 78px;
    width: min(1440px, 100%);
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 54px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 18px;
  }

  #mxh-{{ section.id }} .mxh__left,
  #mxh-{{ section.id }} .mxh__right { display: flex; align-items: center; min-width: 0; }
  #mxh-{{ section.id }} .mxh__left { justify-content: flex-start; }
  #mxh-{{ section.id }} .mxh__center { display: flex; justify-content: center; align-items: center; min-width: 0; }
  #mxh-{{ section.id }} .mxh__right { justify-content: flex-end; gap: 10px; }

  #mxh-{{ section.id }} .mxh__logo { display: inline-flex; align-items: center; justify-content: center; line-height: 1; }
  #mxh-{{ section.id }} .mxh__logo-img {
    width: min(var(--mxh-logo-width), 34vw) !important;
    height: auto !important;
    max-height: 54px !important;
    max-width: min(var(--mxh-logo-width), 34vw) !important;
    object-fit: contain !important;
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
  }
  #mxh-{{ section.id }} .mxh__wordmark { font-family: var(--font-heading-family, sans-serif); font-size: clamp(28px, 4vw, 46px); letter-spacing: -.055em; text-transform: uppercase; }

  #mxh-{{ section.id }} button { font: inherit; color: inherit; }
  #mxh-{{ section.id }} .mxh__menu,
  #mxh-{{ section.id }} .mxh__text-btn,
  #mxh-{{ section.id }} .mxh__bag,
  #mxh-{{ section.id }} .mxh__drawer-search {
    border: 1px solid var(--mxh-line);
    background: rgba(255,255,255,.025);
    color: var(--mxh-text);
    min-height: 42px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 16px;
    text-transform: uppercase;
    letter-spacing: .14em;
    font-size: 11px;
    line-height: 1;
    cursor: pointer;
    transition: background .22s ease, border-color .22s ease, transform .22s ease, color .22s ease;
  }
  #mxh-{{ section.id }} .mxh__menu:hover,
  #mxh-{{ section.id }} .mxh__text-btn:hover,
  #mxh-{{ section.id }} .mxh__bag:hover,
  #mxh-{{ section.id }} .mxh__drawer-search:hover { background: var(--mxh-text); color: var(--mxh-bg); border-color: var(--mxh-text); transform: translateY(-1px); }

  #mxh-{{ section.id }} .mxh__menu-mark { width: 24px; height: 24px; display: grid; place-items: center; }
  #mxh-{{ section.id }} .mxh__menu-mark svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.35; stroke-linecap: round; stroke-linejoin: round; transition: transform .28s ease; }
  #mxh-{{ section.id }} .mxh__menu[aria-expanded="true"] .mxh__menu-mark svg { transform: rotate(45deg); }
  #mxh-{{ section.id }} .mxh__bag-count { min-width: 20px; height: 20px; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; background: var(--mxh-text); color: var(--mxh-bg); font-weight: 800; letter-spacing: 0; font-size: 11px; }
  #mxh-{{ section.id }} .mxh__bag:hover .mxh__bag-count { background: var(--mxh-bg); color: var(--mxh-text); }

  #mxh-{{ section.id }} .mxh__shade { position: fixed; inset: 0; z-index: 1; background: rgba(0,0,0,.58); backdrop-filter: blur(8px); }
  #mxh-{{ section.id }} .mxh__shade[hidden] { display: none !important; }

  #mxh-{{ section.id }} .mxh__drawer,
  #mxh-{{ section.id }} .mxh__search {
    position: fixed;
    inset: 0;
    z-index: 2;
    background: var(--mxh-panel);
    color: var(--mxh-text);
    opacity: 0;
    pointer-events: none;
    transition: opacity .25s ease;
  }
  #mxh-{{ section.id }} .mxh__drawer.is-open,
  #mxh-{{ section.id }} .mxh__search.is-open { opacity: 1; pointer-events: auto; }
  #mxh-{{ section.id }} .mxh__drawer[hidden], #mxh-{{ section.id }} .mxh__search[hidden] { display: none !important; }

  #mxh-{{ section.id }} .mxh__drawer-inner { min-height: 100svh; padding: clamp(20px, 4vw, 58px); display: grid; grid-template-rows: auto 1fr auto; gap: 32px; }
  #mxh-{{ section.id }} .mxh__drawer-top, #mxh-{{ section.id }} .mxh__drawer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 18px; }
  #mxh-{{ section.id }} .mxh__drawer-kicker, #mxh-{{ section.id }} .mxh__search-kicker { color: var(--mxh-muted); text-transform: uppercase; letter-spacing: .18em; font-size: 11px; margin: 0; }
  #mxh-{{ section.id }} .mxh__close { width: 46px; height: 46px; border: 1px solid var(--mxh-line); border-radius: 999px; background: transparent; position: relative; cursor: pointer; }
  #mxh-{{ section.id }} .mxh__close span { position: absolute; left: 50%; top: 50%; width: 18px; height: 1px; background: currentColor; transform-origin: center; }
  #mxh-{{ section.id }} .mxh__close span:first-child { transform: translate(-50%,-50%) rotate(45deg); }
  #mxh-{{ section.id }} .mxh__close span:last-child { transform: translate(-50%,-50%) rotate(-45deg); }

  #mxh-{{ section.id }} .mxh__drawer-grid { display: grid; grid-template-columns: minmax(220px, .72fr) minmax(280px, 1.35fr); gap: clamp(26px, 6vw, 96px); align-items: end; }
  #mxh-{{ section.id }} .mxh__drawer-note { max-width: 360px; align-self: start; }
  #mxh-{{ section.id }} .mxh__drawer-note p { margin: 0 0 24px; color: var(--mxh-muted); font-size: clamp(15px, 1.6vw, 19px); line-height: 1.45; letter-spacing: .01em; }
  #mxh-{{ section.id }} .mxh__drawer-note a { display: inline-flex; border-bottom: 1px solid currentColor; padding-bottom: 5px; text-transform: uppercase; letter-spacing: .14em; font-size: 11px; }
  #mxh-{{ section.id }} .mxh__nav { display: grid; gap: 2px; }
  #mxh-{{ section.id }} .mxh__nav-link { display: grid; grid-template-columns: 44px 1fr; align-items: baseline; gap: 16px; padding: clamp(10px, 1.3vw, 18px) 0; border-bottom: 1px solid var(--mxh-line); font-family: var(--font-heading-family, sans-serif); font-size: clamp(44px, 7.4vw, 118px); line-height: .86; letter-spacing: -.055em; text-transform: uppercase; }
  #mxh-{{ section.id }} .mxh__nav-link span { color: var(--mxh-accent); font-family: var(--font-body-family, sans-serif); font-size: 11px; letter-spacing: .14em; line-height: 1; }
  #mxh-{{ section.id }} .mxh__nav-link:hover { color: var(--mxh-accent); }
  #mxh-{{ section.id }} .mxh__subnav { display: flex; flex-wrap: wrap; gap: 10px 18px; padding: 12px 0 22px 60px; }
  #mxh-{{ section.id }} .mxh__subnav a { color: var(--mxh-muted); text-transform: uppercase; letter-spacing: .14em; font-size: 11px; }
  #mxh-{{ section.id }} .mxh__drawer-bottom a { color: var(--mxh-muted); text-transform: uppercase; letter-spacing: .14em; font-size: 11px; }

  #mxh-{{ section.id }} .mxh__search { display: grid; place-items: center; padding: 24px; background: rgba(5,5,5,.96); backdrop-filter: blur(18px); }
  #mxh-{{ section.id }} .mxh__search-panel { width: min(820px, 100%); position: relative; }
  #mxh-{{ section.id }} .mxh__search-close { position: absolute; right: 0; top: -70px; }
  #mxh-{{ section.id }} .mxh__search-form { display: grid; grid-template-columns: 1fr auto; gap: 12px; margin-top: 18px; }
  #mxh-{{ section.id }} .mxh__search-form input[type="search"] { width: 100%; min-height: 68px; border: 1px solid var(--mxh-line); border-radius: 999px; background: var(--mxh-text); color: var(--mxh-bg); padding: 0 25px; font-size: 18px; outline: none; }
  #mxh-{{ section.id }} .mxh__search-form button { min-height: 68px; border: 1px solid var(--mxh-text); border-radius: 999px; background: transparent; color: var(--mxh-text); padding: 0 28px; text-transform: uppercase; letter-spacing: .14em; font-size: 11px; font-weight: 800; cursor: pointer; }
  #mxh-{{ section.id }} .mxh__sr { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  body.mxh-lock { overflow: hidden; }

  @media (max-width: 749px) {
    #mxh-{{ section.id }} .mxh__bar { min-height: 70px; padding: 0 14px; gap: 8px; }
    #mxh-{{ section.id }} .mxh__menu { min-width: 42px; width: 42px; height: 42px; padding: 0; }
    #mxh-{{ section.id }} .mxh__menu-text, #mxh-{{ section.id }} .mxh__search-btn, #mxh-{{ section.id }} .mxh__account { display: none !important; }
    #mxh-{{ section.id }} .mxh__logo-img { width: min(var(--mxh-logo-width), 138px) !important; max-width: 138px !important; max-height: 42px !important; }
    #mxh-{{ section.id }} .mxh__bag { min-height: 42px; padding: 0 12px; font-size: 10px; }
    #mxh-{{ section.id }} .mxh__drawer-grid { grid-template-columns: 1fr; align-items: start; }
    #mxh-{{ section.id }} .mxh__drawer-note { order: 2; }
    #mxh-{{ section.id }} .mxh__nav-link { grid-template-columns: 34px 1fr; font-size: clamp(42px, 15vw, 72px); }
    #mxh-{{ section.id }} .mxh__subnav { padding-left: 50px; }
    #mxh-{{ section.id }} .mxh__drawer-bottom { align-items: flex-start; flex-direction: column; }
    #mxh-{{ section.id }} .mxh__search-form { grid-template-columns: 1fr; }
  }
  /* ============================================================
   MELATO — PREMIUM NAVIGATION DRAWER VISIBILITY FIX
   Fixes oversized menu links, weak transparency, poor contrast,
   and luxury menu spacing.
   ============================================================ */

#mxh-{{ section.id }} .mxh__shade {
  position: fixed !important;
  inset: 0 !important;
  z-index: 1 !important;
  background:
    radial-gradient(circle at 20% 20%, rgba(216, 199, 167, 0.08), transparent 34%),
    rgba(0, 0, 0, 0.82) !important;
  backdrop-filter: blur(18px) saturate(120%) !important;
  -webkit-backdrop-filter: blur(18px) saturate(120%) !important;
}

#mxh-{{ section.id }} .mxh__drawer {
  position: fixed !important;
  inset: 0 !important;
  z-index: 2 !important;
  background:
    linear-gradient(90deg, rgba(5, 5, 5, 0.98) 0%, rgba(7, 7, 7, 0.96) 42%, rgba(7, 7, 7, 0.92) 100%) !important;
  color: #f6f0e5 !important;
  overflow-y: auto !important;
  min-height: 100svh !important;
}

#mxh-{{ section.id }} .mxh__drawer::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
    radial-gradient(circle at 80% 18%, rgba(255,255,255,0.06), transparent 28%);
  background-size: 100% 110px, cover;
  opacity: 0.45;
}

#mxh-{{ section.id }} .mxh__drawer-inner {
  position: relative !important;
  z-index: 2 !important;
  width: min(1320px, calc(100% - 64px)) !important;
  margin: 0 auto !important;
  min-height: 100svh !important;
  padding: clamp(28px, 4vw, 58px) 0 !important;
  display: grid !important;
  grid-template-rows: auto 1fr auto !important;
  gap: clamp(32px, 5vw, 64px) !important;
}

#mxh-{{ section.id }} .mxh__drawer-top {
  min-height: 54px !important;
  border-bottom: 1px solid rgba(246, 240, 229, 0.10) !important;
  padding-bottom: 20px !important;
}

#mxh-{{ section.id }} .mxh__drawer-kicker {
  display: inline-flex !important;
  align-items: center !important;
  gap: 10px !important;
  color: rgba(246, 240, 229, 0.62) !important;
  font-size: 11px !important;
  letter-spacing: 0.22em !important;
  text-transform: uppercase !important;
}

#mxh-{{ section.id }} .mxh__drawer-kicker::before {
  content: "";
  width: 34px;
  height: 1px;
  background: rgba(216, 199, 167, 0.65);
}

#mxh-{{ section.id }} .mxh__close {
  background: rgba(246, 240, 229, 0.045) !important;
  border: 1px solid rgba(246, 240, 229, 0.14) !important;
  color: #f6f0e5 !important;
  transition: background 180ms ease, border-color 180ms ease, transform 180ms ease !important;
}

#mxh-{{ section.id }} .mxh__close:hover {
  background: #f6f0e5 !important;
  border-color: #f6f0e5 !important;
  color: #050505 !important;

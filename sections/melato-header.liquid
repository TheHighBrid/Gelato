}

#mxh-{{ section.id }} .mxh__drawer-grid {
  display: grid !important;
  grid-template-columns: minmax(260px, 0.48fr) minmax(420px, 0.92fr) !important;
  align-items: center !important;
  gap: clamp(44px, 7vw, 110px) !important;
}

#mxh-{{ section.id }} .mxh__drawer-note {
  align-self: center !important;
  max-width: 360px !important;
  padding: 28px !important;
  border: 1px solid rgba(246, 240, 229, 0.10) !important;
  background: rgba(255, 255, 255, 0.035) !important;
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.42) !important;
}

#mxh-{{ section.id }} .mxh__drawer-note p {
  color: rgba(246, 240, 229, 0.76) !important;
  font-size: clamp(14px, 1.15vw, 17px) !important;
  line-height: 1.55 !important;
  margin-bottom: 26px !important;
}

#mxh-{{ section.id }} .mxh__drawer-note a {
  color: #f6f0e5 !important;
  border-bottom: 1px solid rgba(246, 240, 229, 0.55) !important;
  font-size: 11px !important;
  letter-spacing: 0.16em !important;
}

#mxh-{{ section.id }} .mxh__nav {
  width: 100% !important;
  max-width: 760px !important;
  margin-left: auto !important;
  display: grid !important;
  gap: 0 !important;
}

#mxh-{{ section.id }} .mxh__nav-item {
  position: relative !important;
}

#mxh-{{ section.id }} .mxh__nav-link {
  display: grid !important;
  grid-template-columns: 42px 1fr !important;
  align-items: center !important;
  gap: 18px !important;
  padding: clamp(14px, 1.45vw, 22px) 0 !important;
  border-bottom: 1px solid rgba(246, 240, 229, 0.10) !important;
  color: #f6f0e5 !important;
  font-family: var(--font-heading-family, sans-serif) !important;
  font-size: clamp(42px, 5.4vw, 84px) !important;
  line-height: 0.88 !important;
  letter-spacing: -0.045em !important;
  text-transform: uppercase !important;
  text-shadow: 0 10px 40px rgba(0, 0, 0, 0.55) !important;
  transition: color 180ms ease, transform 180ms ease, padding-left 180ms ease !important;
}

#mxh-{{ section.id }} .mxh__nav-link span {
  color: rgba(216, 199, 167, 0.78) !important;
  font-family: var(--font-body-family, sans-serif) !important;
  font-size: 11px !important;
  font-weight: 600 !important;
  letter-spacing: 0.16em !important;
  line-height: 1 !important;
}

#mxh-{{ section.id }} .mxh__nav-link:hover,
#mxh-{{ section.id }} .mxh__nav-link.is-active {
  color: #d8c7a7 !important;
  transform: translateX(10px) !important;
}

#mxh-{{ section.id }} .mxh__subnav {
  padding: 12px 0 22px 60px !important;
  gap: 10px 18px !important;
}

#mxh-{{ section.id }} .mxh__subnav a {
  color: rgba(246, 240, 229, 0.58) !important;
  font-size: 11px !important;
  letter-spacing: 0.14em !important;
}

#mxh-{{ section.id }} .mxh__drawer-bottom {
  border-top: 1px solid rgba(246, 240, 229, 0.10) !important;
  padding-top: 20px !important;
}

#mxh-{{ section.id }} .mxh__drawer-search {
  background: rgba(246, 240, 229, 0.045) !important;
  border-color: rgba(246, 240, 229, 0.14) !important;
}

#mxh-{{ section.id }} .mxh__drawer-bottom a {
  color: rgba(246, 240, 229, 0.72) !important;
}

/* Mobile luxury drawer */
@media (max-width: 749px) {
  #mxh-{{ section.id }} .mxh__drawer {
    background: rgba(5, 5, 5, 0.98) !important;
  }

  #mxh-{{ section.id }} .mxh__drawer-inner {
    width: calc(100% - 32px) !important;
    padding: 22px 0 28px !important;
    gap: 28px !important;
  }

  #mxh-{{ section.id }} .mxh__drawer-grid {
    grid-template-columns: 1fr !important;
    gap: 28px !important;
    align-items: start !important;
  }

  #mxh-{{ section.id }} .mxh__nav {
    max-width: 100% !important;
    margin-left: 0 !important;
    order: 1 !important;
  }

  #mxh-{{ section.id }} .mxh__drawer-note {
    order: 2 !important;
    max-width: 100% !important;
    padding: 22px !important;
  }

  #mxh-{{ section.id }} .mxh__nav-link {
    grid-template-columns: 32px 1fr !important;
    gap: 12px !important;
    font-size: clamp(38px, 13vw, 62px) !important;
    line-height: 0.9 !important;
    padding: 15px 0 !important;
  }

  #mxh-{{ section.id }} .mxh__nav-link:hover {
    transform: translateX(4px) !important;
  }

  #mxh-{{ section.id }} .mxh__drawer-bottom {
    align-items: stretch !important;
  }

  #mxh-{{ section.id }} .mxh__drawer-search,
  #mxh-{{ section.id }} .mxh__drawer-bottom a {
    width: 100% !important;
    min-height: 46px !important;
    justify-content: center !important;
  }
}
</style>

<script>
  (function() {
    var root = document.getElementById('mxh-{{ section.id }}');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    var menuBtn = root.querySelector('[data-mxh-menu]');
    var closeBtn = root.querySelector('[data-mxh-close]');
    var drawer = root.querySelector('[data-mxh-drawer]');
    var shade = root.querySelector('[data-mxh-shade]');
    var search = root.querySelector('[data-mxh-search]');
    var searchOpeners = root.querySelectorAll('[data-mxh-search-open]');
    var searchClose = root.querySelector('[data-mxh-search-close]');
    var searchInput = root.querySelector('[data-mxh-search-input]');

    function lock(yes) { document.body.classList.toggle('mxh-lock', !!yes); }

    function openDrawer() {
      if (!drawer) return;
      closeSearch();
      drawer.hidden = false;
      if (shade) shade.hidden = false;
      requestAnimationFrame(function(){ drawer.classList.add('is-open'); });
      if (menuBtn) menuBtn.setAttribute('aria-expanded', 'true');
      drawer.setAttribute('aria-hidden', 'false');
      lock(true);
    }

    function closeDrawer() {
      if (!drawer) return;
      drawer.classList.remove('is-open');
      if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
      drawer.setAttribute('aria-hidden', 'true');
      window.setTimeout(function(){ drawer.hidden = true; if (shade && !search.classList.contains('is-open')) shade.hidden = true; }, 250);
      lock(false);
    }

    function openSearch() {
      if (!search) return;
      closeDrawer();
      search.hidden = false;
      if (shade) shade.hidden = false;
      requestAnimationFrame(function(){ search.classList.add('is-open'); });
      search.setAttribute('aria-hidden', 'false');
      searchOpeners.forEach(function(btn){ btn.setAttribute('aria-expanded', 'true'); });
      lock(true);
      window.setTimeout(function(){ if (searchInput) searchInput.focus(); }, 90);
    }

    function closeSearch() {
      if (!search) return;
      search.classList.remove('is-open');
      search.setAttribute('aria-hidden', 'true');
      searchOpeners.forEach(function(btn){ btn.setAttribute('aria-expanded', 'false'); });
      window.setTimeout(function(){ search.hidden = true; if (shade && !drawer.classList.contains('is-open')) shade.hidden = true; }, 250);
      lock(false);
    }

    if (menuBtn) menuBtn.addEventListener('click', function(){ drawer && drawer.classList.contains('is-open') ? closeDrawer() : openDrawer(); });
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (shade) shade.addEventListener('click', function(){ closeDrawer(); closeSearch(); });
    searchOpeners.forEach(function(btn){ btn.addEventListener('click', openSearch); });
    if (searchClose) searchClose.addEventListener('click', closeSearch);
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape') { closeDrawer(); closeSearch(); } });
    window.addEventListener('scroll', function(){ root.classList.toggle('is-scrolled', window.scrollY > 8); }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Melato Atelier Header",
  "limit": 1,
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu" },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 120, "max": 320, "step": 4, "unit": "px", "default": 188 },
    { "type": "text", "id": "menu_label", "label": "Menu button label", "default": "Index" },
    { "type": "text", "id": "drawer_note", "label": "Drawer note", "default": "Designer apparel, edited with intention. Built in Ottawa. Worn anywhere." },
    { "type": "checkbox", "id": "show_account", "label": "Show account link on desktop", "default": false },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Header background", "default": "#050505" },
    { "type": "color", "id": "text_color", "label": "Header text", "default": "#F6F0E5" },
    { "type": "color", "id": "accent_color", "label": "Drawer accent", "default": "#D8C7A7" }
  ],
  "presets": [{ "name": "Melato Atelier Header" }]
}
{% endschema %}

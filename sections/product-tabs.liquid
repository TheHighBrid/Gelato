{% comment %}
  sections/product-tabs.liquid
{% endcomment %}

<div class="container product-tabs" data-accordion-group>
  {%- for block in section.blocks -%}
    {%- if block.type == 'tab' -%}
      {%- assign tab_id = 'tab-' | append: section.id | append: '-' | append: forloop.index -%}
      <div class="product-tab" {{ block.shopify_attributes }}>
        <button
          class="product-tab__trigger"
          aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-controls="{{ tab_id }}"
          data-accordion-trigger
        >
          {{ block.settings.title }}
          <span class="product-tab__icon" aria-hidden="true">+</span>
        </button>
        <div
          class="product-tab__content"
          id="{{ tab_id }}"
          aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
        >
          <div class="product-tab__body">
            {%- if block.settings.content != blank -%}
              {{ block.settings.content }}
            {%- else -%}
              {{ product.description }}
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Product Tabs",
  "tag": "div",
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "title", "label": "Tab title", "default": "Description" },
        { "type": "richtext", "id": "content", "label": "Content", "info": "Leave blank to use product description" }
      ]
    }
  ],
  "settings": []
}
{% endschema %}

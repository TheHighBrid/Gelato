{% comment %}
  MELATO PRODUCT PAGE BIBLE 1.0.0
  Canonical product renderer.
  New products write canonical fields only. Legacy aliases are read-only migration fallbacks.
  One fact, one section. No invented specifications. No duplicate trust copy.
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign product_title_down = product.title | downcase
  assign product_type_down = product.product_type | downcase
  assign tags_down = product.tags | join: '|' | downcase

  assign family = 'other'
  if product_type_down contains 'fragrance' or product_type_down contains 'eau de' or product_title_down contains 'eau de toilette' or product_title_down contains 'eau de parfum' or product_title_down contains 'perfume'
    assign family = 'fragrance'
  elsif product_type_down contains 'denim' or product_type_down contains 'jean' or tags_down contains 'denim'
    assign family = 'denim'
  elsif product_type_down contains 'bag' or product_type_down contains 'duffle' or product_type_down contains 'tote' or product_type_down contains 'messenger'
    assign family = 'bags'
  elsif product_type_down contains 'sunglass' or product_type_down contains 'eyewear' or product_type_down contains 'tie' or product_type_down contains 'suspender' or product_type_down contains 'belt' or product_type_down contains 'accessor'
    assign family = 'accessories'
  elsif product_type_down contains 'shoe' or product_type_down contains 'footwear' or product_type_down contains 'sneaker' or product_type_down contains 'boot'
    assign family = 'footwear'
  elsif product_type_down contains 'jacket' or product_type_down contains 'pant' or product_type_down contains 'trouser' or product_type_down contains 'shirt' or product_type_down contains 'tee' or product_type_down contains 'top' or product_type_down contains 'dress' or product_type_down contains 'skirt' or product_type_down contains 'bodysuit' or product_type_down contains 'vest' or product_type_down contains 'polo' or product_type_down contains 'knit'
    assign family = 'apparel'
  endif

  assign subtitle = product.metafields.custom.subtitle.value | default: product.metafields.custom.pdp_hook.value
  assign story_copy = product.description
  if story_copy == blank
    assign story_copy = product.metafields.melato.product_story.value | default: product.metafields.custom.story.value | default: product.metafields.custom.product_story.value | default: product.metafields.custom.pdp_story.value | default: product.metafields.custom.pdp_story_content.value
  endif

  assign fit_copy = product.metafields.custom.fit_notes.value
  if fit_copy == blank
    assign fit_copy = product.metafields.melato.fit.value | default: product.metafields.custom.fit_summary.value | default: product.metafields.custom.fit.value
  endif
  assign fit_details = product.metafields.custom.pdp_fit_details.value

  assign material_copy = product.metafields.custom.material_composition.value
  if material_copy == blank
    assign material_copy = product.metafields.melato.material_composition.value | default: product.metafields.custom.fabric_composition.value | default: product.metafields.custom.composition.value | default: product.metafields.custom.material.value | default: product.metafields.custom.material_profile.value
  endif
  assign material_details = product.metafields.custom.pdp_material_details.value

  assign care_copy = product.metafields.custom.care_instructions.value
  if care_copy == blank
    assign care_copy = product.metafields.melato.care_instructions.value | default: product.metafields.custom.care.value | default: product.metafields.custom.care_notes.value | default: product.metafields.custom.care_short.value
  endif
  assign care_details = product.metafields.custom.pdp_care_details.value

  assign construction_details = product.metafields.custom.construction.value
  if construction_details == blank
    assign construction_details = product.metafields.custom.design_features.value | default: product.metafields.custom.pdp_technical_details.value
  endif
  assign construction_paragraph = product.metafields.custom.pdp_technical_paragraph.value

  assign ingredients_copy = product.metafields.custom.ingredients.value | default: product.metafields.custom.scent_profile.value
  assign use_copy = product.metafields.custom.use.value | default: product.metafields.custom.application.value
  assign made_in = product.metafields.custom.made_in.value
  assign material_profile = product.metafields.custom.material_profile.value
  assign product_specification = product.metafields.custom.product_specification.value
  assign related_products = product.metafields.custom.related_products.value
  assign pdp_bible_version = product.metafields.custom.pdp_bible_version.value

  assign matching_product = product.metafields.custom.companion_product.value
  if matching_product == blank
    assign matching_product = product.metafields.custom.matching_product.value | default: product.metafields.custom.matching_piece.value | default: product.metafields.custom.set_partner.value
  endif

  assign size_guide_page = product.metafields.custom.size_guide.value
  assign size_guide_url = '/pages/size-guide'
  if size_guide_page != blank
    assign size_guide_url = size_guide_page.url
  endif

  assign bg_seed = product.metafields.custom.background_hex_color_code.value | default: section.settings.bg
  assign fg_seed = product.metafields.custom.foreground_hex_color_code.value | default: section.settings.text
  assign palette_1 = product.metafields.custom.palette_1.value | default: section.settings.accent_2
  assign palette_2 = product.metafields.custom.palette_2.value | default: section.settings.accent
  assign palette_3 = product.metafields.custom.palette_3.value | default: fg_seed
  assign product_button_accent = current_variant.metafields.custom.theme_accent.value | default: palette_1 | default: section.settings.accent

  assign is_fur = false
  if product_type_down contains 'fur' or product_title_down contains 'fur'
    assign is_fur = true
  endif
  if is_fur and care_copy == blank and care_details == blank
    assign care_copy = 'Professional fur cleaning only. Store in a cool, ventilated space away from moisture, direct heat, and prolonged sunlight.'
  endif

  # Historical safety block. Internal sampling language is never a specification.
  if product.handle == 'protective-custody'
    assign material_copy_check = material_copy | strip_html | downcase
    assign story_copy_check = story_copy | strip_html | downcase
    assign construction_copy_check = construction_paragraph | strip_html | downcase
    if material_copy_check contains 'suggested production composition'
      assign material_copy = blank
      assign material_details = blank
    endif
    if story_copy_check contains 'suggested production composition'
      assign story_copy = blank
    endif
    if construction_copy_check contains 'suggested production composition'
      assign construction_paragraph = blank
      assign construction_details = blank
    endif
  endif
-%}

<section
  id="MelatoPDP-{{ section.id }}"
  class="melato-pdp-rebuild"
  style="--pdp-bg:{{ bg_seed }};--pdp-surface:{{ section.settings.surface }};--pdp-text:{{ fg_seed }};--pdp-muted:{{ section.settings.muted }};--pdp-accent:{{ product_button_accent }};--pdp-title-accent:{{ palette_1 }};--melato-pdp-section-title:{{ palette_1 }}"
  data-product-section
  data-pdp-family="{{ family }}"
  data-pdp-bible-version="{{ pdp_bible_version | default: 'legacy-unmigrated' | escape }}"
  data-palette-1="{{ palette_1 }}"
  data-palette-2="{{ palette_2 }}"
  data-palette-3="{{ palette_3 }}"
  data-foreground="{{ fg_seed }}"
  data-surface="{{ section.settings.surface }}"
>
  <div class="pdp-shell">
    <div class="pdp-hero">
      <div class="pdp-gallery" aria-label="{{ product.title | escape }} product gallery">
        {%- if featured_media -%}
          {%- assign featured_alt = featured_media.alt | strip -%}
          {%- if featured_alt == blank -%}{%- assign featured_alt = product.title | append: ' - Front - Product view' -%}{%- endif -%}
          <div class="pdp-main-media">
            {{ featured_media | image_url: width: 1800 | image_tag: class: 'pdp-main-image', loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1500, 1800', sizes: '(min-width: 1000px) 55vw, 100vw', alt: featured_alt }}
          </div>
        {%- endif -%}

        {%- if product.media.size > 1 -%}
          <div class="pdp-thumbs" role="list" aria-label="Product image views">
            {%- for media in product.media limit: 10 -%}
              {%- assign media_alt = media.alt | strip -%}
              {%- if media_alt == blank -%}{%- assign media_alt = product.title | append: ' - Product view ' | append: forloop.index -%}{%- endif -%}
              <button class="pdp-thumb{% if media.id == featured_media.id %} is-active{% endif %}" type="button" data-pdp-thumb data-media-src="{{ media | image_url: width: 1800 }}" data-media-alt="{{ media_alt | escape }}" aria-label="Show {{ media_alt | escape }}" role="listitem">
                {{ media | image_url: width: 220 | image_tag: class: 'pdp-thumb-image', loading: 'lazy', widths: '110, 160, 220', sizes: '110px', alt: media_alt }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="pdp-buybox">
        {%- if section.settings.eyebrow != blank -%}<p class="pdp-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h1 class="pdp-title">{{ product.title }}</h1>
        {%- if subtitle != blank -%}<p class="pdp-thesis">{{ subtitle }}</p>{%- endif -%}

        <div class="pdp-price-row" id="PDPPrice-{{ section.id }}" aria-label="Price">
          <span class="pdp-price">{{ current_variant.price | money }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}<s class="pdp-compare">{{ current_variant.compare_at_price | money }}</s>{%- endif -%}
        </div>

        {% form 'product', product, id: product_form_id, class: 'pdp-form' %}
          {%- if product.has_only_default_variant -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
          {%- else -%}
            {%- for option in product.options_with_values -%}
              <fieldset class="pdp-option">
                <div class="pdp-option__header">
                  <legend>{{ option.name }}</legend>
                  {%- assign option_name_down = option.name | downcase -%}
                  {%- if option_name_down == 'size' and family == 'apparel' or option_name_down == 'size' and family == 'denim' or option_name_down == 'size' and family == 'footwear' -%}
                    {%- if size_guide_page != blank -%}
                      <button class="size-guide-trigger" type="button" data-open-size-drawer aria-haspopup="dialog" aria-expanded="false">Product measurements</button>
                    {%- else -%}
                      <a class="size-guide-trigger" href="{{ size_guide_url }}">Fit guide</a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
                <div class="pdp-option-grid">
                  {%- for value in option.values -%}
                    {%- liquid
                      assign value_available = false
                      for variant in product.variants
                        if option.position == 1 and variant.option1 == value and variant.available
                          assign value_available = true
                        elsif option.position == 2 and variant.option2 == value and variant.available
                          assign value_available = true
                        elsif option.position == 3 and variant.option3 == value and variant.available
                          assign value_available = true
                        endif
                      endfor
                    -%}
                    <label class="pdp-choice{% if option.selected_value == value %} is-selected{% endif %}{% unless value_available %} is-sold-out{% endunless %}">
                      <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} data-option-position="{{ option.position }}" {% unless value_available %}disabled{% endunless %}>
                      <span>{{ value }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
          {%- endif -%}

          <div class="pdp-atc-row">
            <label class="visually-hidden" for="PDPQty-{{ section.id }}">Quantity</label>
            <input id="PDPQty-{{ section.id }}" class="pdp-qty" type="number" name="quantity" min="1" value="1">
            <button class="pdp-atc{% unless current_variant.available %} pdp-atc--oos{% endunless %}" type="submit" name="add" data-pdp-atc {% unless current_variant.available %}disabled{% endunless %}>
              {% if current_variant.available %}Add to cart{% else %}Out of stock{% endif %}
            </button>
          </div>
        {% endform %}

        {% render 'back-in-stock-form', product: product %}

        <p class="pdp-shipping-returns">Ships in 1 to 3 business days. Complimentary delivery on all orders. Returns accepted on eligible unworn items under the posted return policy.</p>

        {%- comment -%}
          Bible v1.0: purchase-decision facts belong in the buybox.
          Non-fragrance PDPs expose Materials, Fit and Care here.
          Fragrance uses category-appropriate Ingredients, Use and Care.
        {%- endcomment -%}
        {%- if family == 'fragrance' -%}
          {%- if ingredients_copy != blank or use_copy != blank or care_details != blank or care_copy != blank -%}
            <div class="pdp-buybox-specs" aria-label="Product details">
              <p class="pdp-buybox-specs__eyebrow">Product details</p>
              {%- if ingredients_copy != blank -%}
                <details class="pdp-buybox-spec">
                  <summary><span>Ingredients</span><span class="pdp-buybox-spec__icon" aria-hidden="true">+</span></summary>
                  <div class="pdp-buybox-spec__body pdp-rte">{{ ingredients_copy }}</div>
                </details>
              {%- endif -%}
              {%- if use_copy != blank -%}
                <details class="pdp-buybox-spec">
                  <summary><span>Use</span><span class="pdp-buybox-spec__icon" aria-hidden="true">+</span></summary>
                  <div class="pdp-buybox-spec__body pdp-rte">{{ use_copy }}</div>
                </details>
              {%- endif -%}
              {%- if care_details != blank or care_copy != blank -%}
                <details class="pdp-buybox-spec">
                  <summary><span>Care</span><span class="pdp-buybox-spec__icon" aria-hidden="true">+</span></summary>
                  <div class="pdp-buybox-spec__body pdp-rte">{%- if care_details != blank -%}<ul>{%- for item in care_details -%}<li>{{ item }}</li>{%- endfor -%}</ul>{%- else -%}{{ care_copy }}{%- endif -%}</div>
                </details>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- else -%}
          {%- if material_details != blank or material_copy != blank or fit_details != blank or fit_copy != blank or care_details != blank or care_copy != blank -%}
            <div class="pdp-buybox-specs" aria-label="Product details">
              <p class="pdp-buybox-specs__eyebrow">Product details</p>
              {%- if material_details != blank or material_copy != blank -%}
                <details class="pdp-buybox-spec">
                  <summary><span>Materials</span><span class="pdp-buybox-spec__icon" aria-hidden="true">+</span></summary>
                  <div class="pdp-buybox-spec__body pdp-rte">{%- if material_details != blank -%}<ul>{%- for item in material_details -%}<li>{{ item }}</li>{%- endfor -%}</ul>{%- else -%}{{ material_copy }}{%- endif -%}</div>
                </details>
              {%- endif -%}
              {%- if fit_details != blank or fit_copy != blank -%}
                <details class="pdp-buybox-spec">
                  <summary><span>Fit</span><span class="pdp-buybox-spec__icon" aria-hidden="true">+</span></summary>
                  <div class="pdp-buybox-spec__body pdp-rte">{%- if fit_details != blank -%}<ul>{%- for item in fit_details -%}<li>{{ item }}</li>{%- endfor -%}</ul>{%- else -%}{{ fit_copy }}{%- endif -%}<p class="pdp-inline-link"><a href="{{ size_guide_url }}">Melato Fit Guide</a></p></div>
                </details>
              {%- endif -%}
              {%- if care_details != blank or care_copy != blank -%}
                <details class="pdp-buybox-spec">
                  <summary><span>Care</span><span class="pdp-buybox-spec__icon" aria-hidden="true">+</span></summary>
                  <div class="pdp-buybox-spec__body pdp-rte">{%- if care_details != blank -%}<ul>{%- for item in care_details -%}<li>{{ item }}</li>{%- endfor -%}</ul>{%- else -%}{{ care_copy }}{%- endif -%}</div>
                </details>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>

    <div class="pdp-content-stack">
      {%- if story_copy != blank -%}
        <section class="pdp-panel pdp-story" aria-labelledby="PDPStory-{{ section.id }}">
          <header class="pdp-section-head"><h2 id="PDPStory-{{ section.id }}" class="melato-pdp-bible-section-title">Story</h2></header>
          <div class="pdp-rte rte">{{ story_copy }}</div>
        </section>
      {%- endif -%}

      <section class="pdp-spec-grid" aria-label="Product specifications">
        {%- if family == 'fragrance' -%}
          {%- comment -%}Fragrance purchase-decision specs are surfaced in the buybox above.{%- endcomment -%}
        {%- else -%}
          {%- if construction_details != blank or construction_paragraph != blank -%}
            <details class="pdp-spec melato-pdp-bible-section-title"><summary>Construction</summary><div class="pdp-rte">{%- if construction_details != blank -%}<ul>{%- for detail in construction_details -%}<li>{{ detail }}</li>{%- endfor -%}</ul>{%- endif -%}{%- if construction_paragraph != blank -%}<p>{{ construction_paragraph }}</p>{%- endif -%}</div></details>
          {%- endif -%}

          {%- if use_copy != blank and family == 'bags' or use_copy != blank and family == 'accessories' -%}
            <details class="pdp-spec melato-pdp-bible-section-title"><summary>Use</summary><div class="pdp-rte">{{ use_copy }}</div></details>
          {%- endif -%}
        {%- endif -%}
      </section>

      {%- if matching_product != blank -%}
        <section class="pdp-panel pdp-set" aria-labelledby="PDPSet-{{ section.id }}">
          <header class="pdp-section-head"><h2 id="PDPSet-{{ section.id }}" class="melato-pdp-bible-section-title">Complete the Set</h2></header>
          <div class="pdp-set-grid" role="list">
            <article class="pdp-set-card" role="listitem">
              {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 800 | image_tag: class: 'pdp-set-image', loading: 'lazy', widths: '300, 500, 800', alt: product.title | append: ' - Selected piece' }}{%- endif -%}
              <h3 class="purchase-summary__title">{{ product.title }}</h3>
              <p class="purchase-summary__price">{{ product.price | money }}</p>
            </article>
            <article class="pdp-set-card" role="listitem">
              <a class="pdp-set-media-link" href="{{ matching_product.url }}" aria-label="View {{ matching_product.title | escape }}">
                {%- if matching_product.featured_image -%}{{ matching_product.featured_image | image_url: width: 800 | image_tag: class: 'pdp-set-image', loading: 'lazy', widths: '300, 500, 800', alt: matching_product.title | append: ' - Matching piece' }}{%- endif -%}
              </a>
              <h3 class="purchase-summary__title"><a href="{{ matching_product.url }}">{{ matching_product.title }}</a></h3>
              <p class="purchase-summary__price">{{ matching_product.price | money }}</p>
              <a class="pdp-set-cta" href="{{ matching_product.url }}">View matching piece</a>
            </article>
          </div>
        </section>
      {%- endif -%}
    </div>
  </div>

  <div class="pdp-sticky-atc" data-pdp-sticky aria-hidden="true">
    <div class="purchase-summary"><strong class="purchase-summary__title">{{ product.title }}</strong><span class="purchase-summary__price" id="PDPStickyPrice-{{ section.id }}">{{ current_variant.price | money }}</span></div>
    <button type="button" data-pdp-sticky-button class="{% unless current_variant.available %}pdp-atc--oos{% endunless %}" {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}Add to cart{% else %}Out of stock{% endif %}</button>
  </div>

  <script type="application/json" id="PDPVariants-{{ section.id }}">{{ product.variants | json }}</script>
</section>

{% render 'size-guide-drawer', product: product %}

<script>
(function(){
  var section=document.getElementById('MelatoPDP-{{ section.id }}');
  if(!section)return;
  var mainImage=section.querySelector('.pdp-main-image');
  var form=section.querySelector('.pdp-form');
  var variants=[];
  try{variants=JSON.parse(document.getElementById('PDPVariants-{{ section.id }}').textContent||'[]')}catch(error){}

  section.querySelectorAll('[data-pdp-thumb]').forEach(function(button){
    button.addEventListener('click',function(){
      section.querySelectorAll('[data-pdp-thumb]').forEach(function(item){item.classList.remove('is-active')});
      button.classList.add('is-active');
      if(mainImage){mainImage.src=button.getAttribute('data-media-src');mainImage.alt=button.getAttribute('data-media-alt')||mainImage.alt;mainImage.removeAttribute('srcset')}
    });
  });

  function formatMoney(cents){if(window.Shopify&&Shopify.formatMoney)return Shopify.formatMoney(cents,{{ shop.money_format | json }});return '$'+(cents/100).toFixed(2)}
  function selections(){return Array.prototype.map.call(section.querySelectorAll('.pdp-option'),function(fieldset){var selected=fieldset.querySelector('input:checked');return selected?selected.value:null})}
  function selectedVariant(){var values=selections();return variants.find(function(variant){return variant.options.every(function(value,index){return values[index]===value})})}
  function updateVariant(variant){
    if(!variant||!form)return;
    var idInput=form.querySelector('[data-variant-id]');if(idInput)idInput.value=variant.id;
    var price=section.querySelector('#PDPPrice-{{ section.id }}');if(price)price.innerHTML='<span class="pdp-price">'+formatMoney(variant.price)+'</span>'+(variant.compare_at_price&&variant.compare_at_price>variant.price?'<s class="pdp-compare">'+formatMoney(variant.compare_at_price)+'</s>':'');
    var stickyPrice=section.querySelector('#PDPStickyPrice-{{ section.id }}');if(stickyPrice)stickyPrice.textContent=formatMoney(variant.price);
    [section.querySelector('[data-pdp-atc]'),section.querySelector('[data-pdp-sticky-button]')].forEach(function(button){if(!button)return;button.disabled=!variant.available;button.textContent=variant.available?'Add to cart':'Out of stock';button.classList.toggle('pdp-atc--oos',!variant.available)});
    if(variant.featured_image&&mainImage){mainImage.src=variant.featured_image.src;mainImage.removeAttribute('srcset')}
    var url=new URL(window.location.href);url.searchParams.set('variant',variant.id);window.history.replaceState({},'',url.toString());
    document.dispatchEvent(new CustomEvent('variant:change',{detail:{variant:variant}}));
  }
  section.querySelectorAll('.pdp-choice input').forEach(function(input){input.addEventListener('change',function(){var grid=input.closest('.pdp-option-grid');if(grid)grid.querySelectorAll('.pdp-choice').forEach(function(label){label.classList.remove('is-selected')});input.closest('.pdp-choice').classList.add('is-selected');updateVariant(selectedVariant())})});
  var stickyButton=section.querySelector('[data-pdp-sticky-button]');if(stickyButton&&form)stickyButton.addEventListener('click',function(){var submit=form.querySelector('[data-pdp-atc]');if(submit)submit.click()});
  var sticky=section.querySelector('[data-pdp-sticky]');var atc=section.querySelector('[data-pdp-atc]');if(sticky&&atc&&'IntersectionObserver'in window){new IntersectionObserver(function(entries){entries.forEach(function(entry){if(window.innerWidth>749)return;sticky.classList.toggle('is-visible',!entry.isIntersecting);sticky.setAttribute('aria-hidden',entry.isIntersecting?'true':'false')})},{threshold:0}).observe(atc)}

  function hex(value){var clean=String(value||'').trim();if(!clean)return null;if(clean.charAt(0)!=='#')clean='#'+clean;return /^#[0-9a-f]{6}$/i.test(clean)?clean:null}
  function rgb(value){var v=hex(value);if(!v)return null;return [parseInt(v.slice(1,3),16),parseInt(v.slice(3,5),16),parseInt(v.slice(5,7),16)]}
  function lum(value){var c=rgb(value);if(!c)return 0;return c.map(function(n){n/=255;return n<=0.03928?n/12.92:Math.pow((n+0.055)/1.055,2.4)}).reduce(function(sum,n,i){return sum+n*[0.2126,0.7152,0.0722][i]},0)}
  function contrast(a,b){var l1=lum(a),l2=lum(b),hi=Math.max(l1,l2),lo=Math.min(l1,l2);return (hi+0.05)/(lo+0.05)}
  var surface=hex(section.dataset.surface)||'#111214';
  var foreground=hex(section.dataset.foreground)||'#f5f1e8';
  var palette=[hex(section.dataset.palette1),hex(section.dataset.palette2),hex(section.dataset.palette3)].filter(Boolean);
  var safe=palette.filter(function(color){return contrast(color,surface)>=4.5});
  if(!safe.length&&contrast(foreground,surface)>=4.5)safe=[foreground];
  if(!safe.length)safe=['#f5f1e8'];
  var index=0;
  var header=document.querySelector('.site-header, header.site-header, .header-wrapper');
  function applyAccent(){
    var color=safe[index%safe.length];
    section.style.setProperty('--melato-pdp-section-title',color);
    section.style.setProperty('--pdp-title-accent',color);
    document.documentElement.style.setProperty('--melato-pdp-section-title',color);
    document.documentElement.style.setProperty('--melato-pdp-header-tint',color);
    if(header){header.style.setProperty('--melato-pdp-header-tint',color);header.classList.add('melato-product-header-tint')}
    index+=1;
  }
  applyAccent();
  if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches&&safe.length>1){window.setInterval(applyAccent,4200)}
})();
</script>


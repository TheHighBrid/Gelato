{% comment %}
  Melato PDP rebuild

  Product facts are rendered from verified Shopify product fields and metafields.
  Generic technical, material, fit, and care claims are intentionally omitted
  when product-specific data is unavailable.
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign product_title_down = product.title | downcase
  assign product_type_down = product.product_type | downcase
  assign size_guide_page = product.metafields.custom.size_guide.value

  assign is_fragrance = false
  if product_type_down contains 'fragrance' or product_title_down contains 'eau de toilette' or product_title_down contains 'eau de parfum' or product_title_down contains 'perfume'
    assign is_fragrance = true
  endif

  assign is_fur = false
  if product_type_down contains 'fur' or product_title_down contains 'fur'
    assign is_fur = true
  endif

  assign pdp_hook = product.metafields.custom.pdp_hook.value
  assign story_copy = product.metafields.custom.story.value | default: product.metafields.custom.product_story.value | default: product.metafields.custom.pdp_story.value | default: product.metafields.custom.pdp_story_content.value
  assign construction_details = product.metafields.custom.design_features.value | default: product.metafields.custom.pdp_technical_details.value
  assign construction_paragraph = product.metafields.custom.pdp_technical_paragraph.value
  assign fit_copy = product.metafields.custom.fit_summary.value | default: product.metafields.custom.fit.value
  assign fit_details = product.metafields.custom.pdp_fit_details.value
  assign material_copy = product.metafields.custom.fabric_composition.value | default: product.metafields.custom.composition.value | default: product.metafields.custom.material.value
  assign material_details = product.metafields.custom.pdp_material_details.value
  assign care_copy = product.metafields.custom.care_short.value | default: product.metafields.custom.care.value
  assign care_details = product.metafields.custom.pdp_care_details.value
  assign application_copy = product.metafields.custom.application.value
  assign scent_profile = product.metafields.custom.scent_profile.value
  assign shipping_returns_details = product.metafields.custom.pdp_shipping_returns_details.value
  assign drop_note = product.metafields.custom.drop_note.value | default: 'Limited Melato production. Restock is not guaranteed.'
  assign matching_product = product.metafields.custom.matching_product.value | default: product.metafields.custom.set_partner.value

  if story_copy == blank and product.description != blank
    assign story_copy = product.description
  endif

  if is_fragrance
    assign fit_copy = blank
    assign fit_details = blank
    if application_copy == blank
      assign application_copy = 'Apply to pulse points. Avoid rubbing the fragrance into the skin.'
    endif
    if care_copy == blank and care_details == blank
      assign care_copy = 'Store upright away from heat and direct sunlight.'
    endif
  endif

  if is_fur and care_copy == blank and care_details == blank
    assign care_copy = 'Professional fur cleaning only. Do not machine wash or hand wash. Store in a cool, ventilated space away from moisture, direct heat, and prolonged sunlight. Use a broad-shouldered hanger.'
  endif

  assign product_accent = product.metafields.custom.palette_1.value | default: product.metafields.custom.palette_2.value | default: product.metafields.custom.palette_3.value | default: section.settings.accent_2
  assign product_button_accent = current_variant.metafields.custom.theme_accent.value | default: product_accent | default: section.settings.accent

  assign current_colorway = blank
  assign current_type = blank
  assign colorway_display = blank
  for tag in product.tags
    assign tag_clean = tag | downcase | strip
    if tag_clean contains 'colorway_'
      assign current_colorway = tag_clean
      assign colorway_display = tag_clean | remove: 'colorway_' | replace: '-', ' ' | upcase
    endif
    if tag_clean == 'type_jacket' or tag_clean == 'type_pants'
      assign current_type = tag_clean
    endif
  endfor

  assign complement_type = blank
  assign complement_label = blank
  if current_type == 'type_jacket'
    assign complement_type = 'type_pants'
    assign complement_label = 'matching pants'
  elsif current_type == 'type_pants'
    assign complement_type = 'type_jacket'
    assign complement_label = 'matching jacket'
  endif

  if matching_product == blank and current_colorway != blank and complement_type != blank
    for candidate in collections.all.products
      if candidate.id != product.id and matching_product == blank
        assign candidate_has_colorway = false
        assign candidate_has_type = false
        for candidate_tag in candidate.tags
          assign candidate_tag_clean = candidate_tag | downcase | strip
          if candidate_tag_clean == current_colorway
            assign candidate_has_colorway = true
          endif
          if candidate_tag_clean == complement_type
            assign candidate_has_type = true
          endif
        endfor
        if candidate_has_colorway and candidate_has_type
          assign matching_product = candidate
        endif
      endif
    endfor
  endif
-%}

<section
  id="MelatoPDP-{{ section.id }}"
  class="melato-pdp-rebuild"
  style="--pdp-bg:{{ current_variant.metafields.custom.theme_bg.value | default: section.settings.bg }};--pdp-surface:{{ current_variant.metafields.custom.theme_surface.value | default: section.settings.surface }};--pdp-text:{{ current_variant.metafields.custom.theme_text.value | default: section.settings.text }};--pdp-muted:{{ section.settings.muted }};--pdp-accent:{{ product_button_accent }};--pdp-title-accent:{{ product_accent }}"
  data-product-section
>
  <div class="pdp-shell">
    <div class="pdp-hero">
      <div class="pdp-gallery" aria-label="{{ product.title | escape }} product gallery">
        {%- if featured_media -%}
          {%- assign featured_alt = featured_media.alt -%}
          {%- if featured_alt == blank -%}{%- assign featured_alt = product.title | append: ', featured product image' -%}{%- endif -%}
          <div class="pdp-main-media">
            {{ featured_media | image_url: width: 1800 | image_tag:
              class: 'pdp-main-image',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '600, 900, 1200, 1500, 1800',
              sizes: '(min-width: 1000px) 55vw, 100vw',
              alt: featured_alt
            }}
          </div>
        {%- endif -%}

        {%- if product.media.size > 1 -%}
          <div class="pdp-thumbs" role="list" aria-label="Product image thumbnails">
            {%- for media in product.media limit: 8 -%}
              {%- assign media_alt = media.alt -%}
              {%- if media_alt == blank -%}{%- assign media_alt = product.title | append: ', product image ' | append: forloop.index -%}{%- endif -%}
              <button
                class="pdp-thumb{% if media.id == featured_media.id %} is-active{% endif %}"
                type="button"
                data-pdp-thumb
                data-media-src="{{ media | image_url: width: 1800 }}"
                data-media-alt="{{ media_alt | escape }}"
                aria-label="Show {{ media_alt | escape }}"
                role="listitem"
              >
                {{ media | image_url: width: 220 | image_tag:
                  class: 'pdp-thumb-image',
                  loading: 'lazy',
                  widths: '110, 160, 220',
                  sizes: '110px',
                  alt: ''
                }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="pdp-buybox">
        {%- if section.settings.eyebrow != blank -%}<p class="pdp-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h1 class="pdp-title">{{ product.title }}</h1>
        {%- if pdp_hook != blank -%}<p class="pdp-thesis">{{ pdp_hook }}</p>{%- endif -%}

        <div class="pdp-price-row" id="PDPPrice-{{ section.id }}">
          <span class="pdp-price">{{ current_variant.price | money }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}<s class="pdp-compare">{{ current_variant.compare_at_price | money }}</s>{%- endif -%}
        </div>

        <ul class="product-assurances" role="list" aria-label="Purchase assurances">
          <li>Fast dispatch</li>
          <li>Complimentary delivery on all orders</li>
          <li>Secure checkout</li>
        </ul>

        {% form 'product', product, class: 'pdp-form', id: 'ProductForm-' | append: section.id %}
          {%- if product.has_only_default_variant -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
          {%- else -%}
            {%- for option in product.options_with_values -%}
              <fieldset class="pdp-option">
                <div class="pdp-option__header">
                  <legend>{{ option.name }}</legend>
                  {%- assign option_name_down = option.name | downcase -%}
                  {%- if option_name_down == 'size' or option_name_down == 'taille' -%}
                    {%- if size_guide_page != blank -%}
                      <button class="size-guide-trigger" type="button" data-open-size-drawer aria-haspopup="dialog" aria-expanded="false">Size guide &amp; silhouette fit</button>
                    {%- endif -%}
                  {%- endif -%}
                </div>
                <div class="pdp-option-grid">
                  {%- for value in option.values -%}
                    <label class="pdp-choice{% if option.selected_value == value %} is-selected{% endif %}">
                      <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} data-option-position="{{ option.position }}">
                      <span>{{ value }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
          {%- endif -%}

          <div class="pdp-atc-row">
            <label class="visually-hidden" for="PDPQty-{{ section.id }}">Quantity</label>
            <input id="PDPQty-{{ section.id }}" class="pdp-qty" type="number" name="quantity" min="1" value="1">
            <button class="pdp-atc{% unless current_variant.available %} pdp-atc--oos{% endunless %}" type="submit" name="add" data-pdp-atc {% unless current_variant.available %}disabled{% endunless %}>
              {% if current_variant.available %}Add to cart{% else %}Out of stock{% endif %}
            </button>
          </div>

          {%- if additional_checkout_buttons and current_variant.available -%}
            <div class="pdp-dynamic-checkout">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        {% endform %}

        {% render 'back-in-stock-form', product: product %}

        <div class="pdp-proof-mini" aria-label="Product information summary">
          <div>
            <strong>Limited production</strong>
            <span>{{ drop_note }}</span>
          </div>
          {%- if material_copy != blank or material_details != blank -%}
            <div>
              <strong>Verified material information</strong>
              <span>See the material section below.</span>
            </div>
          {%- endif -%}
          <div>
            <strong>Returns</strong>
            <span>{% if is_fragrance %}Unopened fragrance products follow the posted Melato return policy.{% else %}Eligible unused items follow the posted Melato return policy.{% endif %}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="pdp-content-stack">
      {%- if story_copy != blank or construction_details != blank or construction_paragraph != blank -%}
        <section class="pdp-panel pdp-story-tech" aria-label="Product story and construction">
          <div class="pdp-story-tech__grid">
            {%- if story_copy != blank -%}
              <details class="pdp-mini-detail">
                <summary>Story</summary>
                <div class="pdp-mini-detail__content rte">{{ story_copy }}</div>
              </details>
            {%- endif -%}

            {%- if construction_details != blank or construction_paragraph != blank -%}
              <details class="pdp-mini-detail">
                <summary>Construction</summary>
                <div class="pdp-mini-detail__content">
                  {%- if construction_details != blank -%}
                    <ul>
                      {%- for detail in construction_details -%}<li>{{ detail }}</li>{%- endfor -%}
                    </ul>
                  {%- endif -%}
                  {%- if construction_paragraph != blank -%}<p>{{ construction_paragraph }}</p>{%- endif -%}
                </div>
              </details>
            {%- endif -%}
          </div>
        </section>
      {%- endif -%}

      <section class="pdp-spec-grid" aria-label="Product specifications">
        {%- if is_fragrance -%}
          {%- if application_copy != blank -%}
            <details class="pdp-spec"><summary>Application</summary><div class="pdp-rte">{{ application_copy }}</div></details>
          {%- endif -%}
          {%- if scent_profile != blank -%}
            <details class="pdp-spec"><summary>Scent profile</summary><div class="pdp-rte">{{ scent_profile }}</div></details>
          {%- endif -%}
        {%- elsif fit_details != blank or fit_copy != blank -%}
          <details class="pdp-spec">
            <summary>Fit</summary>
            <div class="pdp-rte">
              {%- if fit_details != blank -%}<ul>{%- for item in fit_details -%}<li>{{ item }}</li>{%- endfor -%}</ul>{%- else -%}{{ fit_copy }}{%- endif -%}
            </div>
          </details>
        {%- endif -%}

        {%- if material_details != blank or material_copy != blank -%}
          <details class="pdp-spec">
            <summary>Material</summary>
            <div class="pdp-rte">
              {%- if material_details != blank -%}<ul>{%- for item in material_details -%}<li>{{ item }}</li>{%- endfor -%}</ul>{%- else -%}{{ material_copy }}{%- endif -%}
            </div>
          </details>
        {%- endif -%}

        {%- if care_details != blank or care_copy != blank -%}
          <details class="pdp-spec">
            <summary>Care</summary>
            <div class="pdp-rte">
              {%- if care_details != blank -%}<ul>{%- for item in care_details -%}<li>{{ item }}</li>{%- endfor -%}</ul>{%- else -%}{{ care_copy }}{%- endif -%}
            </div>
          </details>
        {%- endif -%}

        <details class="pdp-spec">
          <summary>Shipping &amp; returns</summary>
          <div class="pdp-rte">
            {%- if shipping_returns_details != blank -%}
              <ul>{%- for item in shipping_returns_details -%}<li>{{ item }}</li>{%- endfor -%}</ul>
            {%- elsif is_fragrance -%}
              <p>Orders usually prepare within 1 to 3 business days. Complimentary delivery is available on all orders.</p>
              <p>Unopened fragrance products follow the posted Melato return policy. Contact support@melato.ca before opening the product if you may need return assistance.</p>
            {%- else -%}
              <p>Orders usually prepare within 1 to 3 business days. Complimentary delivery is available on all orders.</p>
              <p>Eligible unused products follow the posted Melato return policy.</p>
            {%- endif -%}
          </div>
        </details>
      </section>

      {%- if matching_product != blank -%}
        <section class="pdp-panel pdp-set" aria-labelledby="PDPSet-{{ section.id }}">
          <header class="pdp-section-head">
            <p class="pdp-kicker">Complete the set</p>
            <h2 id="PDPSet-{{ section.id }}">{% if colorway_display != blank %}Full {{ colorway_display }} uniform{% else %}Style it with{% endif %}</h2>
          </header>
          <div class="pdp-set-grid">
            <article class="pdp-set-card">
              <span class="pdp-set-label">Selected piece</span>
              {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 800 | image_tag: class: 'pdp-set-image', loading: 'lazy', widths: '300, 500, 800', alt: product.title | append: ', selected piece' }}{%- endif -%}
              <div class="purchase-summary">
                <h3 class="purchase-summary__title">{{ product.title }}</h3>
                <p class="purchase-summary__price">{{ product.price | money }}</p>
              </div>
            </article>
            <a class="pdp-set-card pdp-set-card--link" href="{{ matching_product.url }}" aria-label="Shop {{ matching_product.title | escape }}">
              <span class="pdp-set-label">Add {{ complement_label | default: 'matching piece' }}</span>
              {%- if matching_product.featured_image -%}{{ matching_product.featured_image | image_url: width: 800 | image_tag: class: 'pdp-set-image', loading: 'lazy', widths: '300, 500, 800', alt: matching_product.title | append: ', matching piece' }}{%- endif -%}
              <div class="purchase-summary">
                <h3 class="purchase-summary__title">{{ matching_product.title }}</h3>
                <p class="purchase-summary__price">{{ matching_product.price | money }}</p>
              </div>
              <strong>Add full set</strong>
            </a>
          </div>
          <div class="pdp-set-total">
            <span>Full set price</span>
            <strong>{{ product.price | plus: matching_product.price | money_with_currency }}</strong>
          </div>
        </section>
      {%- endif -%}

      {%- if product.media.size > 1 -%}
        <section class="pdp-panel pdp-editorial" aria-labelledby="PDPEditorial-{{ section.id }}">
          <header class="pdp-section-head">
            <p class="pdp-kicker">Editorial photos</p>
            <h2 id="PDPEditorial-{{ section.id }}">Extra angles, texture, and close-ups.</h2>
          </header>
          <div class="pdp-editorial-grid">
            {%- for media in product.media offset: 1 limit: 6 -%}
              {%- assign editorial_alt = media.alt -%}
              {%- if editorial_alt == blank -%}{%- assign editorial_alt = product.title | append: ', editorial product image ' | append: forloop.index -%}{%- endif -%}
              <figure class="pdp-editorial-card">
                {{ media | image_url: width: 1200 | image_tag: class: 'pdp-editorial-image', loading: 'lazy', widths: '400, 700, 900, 1200', sizes: '(min-width: 900px) 33vw, 100vw', alt: editorial_alt }}
              </figure>
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}
    </div>
  </div>

  <div class="pdp-sticky-atc" data-pdp-sticky aria-hidden="true">
    <div class="purchase-summary">
      <strong class="purchase-summary__title">{{ product.title }}</strong>
      <span class="purchase-summary__price" id="PDPStickyPrice-{{ section.id }}">{{ current_variant.price | money }}</span>
    </div>
    <button type="button" data-pdp-sticky-button class="{% unless current_variant.available %}pdp-atc--oos{% endunless %}" {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}Add to cart{% else %}Out of stock{% endif %}</button>
  </div>

  <script type="application/json" id="PDPVariants-{{ section.id }}">{{ product.variants | json }}</script>
</section>

{%- if size_guide_page != blank -%}{% render 'size-guide-drawer', product: product %}{%- endif -%}

<script>
(function(){
  var section=document.getElementById('MelatoPDP-{{ section.id }}');
  if(!section)return;
  var mainImage=section.querySelector('.pdp-main-image');
  var form=section.querySelector('.pdp-form');
  var variants=[];
  try{variants=JSON.parse(document.getElementById('PDPVariants-{{ section.id }}').textContent||'[]')}catch(error){}

  section.querySelectorAll('[data-pdp-thumb]').forEach(function(button){
    button.addEventListener('click',function(){
      section.querySelectorAll('[data-pdp-thumb]').forEach(function(item){item.classList.remove('is-active')});
      button.classList.add('is-active');
      if(mainImage){
        mainImage.src=button.getAttribute('data-media-src');
        mainImage.alt=button.getAttribute('data-media-alt')||mainImage.alt;
        mainImage.removeAttribute('srcset');
      }
    });
  });

  function formatMoney(cents){
    if(window.Shopify&&Shopify.formatMoney)return Shopify.formatMoney(cents,{{ shop.money_format | json }});
    return '$'+(cents/100).toFixed(2);
  }
  function selections(){
    return Array.prototype.map.call(section.querySelectorAll('.pdp-option'),function(fieldset){
      var selected=fieldset.querySelector('input:checked');
      return selected?selected.value:null;
    });
  }
  function selectedVariant(){
    var values=selections();
    return variants.find(function(variant){return variant.options.every(function(value,index){return values[index]===value})});
  }
  function updateVariant(variant){
    if(!variant||!form)return;
    var idInput=form.querySelector('[data-variant-id]');
    if(idInput)idInput.value=variant.id;
    var price=section.querySelector('#PDPPrice-{{ section.id }}');
    if(price){
      price.innerHTML='<span class="pdp-price">'+formatMoney(variant.price)+'</span>'+(variant.compare_at_price&&variant.compare_at_price>variant.price?'<s class="pdp-compare">'+formatMoney(variant.compare_at_price)+'</s>':'');
    }
    var stickyPrice=section.querySelector('#PDPStickyPrice-{{ section.id }}');
    if(stickyPrice)stickyPrice.textContent=formatMoney(variant.price);
    [section.querySelector('[data-pdp-atc]'),section.querySelector('[data-pdp-sticky-button]')].forEach(function(button){
      if(!button)return;
      button.disabled=!variant.available;
      button.textContent=variant.available?'Add to cart':'Out of stock';
      button.classList.toggle('pdp-atc--oos',!variant.available);
    });
    if(variant.featured_image&&mainImage){mainImage.src=variant.featured_image.src;mainImage.removeAttribute('srcset')}
    var url=new URL(window.location.href);url.searchParams.set('variant',variant.id);window.history.replaceState({},'',url.toString());
    document.dispatchEvent(new CustomEvent('variant:change',{detail:{variant:variant}}));
  }

  section.querySelectorAll('.pdp-choice input').forEach(function(input){
    input.addEventListener('change',function(){
      var grid=input.closest('.pdp-option-grid');
      if(grid)grid.querySelectorAll('.pdp-choice').forEach(function(label){label.classList.remove('is-selected')});
      input.closest('.pdp-choice').classList.add('is-selected');
      updateVariant(selectedVariant());
    });
  });

  var stickyButton=section.querySelector('[data-pdp-sticky-button]');
  if(stickyButton&&form)stickyButton.addEventListener('click',function(){var submit=form.querySelector('[data-pdp-atc]');if(submit)submit.click()});
  var sticky=section.querySelector('[data-pdp-sticky]');
  var atc=section.querySelector('[data-pdp-atc]');
  if(sticky&&atc&&'IntersectionObserver'in window){
    new IntersectionObserver(function(entries){entries.forEach(function(entry){if(window.innerWidth>749)return;sticky.classList.toggle('is-visible',!entry.isIntersecting);sticky.setAttribute('aria-hidden',entry.isIntersecting?'true':'false')})},{threshold:0}).observe(atc);
  }
})();
</script>

<style>
#MelatoPDP-{{ section.id }}{background:var(--pdp-bg);color:var(--pdp-text);padding:34px 0 76px}#MelatoPDP-{{ section.id }} *{box-sizing:border-box}#MelatoPDP-{{ section.id }} .pdp-shell{width:min(1440px,calc(100% - 32px));margin:auto}#MelatoPDP-{{ section.id }} .pdp-hero{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(360px,.92fr);gap:28px;align-items:start}#MelatoPDP-{{ section.id }} .pdp-main-media,#MelatoPDP-{{ section.id }} .pdp-buybox,#MelatoPDP-{{ section.id }} .pdp-panel,#MelatoPDP-{{ section.id }} .pdp-spec,#MelatoPDP-{{ section.id }} .pdp-set-card{background:var(--pdp-surface);border:1px solid rgba(255,255,255,.095);border-radius:26px;box-shadow:0 18px 50px rgba(0,0,0,.24)}#MelatoPDP-{{ section.id }} .pdp-main-media{overflow:hidden;padding:12px}#MelatoPDP-{{ section.id }} .pdp-main-image{display:block;width:100%;height:auto;border-radius:18px}#MelatoPDP-{{ section.id }} .pdp-thumbs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:12px}#MelatoPDP-{{ section.id }} .pdp-thumb{background:var(--pdp-surface);border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:7px;cursor:pointer}#MelatoPDP-{{ section.id }} .pdp-thumb.is-active{border-color:var(--pdp-title-accent)}#MelatoPDP-{{ section.id }} .pdp-thumb-image{display:block;width:100%;height:auto;border-radius:12px}#MelatoPDP-{{ section.id }} .pdp-buybox{position:sticky;top:22px;padding:28px}#MelatoPDP-{{ section.id }} .pdp-eyebrow,#MelatoPDP-{{ section.id }} .pdp-kicker{margin:0 0 12px;color:var(--pdp-title-accent);font-size:11px;letter-spacing:.24em;text-transform:uppercase;font-weight:900}#MelatoPDP-{{ section.id }} .pdp-title{margin:0 0 14px;font-size:clamp(34px,5vw,66px);line-height:.92;letter-spacing:-.045em;text-transform:uppercase}#MelatoPDP-{{ section.id }} .pdp-thesis{margin:0 0 20px;max-width:58ch;font-size:17px;line-height:1.5;color:rgba(255,255,255,.82)}#MelatoPDP-{{ section.id }} .pdp-price-row{display:flex;align-items:baseline;gap:12px;margin-botto
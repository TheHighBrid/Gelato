{% comment %}
  Melato Product Page Rebuild
  Out-of-stock display (Zara-style) added by Claude: greyed ATC box + greyed/disabled size pills.
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign product_title_down = product.title | downcase
  assign product_type_down = product.product_type | downcase

  assign product_accent = product.metafields.custom.palette_1.value | default: product.metafields.custom.palette_2.value | default: product.metafields.custom.palette_3.value | default: current_variant.metafields.custom.theme_accent_2.value | default: section.settings.accent_2
  assign product_button_accent = current_variant.metafields.custom.theme_accent.value | default: product_accent | default: section.settings.accent

  assign pdp_hook = product.metafields.custom.pdp_hook.value
  assign story_copy = product.metafields.custom.story.value | default: product.metafields.custom.product_story.value | default: product.metafields.custom.pdp_story.value | default: product.metafields.custom.pdp_proof_context.value
  assign design_features = product.metafields.custom.design_features.value
  assign legacy_details = product.metafields.custom.pdp_technical_details.value

  assign fit_copy = product.metafields.custom.fit_summary.value | default: product.metafields.custom.fit.value
  assign material_copy = product.metafields.custom.fabric_composition.value | default: product.metafields.custom.composition.value | default: product.metafields.custom.material.value
  assign care_copy = product.metafields.custom.care_short.value | default: product.metafields.custom.care.value
  assign drop_note = product.metafields.custom.drop_note.value
  assign matching_product = product.metafields.custom.matching_product.value | default: product.metafields.custom.set_partner.value
  assign review_count = product.metafields.judgeme.review_widget_data.value.number_of_reviews | default: 0 | plus: 0

  assign material_label = 'Premium construction'
  assign trust_material = 'Material-led finish'
  assign type_label = product.product_type | default: 'Melato piece'

  if product_type_down contains 'track jacket' or product_title_down contains 'track jacket'
    assign fallback_hook = 'A premium track jacket built with clean retro-sport structure, controlled colour blocking, and full-set presence.'
    assign fallback_story = 'Built as the upper half of the Melato uniform: structured enough to hold shape, relaxed enough to move through the day. The silhouette keeps the attitude clean, with panel work doing the talking instead of excess branding.'
    assign fallback_fit = 'Relaxed athletic jacket fit. Choose your usual size for a clean silhouette, or size up for a looser oversized read.'
    assign fallback_material = 'Premium track fabric selected for softness, clean movement, and everyday wearability.'
  elsif product_type_down contains 'track pant' or product_title_down contains 'track pant'
    assign fallback_hook = 'A premium track pant cut for movement, comfort, and the full Melato uniform effect.'
    assign fallback_story = 'Designed to ground the matching jacket and complete the set without losing everyday comfort. The leg shape is relaxed, the panel language is intentional, and the full look stays sharp without trying too hard.'
    assign fallback_fit = 'Relaxed athletic pant fit with an easy leg. Choose your usual size for a clean drape, or size up for more volume.'
    assign fallback_material = 'Premium track fabric selected for softness, clean movement, and everyday wearability.'
  elsif product_type_down contains 'dress' or product_title_down contains 'dress'
    assign fallback_hook = 'A statement dress built around body line, controlled tension, and after-dark elegance.'
    assign fallback_story = 'Cut for presence after dark, with shape and texture doing the quiet work. The piece is designed to read refined, fitted, and a little dangerous without becoming costume.'
    assign fallback_fit = 'Body-following fit. Choose your usual size for a sculpted silhouette, or size up if between sizes.'
    assign fallback_material = 'Statement fabric construction selected for shape, texture, and elevated eveningwear presence.'
  elsif product_type_down contains 'bodysuit' or product_title_down contains 'bodysuit'
    assign fallback_hook = 'A fitted layering piece designed with second-skin attitude and sharp styling range.'
    assign fallback_story = 'A close-to-body base layer made to anchor the outfit without overpowering it. It sits clean under jackets, denim, or skirts, with enough texture to stand on its own when the styling calls for it.'
    assign fallback_fit = 'Close-to-body fit with stretch. Choose your usual size for a smooth base layer, or size up for more ease.'
    assign fallback_material = 'Soft stretch fabric selected for a close body fit and clean layering.'
  elsif product_type_down contains 'jean' or product_title_down contains 'jean' or product_type_down contains 'denim'
    assign fallback_hook = 'A directional denim piece cut for shape, attitude, and a stronger silhouette.'
    assign fallback_story = 'A denim piece built around silhouette first. The shape is designed to change the line of the outfit, giving the lower body more attitude, more length, and more visual weight.'
    assign fallback_fit = 'Structured denim fit. Choose your usual size for the intended silhouette, or size up if between sizes.'
    assign fallback_material = 'Structured denim selected for shape retention, clean drape, and a strong finished silhouette.'
  elsif product_type_down contains 'skirt' or product_title_down contains 'skirt'
    assign fallback_hook = 'A shaped skirt built for clean tension, strong proportion, and editorial styling.'
    assign fallback_story = 'Built to sharpen the outfit from the waist down. The silhouette keeps the line clean while the finish gives it enough character to move between everyday styling and evening presence.'
    assign fallback_fit = 'Shaped skirt fit through the waist and hip. Choose your usual size, or size up if between sizes.'
    assign fallback_material = 'Structured skirt construction selected for shape and finish.'
  elsif product_type_down contains 'shirt' or product_title_down contains 'shirt'
    assign fallback_hook = 'A relaxed shirt cut for easy movement, clean layering, and daily styling.'
    assign fallback_story = 'Made to sit loose without looking careless. The shape keeps the body easy, the collar keeps it composed, and the styling range runs from warm-weather uniform to layered city wear.'
    assign fallback_fit = 'Relaxed shirt fit with easy room through the chest and body. Choose your usual size for the intended drape.'
    assign fallback_material = 'Lightweight shirt fabric with a relaxed drape.'
  elsif product_type_down contains 'tie' or product_title_down contains 'tie'
    assign fallback_hook = 'A finishing piece that turns formalwear into a Melato-coded statement.'
    assign fallback_story = 'Designed as the quiet loud piece: formal from a distance, coded up close. It adds pattern, texture, and a little mischief to tailoring, shirting, or layered styling.'
    assign fallback_fit = 'One-size accessory fit designed for standard neckwear styling.'
    assign fallback_material = 'Structured tie construction with patterned surface.'
  elsif product_type_down contains 'suspender' or product_title_down contains 'suspender'
    assign fallback_hook = 'A vintage-coded accessory designed to sharpen the silhouette without trying too hard.'
    assign fallback_story = 'Built to pull the outfit upward, literally and visually. The hardware and strap pattern add old-world tension to denim, trousers, shirting, or a layered Melato uniform.'
    assign fallback_fit = 'Adjustable accessory fit designed to sit clean over shirts, tees, or tailored layers.'
    assign fallback_material = 'Patterned strap construction with adjustable hardware.'
  else
    assign fallback_hook = 'A premium Melato piece built with clean construction, controlled proportion, and everyday presence.'
    assign fallback_story = 'A focused Melato piece designed around proportion, texture, and styling range. Built to feel intentional without overexplaining itself.'
    assign fallback_fit = 'Premium everyday fit. Choose your usual size for the intended silhouette.'
    assign fallback_material = 'Premium construction selected for clean movement and everyday wearability.'
  endif

  if product_title_down contains 'bamboo'
    assign material_label = 'Bamboo-blend track fabric'
    assign trust_material = 'Soft bamboo-blend feel'
  elsif product_title_down contains 'velour'
    assign material_label = 'Premium velour'
    assign trust_material = 'Plush velour handfeel'
  elsif product_type_down contains 'jean' or product_title_down contains 'jean' or product_type_down contains 'denim'
    assign material_label = 'Structured denim'
    assign trust_material = 'Structured denim finish'
  elsif product_type_down contains 'bodysuit' or product_title_down contains 'bodysuit'
    assign material_label = 'Stretch layering fabric'
    assign trust_material = 'Smooth layering base'
  endif

  assign pdp_hook = pdp_hook | default: fallback_hook
  assign story_copy = story_copy | default: fallback_story
  assign fit_copy = fit_copy | default: fallback_fit
  assign material_copy = material_copy | default: fallback_material
  assign care_copy = care_copy | default: 'Wash cold inside out where applicable. Hang dry or lay flat. Avoid direct heat over embroidery, patches, prints, trims, or branded details.'
  assign drop_note = drop_note | default: 'Limited Melato drop. Restock is not guaranteed.'

  assign current_colorway = blank
  assign current_type = blank
  assign colorway_key = blank
  assign colorway_display = blank

  for tag in product.tags
    assign tag_clean = tag | downcase | strip
    if tag_clean contains 'colorway_'
      assign current_colorway = tag_clean
      assign colorway_key = tag_clean | remove: 'colorway_' | handleize
    endif
    if tag_clean == 'type_jacket' or tag_clean == 'type_pants'
      assign current_type = tag_clean
    endif
  endfor

  case colorway_key
    when 'chu'
      assign colorway_display = 'CHŪ'
    when 'divididos'
      assign colorway_display = 'DIVIDIDOS'
    when 'passionfruit'
      assign colorway_display = 'PASSION FRUIT'
    when 'reliance'
      assign colorway_display = 'RELIANCE'
    when 'conquista'
      assign colorway_display = 'CONQUISTA'
    else
      assign colorway_display = colorway_key | replace: '-', ' ' | upcase
  endcase

  assign complement_type = blank
  assign complement_label = blank
  if current_type == 'type_jacket'
    assign complement_type = 'type_pants'
    assign complement_label = 'matching pants'
  elsif current_type == 'type_pants'
    assign complement_type = 'type_jacket'
    assign complement_label = 'matching jacket'
  endif

  if matching_product == blank and current_colorway != blank and complement_type != blank
    for candidate in collections.all.products
      if candidate.id != product.id and matching_product == blank
        assign candidate_has_colorway = false
        assign candidate_has_type = false
        for candidate_tag in candidate.tags
          assign candidate_tag_clean = candidate_tag | downcase | strip
          if candidate_tag_clean == current_colorway
            assign candidate_has_colorway = true
          endif
          if candidate_tag_clean == complement_type
            assign candidate_has_type = true
          endif
        endfor
        if candidate_has_colorway and candidate_has_type
          assign matching_product = candidate
        endif
      endif
    endfor
  endif
-%}

<style>
  :root{ --melato-product-accent: {{ product_accent }}; }
  .announcement-bar,
  .announcement-bar *,
  [class*="announcement-bar"],
  [class*="announcement-bar"] *,
  [class*="announcement"] .announcement-bar,
  [class*="announcement"] .announcement-bar *,
  .melato-announcement,
  .melato-announcement *,
  .m-announcement,
  .m-announcement *{
    color: var(--melato-product-accent) !important;
    border-color: color-mix(in srgb, var(--melato-product-accent) 52%, transparent) !important;
  }
</style>

<section id="MelatoPDP-{{ section.id }}" class="melato-pdp-rebuild" style="--pdp-bg: {{ current_variant.metafields.custom.theme_bg.value | default: section.settings.bg }}; --pdp-surface: {{ current_variant.metafields.custom.theme_surface.value | default: section.settings.surface }}; --pdp-surface-2: {{ section.settings.surface_2 }}; --pdp-text: {{ current_variant.metafields.custom.theme_text.value | default: section.settings.text }}; --pdp-muted: {{ section.settings.muted }}; --pdp-accent: {{ product_button_accent }}; --pdp-accent-2: {{ product_accent }}; --pdp-title-accent: {{ product_accent }};">
  <div class="pdp-shell">
    <div class="pdp-hero">
      <div class="pdp-gallery" aria-label="{{ product.title | escape }} photos">
        {% if featured_media %}{% assign featured_media_alt = featured_media.alt | default: product.title %}<div class="pdp-main-media">{{ featured_media | image_url: width: 1800 | image_tag: class: 'pdp-main-image', loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1500,1800', alt: featured_media_alt }}</div>{% endif %}
        {% if product.media.size > 1 %}<div class="pdp-thumbs" role="list" aria-label="Product image thumbnails">{% for media in product.media limit: 8 %}<button class="pdp-thumb{% if forloop.first %} is-active{% endif %}" type="button" data-pdp-thumb data-media-src="{{ media | image_url: width: 1800 }}" aria-label="Show product image {{ forloop.index }}">{% assign thumb_alt = media.alt | default: product.title %}{{ media | image_url: width: 220 | image_tag: class: 'pdp-thumb-image', loading: 'lazy', widths: '110,160,220', alt: thumb_alt }}</button>{% endfor %}</div>{% endif %}
      </div>

      <div class="pdp-buybox">
        {% if section.settings.eyebrow != blank %}<p class="pdp-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h1 class="pdp-title">{{ product.title }}</h1>
        <p class="pdp-thesis">{{ pdp_hook }}</p>
        <div class="pdp-price-row" id="PDPPrice-{{ section.id }}"><span class="pdp-price">{{ current_variant.price | money }}</span>{% if current_variant.compare_at_price > current_variant.price %}<span class="pdp-compare">{{ current_variant.compare_at_price | money }}</span>{% endif %}</div>
        <div class="pdp-trust-row" aria-label="Payment and shipping trust"><span>Fast dispatch</span><span>Complimentary delivery on all orders</span><span>Secure checkout</span></div>
        <div class="pdp-stock-note" data-pdp-stock-note role="status" aria-live="polite">{% if current_variant.available %}{% if current_variant.inventory_management and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 5 %}Only {{ current_variant.inventory_quantity }} left in this size.{% else %}In stock — ready for checkout.{% endif %}{% else %}This size is currently out of stock.{% endif %}</div>

        {% form 'product', product, class: 'pdp-form' %}
          {% if product.has_only_default_variant %}<input type="hidden" name="id" value="{{ current_variant.id }}">{% else %}
            {% for option in product.options_with_values %}<fieldset class="pdp-option"><legend>{{ option.name }}</legend><div class="pdp-option-grid">{% for value in option.values %}<label class="pdp-choice{% if option.selected_value == value %} is-selected{% endif %}{% unless product.available %} pdp-choice--disabled{% endunless %}"><input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} {% unless product.available %}disabled{% endunless %} data-option-position="{{ option.position }}"><span>{{ value }}</span></label>{% endfor %}</div></fieldset>{% endfor %}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
          {% endif %}
          <div class="pdp-atc-row"><input class="pdp-qty" type="number" name="quantity" min="1" value="1" aria-label="Quantity"><button class="pdp-atc{% unless current_variant.available %} pdp-atc--oos{% endunless %}" type="submit" name="add" data-pdp-atc {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}Add to cart{% else %}Out of Stock{% endif %}</button></div>
          {% if additional_checkout_buttons and current_variant.available %}<div class="pdp-dynamic-checkout">{{ content_for_additional_checkout_buttons }}</div>{% endif %}
        {% endform %}

        <div class="pdp-proof-mini" aria-label="Product trust highlights"><div><strong>Limited production</strong><span>{{ drop_note }}</span></div><div><strong>{{ trust_material }}</strong><span>{{ material_label }}</span></div><div><strong>Easy returns</strong><span>Eligible unworn items follow posted policy.</span></div></div>
      </div>
    </div>

    <div class="pdp-content-stack">
      <section class="pdp-panel pdp-story-tech" aria-labelledby="PDPStory-{{ section.id }}">
        <div class="pdp-story-tech__grid">
          <div class="pdp-story-tech__story"><p class="pdp-kicker">Product story</p><h2 id="PDPStory-{{ section.id }}">Cut with intent.</h2><div class="pdp-rte pdp-rte--story">{{ story_copy | newline_to_br }}</div></div>
          <div class="pdp-story-tech__details"><p class="pdp-kicker">Technical details</p><h2 id="PDPTech-{{ section.id }}">The construction read.</h2>{% if design_features != blank %}<ul class="pdp-detail-list">{% for detail in design_features %}<li>{{ detail }}</li>{% endfor %}</ul>{% elsif legacy_details != blank %}<ul class="pdp-detail-list">{% for detail in legacy_details %}<li>{{ detail }}</li>{% endfor %}</ul>{% else %}<ul class="pdp-detail-list"><li>{{ type_label }} with Melato’s current-season product language.</li><li>{{ material_label }} selected for feel, structure, and everyday wearability.</li><li>Built to sit clean on body without stealing movement.</li></ul>{% endif %}</div>
        </div>
      </section>

      <section class="pdp-spec-grid" aria-label="Fit, material, care, shipping and returns"><details class="pdp-spec"><summary>Fit</summary><div class="pdp-rte">{{ fit_copy }}</div></details><details class="pdp-spec"><summary>Material</summary><div class="pdp-rte">{{ material_copy }}</div></details><details class="pdp-spec"><summary>Care</summary><div class="pdp-rte">{{ care_copy }}</div></details><details class="pdp-spec"><summary>Shipping & returns</summary><div class="pdp-rte">Orders usually prepare within 1 to 3 business days. Complimentary delivery available on all orders. Returns are eligible when items are unworn, unwashed, tagged, and returned within the posted policy window.</div></details></section>

      {% if matching_product != blank %}<section class="pdp-panel pdp-set" aria-labelledby="PDPSet-{{ section.id }}"><div class="pdp-section-head"><p class="pdp-kicker">Complete the set</p><h2 id="PDPSet-{{ section.id }}">{% if colorway_display != blank %}Full {{ colorway_display }} uniform{% else %}Style it with{% endif %}</h2></div><div class="pdp-set-grid"><article class="pdp-set-card"><span class="pdp-set-label">You have</span>{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: class: 'pdp-set-image', loading: 'lazy', widths: '300,500,800', alt: product.title }}{% endif %}<h3>{{ product.title }}</h3><p>{{ product.price | money }}</p></article><a class="pdp-set-card pdp-set-card--link" href="{{ matching_product.url }}" aria-label="Shop {{ matching_product.title | escape }}"><span class="pdp-set-label">Add {{ complement_label | default: 'matching piece' }}</span>{% if matching_product.featured_image %}{{ matching_product.featured_image | image_url: width: 800 | image_tag: class: 'pdp-set-image', loading: 'lazy', widths: '300,500,800', alt: matching_product.title }}{% endif %}<h3>{{ matching_product.title }}</h3><p>{{ matching_product.price | money }}</p><strong>Add full set</strong></a></div><div class="pdp-set-total"><span>Full set price</span><strong>{{ product.price | plus: matching_product.price | money_with_currency }}</strong></div></section>{% endif %}

      {% if product.media.size > 1 %}<section class="pdp-panel pdp-editorial" aria-labelledby="PDPEditorial-{{ section.id }}"><div class="pdp-section-head"><p class="pdp-kicker">Editorial photos</p><h2 id="PDPEditorial-{{ section.id }}">Extra angles, texture, and close-ups.</h2></div><div class="pdp-editorial-grid">{% for media in product.media offset: 1 limit: 6 %}<div class="pdp-editorial-card">{% assign editorial_alt = media.alt | default: product.title %}{{ media | image_url: width: 1200 | image_tag: class: 'pdp-editorial-image', loading: 'lazy', widths: '400,700,900,1200', alt: editorial_alt }}</div>{% endfor %}</div></section>{% endif %}

      {% if review_count > 0 %}<section class="pdp-panel pdp-reviews" aria-labelledby="PDPReviews-{{ section.id }}"><div class="pdp-section-head"><p class="pdp-kicker">Reviews</p><h2 id="PDPReviews-{{ section.id }}">What buyers say.</h2></div><div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-product-title="{{ product.title | escape }}" data-id="{{ product.id }}" data-product-id="{{ product.id }}" data-widget="review" data-auto-install="false"></div></section>{% endif %}
    </div>
  </div>

  <div class="pdp-sticky-atc" data-pdp-sticky aria-hidden="true"><div><strong>{{ product.title }}</strong><span id="PDPStickyPrice-{{ section.id }}">{{ current_variant.price | money }}</span></div><button type="button" data-pdp-sticky-button class="{% unless current_variant.available %}pdp-atc--oos{% endunless %}" {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}Add to cart{% else %}Out of Stock{% endif %}</button></div>
</section>

<script type="application/json" id="PDPVariants-{{ section.id }}">{{ product.variants | json }}</script>
<script>
(function(){var section=document.getElementById('MelatoPDP-{{ section.id }}');if(!section)return;var mainImage=section.querySelector('.pdp-main-image');section.querySelectorAll('[data-pdp-thumb]').forEach(function(button){button.addEventListener('click',function(){section.querySelectorAll('[data-pdp-thumb]').forEach(function(item){item.classList.remove('is-active')});button.classList.add('is-active');if(mainImage){mainImage.src=button.getAttribute('data-media-src');mainImage.removeAttribute('srcset')}})});var form=section.querySelector('.pdp-form');var variantsEl=document.getElementById('PDPVariants-{{ section.id }}');var variants=[];try{variants=JSON.parse(variantsEl.textContent||'[]')}catch(e){}function formatMoney(cents){if(window.Shopify&&Shopify.formatMoney){return Shopify.formatMoney(cents,{{ shop.money_format | json }})}return '$'+(cents/100).toFixed(2)}function getSelections(){var selections=[];section.querySelectorAll('.pdp-option').forEach(function(fieldset){var selected=fieldset.querySelector('input:checked');selections.push(selected?selected.value:null)});return selections}function findVariant(){var selections=getSelections();return variants.find(function(variant){return variant.options.every(function(option,index){return selections[index]===option})})}function variantMatchesOption(variant,position,value,selections){return variant.options.every(function(option,index){if(index===position)return option===value;return !selections[index]||selections[index]===option})}function updateOptionAvailability(){var selections=getSelections();section.querySelectorAll('.pdp-choice input').forEach(function(input){var position=parseInt(input.getAttribute('data-option-position'),10)-1;var available=variants.some(function(variant){return variant.available&&variantMatchesOption(variant,position,input.value,selections)});input.disabled=!available;var label=input.closest('.pdp-choice');if(label){label.classList.toggle('pdp-choice--disabled',!available);label.setAttribute('aria-disabled',available?'false':'true')}})}function updateVariant(variant){if(!variant||!form)return;var idInput=form.querySelector('[data-variant-id]');var atc=section.querySelector('[data-pdp-atc]');var stickyBtn=section.querySelector('[data-pdp-sticky-button]');var price=section.querySelector('#PDPPrice-{{ section.id }}');var stickyPrice=section.querySelector('#PDPStickyPrice-{{ section.id }}');var stockNote=section.querySelector('[data-pdp-stock-note]');if(idInput)idInput.value=variant.id;if(price){var html='<span class="pdp-price">'+formatMoney(variant.price)+'</span>';if(variant.compare_at_price&&variant.compare_at_price>variant.price){html+='<span class="pdp-compare">'+formatMoney(variant.compare_at_price)+'</span>'}price.innerHTML=html}if(stickyPrice)stickyPrice.textContent=formatMoney(variant.price);if(stockNote){var lowStock=variant.inventory_management&&variant.inventory_quantity>0&&variant.inventory_quantity<=5;stockNote.textContent=variant.available?(lowStock?'Only '+variant.inventory_quantity+' left in this size.':'In stock — ready for checkout.'):'This size is currently out of stock.';stockNote.classList.toggle('is-low',!!lowStock);stockNote.classList.toggle('is-out',!variant.available)}[atc,stickyBtn].forEach(function(btn){if(!btn)return;btn.disabled=!variant.available;btn.textContent=variant.available?'Add to cart':'Out of Stock';btn.classList.toggle('pdp-atc--oos',!variant.available)});if(variant.featured_image&&mainImage){mainImage.src=variant.featured_image.src;mainImage.removeAttribute('srcset')}updateOptionAvailability();var url=new URL(window.location.href);url.searchParams.set('variant',variant.id);window.history.replaceState({},'',url.toString())}section.querySelectorAll('.pdp-choice input').forEach(function(input){input.addEventListener('change',function(){var wrap=input.closest('.pdp-option-grid');if(wrap){wrap.querySelectorAll('.pdp-choice').forEach(function(label){label.classList.remove('is-selected')})}input.closest('.pdp-choice').classList.add('is-selected');updateVariant(findVariant())})});var stickyButton=section.querySelector('[data-pdp-sticky-button]');if(stickyButton&&form){stickyButton.addEventListener('click',function(){var submitButton=form.querySelector('[data-pdp-atc]');if(submitButton)submitButton.click()})}var sticky=section.querySelector('[data-pdp-sticky]');var atc=section.querySelector('[data-pdp-atc]');if(sticky&&atc&&'IntersectionObserver'in window){var observer=new IntersectionObserver(function(entries){entries.forEach(function(entry){if(window.innerWidth>749)return;sticky.classList.toggle('is-visible',!entry.isIntersecting);sticky.setAttribute('aria-hidden',entry.isIntersecting?'true':'false')})},{threshold:0});observer.observe(atc)}updateOptionAvailability()})();
</script>

<style>

{% comment %}
  MELATO HOUSE FOOTER
  Phase 1 global shell.
  Retains essential commerce, information and legal links while changing the
  presentation into a bold Casablanca-influenced Melato masthead.
  Compatibility contract: melato-footer__copyright remains the single visible copyright source.
{% endcomment %}

<footer
  class="melato-footer melato-house-footer"
  role="contentinfo"
  style="--house-footer-bg:{{ section.settings.house_bg_color | default: '#9d4918' }};--house-footer-fg:{{ section.settings.house_text_color | default: '#f0e8d9' }}"
>
  <div class="melato-house-footer__inner">
    <div class="melato-house-footer__masthead">
      <p class="melato-house-footer__wordmark" aria-label="Melato">MELATO</p>
    </div>

    <div class="melato-house-footer__grid">
      <div class="melato-house-footer__intro">
        <p class="melato-house-footer__tagline">{{ section.settings.tagline | default: 'The culture wears us.' }}</p>
        <p class="melato-house-footer__note">Designer apparel, objects and visual chapters built around identity, movement and presence.</p>
      </div>

      <nav aria-label="Shop Melato">
        <h2 class="melato-house-footer__heading">Shop</h2>
        <ul class="melato-house-footer__links">
          <li><a href="/collections/new-arrivals">New Arrivals</a></li>
          <li><a href="/collections/men">Men</a></li>
          <li><a href="/collections/womens-zellige-capsule">Women</a></li>
          <li><a href="/collections/tracksuits">The Uniform</a></li>
          <li><a href="/collections/accessories">Objects</a></li>
          <li><a href="/collections/fragrance">Fragrance</a></li>
        </ul>
      </nav>

      <nav aria-label="World of Melato">
        <h2 class="melato-house-footer__heading">World of Melato</h2>
        <ul class="melato-house-footer__links">
          <li><a href="/collections/the-living-lookbook">Living Book</a></li>
          <li><a href="/collections/drop-001-texture-form">Current Drop</a></li>
          <li><a href="/collections/ovum-before-the-world">OVUM</a></li>
          <li><a href="/pages/our-story">Our Story</a></li>
          {% if section.settings.instagram_url != blank %}<li><a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer">Instagram</a></li>{% endif %}
        </ul>
      </nav>

      <nav aria-label="Client services">
        <h2 class="melato-house-footer__heading">Client Services</h2>
        <ul class="melato-house-footer__links">
          <li><a href="/pages/contact">Contact</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/size-guide">Fit Guidance</a></li>
          <li><a href="/pages/shipping-returns">Delivery &amp; Returns</a></li>
          <li><a href="/pages/preview">Private Preview</a></li>
          <li><a href="/policies/refund-policy">Return Policy</a></li>
          <li><a href="/policies/privacy-policy">Privacy</a></li>
          <li><a href="/policies/terms-of-service">Terms</a></li>
        </ul>
      </nav>
    </div>

    <div class="melato-house-footer__bottom">
      <span class="melato-footer__copyright">© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      <span>{{ localization.country.name }} / {{ localization.country.currency.iso_code }}</span>
      <span>Culture-forward premium apparel / Comme never change.</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Melato House Footer",
  "limit": 1,
  "settings": [
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "The culture wears us." },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "header", "content": "House colors" },
    { "type": "color", "id": "house_bg_color", "label": "Footer background", "default": "#9d4918" },
    { "type": "color", "id": "house_text_color", "label": "Footer text", "default": "#f0e8d9" }
  ],
  "presets": [{ "name": "Melato House Footer" }]
}
{% endschema %}
{% comment %}
  MELATO - Global Footer
  Single footer source for Gelato v5.30.
{% endcomment %}

<footer class="melato-footer melato-footer--{{ section.id }}" role="contentinfo">
  <div class="melato-footer__wrap">
    <div class="melato-footer__top">
      <div class="melato-footer__brand">
        <a href="{{ routes.root_url }}" class="melato-footer__logo-link" aria-label="{{ shop.name }} home">
          {% if section.settings.logo != blank %}
            {{ section.settings.logo | image_url: width: 520 | image_tag: class: 'melato-footer__logo', loading: 'lazy', widths: '160, 220, 300, 380, 460, 520', sizes: '(max-width: 749px) 170px, 240px', alt: shop.name }}
          {% else %}
            <span class="melato-footer__wordmark">{{ shop.name }}</span>
          {% endif %}
        </a>
        <p class="melato-footer__tagline">{{ section.settings.tagline | default: 'Premium garments. Cut with intent.' }}</p>
        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" class="melato-footer__social" target="_blank" rel="noopener noreferrer" aria-label="Melato Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg><span>Instagram</span>
          </a>
        {% endif %}
      </div>

      <nav class="melato-footer__column" aria-label="Shop links">
        <h2>Shop</h2>
        <ul>
          <li><a href="{{ routes.all_products_collection_url }}">All Products</a></li>
          <li><a href="/collections/new-arrivals">New Arrivals</a></li>
          <li><a href="/collections/tracksuits">Tracksuits</a></li>
          <li><a href="/collections/denim">Denim</a></li>
          <li><a href="/collections/accessories">Accessories</a></li>
        </ul>
      </nav>

      <nav class="melato-footer__column" aria-label="Information links">
        <h2>Info</h2>
        <ul>
          <li><a href="/pages/our-story">Our Story</a></li>
          <li><a href="/pages/living-lookbook">Living Lookbook</a></li>
          <li><a href="/pages/newsletter">Newsletter</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/contact">Contact</a></li>
        </ul>
      </nav>

      <nav class="melato-footer__column" aria-label="Legal links">
        <h2>Legal</h2>
        <ul>
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service">Terms of Service</a></li>
          <li><a href="/policies/refund-policy">Returns & Refunds</a></li>
        </ul>
      </nav>
    </div>

    <div class="melato-footer__bottom">
      <p class="melato-footer__copyright">© 2026 Melato. Cut with intent.</p>
    </div>
  </div>
</footer>

<style>
  /* MELATO storefront policy hard-stop. These surfaces must never display. */
  .cart-free-shipping,
  .cart-drawer__tax-note,
  .shopify-payment-button,
  .shopify-payment-button__button,
  .shopify-payment-button__button--unbranded,
  [data-shopify="payment-button"],
  [data-testid="ShopifyPay-button"],
  .additional-checkout-buttons,
  .additional-checkout-button,
  .dynamic-checkout__content,
  .pdp-dynamic-checkout,
  .shopify-cleanslate [role="button"] {
    display:none!important;
    visibility:hidden!important;
    width:0!important;
    height:0!important;
    min-height:0!important;
    margin:0!important;
    padding:0!important;
    overflow:hidden!important;
    pointer-events:none!important;
  }
  .melato-footer--{{ section.id }}{--footer-bg:{{ section.settings.bg_color | default: '#111111' }};--footer-text:{{ section.settings.text_color | default: '#F5F1E8' }};--footer-muted:rgba(245,241,232,.68);--footer-soft:rgba(245,241,232,.48);--footer-line:rgba(245,241,232,.08);background:var(--footer-bg)!important;color:var(--footer-text)!important;border-top:1px solid var(--footer-line)}
  .melato-footer--{{ section.id }} *{box-sizing:border-box}.melato-footer--{{ section.id }} .melato-footer__wrap{width:min(1180px,calc(100% - 40px));margin:0 auto;padding:clamp(56px,7vw,96px) 0 28px}.melato-footer--{{ section.id }} .melato-footer__top{display:grid!important;grid-template-columns:minmax(260px,1.7fr) minmax(140px,.8fr) minmax(150px,.8fr) minmax(150px,.8fr);gap:clamp(34px,6vw,86px);align-items:start}.melato-footer--{{ section.id }} .melato-footer__brand{display:flex;flex-direction:column;align-items:flex-start}.melato-footer--{{ section.id }} .melato-footer__logo-link{display:inline-flex;align-items:center;color:var(--footer-text)!important;text-decoration:none}.melato-footer--{{ section.id }} .melato-footer__logo{width:{{ section.settings.logo_width | default: 240 }}px!important;max-width:min({{ section.settings.logo_width | default: 240 }}px,72vw)!important;height:auto!important;display:block!important}.melato-footer--{{ section.id }} .melato-footer__wordmark{color:var(--footer-text)!important;font-size:clamp(30px,4vw,52px);line-height:.9;letter-spacing:-.07em;text-transform:uppercase;font-weight:900}.melato-footer--{{ section.id }} .melato-footer__tagline{margin:42px 0 24px;max-width:260px;color:var(--footer-muted)!important;font-size:14px;line-height:1.65}.melato-footer--{{ section.id }} .melato-footer__social{display:inline-flex;align-items:center;gap:10px;color:var(--footer-soft)!important;text-decoration:none;font-size:11px;letter-spacing:.14em;text-transform:uppercase}.melato-footer--{{ section.id }} .melato-footer__social svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.5}.melato-footer--{{ section.id }} .melato-footer__column h2{margin:0 0 24px;color:var(--footer-text)!important;font-size:11px;letter-spacing:.16em;text-transform:uppercase;font-weight:700}.melato-footer--{{ section.id }} .melato-footer__column ul{display:grid!important;gap:16px;list-style:none!important;margin:0!important;padding:0!important}.melato-footer--{{ section.id }} .melato-footer__column a{color:var(--footer-muted)!important;text-decoration:none;font-size:14px;line-height:1.2;transition:color 160ms ease}.melato-footer--{{ section.id }} .melato-footer__column a:hover,.melato-footer--{{ section.id }} .melato-footer__social:hover{color:var(--footer-text)!important}.melato-footer--{{ section.id }} .melato-footer__bottom{margin-top:clamp(56px,7vw,86px);padding-top:28px;border-top:1px solid var(--footer-line);display:grid!important;grid-template-columns:1fr auto;align-items:center;gap:24px}.melato-footer--{{ section.id }} .melato-footer__copyright{margin:0;color:var(--footer-muted)!important;font-size:12px;line-height:1.5}@media screen and (max-width:900px){.melato-footer--{{ section.id }} .melato-footer__top{grid-template-columns:1fr 1fr 1fr;gap:42px 28px}.melato-footer--{{ section.id }} .melato-footer__brand{grid-column:1/-1}}@media screen and (max-width:640px){.melato-footer--{{ section.id }} .melato-footer__wrap{width:min(100% - 28px,1180px);padding-top:46px}.melato-footer--{{ section.id }} .melato-footer__top{grid-template-columns:1fr;gap:34px}.melato-footer--{{ section.id }} .melato-footer__bottom{grid-template-columns:1fr}.melato-footer--{{ section.id }} .melato-footer__logo{width:min({{ section.settings.logo_width | default: 240 }}px,62vw)!important}}
</style>

<script>
(function(){
  var walletSelectors = [
    '.shopify-payment-button',
    '[data-shopify="payment-button"]',
    '.additional-checkout-buttons',
    '.dynamic-checkout__content',
    '.pdp-dynamic-checkout'
  ];
  function enforceMelatoPolicy(root){
    root = root || document;
    walletSelectors.forEach(function(selector){
      root.querySelectorAll(selector).forEach(function(node){ node.remove(); });
    });
    root.querySelectorAll('.cart-free-shipping,.cart-drawer__tax-note').forEach(function(node){ node.remove(); });
    root.querySelectorAll('.product-assurances li,.melato-home-conversion__proof-card').forEach(function(node){
      var text=(node.textContent||'').replace(/\s+/g,' ').trim().toLowerCase();
      if(text.indexOf('fast dispatch')!==-1 || text.indexOf('secure checkout')!==-1 || text.indexOf('complimentary delivery')!==-1 || text.indexOf('google pay')!==-1 || text.indexOf('apple pay')!==-1 || text.indexOf('shop pay')!==-1){ node.remove(); }
    });
  }
  enforceMelatoPolicy(document);
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',function(){enforceMelatoPolicy(document)});
  new MutationObserver(function(mutations){
    mutations.forEach(function(mutation){
      mutation.addedNodes.forEach(function(node){
        if(node.nodeType===1) enforceMelatoPolicy(node);
      });
    });
  }).observe(document.documentElement,{childList:true,subtree:true});
})();
</script>

{% schema %}
{
  "name": "Melato footer",
  "limit": 1,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Footer logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 120, "max": 320, "step": 4, "unit": "px", "default": 240 },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Premium garments. Cut with intent." },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Footer background", "default": "#111111" },
    { "type": "color", "id": "text_color", "label": "Footer text", "default": "#F5F1E8" }
  ],
  "presets": [{ "name": "Melato footer" }]
}
{% endschema %}

{% comment %}
  Melato - Drop List Signup Section
  Full-width email capture section designed for between-drops traffic capture.
  Connects to Shopify's native customer/contact form OR can be wired to Klaviyo.

  INTEGRATION:
  Add via Shopify Customizer → Add Section → Drop List Signup
  OR add {% section 'drop-signup' %} to your homepage template JSON/liquid.

  FOR KLAVIYO (optional upgrade):
  Replace the <form> action with your Klaviyo embed form URL and change
  name="contact[email]" to the field name Klaviyo specifies in your embed code.
{% endcomment %}

<section
  class="m-dropsignup"
  id="drop-signup-{{ section.id }}"
  style="
    --ds-bg:      {{ section.settings.bg_color | default: '#0a0a0a' }};
    --ds-text:    {{ section.settings.text_color | default: '#e8e8e8' }};
    --ds-accent:  {{ section.settings.accent_color | default: '#8fff00' }};
  "
>
  <div class="m-dropsignup__inner">

    <div class="m-dropsignup__copy">
      <p class="m-dropsignup__eyebrow">
        {{ section.settings.eyebrow | default: 'MELATO - EXCLUSIVE ACCESS' }}
      </p>
      <h2 class="m-dropsignup__heading">
        {{ section.settings.heading | default: 'BE FIRST.<br>JOIN THE DROP LIST.' }}
      </h2>
      <p class="m-dropsignup__sub">
        {{ section.settings.subtext | default: 'Early access. No spam. Drop notifications only.' }}
      </p>
    </div>

    <div class="m-dropsignup__form-wrap">
      {%- form 'customer', id: 'droplist-form-{{ section.id }}', class: 'm-dropsignup__form' -%}
        <input type="hidden" name="contact[tags]" value="drop-list-subscriber">

        {% if form.posted_successfully? %}
          <p class="m-dropsignup__success" role="alert">
            ✓ &nbsp;You're on the list. Stay ready.
          </p>
        {% else %}

          <div class="m-dropsignup__field-group">
            <label for="droplist-email-{{ section.id }}" class="visually-hidden">
              Email address
            </label>
            <input
              id="droplist-email-{{ section.id }}"
              class="m-dropsignup__input"
              type="email"
              name="contact[email]"
              placeholder="{{ section.settings.placeholder | default: 'YOUR EMAIL' }}"
              autocomplete="email"
              required
              aria-required="true"
            >
            <button
              type="submit"
              class="m-dropsignup__btn"
              aria-label="Join the drop list"
            >
              {{ section.settings.btn_label | default: 'NOTIFY ME' }}
            </button>
          </div>

          {% if form.errors %}
            <p class="m-dropsignup__error" role="alert">
              {{ form.errors.translated_fields['email'] | capitalize }}
              {{ form.errors.messages['email'] }}
            </p>
          {% endif %}

        {% endif %}
      {%- endform -%}

      <p class="m-dropsignup__disclaimer">
        {{ section.settings.disclaimer | default: 'No spam. Unsubscribe anytime.' }}
      </p>
    </div>

  </div>

  {% if section.settings.show_divider_lines %}
    <div class="m-dropsignup__lines" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
  {% endif %}

</section>

{% schema %}
{
  "name": "Drop List Signup",
  "tag": "section",
  "class": "melato-drop-signup",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "MELATO - EXCLUSIVE ACCESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BE FIRST.<br>JOIN THE DROP LIST."
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Sub-text",
      "default": "Early access. No spam. Drop notifications only."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "YOUR EMAIL"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button label",
      "default": "NOTIFY ME"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer text",
      "default": "No spam. Unsubscribe anytime."
    },
    {
      "type": "checkbox",
      "id": "show_divider_lines",
      "label": "Show decorative lines",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#e8e8e8"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#8fff00"
    }
  ],
  "presets": [
    {
      "name": "Drop List Signup"
    }
  ]
}
{% endschema %}

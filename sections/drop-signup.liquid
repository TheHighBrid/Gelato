{% comment %}Melato email signup / clean QA 2026-08-11{% endcomment %}
<section class="melato-mail" id="MelatoMail-{{ section.id }}" style="--mail-bg:{{ section.settings.bg_color | default:'#0a0a0a' }};--mail-text:{{ section.settings.text_color | default:'#f5f1e8' }};--mail-accent:{{ section.settings.accent_color | default:'#f5f1e8' }}">
  <div class="melato-mail__inner">
    <div>{%- if section.settings.eyebrow != blank -%}<p class="melato-mail__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}<h2>{{ section.settings.heading | default:'Melato notes' }}</h2>{%- if section.settings.subtext != blank -%}<p class="melato-mail__sub">{{ section.settings.subtext }}</p>{%- endif -%}</div>
    <div>{%- form 'customer', id:'droplist-form-{{ section.id }}', class:'melato-mail__form' -%}<input type="hidden" name="contact[tags]" value="newsletter">{% if form.posted_successfully? %}<p class="melato-mail__success" role="status">Thank you.</p>{% else %}<div class="melato-mail__field"><label class="visually-hidden" for="droplist-email-{{ section.id }}">Email address</label><input id="droplist-email-{{ section.id }}" type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | default:'Email address' }}" autocomplete="email" required><button type="submit">{{ section.settings.btn_label | default:'Join' }}</button></div>{% if form.errors %}<div class="melato-mail__error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}{% endif %}{%- endform -%}</div>
  </div>
</section>
<style>
#MelatoMail-{{ section.id }}{background:var(--mail-bg);color:var(--mail-text);padding:clamp(38px,5vw,60px) 0;border-top:1px solid rgba(245,241,232,.1)}#MelatoMail-{{ section.id }} .melato-mail__inner{width:min(1180px,calc(100% - 32px));margin:auto;display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,6vw,80px);align-items:end}#MelatoMail-{{ section.id }} .melato-mail__eyebrow{margin:0 0 9px;color:#aaa49b;font:700 10px/1.2 var(--font-mono-family,monospace);letter-spacing:.2em;text-transform:uppercase}#MelatoMail-{{ section.id }} h2{margin:0;font-family:var(--font-heading-family,'Bebas Neue',sans-serif);font-size:clamp(40px,5vw,64px);line-height:.94;text-transform:uppercase}#MelatoMail-{{ section.id }} .melato-mail__sub{margin:11px 0 0;color:#aaa49b;line-height:1.5}#MelatoMail-{{ section.id }} .melato-mail__field{display:grid;grid-template-columns:1fr auto;gap:8px}#MelatoMail-{{ section.id }} input,#MelatoMail-{{ section.id }} button{min-height:50px;border-radius:12px;font:inherit}#MelatoMail-{{ section.id }} input{min-width:0;background:#111214;border:1px solid rgba(245,241,232,.16);color:var(--mail-text);padding:0 14px}#MelatoMail-{{ section.id }} button{border:0;background:var(--mail-accent);color:#080808;padding:0 22px;font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}#MelatoMail-{{ section.id }} .melato-mail__success{margin:0;color:#9ed7ae}@media(max-width:720px){#MelatoMail-{{ section.id }} .melato-mail__inner{grid-template-columns:1fr}#MelatoMail-{{ section.id }} .melato-mail__field{grid-template-columns:1fr}}
</style>
{% schema %}
{"name":"Email Signup","tag":"section","class":"melato-drop-signup","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow text","default":"Email"},{"type":"text","id":"heading","label":"Heading","default":"Melato notes"},{"type":"text","id":"subtext","label":"Sub-text","default":"Product updates and restocks."},{"type":"text","id":"placeholder","label":"Input placeholder","default":"Email address"},{"type":"text","id":"btn_label","label":"Button label","default":"Join"},{"type":"checkbox","id":"show_divider_lines","label":"Show decorative lines","default":false},{"type":"color","id":"bg_color","label":"Background colour","default":"#0a0a0a"},{"type":"color","id":"text_color","label":"Text colour","default":"#f5f1e8"},{"type":"color","id":"accent_color","label":"Accent colour","default":"#f5f1e8"}],"presets":[{"name":"Email Signup"}]}
{% endschema %}

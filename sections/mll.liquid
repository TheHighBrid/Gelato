
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Barlow+Condensed:wght@200;400;500;700&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════
   RESET & ROOT
═══════════════════════════════════════ */
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
:root {
  --black:    #050505;
  --ink:      #0c0c0c;
  --offwhite: #ede8e0;
  --cream:    #d6ccbc;
  --gold:     #b89660;
  --gold-lt:  #d4b07a;
  --red:      #8b1a1a;
  --muted:    #5a5550;
  --dim:      #2a2620;
  --bebas:    'Bebas Neue', sans-serif;
  --cormo:    'Cormorant Garamond', serif;
  --barlow:   'Barlow Condensed', sans-serif;
}
html { scroll-behavior: smooth; background: var(--black); }
body {
  background: var(--black);
  color: var(--offwhite);
  font-family: var(--barlow);
  font-weight: 200;
  cursor: none;
  overflow-x: hidden;
}
a { text-decoration: none; color: inherit; }
img { display: block; width: 100%; height: 100%; object-fit: cover; }

/* ═══════════════════════════════════════
   CUSTOM CURSOR
═══════════════════════════════════════ */
.cursor {
  position: fixed;
  top: 0; left: 0;
  width: 10px; height: 10px;
  background: var(--gold);
  border-radius: 50%;
  pointer-events: none;
  z-index: 9999;
  transform: translate(-50%,-50%);
  transition: transform .12s ease, width .25s ease, height .25s ease, background .25s ease;
  mix-blend-mode: difference;
}
.cursor-ring {
  position: fixed;
  top: 0; left: 0;
  width: 36px; height: 36px;
  border: 1px solid rgba(184,150,96,.5);
  border-radius: 50%;
  pointer-events: none;
  z-index: 9998;
  transform: translate(-50%,-50%);
  transition: transform .35s cubic-bezier(.25,.46,.45,.94), width .3s ease, height .3s ease, border-color .3s ease;
}
.cursor.hovering { width: 6px; height: 6px; }
.cursor-ring.hovering { width: 60px; height: 60px; border-color: var(--gold); }
.cursor-ring .cursor-label {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--barlow);
  font-size: 8px; font-weight: 500;
  letter-spacing: .2em; text-transform: uppercase;
  color: var(--gold); opacity: 0;
  transition: opacity .25s;
}
.cursor-ring.hovering .cursor-label { opacity: 1; }

/* ═══════════════════════════════════════
   LOADING SCREEN
═══════════════════════════════════════ */
.loader {
  position: fixed; inset: 0;
  background: var(--black);
  z-index: 8000;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 24px;
  transition: opacity .8s ease, visibility .8s ease;
}
.loader.done { opacity: 0; visibility: hidden; }
.loader-logo {
  font-family: var(--bebas);
  font-size: 52px;
  letter-spacing: .2em;
  color: var(--gold);
  animation: pulse-gold 1.4s ease infinite;
}
.loader-line {
  width: 120px; height: 1px;
  background: var(--dim);
  position: relative; overflow: hidden;
}
.loader-line::after {
  content: '';
  position: absolute; top: 0; left: -100%;
  width: 100%; height: 100%;
  background: var(--gold);
  animation: load-sweep 1.2s ease forwards;
}
.loader-sub {
  font-family: var(--barlow);
  font-size: 11px; font-weight: 200;
  letter-spacing: .35em; text-transform: uppercase;
  color: var(--muted);
  animation: fade-in .5s ease .8s both;
}
@keyframes load-sweep { to { left: 100%; } }
@keyframes pulse-gold { 0%,100%{opacity:1} 50%{opacity:.4} }
@keyframes fade-in { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:none} }

/* ═══════════════════════════════════════
   CINEMATIC HERO
═══════════════════════════════════════ */
.hero {
  position: relative;
  height: 100svh;
  display: flex; flex-direction: column;
  align-items: center; justify-content: flex-end;
  padding-bottom: 8vh;
  overflow: hidden;
}
.hero-bg {
  position: absolute; inset: 0;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 2px;
  opacity: .18;
  filter: grayscale(1);
}
.hero-bg-tile { overflow: hidden; }
.hero-bg-tile img {
  width: 100%; height: 100%; object-fit: cover;
  transform: scale(1.08);
  animation: slow-zoom 14s ease-in-out infinite alternate;
}
.hero-bg-tile:nth-child(2) img { animation-delay: -4s; }
.hero-bg-tile:nth-child(3) img { animation-delay: -8s; }
@keyframes slow-zoom { from{transform:scale(1.08)} to{transform:scale(1.14)} }

/* grain overlay */
.hero::before {
  content: '';
  position: absolute; inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='.06'/%3E%3C/svg%3E");
  background-size: 256px;
  pointer-events: none;
  z-index: 2;
  opacity: .4;
}
/* vignette */
.hero::after {
  content: '';
  position: absolute; inset: 0;
  background: radial-gradient(ellipse at center, transparent 30%, rgba(5,5,5,.92) 100%);
  z-index: 1;
}
.hero-content {
  position: relative; z-index: 3;
  text-align: center;
  display: flex; flex-direction: column; align-items: center;
  gap: 16px;
}
.hero-eyebrow {
  font-family: var(--barlow);
  font-size: 11px; font-weight: 400;
  letter-spacing: .45em; text-transform: uppercase;
  color: var(--gold); opacity: .8;
  animation: fade-in .6s ease .5s both;
}
.hero-title {
  font-family: var(--bebas);
  font-size: clamp(64px, 14vw, 160px);
  line-height: .92;
  letter-spacing: .04em;
  color: var(--offwhite);
  animation: hero-rise .9s cubic-bezier(.22,1,.36,1) .3s both;
}
.hero-title em {
  color: var(--gold);
  font-style: normal;
}
.hero-desc {
  font-family: var(--cormo);
  font-size: clamp(15px, 2.2vw, 20px);
  font-style: italic;
  color: var(--cream);
  opacity: .65;
  max-width: 480px;
  line-height: 1.5;
  animation: fade-in .7s ease .7s both;
}
.hero-scroll {
  margin-top: 32px;
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  animation: fade-in .6s ease 1.1s both;
}
.hero-scroll span {
  font-family: var(--barlow);
  font-size: 9px; font-weight: 400;
  letter-spacing: .4em; text-transform: uppercase;
  color: var(--muted);
}
.scroll-line {
  width: 1px; height: 40px;
  background: var(--dim);
  position: relative; overflow: hidden;
}
.scroll-line::after {
  content: '';
  position: absolute; top: -100%; left: 0;
  width: 100%; height: 100%;
  background: var(--gold);
  animation: scroll-drop 1.6s ease 1.5s infinite;
}
@keyframes scroll-drop { 0%{top:-100%} 100%{top:100%} }
@keyframes hero-rise { from{opacity:0;transform:translateY(40px)} to{opacity:1;transform:none} }

/* ═══════════════════════════════════════
   FILTER BAR
═══════════════════════════════════════ */
.filter-bar {
  position: sticky; top: 0; z-index: 100;
  background: rgba(5,5,5,.96);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--dim);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 40px;
  height: 52px;
  gap: 16px;
}
.filter-bar-logo {
  font-family: var(--bebas);
  font-size: 20px; letter-spacing: .18em;
  color: var(--gold); flex-shrink: 0;
}
.filter-tabs {
  display: flex; gap: 4px;
  overflow-x: auto; scrollbar-width: none;
}
.filter-tabs::-webkit-scrollbar { display: none; }
.filter-tab {
  font-family: var(--barlow);
  font-size: 10px; font-weight: 400;
  letter-spacing: .28em; text-transform: uppercase;
  color: var(--muted);
  padding: 6px 14px;
  border: 1px solid transparent;
  border-radius: 1px;
  background: none;
  cursor: none;
  white-space: nowrap;
  transition: color .2s, border-color .2s;
}
.filter-tab:hover { color: var(--offwhite); }
.filter-tab.active {
  color: var(--gold);
  border-color: rgba(184,150,96,.3);
}
.filter-bar-cta {
  font-family: var(--barlow);
  font-size: 10px; font-weight: 500;
  letter-spacing: .28em; text-transform: uppercase;
  color: var(--offwhite);
  background: var(--gold);
  padding: 7px 16px;
  flex-shrink: 0;
  transition: background .2s;
}
.filter-bar-cta:hover { background: var(--gold-lt); }

/* ═══════════════════════════════════════
   ISSUE HEADER - editorial magazine style
═══════════════════════════════════════ */
.issue-header {
  padding: 80px 40px 40px;
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: end;
  gap: 24px;
  border-bottom: 1px solid var(--dim);
  max-width: 1400px; margin: 0 auto;
}
.issue-tag {
  font-family: var(--barlow);
  font-size: 10px; font-weight: 400;
  letter-spacing: .4em; text-transform: uppercase;
  color: var(--gold); margin-bottom: 14px;
  display: flex; align-items: center; gap: 12px;
}
.issue-tag::before {
  content: '';
  width: 24px; height: 1px;
  background: var(--gold);
}
.issue-title {
  font-family: var(--bebas);
  font-size: clamp(40px, 6vw, 80px);
  line-height: 1;
  letter-spacing: .05em;
  color: var(--offwhite);
}
.issue-meta {
  text-align: right;
}
.issue-count {
  font-family: var(--bebas);
  font-size: 64px; line-height: 1;
  color: var(--dim);
  letter-spacing: .05em;
}
.issue-label {
  font-family: var(--barlow);
  font-size: 9px; font-weight: 400;
  letter-spacing: .3em; text-transform: uppercase;
  color: var(--muted);
}

/* ═══════════════════════════════════════
   MASONRY GRID - the main event
═══════════════════════════════════════ */
.grid-wrap {
  max-width: 1400px; margin: 0 auto;
  padding: 48px 24px;
}
.masonry {
  columns: 3;
  column-gap: 6px;
}
@media(max-width:900px) { .masonry { columns: 2; } }
@media(max-width:540px) { .masonry { columns: 1; } }

/* ─── LOOK CARD ─── */
.look-card {
  break-inside: avoid;
  margin-bottom: 6px;
  position: relative;
  overflow: hidden;
  display: block;
  cursor: none;
}
/* Featured cards (tall) */
.look-card--feat { grid-row: span 2; }

.look-card__img-wrap {
  position: relative;
  overflow: hidden;
  background: var(--ink);
}
.look-card__img-wrap img {
  width: 100%; height: auto;
  display: block;
  transform: scale(1);
  transition: transform .65s cubic-bezier(.25,.46,.45,.94);
  filter: brightness(.96);
}
.look-card:hover .look-card__img-wrap img {
  transform: scale(1.04);
  filter: brightness(1.02);
}

/* overlay */
.look-card__overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(5,5,5,.88) 0%, rgba(5,5,5,.2) 45%, transparent 70%);
  opacity: 0;
  transition: opacity .4s ease;
  display: flex; flex-direction: column;
  justify-content: flex-end;
  padding: 20px;
}
.look-card:hover .look-card__overlay { opacity: 1; }

.look-card__name {
  font-family: var(--cormo);
  font-size: 18px;
  font-style: italic;
  color: var(--offwhite);
  margin-bottom: 4px;
  transform: translateY(8px);
  transition: transform .35s ease;
}
.look-card:hover .look-card__name { transform: translateY(0); }

.look-card__price {
  font-family: var(--barlow);
  font-size: 12px; font-weight: 400;
  letter-spacing: .2em;
  color: var(--gold-lt);
  margin-bottom: 12px;
  transform: translateY(8px);
  transition: transform .35s ease .04s;
}
.look-card:hover .look-card__price { transform: translateY(0); }

.look-card__cta {
  display: inline-flex;
  align-items: center; gap: 8px;
  font-family: var(--barlow);
  font-size: 9px; font-weight: 500;
  letter-spacing: .35em; text-transform: uppercase;
  color: var(--offwhite);
  border-bottom: 1px solid rgba(214,204,188,.35);
  padding-bottom: 2px;
  width: fit-content;
  transform: translateY(8px);
  opacity: 0;
  transition: transform .35s ease .08s, opacity .35s ease .08s;
}
.look-card:hover .look-card__cta { transform: translateY(0); opacity: 1; }
.look-card__cta svg { transition: transform .25s; }
.look-card:hover .look-card__cta svg { transform: translateX(4px); }

/* category tag on card */
.look-card__tag {
  position: absolute;
  top: 14px; left: 14px;
  font-family: var(--barlow);
  font-size: 8.5px; font-weight: 500;
  letter-spacing: .25em; text-transform: uppercase;
  color: var(--offwhite);
  background: rgba(5,5,5,.72);
  padding: 4px 10px;
  border: 1px solid rgba(214,204,188,.15);
  backdrop-filter: blur(4px);
  opacity: 0;
  transform: translateY(-4px);
  transition: opacity .3s, transform .3s;
}
.look-card:hover .look-card__tag { opacity: 1; transform: none; }

/* card number */
.look-card__num {
  position: absolute;
  bottom: 14px; right: 14px;
  font-family: var(--bebas);
  font-size: 13px; letter-spacing: .1em;
  color: rgba(214,204,188,.25);
  opacity: 0;
  transition: opacity .3s;
}
.look-card:hover .look-card__num { opacity: 1; }

/* reveal animation on scroll */
.look-card {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity .6s ease, transform .6s ease;
}
.look-card.visible { opacity: 1; transform: none; }

/* ═══════════════════════════════════════
   EDITORIAL BREAK - full width quote
═══════════════════════════════════════ */
.editorial-break {
  padding: 80px 40px;
  text-align: center;
  border-top: 1px solid var(--dim);
  border-bottom: 1px solid var(--dim);
  margin: 48px 0;
  position: relative;
  overflow: hidden;
}
.editorial-break::before {
  content: '"';
  position: absolute;
  font-family: var(--bebas);
  font-size: 400px; line-height: 1;
  color: var(--dim);
  top: -80px; left: 50%;
  transform: translateX(-50%);
  pointer-events: none;
  opacity: .3;
}
.editorial-quote {
  position: relative; z-index: 1;
  font-family: var(--cormo);
  font-size: clamp(22px, 4vw, 42px);
  font-style: italic;
  line-height: 1.35;
  color: var(--offwhite);
  max-width: 700px;
  margin: 0 auto 20px;
}
.editorial-attr {
  font-family: var(--barlow);
  font-size: 10px; font-weight: 400;
  letter-spacing: .4em; text-transform: uppercase;
  color: var(--gold); opacity: .7;
}

/* ═══════════════════════════════════════
   MARQUEE STRIP
═══════════════════════════════════════ */
.marquee-strip {
  overflow: hidden;
  border-top: 1px solid var(--dim);
  border-bottom: 1px solid var(--dim);
  padding: 14px 0;
  margin: 0;
  background: var(--ink);
}
.marquee-track {
  display: flex; gap: 0;
  width: max-content;
  animation: marquee-scroll 22s linear infinite;
}
.marquee-item {
  display: flex; align-items: center; gap: 32px;
  padding: 0 32px;
  font-family: var(--bebas);
  font-size: 14px; letter-spacing: .25em;
  color: var(--muted);
  white-space: nowrap;
}
.marquee-item .dot {
  width: 4px; height: 4px; border-radius: 50%;
  background: var(--gold); opacity: .6; flex-shrink: 0;
}
@keyframes marquee-scroll { from{transform:translateX(0)} to{transform:translateX(-50%)} }

/* ═══════════════════════════════════════
   LIGHTBOX
═══════════════════════════════════════ */
.lightbox {
  position: fixed; inset: 0;
  background: rgba(5,5,5,.97);
  z-index: 7000;
  display: flex; align-items: center; justify-content: center;
  opacity: 0; visibility: hidden;
  transition: opacity .4s ease, visibility .4s ease;
}
.lightbox.open { opacity: 1; visibility: visible; }

.lightbox-inner {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 320px;
  max-width: 1100px;
  width: 94vw;
  max-height: 90vh;
  gap: 0;
  border: 1px solid var(--dim);
}
@media(max-width:700px){
  .lightbox-inner { grid-template-columns: 1fr; max-height: 95vh; }
}
.lightbox-img {
  overflow: hidden;
  max-height: 90vh;
  background: var(--ink);
  display: flex; align-items: center;
}
.lightbox-img img {
  width: 100%; height: 100%; object-fit: contain;
  max-height: 90vh;
}
.lightbox-panel {
  background: var(--ink);
  border-left: 1px solid var(--dim);
  padding: 36px 28px;
  display: flex; flex-direction: column;
  gap: 20px;
  overflow-y: auto;
}
.lightbox-num {
  font-family: var(--bebas);
  font-size: 11px; letter-spacing: .3em;
  color: var(--muted);
}
.lightbox-tag {
  display: inline-block;
  font-family: var(--barlow);
  font-size: 9px; font-weight: 500;
  letter-spacing: .3em; text-transform: uppercase;
  color: var(--gold);
  border: 1px solid rgba(184,150,96,.3);
  padding: 3px 10px;
  width: fit-content;
}
.lightbox-name {
  font-family: var(--cormo);
  font-size: 28px; font-weight: 300;
  font-style: italic;
  line-height: 1.2;
  color: var(--offwhite);
}
.lightbox-desc {
  font-family: var(--cormo);
  font-size: 15px; font-weight: 300;
  line-height: 1.65;
  color: var(--muted);
}
.lightbox-price {
  font-family: var(--barlow);
  font-size: 20px; font-weight: 400;
  letter-spacing: .12em;
  color: var(--offwhite);
}
.lightbox-cta {
  display: block;
  text-align: center;
  background: var(--gold);
  color: var(--black);
  font-family: var(--barlow);
  font-size: 11px; font-weight: 500;
  letter-spacing: .35em; text-transform: uppercase;
  padding: 14px 24px;
  transition: background .2s;
  margin-top: auto;
}
.lightbox-cta:hover { background: var(--gold-lt); }
.lightbox-close {
  position: absolute;
  top: 16px; right: 16px;
  width: 36px; height: 36px;
  background: none;
  border: 1px solid var(--dim);
  color: var(--muted);
  font-size: 18px;
  display: flex; align-items: center; justify-content: center;
  cursor: none;
  transition: border-color .2s, color .2s;
  z-index: 2;
}
.lightbox-close:hover { border-color: var(--gold); color: var(--gold); }
.lightbox-nav {
  position: absolute;
  top: 50%; transform: translateY(-50%);
  background: rgba(12,12,12,.85);
  border: 1px solid var(--dim);
  color: var(--muted);
  width: 40px; height: 40px;
  display: flex; align-items: center; justify-content: center;
  cursor: none; font-size: 20px;
  transition: border-color .2s, color .2s;
  z-index: 2;
}
.lightbox-nav:hover { border-color: var(--gold); color: var(--gold); }
.lightbox-nav--prev { left: 12px; }
.lightbox-nav--next { left: calc(100% - 320px - 52px); }
@media(max-width:700px) {
  .lightbox-nav--next { left: auto; right: 12px; }
}

/* ═══════════════════════════════════════
   SHOP THE DROP CTA SECTION
═══════════════════════════════════════ */
.drop-cta {
  max-width: 1400px; margin: 0 auto;
  padding: 80px 40px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2px;
}
@media(max-width:700px) { .drop-cta { grid-template-columns: 1fr; } }
.drop-cta-panel {
  background: var(--ink);
  padding: 48px 40px;
  border: 1px solid var(--dim);
  display: flex; flex-direction: column; gap: 16px;
}
.drop-cta-panel--gold { background: var(--gold); border-color: var(--gold); }
.drop-cta-panel--gold * { color: var(--black) !important; }
.drop-cta-label {
  font-family: var(--barlow);
  font-size: 10px; font-weight: 400;
  letter-spacing: .4em; text-transform: uppercase;
  color: var(--muted);
}
.drop-cta-title {
  font-family: var(--bebas);
  font-size: clamp(32px, 5vw, 56px);
  letter-spacing: .04em;
  color: var(--offwhite);
  line-height: 1;
}
.drop-cta-desc {
  font-family: var(--cormo);
  font-size: 16px; font-style: italic;
  color: var(--muted);
  line-height: 1.5;
}
.drop-cta-btn {
  display: inline-flex; align-items: center; gap: 10px;
  font-family: var(--barlow);
  font-size: 11px; font-weight: 500;
  letter-spacing: .3em; text-transform: uppercase;
  color: var(--offwhite);
  border-bottom: 1px solid rgba(214,204,188,.3);
  padding-bottom: 4px;
  width: fit-content;
  margin-top: 8px;
  transition: gap .25s;
}
.drop-cta-btn:hover { gap: 16px; }
.drop-cta-panel--gold .drop-cta-btn {
  color: var(--black);
  border-color: rgba(5,5,5,.25);
}

/* ═══════════════════════════════════════
   FOOTER STRIP
═══════════════════════════════════════ */
.lb-footer {
  border-top: 1px solid var(--dim);
  padding: 24px 40px;
  display: flex; align-items: center; justify-content: space-between;

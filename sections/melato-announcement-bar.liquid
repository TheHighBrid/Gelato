{% comment %}
  Melato announcement bar.
  Sync revision: 2026-08-07T18:28Z.
  Global storefront policy enforcement lives here because this section is rendered
  site-wide and syncs reliably to the published Shopify theme.
{% endcomment %}

{%- liquid
  assign accent = section.settings.default_accent | default: 'black'
  assign bg = '#070707'
  assign fg = '#f7f1e8'
  assign muted = 'rgba(247,241,232,.72)'
  assign button_bg = '#f7f1e8'
  assign button_fg = '#070707'
  assign fallback_message = section.settings.fallback_message | replace: ' · COMPLIMENTARY DELIVERY ON ALL ORDERS', '' | replace: 'COMPLIMENTARY DELIVERY ON ALL ORDERS · ', '' | replace: 'COMPLIMENTARY DELIVERY ON ALL ORDERS', ''

  case accent
    when 'cream'
      assign bg = '#f2e5d0'
      assign fg = '#1d140c'
      assign muted = 'rgba(29,20,12,.68)'
      assign button_bg = '#1d140c'
      assign button_fg = '#f8ead6'
    when 'burgundy'
      assign bg = '#3a0f19'
      assign fg = '#fff7f5'
      assign muted = 'rgba(255,247,245,.76)'
      assign button_bg = '#ffd7dd'
      assign button_fg = '#2a0811'
    when 'blue'
      assign bg = '#102a46'
      assign fg = '#f2f9ff'
      assign muted = 'rgba(242,249,255,.74)'
      assign button_bg = '#d5ecff'
      assign button_fg = '#071b30'
    when 'pink'
      assign bg = '#4a1931'
      assign fg = '#fff5fb'
      assign muted = 'rgba(255,245,251,.76)'
      assign button_bg = '#ffd6ec'
      assign button_fg = '#2a0718'
    when 'gold'
      assign bg = '#6a4a0a'
      assign fg = '#fff9e8'
      assign muted = 'rgba(255,249,232,.76)'
      assign button_bg = '#fff0ba'
      assign button_fg = '#2b1d03'
    when 'green', 'emerald', 'teal', 'turquoise'
      assign bg = '#12341f'
      assign fg = '#f3fff7'
      assign muted = 'rgba(243,255,247,.76)'
      assign button_bg = '#cffff0'
      assign button_fg = '#071f12'
    when 'red'
      assign bg = '#4a0b0b'
      assign fg = '#fff5f5'
      assign muted = 'rgba(255,245,245,.76)'
      assign button_bg = '#ffd1d1'
      assign button_fg = '#2b0505'
    when 'lime', 'yellow'
      assign bg = '#cce96a'
      assign fg = '#111606'
      assign muted = 'rgba(17,22,6,.72)'
      assign button_bg = '#111606'
      assign button_fg = '#f5ffd7'
    when 'white', 'silver'
      assign bg = '#ffffff'
      assign fg = '#0a0a0a'
      assign muted = 'rgba(10,10,10,.65)'
      assign button_bg = '#0a0a0a'
      assign button_fg = '#ffffff'
    when 'brown', 'orange'
      assign bg = '#2e180b'
      assign fg = '#fff0e0'
      assign muted = 'rgba(255,240,224,.76)'
      assign button_bg = '#ffd4a8'
      assign button_fg = '#1a0c04'
    when 'purple', 'fuchsia'
      assign bg = '#241335'
      assign fg = '#fff7ff'
      assign muted = 'rgba(255,247,255,.76)'
      assign button_bg = '#f1d7ff'
      assign button_fg = '#1a0b27'
    when 'gray', 'charcoal', 'navy'
      assign bg = '#1c1c1e'
      assign fg = '#f0ede8'
      assign muted = 'rgba(240,237,232,.72)'
      assign button_bg = '#f0ede8'
      assign button_fg = '#1c1c1e'
  endcase
-%}

{% if section.settings.enabled %}
  <div
    class="melato-ann"
    id="melato-announcement-bar"
    style="--ab-bg:{{ bg }};--ab-fg:{{ fg }};--ab-muted:{{ muted }};--ab-btn-bg:{{ button_bg }};--ab-btn-fg:{{ button_fg }};--ab-h:{{ section.settings.height }}px;--ab-fs:{{ section.settings.font_size }}px;--ab-speed:{{ section.settings.speed }}s"
  >
    {%- if section.settings.badge_text != blank -%}
      <span class="melato-ann__badge">{{ section.settings.badge_text }}</span>
    {%- else -%}
      <span aria-hidden="true"></span>
    {%- endif -%}

    <div class="melato-ann__viewport" aria-label="Store announcements">
      <div class="melato-ann__track" data-announcement-track>
        <div class="melato-ann__group" data-announcement-source>
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.message != blank -%}
                {%- if block.settings.link != blank -%}
                  <a class="melato-ann__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
                    <span class="melato-ann__dot" aria-hidden="true"></span>
                    <span>{{ block.settings.message }}</span>
                    {%- if block.settings.micro_text != blank -%}<small>{{ block.settings.micro_text }}</small>{%- endif -%}
                  </a>
                {%- else -%}
                  <span class="melato-ann__item" {{ block.shopify_attributes }}>
                    <span class="melato-ann__dot" aria-hidden="true"></span>
                    <span>{{ block.settings.message }}</span>
                    {%- if block.settings.micro_text != blank -%}<small>{{ block.settings.micro_text }}</small>{%- endif -%}
                  </span>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <span class="melato-ann__item">
              <span class="melato-ann__dot" aria-hidden="true"></span>
              <span>{{ fallback_message }}</span>
              {%- if section.settings.fallback_micro != blank -%}<small>{{ section.settings.fallback_micro }}</small>{%- endif -%}
            </span>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- if section.settings.cta_text != blank -%}
      <a class="melato-ann__cta" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_text }}</a>
    {%- else -%}
      <span aria-hidden="true"></span>
    {%- endif -%}
  </div>

  <script>
  (function(){
    var bar=document.getElementById('melato-announcement-bar');
    if(!bar||bar.dataset.cloneReady==='true')return;
    var track=bar.querySelector('[data-announcement-track]');
    var source=bar.querySelector('[data-announcement-source]');
    if(!track||!source)return;
    var clone=source.cloneNode(true);
    clone.removeAttribute('data-announcement-source');
    clone.setAttribute('aria-hidden','true');
    clone.setAttribute('role','presentation');
    clone.setAttribute('inert','');
    clone.querySelectorAll('[id]').forEach(function(node){node.removeAttribute('id')});
    clone.querySelectorAll('a,button,input,select,textarea,[tabindex]').forEach(function(node){node.setAttribute('tabindex','-1')});
    track.appendChild(clone);
    bar.dataset.cloneReady='true';
  })();
  </script>
{% endif %}

<style>
.melato-ann{min-height:var(--ab-h);display:grid;grid-template-columns:minmax(108px,.72fr) minmax(0,2.8fr) minmax(108px,.72fr);align-items:center;gap:14px;padding:0 clamp(14px,3vw,34px);overflow:hidden;position:relative;background:var(--ab-bg);color:var(--ab-fg);border-bottom:1px solid color-mix(in srgb,var(--ab-fg) 18%,transparent);font-family:var(--font-mono-family,'DM Mono',monospace)}.melato-ann__badge,.melato-ann__cta{min-height:34px;display:inline-flex;align-items:center;justify-content:center;padding:0 14px;border-radius:999px;font-size:max(10px,calc(var(--ab-fs) - 2px));font-weight:800;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap}.melato-ann__badge{justify-self:start;border:1px solid color-mix(in srgb,var(--ab-fg) 20%,transparent);color:var(--ab-fg);background:color-mix(in srgb,var(--ab-fg) 7%,transparent)}.melato-ann__cta{justify-self:end;background:var(--ab-btn-bg);color:var(--ab-btn-fg);text-decoration:none}.melato-ann__viewport{width:100%;overflow:hidden;mask-image:linear-gradient(90deg,transparent,black 8%,black 92%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent 0,black 8%,black 92%,transparent 100%)}.melato-ann__track{display:flex;width:max-content;align-items:center;animation:melato-ann-scroll var(--ab-speed) linear infinite;will-change:transform}.melato-ann__group{display:inline-flex;align-items:center;gap:clamp(24px,4vw,56px);padding-right:clamp(24px,4vw,56px)}.melato-ann__item{display:inline-flex;align-items:center;gap:12px;color:var(--ab-fg);font-size:var(--ab-fs);font-weight:800;letter-spacing:.12em;text-decoration:none;text-transform:uppercase;white-space:nowrap}.melato-ann__item small{color:var(--ab-muted);font-size:.78em}.melato-ann__dot{width:7px;height:7px;border-radius:50%;background:currentColor;opacity:.72}@keyframes melato-ann-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}@media(prefers-reduced-motion:reduce){.melato-ann__track{animation:none}.melato-ann__group[aria-hidden="true"]{display:none}}@media(max-width:749px){.melato-ann{grid-template-columns:1fr;min-height:max(48px,calc(var(--ab-h) - 8px));padding:0 14px}.melato-ann__badge,.melato-ann__cta{display:none}.melato-ann__item{font-size:max(11px,calc(var(--ab-fs) - 1px))}}

/* Melato storefront policy hard-stop. */
.cart-free-shipping,
.cart-drawer__tax-note,
.shopify-payment-button,
.shopify-payment-button__button,
.shopify-payment-button__button--unbranded,
[data-shopify="payment-button"],
.additional-checkout-buttons,
.additional-checkout-button,
.dynamic-checkout__content,
.pdp-dynamic-checkout,
.melato-home-conversion__ctas{display:none!important;visibility:hidden!important;height:0!important;min-height:0!important;margin:0!important;padding:0!important;overflow:hidden!important;pointer-events:none!important}
</style>

<script>
(function(){
  var selectors=[
    '.cart-free-shipping',
    '.cart-drawer__tax-note',
    '.shopify-payment-button',
    '[data-shopify="payment-button"]',
    '.additional-checkout-buttons',
    '.additional-checkout-button',
    '.dynamic-checkout__content',
    '.pdp-dynamic-checkout',
    '.melato-home-conversion__ctas'
  ];
  function clean(root){
    root=root||document;
    selectors.forEach(function(selector){root.querySelectorAll(selector).forEach(function(node){node.remove()})});
    root.querySelectorAll('.product-assurances li,.melato-home-conversion__proof-card').forEach(function(node){
      var text=(node.textContent||'').replace(/\s+/g,' ').trim().toLowerCase();
      if(text.indexOf('fast dispatch')>-1||text.indexOf('secure checkout')>-1||text.indexOf('complimentary delivery')>-1||text.indexOf('google pay')>-1||text.indexOf('apple pay')>-1||text.indexOf('shop pay')>-1){node.remove()}
    });
  }
  clean(document);
  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',function(){clean(document)})}
  new MutationObserver(function(mutations){mutations.forEach(function(mutation){mutation.addedNodes.forEach(function(node){if(node.nodeType===1)clean(node)})})}).observe(document.documentElement,{childList:true,subtree:true});
})();
</script>


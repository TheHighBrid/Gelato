{% comment %}
  MELATO OWNER-PROTECTED ANNOUNCEMENT COLOR CONTRACT
  Restored 2026-08-08 after the product-aware color engine was removed by commit a0f83e1.

  This system must not be flattened to one static announcement color without explicit owner authorization.

  Priority:
  1. Product/collection foreground + background hex metafields
     - custom.background_hex_color_code / custom.foreground_hex_color_code
     - legacy aliases custom.bar_bg / custom.bar_fg
  2. Product hex tags: bar_bg_RRGGBB + bar_fg_RRGGBB
  3. Product accent_<name> tag
  4. Product type / collection handle
  5. Theme customizer default accent

  Product palette_1, palette_2 and palette_3 are a deliberate rotating color layer.
  When present, they rotate through the announcement bar every 4.2 seconds.
{% endcomment %}

{%- liquid
  assign accent = section.settings.default_accent | default: 'black'
  assign color_source = 'customizer'
  assign hex_bg_tag = blank
  assign hex_fg_tag = blank
  assign mf_bg = blank
  assign mf_fg = blank
  assign palette_1 = blank
  assign palette_2 = blank
  assign palette_3 = blank

  if template.name == 'product' and product
    assign ptype = product.type | downcase
    if ptype == 'track jacket'
      assign accent = 'burgundy'
    elsif ptype == 'track pants'
      assign accent = 'charcoal'
    elsif ptype == 'tracksuit'
      assign accent = 'black'
    elsif ptype == 'jeans' or ptype == 'denim jacket' or ptype == 'denim'
      assign accent = 'blue'
    elsif ptype == 'dress' or ptype == 'skirt'
      assign accent = 'pink'
    elsif ptype == 'bodysuit' or ptype == 'undergarment' or ptype == 'intimates'
      assign accent = 'purple'
    elsif ptype == 'top'
      assign accent = 'cream'
    elsif ptype == 'set'
      assign accent = 'gold'
    elsif ptype == 'shirt'
      assign accent = 'teal'
    elsif ptype == 'trousers'
      assign accent = 'green'
    endif
    assign color_source = 'product-type'

    for t in product.tags
      if t contains 'accent_'
        assign tag_accent = t | remove: 'accent_'
        if tag_accent == 'teal' or tag_accent == 'purple' or tag_accent == 'burgundy' or tag_accent == 'lime' or tag_accent == 'orange' or tag_accent == 'blue' or tag_accent == 'navy' or tag_accent == 'red' or tag_accent == 'pink' or tag_accent == 'gold' or tag_accent == 'green' or tag_accent == 'silver' or tag_accent == 'black' or tag_accent == 'cream' or tag_accent == 'brown' or tag_accent == 'emerald' or tag_accent == 'charcoal' or tag_accent == 'yellow' or tag_accent == 'gray' or tag_accent == 'fuchsia' or tag_accent == 'turquoise' or tag_accent == 'white'
          assign accent = tag_accent
          assign color_source = 'accent-tag'
        endif
      endif
      if t contains 'bar_bg_'
        assign hex_bg_tag = t | remove: 'bar_bg_'
      endif
      if t contains 'bar_fg_'
        assign hex_fg_tag = t | remove: 'bar_fg_'
      endif
    endfor

    assign mf_bg = product.metafields.custom.background_hex_color_code.value | default: product.metafields.custom.bar_bg.value
    assign mf_fg = product.metafields.custom.foreground_hex_color_code.value | default: product.metafields.custom.bar_fg.value
    assign palette_1 = product.metafields.custom.palette_1.value | default: product.metafields.custom.theme_bar_1.value
    assign palette_2 = product.metafields.custom.palette_2.value | default: product.metafields.custom.theme_bar_2.value
    assign palette_3 = product.metafields.custom.palette_3.value | default: product.metafields.custom.theme_bar_3.value
  elsif template.name == 'collection' and collection
    assign ch = collection.handle
    if ch contains 'women' or ch contains 'zellige' or ch contains 'eve'
      assign accent = 'pink'
    elsif ch contains 'denim'
      assign accent = 'blue'
    elsif ch contains 'tracksuit' or ch contains 'velour'
      assign accent = 'black'
    elsif ch contains 'jacket'
      assign accent = 'burgundy'
    elsif ch contains 'accessori'
      assign accent = 'gold'
    elsif ch contains 'sale' or ch contains 'archive'
      assign accent = 'red'
    elsif ch contains 'new' or ch contains 'drop'
      assign accent = 'lime'
    endif
    assign color_source = 'collection-handle'

    assign mf_bg = collection.metafields.custom.background_hex_color_code.value | default: collection.metafields.custom.bar_bg.value
    assign mf_fg = collection.metafields.custom.foreground_hex_color_code.value | default: collection.metafields.custom.bar_fg.value
    assign palette_1 = collection.metafields.custom.palette_1.value | default: collection.metafields.custom.theme_bar_1.value
    assign palette_2 = collection.metafields.custom.palette_2.value | default: collection.metafields.custom.theme_bar_2.value
    assign palette_3 = collection.metafields.custom.palette_3.value | default: collection.metafields.custom.theme_bar_3.value
  endif

  assign bg = '#070707'
  assign fg = '#f7f1e8'
  assign muted = 'rgba(247,241,232,.72)'
  assign border_c = 'rgba(247,241,232,.18)'
  assign button_bg = '#f7f1e8'
  assign button_fg = '#070707'

  case accent
    when 'cream'
      assign bg = '#f2e5d0'
      assign fg = '#1d140c'
      assign muted = 'rgba(29,20,12,.68)'
      assign border_c = 'rgba(29,20,12,.18)'
      assign button_bg = '#1d140c'
      assign button_fg = '#f8ead6'
    when 'burgundy'
      assign bg = '#3a0f19'
      assign fg = '#fff7f5'
      assign muted = 'rgba(255,247,245,.76)'
      assign border_c = 'rgba(255,247,245,.2)'
      assign button_bg = '#ffd7dd'
      assign button_fg = '#2a0811'
    when 'blue'
      assign bg = '#102a46'
      assign fg = '#f2f9ff'
      assign muted = 'rgba(242,249,255,.74)'
      assign border_c = 'rgba(242,249,255,.2)'
      assign button_bg = '#d5ecff'
      assign button_fg = '#071b30'
    when 'navy'
      assign bg = '#071428'
      assign fg = '#eef4ff'
      assign muted = 'rgba(238,244,255,.74)'
      assign border_c = 'rgba(238,244,255,.18)'
      assign button_bg = '#c8dcff'
      assign button_fg = '#071428'
    when 'pink'
      assign bg = '#4a1931'
      assign fg = '#fff5fb'
      assign muted = 'rgba(255,245,251,.76)'
      assign border_c = 'rgba(255,245,251,.2)'
      assign button_bg = '#ffd6ec'
      assign button_fg = '#2a0718'
    when 'gold'
      assign bg = '#6a4a0a'
      assign fg = '#fff9e8'
      assign muted = 'rgba(255,249,232,.76)'
      assign border_c = 'rgba(255,249,232,.2)'
      assign button_bg = '#fff0ba'
      assign button_fg = '#2b1d03'
    when 'green'
      assign bg = '#12341f'
      assign fg = '#f3fff7'
      assign muted = 'rgba(243,255,247,.76)'
      assign border_c = 'rgba(243,255,247,.2)'
      assign button_bg = '#cffff0'
      assign button_fg = '#071f12'
    when 'emerald'
      assign bg = '#063a29'
      assign fg = '#e8fff5'
      assign muted = 'rgba(232,255,245,.76)'
      assign border_c = 'rgba(232,255,245,.2)'
      assign button_bg = '#b8ffde'
      assign button_fg = '#032718'
    when 'teal'
      assign bg = '#0b3f3c'
      assign fg = '#f2fffb'
      assign muted = 'rgba(242,255,251,.76)'
      assign border_c = 'rgba(242,255,251,.2)'
      assign button_bg = '#c9fff2'
      assign button_fg = '#082523'
    when 'turquoise'
      assign bg = '#083a3a'
      assign fg = '#e8ffff'
      assign muted = 'rgba(232,255,255,.76)'
      assign border_c = 'rgba(232,255,255,.2)'
      assign button_bg = '#b3ffff'
      assign button_fg = '#042424'
    when 'red'
      assign bg = '#4a0b0b'
      assign fg = '#fff5f5'
      assign muted = 'rgba(255,245,245,.76)'
      assign border_c = 'rgba(255,245,245,.2)'
      assign button_bg = '#ffd1d1'
      assign button_fg = '#2b0505'
    when 'lime'
      assign bg = '#cce96a'
      assign fg = '#111606'
      assign muted = 'rgba(17,22,6,.72)'
      assign border_c = 'rgba(17,22,6,.2)'
      assign button_bg = '#111606'
      assign button_fg = '#f5ffd7'
    when 'yellow'
      assign bg = '#f5d200'
      assign fg = '#1a1400'
      assign muted = 'rgba(26,20,0,.72)'
      assign border_c = 'rgba(26,20,0,.2)'
      assign button_bg = '#1a1400'
      assign button_fg = '#f5d200'
    when 'white'
      assign bg = '#ffffff'
      assign fg = '#0a0a0a'
      assign muted = 'rgba(10,10,10,.65)'
      assign border_c = 'rgba(10,10,10,.16)'
      assign button_bg = '#0a0a0a'
      assign button_fg = '#ffffff'
    when 'silver'
      assign bg = '#d8d8d8'
      assign fg = '#111111'
      assign muted = 'rgba(17,17,17,.68)'
      assign border_c = 'rgba(17,17,17,.18)'
      assign button_bg = '#111111'
      assign button_fg = '#f4f4f4'
    when 'brown'
      assign bg = '#2e180b'
      assign fg = '#fff0e0'
      assign muted = 'rgba(255,240,224,.76)'
      assign border_c = 'rgba(255,240,224,.2)'
      assign button_bg = '#ffd4a8'
      assign button_fg = '#1a0c04'
    when 'orange'
      assign bg = '#5a2a08'
      assign fg = '#fff3e8'
      assign muted = 'rgba(255,243,232,.74)'
      assign border_c = 'rgba(255,243,232,.2)'
      assign button_bg = '#ffd9b3'
      assign button_fg = '#2b1203'
    when 'purple'
      assign bg = '#241335'
      assign fg = '#fff7ff'
      assign muted = 'rgba(255,247,255,.76)'
      assign border_c = 'rgba(255,247,255,.2)'
      assign button_bg = '#f1d7ff'
      assign button_fg = '#1a0b27'
    when 'fuchsia'
      assign bg = '#4a0a3a'
      assign fg = '#ffe8fd'
      assign muted = 'rgba(255,232,253,.76)'
      assign border_c = 'rgba(255,232,253,.2)'
      assign button_bg = '#ffb3f7'
      assign button_fg = '#2a0420'
    when 'gray'
      assign bg = '#2e2e2e'
      assign fg = '#f0f0f0'
      assign muted = 'rgba(240,240,240,.7)'
      assign border_c = 'rgba(240,240,240,.16)'
      assign button_bg = '#f0f0f0'
      assign button_fg = '#2e2e2e'
    when 'charcoal'
      assign bg = '#1c1c1e'
      assign fg = '#f0ede8'
      assign muted = 'rgba(240,237,232,.72)'
      assign border_c = 'rgba(240,237,232,.16)'

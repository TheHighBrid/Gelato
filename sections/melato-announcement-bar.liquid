  if hex_bg_tag != blank
    assign bg = '#' | append: hex_bg_tag
    assign color_source = 'hex-tag'
  endif
  if hex_fg_tag != blank
    assign fg = '#' | append: hex_fg_tag
  endif

  if mf_bg != blank
    assign clean_bg = mf_bg | remove: '#'
    assign bg = '#' | append: clean_bg
    assign color_source = 'metafield'
  elsif palette_1 != blank
    assign clean_palette_1 = palette_1 | remove: '#'
    assign bg = '#' | append: clean_palette_1
    assign color_source = 'palette-1'
  endif

  if mf_fg != blank
    assign clean_fg = mf_fg | remove: '#'
    assign fg = '#' | append: clean_fg
  endif

  if mf_bg != blank or mf_fg != blank or hex_bg_tag != blank or hex_fg_tag != blank
    assign muted = 'color-mix(in srgb,' | append: fg | append: ' 72%,transparent)'
    assign border_c = 'color-mix(in srgb,' | append: fg | append: ' 20%,transparent)'
    assign button_bg = fg
    assign button_fg = bg
  endif

  assign fallback_message = section.settings.fallback_message | replace: ' · COMPLIMENTARY DELIVERY ON ALL ORDERS', '' | replace: 'COMPLIMENTARY DELIVERY ON ALL ORDERS · ', '' | replace: 'COMPLIMENTARY DELIVERY ON ALL ORDERS', ''
-%}

{% if section.settings.enabled %}
  <div
    class="melato-ann"
    id="melato-announcement-bar"
    data-melato-color-owner="announcement-section"
    data-melato-color-source="{{ color_source | escape }}"
    data-melato-explicit-bg="{{ mf_bg | escape }}"
    data-melato-explicit-fg="{{ mf_fg | escape }}"
    data-melato-palette-1="{{ palette_1 | escape }}"
    data-melato-palette-2="{{ palette_2 | escape }}"
    data-melato-palette-3="{{ palette_3 | escape }}"
    style="--ab-bg:{{ bg }};--ab-fg:{{ fg }};--ab-muted:{{ muted }};--ab-border:{{ border_c }};--ab-btn-bg:{{ button_bg }};--ab-btn-fg:{{ button_fg }};--ab-h:{{ section.settings.height }}px;--ab-fs:{{ section.settings.font_size }}px;--ab-speed:{{ section.settings.speed }}s"
  >
    {%- if section.settings.badge_text != blank -%}
      <span class="melato-ann__badge">{{ section.settings.badge_text }}</span>
    {%- else -%}
      <span aria-hidden="true"></span>
    {%- endif -%}

    <div class="melato-ann__viewport" aria-label="Store announcements">
      <div class="melato-ann__track" data-announcement-track>
        <div class="melato-ann__group" data-announcement-source>
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.message != blank -%}
                {%- if block.settings.link != blank -%}
                  <a class="melato-ann__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
                    <span class="melato-ann__dot" aria-hidden="true"></span>
                    <span>{{ block.settings.message }}</span>
                    {%- if block.settings.micro_text != blank -%}<small>{{ block.settings.micro_text }}</small>{%- endif -%}
                  </a>
                {%- else -%}
                  <span class="melato-ann__item" {{ block.shopify_attributes }}>
                    <span class="melato-ann__dot" aria-hidden="true"></span>
                    <span>{{ block.settings.message }}</span>
                    {%- if block.settings.micro_text != blank -%}<small>{{ block.settings.micro_text }}</small>{%- endif -%}
                  </span>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <span class="melato-ann__item">
              <span class="melato-ann__dot" aria-hidden="true"></span>
              <span>{{ fallback_message }}</span>
              {%- if section.settings.fallback_micro != blank -%}<small>{{ section.settings.fallback_micro }}</small>{%- endif -%}
            </span>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- if section.settings.cta_text != blank -%}
      <a class="melato-ann__cta" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_text }}</a>
    {%- else -%}
      <span aria-hidden="true"></span>
    {%- endif -%}
  </div>

  <script>
  (function(){
    var bar=document.getElementById('melato-announcement-bar');
    if(!bar)return;

    if(bar.dataset.cloneReady!=='true'){
      var track=bar.querySelector('[data-announcement-track]');
      var source=bar.querySelector('[data-announcement-source]');
      if(track&&source){
        var clone=source.cloneNode(true);
        clone.removeAttribute('data-announcement-source');
        clone.setAttribute('aria-hidden','true');
        clone.setAttribute('role','presentation');
        clone.setAttribute('inert','');
        clone.querySelectorAll('[id]').forEach(function(node){node.removeAttribute('id')});
        clone.querySelectorAll('a,button,input,select,textarea,[tabindex]').forEach(function(node){node.setAttribute('tabindex','-1')});
        track.appendChild(clone);
        bar.dataset.cloneReady='true';
      }
    }

    if(bar.dataset.colorEngineReady==='true')return;
    bar.dataset.colorEngineReady='true';

    function cleanHex(value){
      if(!value)return '';
      var hex=String(value).trim();
      if(hex.charAt(0)!=='#')hex='#'+hex;
      if(/^#[0-9a-f]{3}$/i.test(hex)){
        hex='#'+hex.slice(1).split('').map(function(c){return c+c}).join('');
      }
      return /^#[0-9a-f]{6}$/i.test(hex)?hex:'';
    }

    function luminance(hex){
      var n=parseInt(hex.slice(1),16);
      var rgb=[(n>>16)&255,(n>>8)&255,n&255].map(function(v){
        v=v/255;
        return v<=0.03928?v/12.92:Math.pow((v+0.055)/1.055,2.4);
      });
      return 0.2126*rgb[0]+0.7152*rgb[1]+0.0722*rgb[2];
    }

    function readableText(background){
      return luminance(background)>0.58?'#111111':'#fff7ea';
    }

    var fixedBg=cleanHex(bar.dataset.melatoExplicitBg);
    var fixedFg=cleanHex(bar.dataset.melatoExplicitFg);
    var colors=[
      fixedBg,
      cleanHex(bar.dataset.melatoPalette1),
      cleanHex(bar.dataset.melatoPalette2),
      cleanHex(bar.dataset.melatoPalette3)
    ].filter(Boolean).filter(function(color,index,array){return array.indexOf(color)===index});

    if(!colors.length)return;

    var index=0;
    function rotate(){
      var background=colors[index%colors.length];
      var foreground=fixedFg||readableText(background);
      bar.style.setProperty('--ab-bg',background);
      bar.style.setProperty('--ab-fg',foreground);
      bar.style.setProperty('--ab-muted','color-mix(in srgb,'+foreground+' 72%,transparent)');
      bar.style.setProperty('--ab-border','color-mix(in srgb,'+foreground+' 20%,transparent)');
      bar.style.setProperty('--ab-btn-bg',foreground);
      bar.style.setProperty('--ab-btn-fg',background);
      index+=1;
    }

    rotate();
    if(colors.length>1){
      window.setInterval(rotate,4200);
    }
  })();
  </script>
{% endif %}

<style>
#melato-announcement-bar{min-height:var(--ab-h);display:grid;grid-template-columns:minmax(108px,.72fr) minmax(0,2.8fr) minmax(108px,.72fr);align-items:center;gap:14px;padding:0 clamp(14px,3vw,34px);overflow:hidden;position:relative;background:var(--ab-bg)!important;color:var(--ab-fg)!important;border-bottom:1px solid var(--ab-border)!important;font-family:var(--font-mono-family,'DM Mono',monospace);transition:background-color 1.8s cubic-bezier(.4,0,.2,1),color .8s ease,border-color .8s ease}
#melato-announcement-bar .melato-ann__badge,#melato-announcement-bar .melato-ann__cta{min-height:34px;display:inline-flex;align-items:center;justify-content:center;padding:0 14px;border-radius:999px;font-size:max(10px,calc(var(--ab-fs) - 2px));font-weight:800;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap}
#melato-announcement-bar .melato-ann__badge{justify-self:start;border:1px solid var(--ab-border)!important;color:var(--ab-fg)!important;background:color-mix(in srgb,var(--ab-fg) 7%,transparent)}
#melato-announcement-bar .melato-ann__cta{justify-self:end;background:var(--ab-btn-bg)!important;color:var(--ab-btn-fg)!important;text-decoration:none}
#melato-announcement-bar .melato-ann__viewport{width:100%;overflow:hidden;mask-image:linear-gradient(90deg,transparent,black 8%,black 92%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent 0,black 8%,black 92%,transparent 100%)}
#melato-announcement-bar .melato-ann__track{display:flex;width:max-content;align-items:center;animation:melato-ann-scroll var(--ab-speed) linear infinite;will-change:transform}
#melato-announcement-bar .melato-ann__group{display:inline-flex;align-items:center;gap:clamp(24px,4vw,56px);padding-right:clamp(24px,4vw,56px)}
#melato-announcement-bar .melato-ann__item{display:inline-flex;align-items:center;gap:12px;color:var(--ab-fg)!important;font-size:var(--ab-fs);font-weight:800;letter-spacing:.12em;text-decoration:none;text-transform:uppercase;white-space:nowrap}
#melato-announcement-bar .melato-ann__item *{color:inherit!important;border-color:currentColor!important}
#melato-announcement-bar .melato-ann__item small{color:color-mix(in srgb,var(--ab-fg) 72%,transparent)!important;font-size:.78em}
#melato-announcement-bar .melato-ann__dot{width:7px;height:7px;border-radius:50%;background:currentColor;opacity:.72}
@keyframes melato-ann-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media(prefers-reduced-motion:reduce){#melato-announcement-bar .melato-ann__track{animation:none}#melato-announcement-bar .melato-ann__group[aria-hidden="true"]{display:none}}
@media(max-width:749px){#melato-announcement-bar{grid-template-columns:1fr;min-height:max(48px,calc(var(--ab-h) - 8px));padding:0 14px}#melato-announcement-bar .melato-ann__badge,#melato-announcement-bar .melato-ann__cta{display:none}#melato-announcement-bar .melato-ann__item{font-size:max(11px,calc(var(--ab-fs) - 1px))}}

/* Melato storefront policy hard-stop. */
.cart-free-shipping,
.cart-drawer__tax-note,
.shopify-payment-button,
.shopify-payment-button__button,
.shopify-payment-button__button--unbranded,
[data-shopify="payment-button"],
.additional-checkout-buttons,
.additional-checkout-button,
.dynamic-checkout__content,
.pdp-dynamic-checkout,
.pdp-proof-mini,
.melato-home-conversion__ctas{display:none!important;visibility:hidden!important;height:0!important;min-height:0!important;margin:0!important;padding:0!important;overflow:hidden!important;pointer-events:none!important}
</style>

<script>
(function(){
  var selectors=[
    '.cart-free-shipping',
    '.cart-drawer__tax-note',
    '.shopify-payment-button',
    '[data-shopify="payment-button"]',
    '.additional-checkout-buttons',
    '.additional-checkout-button',
    '.dynamic-checkout__content',
    '.pdp-dynamic-checkout',
    '.pdp-proof-mini',
    '.melato-home-conversion__ctas'
  ];
  function clean(root){
    root=root||document;
    selectors.forEach(function(selector){root.querySelectorAll(selector).forEach(function(node){node.remove()})});
    root.querySelectorAll('.product-assurances li,.melato-home-conversion__proof-card').forEach(function(node){
      var text=(node.textContent||'').replace(/\s+/g,' ').trim().toLowerCase();
      if(text.indexOf('fast dispatch')>-1||text.indexOf('secure checkout')>-1||text.indexOf('complimentary delivery')>-1||text.indexOf('google pay')>-1||text.indexOf('apple pay')>-1||text.indexOf('shop pay')>-1){node.remove()}
    });
  }
  clean(document);
  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',function(){clean(document)})}
  new MutationObserver(function(mutations){mutations.forEach(function(mutation){mutation.addedNodes.forEach(function(node){if(node.nodeType===1)clean(node)})})}).observe(document.documentElement,{childList:true,subtree:true});
})();
</script>

{% schema %}
{
  "name":"Announcement Bar",
  "settings":[

{% comment %}
  sections/main-addresses.liquid
{% endcomment %}

<section class="section-spacing">
  <div class="container--narrow">
    <div class="drip-reveal" style="margin-bottom:40px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;">
      <h1 class="heading-md">{{ 'account.addresses' | t }}</h1>
      <button class="btn btn--primary btn--sm" onclick="document.getElementById('new-address').style.display='block'">+ Add Address</button>
    </div>

    <div id="new-address" style="display:none;background:var(--color-surface);padding:32px;margin-bottom:40px;" class="drip-reveal">
      <h2 class="heading-xs" style="margin-bottom:24px;">New Address</h2>
      {%- form 'customer_address', customer.new_address -%}
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
          <div class="field"><label class="field__label">First Name</label><input class="field__input" type="text" name="address[first_name]" autocomplete="given-name"></div>
          <div class="field"><label class="field__label">Last Name</label><input class="field__input" type="text" name="address[last_name]" autocomplete="family-name"></div>
          <div class="field" style="grid-column:span 2;"><label class="field__label">Address</label><input class="field__input" type="text" name="address[address1]" autocomplete="address-line1"></div>
          <div class="field"><label class="field__label">City</label><input class="field__input" type="text" name="address[city]" autocomplete="address-level2"></div>
          <div class="field"><label class="field__label">Country</label>{{ country_option_tags | prepend: '<select class="field__select" name="address[country]" autocomplete="country-name">' | append: '</select>' }}</div>
          <div class="field"><label class="field__label">ZIP / Postal Code</label><input class="field__input" type="text" name="address[zip]" autocomplete="postal-code"></div>
          <div class="field"><label class="field__label">Phone</label><input class="field__input" type="tel" name="address[phone]" autocomplete="tel"></div>
        </div>
        <div style="margin-top:24px;display:flex;gap:12px;">
          <button type="submit" class="btn btn--primary">Save Address</button>
          <button type="button" class="btn btn--secondary" onclick="document.getElementById('new-address').style.display='none'">Cancel</button>
        </div>
      {%- endform -%}
    </div>

    {%- if customer.addresses.size > 0 -%}
      <div class="grid grid--2 drip-reveal drip-reveal--delay-1">
        {%- for address in customer.addresses -%}
          <div style="background:var(--color-surface);padding:24px;border:1px solid var(--color-border);">
            {%- if address == customer.default_address -%}
              <span class="badge badge--new" style="margin-bottom:12px;display:inline-block;">Default</span>
            {%- endif -%}
            <p style="font-family:var(--font-mono-family);font-size:0.75rem;color:var(--color-muted);line-height:1.8;">
              {{ address.name }}<br>
              {{ address.address1 }}<br>
              {%- if address.address2 != blank -%}{{ address.address2 }}<br>{%- endif -%}
              {{ address.city }}, {{ address.province }} {{ address.zip }}<br>
              {{ address.country }}
            </p>
            <div style="display:flex;gap:8px;margin-top:16px;">
              <a href="{{ routes.account_addresses_url }}/{{ address.id }}" class="btn btn--secondary btn--sm">Edit</a>
              {%- form 'customer_address', address -%}
                <input type="hidden" name="_method" value="delete">
                <button type="submit" class="btn btn--ghost btn--sm" style="color:var(--color-error);">Remove</button>
              {%- endform -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Addresses", "tag": "section", "settings": [] }
{% endschema %}

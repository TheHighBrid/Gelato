{% comment %}
  sections/main-addresses.liquid
  Native Shopify address forms presented as an accessible House ledger.
{% endcomment %}

<section class="melato-addresses" aria-labelledby="MelatoAddressesTitle-{{ section.id }}">
  <header class="melato-addresses__header">
    <div>
      <p class="melato-addresses__eyebrow">Account / Delivery details</p>
      <h1 id="MelatoAddressesTitle-{{ section.id }}" class="melato-addresses__title">Addresses</h1>
    </div>
    <a href="{{ routes.account_url }}" class="melato-utility-link">Back to account</a>
  </header>

  <div class="melato-addresses__body">
    <details class="melato-addresses__new">
      <summary>Add a new address</summary>
      <div class="melato-addresses__form">
        {%- form 'customer_address', customer.new_address -%}
          <div class="melato-addresses__form-grid">
            <div class="melato-field">
              <label for="NewAddressFirst-{{ section.id }}">First name</label>
              <input id="NewAddressFirst-{{ section.id }}" type="text" name="address[first_name]" autocomplete="given-name">
            </div>
            <div class="melato-field">
              <label for="NewAddressLast-{{ section.id }}">Last name</label>
              <input id="NewAddressLast-{{ section.id }}" type="text" name="address[last_name]" autocomplete="family-name">
            </div>
            <div class="melato-field melato-field--wide">
              <label for="NewAddress1-{{ section.id }}">Address</label>
              <input id="NewAddress1-{{ section.id }}" type="text" name="address[address1]" autocomplete="address-line1" required>
            </div>
            <div class="melato-field melato-field--wide">
              <label for="NewAddress2-{{ section.id }}">Apartment, suite, etc.</label>
              <input id="NewAddress2-{{ section.id }}" type="text" name="address[address2]" autocomplete="address-line2">
            </div>
            <div class="melato-field">
              <label for="NewAddressCity-{{ section.id }}">City</label>
              <input id="NewAddressCity-{{ section.id }}" type="text" name="address[city]" autocomplete="address-level2" required>
            </div>
            <div class="melato-field">
              <label for="NewAddressProvince-{{ section.id }}">Province / State</label>
              <input id="NewAddressProvince-{{ section.id }}" type="text" name="address[province]" autocomplete="address-level1">
            </div>
            <div class="melato-field">
              <label for="NewAddressCountry-{{ section.id }}">Country</label>
              <select id="NewAddressCountry-{{ section.id }}" name="address[country]" autocomplete="country-name">{{ all_country_option_tags }}</select>
            </div>
            <div class="melato-field">
              <label for="NewAddressZip-{{ section.id }}">ZIP / Postal code</label>
              <input id="NewAddressZip-{{ section.id }}" type="text" name="address[zip]" autocomplete="postal-code" required>
            </div>
            <div class="melato-field melato-field--wide">
              <label for="NewAddressPhone-{{ section.id }}">Phone</label>
              <input id="NewAddressPhone-{{ section.id }}" type="tel" name="address[phone]" autocomplete="tel">
            </div>
          </div>
          <div class="melato-addresses__actions">
            <button type="submit" class="melato-house-button">Save address</button>
          </div>
        {%- endform -%}
      </div>
    </details>

    {%- if customer.addresses.size > 0 -%}
      <h2 class="melato-addresses__section-title">Saved addresses</h2>
      <div class="melato-addresses__grid">
        {%- for address in customer.addresses -%}
          <article class="melato-address-card">
            {%- if address == customer.default_address -%}
              <span class="melato-address-card__default">Default address</span>
            {%- endif -%}

            <p>
              <strong>{{ address.name }}</strong><br>
              {{ address.address1 }}<br>
              {%- if address.address2 != blank -%}{{ address.address2 }}<br>{%- endif -%}
              {{ address.city }}{% if address.province != blank %}, {{ address.province }}{% endif %} {{ address.zip }}<br>
              {{ address.country }}
              {%- if address.phone != blank -%}<br>{{ address.phone }}{%- endif -%}
            </p>

            <details class="melato-addresses__new" style="margin:24px 0 0;">
              <summary>Edit address</summary>
              <div class="melato-addresses__form">
                {%- form 'customer_address', address -%}
                  <div class="melato-addresses__form-grid">
                    <div class="melato-field">
                      <label for="AddressFirst-{{ address.id }}">First name</label>
                      <input id="AddressFirst-{{ address.id }}" type="text" name="address[first_name]" value="{{ address.first_name | escape }}" autocomplete="given-name">
                    </div>
                    <div class="melato-field">
                      <label for="AddressLast-{{ address.id }}">Last name</label>
                      <input id="AddressLast-{{ address.id }}" type="text" name="address[last_name]" value="{{ address.last_name | escape }}" autocomplete="family-name">
                    </div>
                    <div class="melato-field melato-field--wide">
                      <label for="Address1-{{ address.id }}">Address</label>
                      <input id="Address1-{{ address.id }}" type="text" name="address[address1]" value="{{ address.address1 | escape }}" autocomplete="address-line1" required>
                    </div>
                    <div class="melato-field melato-field--wide">
                      <label for="Address2-{{ address.id }}">Apartment, suite, etc.</label>
                      <input id="Address2-{{ address.id }}" type="text" name="address[address2]" value="{{ address.address2 | escape }}" autocomplete="address-line2">
                    </div>
                    <div class="melato-field">
                      <label for="AddressCity-{{ address.id }}">City</label>
                      <input id="AddressCity-{{ address.id }}" type="text" name="address[city]" value="{{ address.city | escape }}" autocomplete="address-level2" required>
                    </div>
                    <div class="melato-field">
                      <label for="AddressProvince-{{ address.id }}">Province / State</label>
                      <input id="AddressProvince-{{ address.id }}" type="text" name="address[province]" value="{{ address.province | escape }}" autocomplete="address-level1">
                    </div>
                    <div class="melato-field">
                      <label for="AddressCountry-{{ address.id }}">Country</label>
                      <select id="AddressCountry-{{ address.id }}" name="address[country]" data-default="{{ address.country | escape }}" autocomplete="country-name">{{ all_country_option_tags }}</select>
                    </div>
                    <div class="melato-field">
                      <label for="AddressZip-{{ address.id }}">ZIP / Postal code</label>
                      <input id="AddressZip-{{ address.id }}" type="text" name="address[zip]" value="{{ address.zip | escape }}" autocomplete="postal-code" required>
                    </div>
                    <div class="melato-field melato-field--wide">
                      <label for="AddressPhone-{{ address.id }}">Phone</label>
                      <input id="AddressPhone-{{ address.id }}" type="tel" name="address[phone]" value="{{ address.phone | escape }}" autocomplete="tel">
                    </div>
                  </div>
                  <div class="melato-addresses__actions">
                    <button type="submit" class="melato-house-button">Update address</button>
                  </div>
                {%- endform -%}
              </div>
            </details>

            <div class="melato-address-card__actions">
              {%- form 'customer_address', address -%}
                <input type="hidden" name="_method" value="delete">
                <button type="submit" aria-label="Remove address for {{ address.name | escape }}">Remove</button>
              {%- endform -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <section class="melato-empty-state" aria-labelledby="MelatoNoAddresses-{{ section.id }}">
        <p class="melato-empty-state__eyebrow">Addresses / 00</p>
        <div>
          <h2 id="MelatoNoAddresses-{{ section.id }}" class="melato-empty-state__title">No saved address.</h2>
          <p class="melato-empty-state__copy">Add one when you want it available for future Melato orders.</p>
        </div>
      </section>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Addresses", "tag": "section", "settings": [] }
{% endschema %}

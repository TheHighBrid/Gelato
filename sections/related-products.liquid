{% comment %}
  MELATO PRODUCT PAGE BIBLE 1.0.0
  Universal PDP continuation layer.
  Canonical priority: custom.related_products, legacy custom.pdp_recommendations,
  Shopify related recommendations, same product type from New Arrivals,
  Best Sellers, then broader New Arrivals.
  Heading is intentionally fixed to avoid category-by-category language drift.
{% endcomment %}

{{ 'melato-audit-upgrades.css' | asset_url | stylesheet_tag }}
<script src="{{ 'melato-audit-upgrades.js' | asset_url }}" defer></script>

{%- liquid
  assign section_heading = 'You might also like'
  assign section_eyebrow = section.settings.eyebrow | default: 'Continue shopping'
  assign products_to_show = section.settings.products_to_show | default: 4 | plus: 0
  assign curated_products = product.metafields.custom.related_products.value
  if curated_products == blank
    assign curated_products = product.metafields.custom.pdp_recommendations.value
  endif
  if products_to_show < 1
    assign products_to_show = 4
  endif
  if products_to_show > 4
    assign products_to_show = 4
  endif
-%}

{%- if product != blank -%}
  <section class="melato-related{% if curated_products != blank %} melato-related-products--curated{% endif %} section-{{ section.id }}" aria-labelledby="RelatedHeading-{{ section.id }}">
    <div class="melato-section-wrap">
      <div class="melato-section-head">
        <p class="melato-eyebrow">{{ section_eyebrow }}</p>
        <h2 id="RelatedHeading-{{ section.id }}" class="melato-pdp-bible-section-title">{{ section_heading }}</h2>
      </div>

      {%- if curated_products != blank -%}
        <div class="melato-grid melato-grid--cards" data-curated-recommendations>
          {%- assign curated_shown = 0 -%}
          {%- for recommendation in curated_products -%}
            {%- if curated_shown >= products_to_show -%}{%- break -%}{%- endif -%}
            {%- if recommendation.available and recommendation.id != product.id -%}
              {% render 'melato-product-card-audit', card_product: recommendation %}
              {%- assign curated_shown = curated_shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        {%- comment -%}Only matching product families; never a broad new-arrivals fallback.{%- endcomment -%}
        {%- liquid
          assign family = 'other'
          assign kind = product.product_type | downcase
          assign title_down = product.title | downcase
          if kind contains 'fragrance' or kind contains 'perfume' or title_down contains 'eau de'
            assign family = 'fragrance'
          elsif kind contains 'denim' or kind contains 'jean' or title_down contains 'jean'
            assign family = 'denim'
          elsif kind contains 'blazer' or kind contains 'tailor' or title_down contains 'blazer'
            assign family = 'tailoring'
          endif
          assign family_collection = blank
          for candidate in product.collections
            assign handle = candidate.handle | downcase
            if family == 'fragrance' and handle contains 'fragrance'
              assign family_collection = candidate
              break
            elsif family == 'denim' and handle contains 'denim'
              assign family_collection = candidate
              break
            elsif family == 'tailoring' and handle contains 'tailor'
              assign family_collection = candidate
              break
            endif
          endfor
          assign fallback_collection = family_collection
          if fallback_collection == blank
            assign fallback_collection = collections['new-arrivals']
          endif
          assign shown = 0
        -%}
        <div class="melato-grid melato-grid--cards">
          {%- if fallback_collection != blank -%}
            {%- for recommendation in fallback_collection.products -%}
              {%- if shown >= products_to_show -%}{%- break -%}{%- endif -%}
              {%- assign recommendation_kind = recommendation.product_type | downcase -%}
              {%- assign recommendation_title = recommendation.title | downcase -%}
              {%- assign relevant = false -%}
              {%- if family == 'fragrance' -%}
                {%- if recommendation_kind contains 'fragrance' or recommendation_kind contains 'perfume' or recommendation_title contains 'eau de' -%}{%- assign relevant = true -%}{%- endif -%}
              {%- elsif family == 'denim' -%}
                {%- if recommendation_kind contains 'denim' or recommendation_kind contains 'jean' or recommendation_title contains 'jean' -%}{%- assign relevant = true -%}{%- endif -%}
              {%- elsif family == 'tailoring' -%}
                {%- if recommendation_kind contains 'blazer' or recommendation_kind contains 'tailor' or recommendation_title contains 'blazer' -%}{%- assign relevant = true -%}{%- endif -%}
              {%- elsif recommendation_kind == kind and kind != blank -%}
                {%- assign relevant = true -%}
              {%- endif -%}
              {%- if relevant and recommendation.available and recommendation.id != product.id -%}
                {% render 'melato-product-card-audit', card_product: recommendation %}
                {%- assign shown = shown | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "class": "section melato-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Continue shopping"},
    {"type":"text","id":"heading","label":"Heading","default":"You might also like","info":"Bible-governed. Renderer always uses the canonical heading."},
    {"type":"range","id":"products_to_show","label":"Products to show","min":2,"max":4,"step":1,"default":4}
  ],
  "presets": [{"name":"Related products"}]
}
{% endschema %}
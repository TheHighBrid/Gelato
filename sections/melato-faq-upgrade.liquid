{{ 'melato-audit-upgrades.css' | asset_url | stylesheet_tag }}

<section class="melato-page melato-faq section-{{ section.id }}" aria-labelledby="FaqHeading-{{ section.id }}">
  <div class="melato-section-wrap melato-page__wrap">
    <header class="melato-page__header">
      <p class="melato-eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 id="FaqHeading-{{ section.id }}">{{ section.settings.heading }}</h1>
      <p>{{ section.settings.intro }}</p>
    </header>

    <div class="melato-accordion-list">
      {%- for block in section.blocks -%}
        <details class="melato-accordion" {{ block.shopify_attributes }}>
          <summary>
            <span>{{ block.settings.question }}</span>
            <span aria-hidden="true">+</span>
          </summary>
          <div class="melato-accordion__content rte">
            {{ block.settings.answer }}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
      {
        "@type": "Question",
        "name": {{ block.settings.question | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ block.settings.answer | strip_html | json }}
        }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "Melato FAQ upgrade",
  "tag": "section",
  "class": "section melato-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer guide" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQ" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "A clean guide to orders, shipping, sizing, care, returns, and limited productions." }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does order processing take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Orders are usually prepared within 1–3 business days. During limited productions, holidays, or high-volume periods, processing may take slightly longer.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Melato FAQ upgrade",
      "blocks": [
        { "type": "faq", "settings": { "question": "How long does order processing take?", "answer": "<p>Orders are usually prepared within 1–3 business days. During limited productions, holidays, or high-volume periods, processing may take slightly longer.</p>" } },
        { "type": "faq", "settings": { "question": "Do you offer complimentary domestic shipping?", "answer": "<p>Yes. Complimentary free shipping is offered on all orders.</p>" } },
        { "type": "faq", "settings": { "question": "How does Melato fit?", "answer": "<p>Melato pieces are designed with a relaxed athletic fit. Choose your usual size for a clean retro silhouette, or size up if you prefer a looser oversized look.</p>" } },
        { "type": "faq", "settings": { "question": "Will sold-out colorways restock?", "answer": "<p>Melato drops are limited. Some pieces may return, but many colorways are released in small quantities and may not restock once sold out.</p>" } },
        { "type": "faq", "settings": { "question": "How do I start a return?", "answer": "<p>Email support@melato.ca with your order number, the item you want to return, and the reason for return. We will review the request and send next steps if approved.</p>" } }
      ]
    }
  ]
}
{% endschema %}

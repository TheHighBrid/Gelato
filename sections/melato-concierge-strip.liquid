{%- liquid
  assign has_blocks = false
  if section.blocks.size > 0
    assign has_blocks = true
  endif
-%}

{%- comment -%} Desktop sticky pillar nav {%- endcomment -%}
<nav class="concierge-strip concierge-strip--desktop" id="ConciergeStripDesktop">
  {%- if has_blocks -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign strip_url = block.settings.link | default: '#'
        assign is_active = false
        if request.path == strip_url
          assign is_active = true
        endif
      -%}
      <a href="{{ strip_url }}" class="concierge-strip__pillar{% if is_active %} is-active{% endif %}" {{ block.shopify_attributes }}>
        <span class="concierge-strip__active-bar"></span>
        {%- if block.settings.icon != blank -%}<span class="concierge-strip__icon">{{ block.settings.icon }}</span>{%- endif -%}
        <span class="concierge-strip__copy">
          <span class="concierge-strip__label">{{ block.settings.label }}</span>
          <span class="concierge-strip__title">{{ block.settings.title }}</span>
        </span>
        <span class="concierge-strip__arrow" aria-hidden="true">&rarr;</span>
      </a>
    {%- endfor -%}
  {%- else -%}
    <a href="/pages/order-companion" class="concierge-strip__pillar{% if request.path == '/pages/order-companion' %} is-active{% endif %}">
      <span class="concierge-strip__active-bar"></span>
      <span class="concierge-strip__icon">{% render 'melato-concierge-icon-care' %}</span>
      <span class="concierge-strip__copy"><span class="concierge-strip__label">Care</span><span class="concierge-strip__title">Order Companion</span></span>
      <span class="concierge-strip__arrow" aria-hidden="true">&rarr;</span>
    </a>
    <a href="/pages/preview-room" class="concierge-strip__pillar{% if request.path == '/pages/preview-room' %} is-active{% endif %}">
      <span class="concierge-strip__active-bar"></span>
      <span class="concierge-strip__icon">{% render 'melato-concierge-icon-access' %}</span>
      <span class="concierge-strip__copy"><span class="concierge-strip__label">Access</span><span class="concierge-strip__title">The Preview Room</span></span>
      <span class="concierge-strip__arrow" aria-hidden="true">&rarr;</span>
    </a>
    <a href="/pages/fit-concierge" class="concierge-strip__pillar{% if request.path == '/pages/fit-concierge' %} is-active{% endif %}">
      <span class="concierge-strip__active-bar"></span>
      <span class="concierge-strip__icon">{% render 'melato-concierge-icon-fit' %}</span>
      <span class="concierge-strip__copy"><span class="concierge-strip__label">Fit</span><span class="concierge-strip__title">Fit Concierge</span></span>
      <span class="concierge-strip__arrow" aria-hidden="true">&rarr;</span>
    </a>
    <a href="/pages/delivery-concierge" class="concierge-strip__pillar{% if request.path == '/pages/delivery-concierge' %} is-active{% endif %}">
      <span class="concierge-strip__active-bar"></span>
      <span class="concierge-strip__icon">{% render 'melato-concierge-icon-delivery' %}</span>
      <span class="concierge-strip__copy"><span class="concierge-strip__label">Delivery</span><span class="concierge-strip__title">Delivery Concierge</span></span>
      <span class="concierge-strip__arrow" aria-hidden="true">&rarr;</span>
    </a>
  {%- endif -%}
</nav>

{%- comment -%} Mobile horizontal-scroll pill bar {%- endcomment -%}
<nav class="concierge-strip concierge-strip--mobile" id="ConciergeStripMobile">
  <div class="concierge-strip__mobile-track">
    {%- if has_blocks -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign strip_url = block.settings.link | default: '#'
          assign is_active = false
          if request.path == strip_url
            assign is_active = true
          endif
        -%}
        <a href="{{ strip_url }}" class="concierge-strip__mobile-pill{% if is_active %} is-active{% endif %}">
          {%- if block.settings.icon != blank -%}<span class="concierge-strip__icon">{{ block.settings.icon }}</span>{%- endif -%}
          <span class="concierge-strip__mobile-label">{{ block.settings.label }}</span>
        </a>
      {%- endfor -%}
    {%- else -%}
      <a href="/pages/order-companion" class="concierge-strip__mobile-pill{% if request.path == '/pages/order-companion' %} is-active{% endif %}"><span class="concierge-strip__icon">{% render 'melato-concierge-icon-care' %}</span><span class="concierge-strip__mobile-label">Care</span></a>
      <a href="/pages/preview-room" class="concierge-strip__mobile-pill{% if request.path == '/pages/preview-room' %} is-active{% endif %}"><span class="concierge-strip__icon">{% render 'melato-concierge-icon-access' %}</span><span class="concierge-strip__mobile-label">Access</span></a>
      <a href="/pages/fit-concierge" class="concierge-strip__mobile-pill{% if request.path == '/pages/fit-concierge' %} is-active{% endif %}"><span class="concierge-strip__icon">{% render 'melato-concierge-icon-fit' %}</span><span class="concierge-strip__mobile-label">Fit</span></a>
      <a href="/pages/delivery-concierge" class="concierge-strip__mobile-pill{% if request.path == '/pages/delivery-concierge' %} is-active{% endif %}"><span class="concierge-strip__icon">{% render 'melato-concierge-icon-delivery' %}</span><span class="concierge-strip__mobile-label">Delivery</span></a>
    {%- endif -%}
  </div>
</nav>

{% stylesheet %}
.concierge-strip { position: sticky; top: var(--header-height, 0px); z-index: 40; background: #080808; border-bottom: 1px solid rgba(244,234,216,0.10); }

.concierge-strip--desktop { display: none; height: 64px; }
@media (min-width: 768px) { .concierge-strip--desktop { display: flex; } }
.concierge-strip__pillar { flex: 1 1 0; display: flex; align-items: center; gap: 12px; padding: 0 24px; position: relative; text-decoration: none; border-right: 1px solid rgba(244,234,216,0.10); background: transparent; transition: background .2s ease; }
.concierge-strip__pillar:last-child { border-right: none; }
.concierge-strip__pillar:hover, .concierge-strip__pillar.is-active { background: #111111; }
.concierge-strip__active-bar { position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: #D3A74A; opacity: 0; }
.concierge-strip__pillar.is-active .concierge-strip__active-bar { opacity: 1; }
.concierge-strip__copy { display: flex; flex-direction: column; }
.concierge-strip__label { font-family: var(--font-mono-family, monospace); text-transform: uppercase; letter-spacing: .08em; font-size: 11px; color: #747474; }
.concierge-strip__title { font-family: var(--font-body-family, 'Barlow', sans-serif); font-size: 13px; color: #F4EAD8; transition: color .2s ease; }
.concierge-strip__pillar.is-active .concierge-strip__title, .concierge-strip__pillar:hover .concierge-strip__title { color: #D3A74A; }
.concierge-strip__arrow { margin-left: auto; color: #D3A74A; font-size: 12px; opacity: 0; transition: opacity .2s ease, transform .2s ease; }
.concierge-strip__pillar:hover .concierge-strip__arrow { opacity: 1; transform: translateX(4px); }

.concierge-strip--mobile { display: flex; height: 52px; align-items: center; }
@media (min-width: 768px) { .concierge-strip--mobile { display: none; } }
.concierge-strip__mobile-track { display: flex; gap: 8px; overflow-x: auto; scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch; padding: 0 12px; width: 100%; scrollbar-width: none; }
.concierge-strip__mobile-track::-webkit-scrollbar { display: none; }
.concierge-strip__mobile-pill { flex: 0 0 auto; scroll-snap-align: start; display: flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 999px; border: 1px solid rgba(244,234,216,0.14); text-decoration: none; white-space: nowrap; }
.concierge-strip__mobile-pill.is-active { background: #111111; border-color: #D3A74A; }
.concierge-strip__mobile-label { font-family: var(--font-mono-family, monospace); text-transform: uppercase; letter-spacing: .06em; font-size: 11px; color: #F4EAD8; }
.concierge-strip__mobile-pill.is-active .concierge-strip__mobile-label { color: #D3A74A; }

.concierge-strip__icon { color: #D3A74A; flex-shrink: 0; line-height: 0; display: inline-flex; }
.concierge-strip__icon svg { width: 18px; height: 18px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Concierge Strip",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        { "type": "text", "id": "label", "label": "Eyebrow label", "default": "Care" },
        { "type": "text", "id": "title", "label": "Title", "default": "Order Companion" },
        { "type": "url", "id": "link", "label": "Page link" },
        { "type": "html", "id": "icon", "label": "Icon (paste inline SVG, optional — leave blank to use default icon)" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "pillar", "settings": { "label": "Care", "title": "Order Companion", "link": "/pages/order-companion" } },
      { "type": "pillar", "settings": { "label": "Access", "title": "The Preview Room", "link": "/pages/preview-room" } },
      { "type": "pillar", "settings": { "label": "Fit", "title": "Fit Concierge", "link": "/pages/fit-concierge" } },
      { "type": "pillar", "settings": { "label": "Delivery", "title": "Delivery Concierge", "link": "/pages/delivery-concierge" } }
    ]
  }
}
{% endschema %}

{%- liquid
  assign contact_url = section.settings.contact_url | default: '/pages/contact'
  assign contact_label = section.settings.contact_label | default: 'Speak with client care'
-%}

<section class="melato-concierge" id="Concierge-{{ section.id }}" aria-labelledby="ConciergeTitle-{{ section.id }}">
  <div class="melato-concierge__shell">
    <header class="melato-concierge__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="melato-concierge__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="melato-concierge__heading" id="ConciergeTitle-{{ section.id }}">{{ section.settings.heading | default: 'At your service' }}</h2>
      </div>
      {%- if section.settings.intro != blank -%}<div class="melato-concierge__intro">{{ section.settings.intro }}</div>{%- endif -%}
    </header>

    <div class="melato-concierge__services">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign service_url = block.settings.link | default: contact_url -%}
          <article class="melato-concierge__service" {{ block.shopify_attributes }}>
            <p class="melato-concierge__number" aria-hidden="true">0{{ forloop.index }}</p>
            <div class="melato-concierge__service-body">
              <h3 class="melato-concierge__service-title">{{ block.settings.title }}</h3>
              {%- if block.settings.description != blank -%}<p class="melato-concierge__service-copy">{{ block.settings.description }}</p>{%- endif -%}
              {%- if block.settings.note != blank -%}<p class="melato-concierge__service-note">{{ block.settings.note }}</p>{%- endif -%}
            </div>
            <a class="melato-concierge__service-link" href="{{ service_url }}" aria-label="{{ block.settings.title | escape }}">Explore <span aria-hidden="true">↗</span></a>
          </article>
        {%- endfor -%}
      {%- else -%}
        <article class="melato-concierge__service">
          <p class="melato-concierge__number" aria-hidden="true">01</p>
          <div class="melato-concierge__service-body">
            <h3 class="melato-concierge__service-title">Personal fit consultation</h3>
            <p class="melato-concierge__service-copy">Send us your measurements and preferred silhouette. We will recommend the right size and coordinate matching sets.</p>
            <p class="melato-concierge__service-note">Advice from a real client care specialist</p>
          </div>
          <a class="melato-concierge__service-link" href="/pages/fit-concierge">Explore <span aria-hidden="true">↗</span></a>
        </article>
        <article class="melato-concierge__service">
          <p class="melato-concierge__number" aria-hidden="true">02</p>
          <div class="melato-concierge__service-body">
            <h3 class="melato-concierge__service-title">Delivery planning</h3>
            <p class="melato-concierge__service-copy">Ordering for a date? Ask us to review destination, processing, and carrier timing before you purchase.</p>
            <p class="melato-concierge__service-note">Practical guidance before checkout</p>
          </div>
          <a class="melato-concierge__service-link" href="/pages/delivery-concierge">Explore <span aria-hidden="true">↗</span></a>
        </article>
        <article class="melato-concierge__service">
          <p class="melato-concierge__number" aria-hidden="true">03</p>
          <div class="melato-concierge__service-body">
            <h3 class="melato-concierge__service-title">Order and aftercare</h3>
            <p class="melato-concierge__service-copy">Get help with an active order, exchange, garment care, or an issue after delivery.</p>
            <p class="melato-concierge__service-note">One point of contact before and after delivery</p>
          </div>
          <a class="melato-concierge__service-link" href="/pages/order-companion">Explore <span aria-hidden="true">↗</span></a>
        </article>
        <article class="melato-concierge__service">
          <p class="melato-concierge__number" aria-hidden="true">04</p>
          <div class="melato-concierge__service-body">
            <h3 class="melato-concierge__service-title">Private product guidance</h3>
            <p class="melato-concierge__service-copy">Ask about fabric, construction, styling, and upcoming releases before making a considered choice.</p>
            <p class="melato-concierge__service-note">Detailed product and release assistance</p>
          </div>
          <a class="melato-concierge__service-link" href="/pages/preview-room">Explore <span aria-hidden="true">↗</span></a>
        </article>
      {%- endif -%}
    </div>

    <footer class="melato-concierge__footer">
      <div class="melato-concierge__availability">
        <span class="melato-concierge__status" aria-hidden="true"></span>
        <div>
          <strong>{{ section.settings.availability_title | default: 'Client care is available' }}</strong>
          <p>{{ section.settings.availability_text | default: 'Replies are typically sent within one business day.' }}</p>
        </div>
      </div>
      <a class="melato-concierge__contact" href="{{ contact_url }}">{{ contact_label }} <span aria-hidden="true">→</span></a>
    </footer>
  </div>
</section>

{% stylesheet %}
.melato-concierge{--ink:#f3efe6;--paper:#171714;--copy:#cbc7bd;--muted:#9d998f;--line:rgba(243,239,230,.18);background:var(--paper);color:var(--ink);border-block:1px solid var(--line)}.melato-concierge *{box-sizing:border-box}.melato-concierge__shell{width:min(100% - 40px,1440px);margin:auto;padding:clamp(58px,8vw,108px) 0 clamp(40px,6vw,78px)}.melato-concierge__header{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.55fr);align-items:end;gap:40px;margin-bottom:clamp(40px,6vw,76px)}.melato-concierge__eyebrow{margin:0 0 16px;color:var(--muted);font-size:10px;letter-spacing:.26em;text-transform:uppercase}.melato-concierge__heading{margin:0;font-size:clamp(44px,7.5vw,108px);line-height:.88;letter-spacing:-.055em}.melato-concierge__intro{color:var(--muted);line-height:1.7}.melato-concierge__intro p{margin:0}.melato-concierge__services{border-top:1px solid var(--ink)}.melato-concierge__service{display:grid;grid-template-columns:64px minmax(0,1fr) auto;gap:clamp(16px,3vw,48px);align-items:start;padding:clamp(26px,3.4vw,46px) 4px;border-bottom:1px solid var(--line)}.melato-concierge__number{margin:7px 0 0;color:var(--muted);font-size:10px;letter-spacing:.18em}.melato-concierge__service-body{display:grid;grid-template-columns:minmax(220px,.7fr) minmax(280px,1fr) minmax(180px,.55fr);gap:clamp(24px,4vw,72px);align-items:baseline}.melato-concierge__service-title,.melato-concierge__service-copy,.melato-concierge__service-note{margin:0}.melato-concierge__service-title{font-size:clamp(24px,2.5vw,38px);line-height:1;letter-spacing:-.03em}.melato-concierge__service-copy{color:var(--copy);font-size:14px;line-height:1.65}.melato-concierge__service-note{color:var(--muted);font-size:10px;line-height:1.5;letter-spacing:.12em;text-transform:uppercase}.melato-concierge__service-link{color:var(--ink);font-size:10px;letter-spacing:.14em;text-decoration:none;text-transform:uppercase}.melato-concierge__footer{display:flex;align-items:center;justify-content:space-between;gap:28px;padding-top:clamp(30px,4vw,52px)}.melato-concierge__availability{display:flex;gap:12px;color:var(--muted);font-size:12px}.melato-concierge__availability strong{display:block;color:var(--ink);font-size:11px;letter-spacing:.08em;text-transform:uppercase}.melato-concierge__availability p{margin:4px 0 0}.melato-concierge__status{width:7px;height:7px;margin-top:5px;border-radius:50%;background:#6b9b70;box-shadow:0 0 0 4px rgba(107,155,112,.16)}.melato-concierge__contact{display:inline-flex;align-items:center;justify-content:space-between;gap:32px;min-width:260px;min-height:50px;padding:0 18px;color:var(--paper);background:var(--ink);font-size:10px;letter-spacing:.18em;text-decoration:none;text-transform:uppercase}@media(max-width:990px){.melato-concierge__header{grid-template-columns:1fr}.melato-concierge__service-body{grid-template-columns:minmax(180px,.7fr) 1fr}.melato-concierge__service-note{grid-column:2}}@media(max-width:700px){.melato-concierge__shell{width:min(100% - 28px,1440px)}.melato-concierge__service{grid-template-columns:32px minmax(0,1fr);gap:10px}.melato-concierge__service-body{grid-template-columns:1fr;gap:13px}.melato-concierge__service-note{grid-column:auto}.melato-concierge__service-link{grid-column:2}.melato-concierge__footer{align-items:stretch;flex-direction:column}.melato-concierge__contact{width:100%}}
{% endstylesheet %}

{% schema %}
{
  "name":"Client Concierge",
  "tag":"section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Melato client services"},
    {"type":"text","id":"heading","label":"Heading","default":"At your service"},
    {"type":"richtext","id":"intro","label":"Introduction","default":"<p>Considered support from discovery through delivery. Our client care team offers practical, personal guidance so every purchase feels assured.</p>"},
    {"type":"text","id":"availability_title","label":"Availability title","default":"Client care is available"},
    {"type":"text","id":"availability_text","label":"Response-time note","default":"Replies are typically sent within one business day."},
    {"type":"text","id":"contact_label","label":"Contact button label","default":"Speak with client care"},
    {"type":"url","id":"contact_url","label":"Contact page"}
  ],
  "blocks":[{
    "type":"service",
    "name":"Concierge service",
    "settings":[
      {"type":"text","id":"title","label":"Service name","default":"Personal fit consultation"},
      {"type":"textarea","id":"description","label":"What the team will do","default":"Share your measurements and preferred silhouette for considered size and styling guidance."},
      {"type":"text","id":"note","label":"Service promise","default":"Personal advice from client care"},
      {"type":"url","id":"link","label":"Service page"}
    ]
  }],
  "max_blocks":6,
  "presets":[{"name":"Client Concierge"}]
}
{% endschema %}
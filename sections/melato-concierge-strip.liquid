{%- liquid
  assign contact_url = section.settings.contact_url | default: '/pages/contact'
  assign contact_label = section.settings.contact_label | default: 'Speak with client care'
-%}

<section class="melato-concierge" id="Concierge-{{ section.id }}" aria-labelledby="ConciergeTitle-{{ section.id }}">
  <div class="melato-concierge__shell">
    <header class="melato-concierge__header">
      <div class="melato-concierge__heading-group">
        {%- if section.settings.eyebrow != blank -%}
          <p class="melato-concierge__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="melato-concierge__heading" id="ConciergeTitle-{{ section.id }}">
          {{ section.settings.heading | default: 'At your service' }}
        </h2>
      </div>
      {%- if section.settings.intro != blank -%}
        <div class="melato-concierge__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    <div class="melato-concierge__services" role="list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign service_url = block.settings.link | default: contact_url -%}
          <a class="melato-concierge__service" href="{{ service_url }}" role="listitem" {{ block.shopify_attributes }}>
            <span class="melato-concierge__number" aria-hidden="true">0{{ forloop.index }}</span>
            <span class="melato-concierge__service-body">
              <span class="melato-concierge__service-title">{{ block.settings.title }}</span>
              {%- if block.settings.description != blank -%}
                <span class="melato-concierge__service-copy">{{ block.settings.description }}</span>
              {%- endif -%}
              {%- if block.settings.note != blank -%}
                <span class="melato-concierge__service-note">{{ block.settings.note }}</span>
              {%- endif -%}
            </span>
            <span class="melato-concierge__arrow" aria-hidden="true">&#8599;</span>
          </a>
        {%- endfor -%}
      {%- else -%}
        <a class="melato-concierge__service" href="/pages/fit-concierge" role="listitem">
          <span class="melato-concierge__number" aria-hidden="true">01</span>
          <span class="melato-concierge__service-body"><span class="melato-concierge__service-title">Personal fit consultation</span><span class="melato-concierge__service-copy">Send us your measurements and preferred silhouette. We will recommend the right size and coordinate matching sets.</span><span class="melato-concierge__service-note">Advice from a real client care specialist</span></span>
          <span class="melato-concierge__arrow" aria-hidden="true">&#8599;</span>
        </a>
        <a class="melato-concierge__service" href="/pages/delivery-concierge" role="listitem">
          <span class="melato-concierge__number" aria-hidden="true">02</span>
          <span class="melato-concierge__service-body"><span class="melato-concierge__service-title">Delivery planning</span><span class="melato-concierge__service-copy">Ordering for a date? Ask us to review destination, processing and carrier timing before you purchase.</span><span class="melato-concierge__service-note">Practical guidance before checkout</span></span>
          <span class="melato-concierge__arrow" aria-hidden="true">&#8599;</span>
        </a>
        <a class="melato-concierge__service" href="/pages/order-companion" role="listitem">
          <span class="melato-concierge__number" aria-hidden="true">03</span>
          <span class="melato-concierge__service-body"><span class="melato-concierge__service-title">Order &amp; aftercare</span><span class="melato-concierge__service-copy">Get help with an active order, exchange, garment care or an issue after delivery—without searching for the right department.</span><span class="melato-concierge__service-note">One point of contact, before and after delivery</span></span>
          <span class="melato-concierge__arrow" aria-hidden="true">&#8599;</span>
        </a>
        <a class="melato-concierge__service" href="/pages/preview-room" role="listitem">
          <span class="melato-concierge__number" aria-hidden="true">04</span>
          <span class="melato-concierge__service-body"><span class="melato-concierge__service-title">Private product guidance</span><span class="melato-concierge__service-copy">Ask about fabric, construction, styling and upcoming releases to make a considered choice—not a rushed one.</span><span class="melato-concierge__service-note">Detailed product answers and release assistance</span></span>
          <span class="melato-concierge__arrow" aria-hidden="true">&#8599;</span>
        </a>
      {%- endif -%}
    </div>

    <footer class="melato-concierge__footer">
      <div class="melato-concierge__availability">
        <span class="melato-concierge__status" aria-hidden="true"></span>
        <span><strong>{{ section.settings.availability_title | default: 'Client care is available' }}</strong>{{ section.settings.availability_text | default: 'Replies are typically sent within one business day.' }}</span>
      </div>
      <a class="melato-concierge__contact" href="{{ contact_url }}">{{ contact_label }} <span aria-hidden="true">&#8594;</span></a>
    </footer>
  </div>
</section>

{% stylesheet %}
.melato-concierge { --concierge-ink: #f3efe6; --concierge-paper: #171714; --concierge-copy: #cbc7bd; --concierge-muted: #9d998f; --concierge-line: rgba(243,239,230,.18); background: var(--concierge-paper); color: var(--concierge-ink); border-block: 1px solid var(--concierge-line); }
.melato-concierge * { box-sizing: border-box; }
.melato-concierge__shell { width: min(100% - 40px, 1440px); margin-inline: auto; padding-block: clamp(64px, 8vw, 120px) clamp(40px, 6vw, 80px); }
.melato-concierge__header { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .55fr); align-items: end; gap: 40px; margin-bottom: clamp(44px, 6vw, 84px); }
.melato-concierge__eyebrow { margin: 0 0 18px; color: var(--concierge-muted); font-size: 10px; font-weight: 600; line-height: 1; letter-spacing: .26em; text-transform: uppercase; }
.melato-concierge__heading { max-width: 760px; margin: 0; color: var(--concierge-ink); font-family: var(--font-heading-family, serif); font-size: clamp(44px, 7.5vw, 108px); font-weight: 400; letter-spacing: -.055em; line-height: .88; text-wrap: balance; }
.melato-concierge__intro { max-width: 520px; color: var(--concierge-muted); font-size: clamp(15px, 1.3vw, 18px); line-height: 1.7; }
.melato-concierge__intro p { margin: 0; color: inherit; }
.melato-concierge__services { border-top: 1px solid var(--concierge-ink); }
.melato-concierge__service { display: grid; grid-template-columns: 64px minmax(0, 1fr) 28px; gap: clamp(16px, 3vw, 48px); align-items: start; padding: clamp(26px, 3.4vw, 48px) 4px; color: inherit; text-decoration: none; border-bottom: 1px solid var(--concierge-line); transition: padding-inline .3s ease, background-color .3s ease; }
.melato-concierge__number { padding-top: 7px; color: var(--concierge-muted); font-size: 10px; letter-spacing: .18em; }
.melato-concierge__service-body { display: grid; grid-template-columns: minmax(220px, .7fr) minmax(280px, 1fr) minmax(180px, .55fr); gap: clamp(24px, 4vw, 72px); align-items: baseline; }
.melato-concierge__service-title { color: var(--concierge-ink); font-family: var(--font-heading-family, serif); font-size: clamp(24px, 2.5vw, 38px); line-height: 1; letter-spacing: -.03em; }
.melato-concierge__service-copy { max-width: 510px; color: var(--concierge-copy); font-size: 14px; line-height: 1.65; }
.melato-concierge__service-note { color: var(--concierge-muted); font-size: 10px; line-height: 1.5; letter-spacing: .12em; text-transform: uppercase; }
.melato-concierge__arrow { padding-top: 3px; font-size: 20px; transition: transform .3s ease; }
.melato-concierge__service:hover { padding-inline: 16px; background: rgba(243,239,230,.055); }
.melato-concierge__service:hover .melato-concierge__arrow { transform: translate(4px, -4px); }
.melato-concierge__service:focus-visible, .melato-concierge__contact:focus-visible { outline: 2px solid var(--concierge-ink); outline-offset: 4px; }
.melato-concierge__footer { display: flex; align-items: center; justify-content: space-between; gap: 28px; padding-top: clamp(30px, 4vw, 52px); }
.melato-concierge__availability { display: flex; align-items: flex-start; gap: 12px; color: var(--concierge-muted); font-size: 12px; line-height: 1.5; }
.melato-concierge__availability strong { display: block; color: var(--concierge-ink); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
.melato-concierge__status { width: 7px; height: 7px; margin-top: 5px; flex: 0 0 auto; border-radius: 50%; background: #6b9b70; box-shadow: 0 0 0 4px rgba(107,155,112,.16); }
.melato-concierge__contact { display: inline-flex; align-items: center; justify-content: space-between; gap: 32px; min-width: 260px; min-height: 50px; padding: 0 18px; color: var(--concierge-paper); background: var(--concierge-ink); border: 1px solid var(--concierge-ink); font-size: 10px; font-weight: 600; letter-spacing: .18em; text-decoration: none; text-transform: uppercase; transition: color .25s ease, background .25s ease; }
.melato-concierge__contact:hover { color: var(--concierge-ink); background: transparent; }
@media (max-width: 990px) {
  .melato-concierge__header { grid-template-columns: 1fr; align-items: start; }
  .melato-concierge__service-body { grid-template-columns: minmax(200px, .7fr) 1fr; }
  .melato-concierge__service-note { grid-column: 2; }
}
@media (max-width: 700px) {
  .melato-concierge__shell { width: min(100% - 28px, 1440px); }
  .melato-concierge__header { gap: 24px; }
  .melato-concierge__service { grid-template-columns: 32px minmax(0, 1fr) 20px; gap: 10px; }
  .melato-concierge__service-body { grid-template-columns: 1fr; gap: 13px; }
  .melato-concierge__service-note { grid-column: auto; }
  .melato-concierge__service:hover { padding-inline: 4px; }
  .melato-concierge__footer { align-items: stretch; flex-direction: column; }
  .melato-concierge__contact { width: 100%; }
}
@media (prefers-reduced-motion: reduce) { .melato-concierge__service, .melato-concierge__arrow, .melato-concierge__contact { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Client Concierge",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Melato client services" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "At your service" },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Considered support from discovery through delivery. Our client care team offers practical, personal guidance so every purchase feels as assured as the piece itself.</p>" },
    { "type": "text", "id": "availability_title", "label": "Availability title", "default": "Client care is available" },
    { "type": "text", "id": "availability_text", "label": "Response-time note", "default": "Replies are typically sent within one business day." },
    { "type": "text", "id": "contact_label", "label": "Contact button label", "default": "Speak with client care" },
    { "type": "url", "id": "contact_url", "label": "Contact page" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Concierge service",
      "settings": [
        { "type": "text", "id": "title", "label": "Service name", "default": "Personal fit consultation" },
        { "type": "textarea", "id": "description", "label": "What the team will do", "default": "Share your measurements and preferred silhouette for considered size and styling guidance." },
        { "type": "text", "id": "note", "label": "Service promise", "default": "Personal advice from client care" },
        { "type": "url", "id": "link", "label": "Service page" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{
    "name": "Client Concierge",
    "blocks": [
      { "type": "service", "settings": { "title": "Personal fit consultation", "description": "Send us your measurements and preferred silhouette. We will recommend the right size and coordinate matching sets.", "note": "Advice from a real client care specialist", "link": "/pages/fit-concierge" } },
      { "type": "service", "settings": { "title": "Delivery planning", "description": "Ordering for a date? Ask us to review destination, processing and carrier timing before you purchase.", "note": "Practical guidance before checkout", "link": "/pages/delivery-concierge" } },
      { "type": "service", "settings": { "title": "Order & aftercare", "description": "Get help with an active order, exchange, garment care or an issue after delivery.", "note": "One point of contact before and after delivery", "link": "/pages/order-companion" } },
      { "type": "service", "settings": { "title": "Private product guidance", "description": "Ask about fabric, construction, styling and upcoming releases to make a considered choice.", "note": "Detailed product and release assistance", "link": "/pages/preview-room" } }
    ]
  }]
}
{% endschema %}

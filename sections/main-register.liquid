{% comment %}
  sections/main-register.liquid
{% endcomment %}

<section class="melato-auth" aria-labelledby="MelatoRegisterTitle-{{ section.id }}">
  <div class="melato-auth__grid">
    <header class="melato-auth__intro">
      <p class="melato-auth__eyebrow">Account / Registration</p>
      <h1 id="MelatoRegisterTitle-{{ section.id }}" class="melato-auth__title">Create Account</h1>
      <p class="melato-auth__note">Create one Melato account for order history, delivery details and a faster return to the house.</p>
    </header>

    <div class="melato-auth__form">
      {%- form 'create_customer' -%}
        {%- if form.errors -%}
          <div class="melato-form-error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="melato-auth__name-grid">
          <div class="melato-field">
            <label for="reg-first">First name</label>
            <input type="text" name="customer[first_name]" id="reg-first" autocomplete="given-name">
          </div>
          <div class="melato-field">
            <label for="reg-last">Last name</label>
            <input type="text" name="customer[last_name]" id="reg-last" autocomplete="family-name">
          </div>
        </div>

        <div class="melato-field">
          <label for="reg-email">Email address</label>
          <input type="email" name="customer[email]" id="reg-email" autocomplete="email" autocapitalize="off" required>
        </div>

        <div class="melato-field">
          <label for="reg-password">Password</label>
          <input type="password" name="customer[password]" id="reg-password" autocomplete="new-password" required>
        </div>

        <div class="melato-auth__actions">
          <button type="submit" class="melato-house-button">Create account</button>
          <a href="{{ routes.account_login_url }}" class="melato-house-button melato-house-button--secondary">Already have an account</a>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Register", "tag": "section", "settings": [] }
{% endschema %}
